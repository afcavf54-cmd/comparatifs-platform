<!-- ===== METHODOLOGIE ===== -->
<section id="methodologie" style="padding:96px 48px;background:#fff;">
  <div style="max-width:820px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:64px;">
      <span style="display:block;color:#6366F1;font-weight:700;font-size:13px;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:14px;">Notre processus</span>
      <h2 style="margin:0 auto;max-width:640px;font-size:40px;font-weight:800;letter-spacing:-0.02em;text-wrap:balance;">Comment nous analysons un logiciel</h2>
