<style>
/* ===================================================================
   A PROPOS - startup-factory-fr.
   Design « Startup Factory » (Claude Design), aplati en statique.
   En-tete + pied = partials _nav / _footer (autoportants) : ils ne
   reclament que les variables :root ci-dessous (theme.*).
   Le corps du design garde sa palette inline (#6366F1 / #14B8A6 /
   #1E293B) et ses polices Plus Jakarta Sans + JetBrains Mono.
   =================================================================== */
:root{
  --bg:{{ theme.bg }};
  --surface:#fff;
  --ink:{{ theme.ink }};
  --accent:{{ theme.accent }};
  --accent2:{{ theme.accent2 }};
  --cta:{{ theme.cta_color if theme.cta_color is defined and theme.cta_color else "#14B8A6" }};
  --cta-text:{{ theme.cta_text_color if theme.cta_text_color is defined and theme.cta_text_color else "#ffffff" }};
  --border:#E2E8F0;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans',system-ui,-apple-system,sans-serif;background:var(--bg);color:#0F172A;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
a{text-decoration:none;color:inherit}
nav.site-nav .nav-logo{font-family:'{{ theme.font_title }}',serif}
nav.site-nav .nav-links a,nav.site-nav .nav-cta,nav.site-nav .nav-mobile a,.footer{font-family:'{{ theme.font_body }}',system-ui,-apple-system,sans-serif}
/* FAQ accordeon natif (indicateur + / - du design, sans JS) */
details.faq-item{border:1px solid #E7EAF0;border-radius:16px;overflow:hidden;background:#fff;box-shadow:0 2px 10px rgba(15,23,42,0.04)}
details.faq-item>summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;padding:22px 26px}
details.faq-item>summary::-webkit-details-marker{display:none}
details.faq-item>summary .faq-q{font-size:17px;font-weight:700;color:#0F172A;padding-right:20px;line-height:1.4}
details.faq-item>summary .faq-ico{display:inline-flex;width:34px;height:34px;align-items:center;justify-content:center;border-radius:50%;background:#F1F5F9;color:#475569;font-size:20px;line-height:1;flex:none}
details.faq-item>summary .faq-ico::after{content:"+"}
details.faq-item[open]>summary .faq-ico::after{content:"\2212"}
details.faq-item>.faq-a{padding:0 26px 24px}
details.faq-item>.faq-a p{margin:0;color:#475569;font-size:16px;line-height:1.7;border-top:1px solid #F1F5F9;padding-top:18px}
</style>
</head>
