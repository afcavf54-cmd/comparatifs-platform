<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ brand.meta_title or ('Codes promo ' ~ brand.marque ~ ' — ' ~ build_month_year ~ ' | ' ~ site.name) }}</title>
  <meta name="description" content="{{ brand.meta_description or (brand.n_total | string ~ ' codes promo ' ~ brand.marque ~ ' vérifiés. ' ~ (brand.avis_sophie | striptags | truncate(110, true, '…') if brand.avis_sophie else '')) }}">
  <link rel="canonical" href="{{ site.url }}/codes-promo/{{ brand.slug }}/">
  <link rel="icon" href="/favicon.png" type="image/png">

  <!-- Fonts Google -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">

  <!-- JSON-LD Rich Snippets -->
  {% for block in jsonld_blocks %}
  <script type="application/ld+json">{{ block | tojson(indent=2) | safe }}</script>
  {% endfor %}

  <style>
    /* ═══ DESIGN TOKENS ════════════════════════════════════════════════════ */
    :root {
      --rose-50: #fff5f8; --rose-100: #ffe7ef; --rose-200: #ffd0e0;
      --rose-300: #ffb1cc; --rose-500: #ff5b8a; --rose-600: #ec3f76;
      --rose-700: #cf2c61; --coral: #ff7a59;
      --ink: #251d27; --ink-soft: #5d5360; --line: #f0e3e9;
      --bg: #fafafa; --white: #fff;
      --green: #2bb673; --green-soft: #e6f7ef;
      --grad: linear-gradient(135deg, var(--rose-500), var(--coral));
      --r: 22px;
      --shadow-sm: 0 1px 3px rgba(207,44,97,0.06), 0 1px 2px rgba(207,44,97,0.04);
      --shadow-md: 0 6px 20px rgba(207,44,97,0.10), 0 2px 8px rgba(207,44,97,0.06);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Nunito Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 16px; line-height: 1.6; color: var(--ink);
      background: var(--bg);
    }
    h1, h2, h3, h4 { font-family: 'Poppins', sans-serif; font-weight: 700; }
    a { color: inherit; text-decoration: none; }

    /* ═══ HEADER (identique aux autres pages cadeauclic) ═══════════════════ */
    header { background: var(--white); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 100; }
    .nav { max-width: 1200px; margin: 0 auto; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .logo { font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 1.4rem; display: flex; align-items: center; gap: 8px; }
    .logo img { height: 34px; width: auto; }
    .logo-fallback { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .nav-collapse { display: flex; align-items: center; gap: 28px; flex: 1; justify-content: space-between; }
    .menu { display: flex; gap: 22px; list-style: none; }
    .menu a { font-weight: 600; font-size: .95rem; color: var(--ink-soft); transition: color .2s; }
    .menu a:hover { color: var(--rose-600); }
    .nav-right { display: flex; align-items: center; gap: 16px; }
    .socials { display: flex; gap: 10px; }
    .socials a { width: 32px; height: 32px; border-radius: 50%; background: var(--rose-50); display: flex; align-items: center; justify-content: center; color: var(--rose-600); transition: all .2s; }
    .socials a:hover { background: var(--rose-500); color: var(--white); }
    .socials svg { width: 16px; height: 16px; }
    .btn { background: var(--grad); color: var(--white); padding: 10px 20px; border-radius: 999px; font-weight: 700; font-size: .95rem; border: 0; cursor: pointer; transition: all .2s; display: inline-flex; align-items: center; gap: 6px; }
    .btn:hover { transform: translateY(-1px); box-shadow: var(--shadow-md); }
    .hamburger { display: none; background: none; border: 0; cursor: pointer; padding: 8px; }
    .hamburger span { display: block; width: 22px; height: 2px; background: var(--ink); margin: 5px 0; transition: all .3s; }
    .nav-backdrop { display: none; position: fixed; inset: 0; background: rgba(37,29,39,0.5); z-index: 90; }

    /* ═══ MAIN WRAP ════════════════════════════════════════════════════════ */
    .wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

    /* Breadcrumb */
    .crumb { padding: 20px 0 8px; font-size: .9rem; color: var(--ink-soft); }
    .crumb a { color: var(--ink-soft); }
    .crumb a:hover { color: var(--rose-600); }
    .crumb span { color: var(--ink); font-weight: 600; }

    /* Page head */
    .page-head { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding: 24px 0 28px; }
    .page-head h1 { font-size: 2.4rem; line-height: 1.15; margin-bottom: 8px; }
    .pink { color: var(--rose-600); }
    .updated { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-soft); font-size: .95rem; }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); animation: pulse 2s infinite; }
    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }
    .brandbox { width: 110px; height: 110px; background: var(--white); border-radius: 18px; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; padding: 14px; flex-shrink: 0; box-shadow: var(--shadow-sm); }
    .brandbox img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .brandbox .ph { font-family: 'Poppins', sans-serif; font-weight: 700; color: var(--rose-600); font-size: 1rem; text-align: center; }

    /* Tabs filtres */
    .tabs { display: flex; gap: 8px; padding-bottom: 24px; flex-wrap: wrap; }
    .tab { background: var(--white); border: 1px solid var(--line); padding: 10px 16px; border-radius: 999px; cursor: pointer; font-weight: 600; font-size: .9rem; color: var(--ink-soft); display: inline-flex; align-items: center; gap: 6px; transition: all .2s; }
    .tab .count { background: var(--rose-50); color: var(--rose-600); padding: 2px 8px; border-radius: 999px; font-size: .8rem; font-weight: 700; }
    .tab:hover { border-color: var(--rose-300); color: var(--ink); }
    .tab.active { background: var(--ink); color: var(--white); border-color: var(--ink); }
    .tab.active .count { background: rgba(255,255,255,.15); color: var(--white); }

    /* ═══ LAYOUT 2 COLS ════════════════════════════════════════════════════ */
    .layout { display: grid; grid-template-columns: 1fr 340px; gap: 36px; padding-bottom: 56px; }

    /* ═══ COUPON CARD ══════════════════════════════════════════════════════ */
    .coupon { background: var(--white); border-radius: var(--r); padding: 22px; margin-bottom: 16px; display: grid; grid-template-columns: 110px 1fr 160px; gap: 22px; align-items: center; box-shadow: var(--shadow-sm); border: 1px solid var(--line); transition: all .2s; }
    .coupon:hover { box-shadow: var(--shadow-md); transform: translateY(-1px); }
    .coupon[data-best="1"] { border-color: var(--rose-300); position: relative; }
    .coupon[data-best="1"]::before { content: "⭐ Meilleure remise"; position: absolute; top: -10px; left: 22px; background: var(--grad); color: var(--white); font-size: .72rem; font-weight: 700; padding: 4px 10px; border-radius: 999px; letter-spacing: .03em; }

    .val { text-align: center; }
    .val .big { font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 2.2rem; line-height: 1; color: var(--rose-600); }
    .val .kind { display: inline-block; margin-top: 6px; font-size: .72rem; font-weight: 700; background: var(--rose-50); color: var(--rose-600); padding: 3px 10px; border-radius: 999px; text-transform: uppercase; letter-spacing: .03em; }

    .mid h3 { font-size: 1.05rem; line-height: 1.35; margin-bottom: 10px; }
    .meta { display: flex; flex-wrap: wrap; gap: 14px; font-size: .85rem; color: var(--ink-soft); margin-bottom: 10px; }
    .verif { color: var(--green); font-weight: 700; }
    .tested { display: inline-flex; align-items: center; gap: 8px; background: var(--rose-50); color: var(--ink); font-size: .85rem; padding: 6px 12px; border-radius: 999px; margin-bottom: 10px; }
    .ava { width: 22px; height: 22px; border-radius: 50%; background: var(--grad); color: var(--white); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: .72rem; }
    .detail { background: none; border: 0; color: var(--ink-soft); cursor: pointer; font-size: .85rem; font-weight: 600; padding: 0; display: inline-flex; align-items: center; gap: 4px; transition: color .2s; }
    .detail:hover { color: var(--rose-600); }
    .detail .chev { transition: transform .2s; }
    .detail.open .chev { transform: rotate(180deg); }
    .detail-body { max-height: 0; overflow: hidden; transition: max-height .3s ease; }
    .detail-body .inner { padding: 14px 0 4px; font-size: .92rem; color: var(--ink-soft); line-height: 1.6; }
    .detail-body .inner ul { padding-left: 18px; margin-top: 8px; }
    .detail-body .inner li { margin-bottom: 4px; }

    /* Reveal code button */
    .reveal { background: var(--grad); color: var(--white); border: 0; padding: 14px 18px; border-radius: 12px; cursor: pointer; font-weight: 700; font-size: .95rem; display: flex; flex-direction: column; align-items: center; gap: 4px; transition: all .2s; position: relative; overflow: hidden; }
    .reveal::after { content: ''; position: absolute; inset: 0; background: rgba(255,255,255,.15); transform: translateX(-100%); transition: transform .3s; }
    .reveal:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
    .reveal:hover::after { transform: translateX(0); }
    .reveal .label { font-size: .95rem; }
    .reveal .peek { font-family: 'Poppins', sans-serif; font-size: .8rem; opacity: .9; letter-spacing: .1em; font-weight: 600; }
    /* For offer type (no code) the reveal button shows "Profiter" */
    .reveal[data-type="offer"] .peek { display: none; }

    /* Expired section */
    .expired { margin-top: 36px; padding-top: 28px; border-top: 1px dashed var(--line); }
    .expired h2 { font-size: 1.15rem; margin-bottom: 18px; color: var(--ink-soft); }
    .expired .coupon { opacity: .55; }
    .expired .coupon:hover { opacity: 1; }

    /* Rating bar */
    .rating { background: var(--white); border-radius: var(--r); padding: 22px; margin-top: 28px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; box-shadow: var(--shadow-sm); border: 1px solid var(--line); }
    .stars { display: inline-flex; gap: 2px; color: #ffb400; font-size: 1.15rem; }

    /* Panels: How-to / History / FAQ */
    .panel { background: var(--white); border-radius: var(--r); padding: 32px; margin-top: 28px; box-shadow: var(--shadow-sm); border: 1px solid var(--line); }
    .panel h2 { font-size: 1.45rem; margin-bottom: 22px; }

    /* How-to steps */
    .steps { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .step { display: flex; gap: 16px; align-items: flex-start; }
    .step .num { width: 36px; height: 36px; border-radius: 50%; background: var(--grad); color: var(--white); font-weight: 800; display: flex; align-items: center; justify-content: center; font-family: 'Poppins', sans-serif; flex-shrink: 0; }
    .step p { color: var(--ink-soft); line-height: 1.55; font-size: .95rem; }

    /* History chart */
    .chart { display: flex; align-items: flex-end; gap: 12px; height: 180px; padding: 12px 0; border-bottom: 1px solid var(--line); }
    .chart .bar { flex: 1; background: var(--grad); border-radius: 6px 6px 0 0; position: relative; min-height: 6px; transition: all .3s; }
    .chart .bar:hover { opacity: .85; }
    .chart .bar::after { content: attr(data-val); position: absolute; top: -22px; left: 50%; transform: translateX(-50%); font-size: .8rem; font-weight: 700; color: var(--ink); white-space: nowrap; }
    .chart-x { display: flex; gap: 12px; padding-top: 8px; }
    .chart-x span { flex: 1; text-align: center; font-size: .78rem; color: var(--ink-soft); text-transform: uppercase; letter-spacing: .03em; }

    /* FAQ */
    .faq-item { border-bottom: 1px solid var(--line); }
    .faq-item:last-child { border-bottom: 0; }
    .faq-q { width: 100%; background: none; border: 0; padding: 18px 0; font-size: 1rem; font-weight: 600; color: var(--ink); cursor: pointer; text-align: left; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
    .faq-q .plus { font-size: 1.3rem; color: var(--rose-600); transition: transform .2s; flex-shrink: 0; }
    .faq-item.active .faq-q .plus { transform: rotate(45deg); }
    .faq-a { max-height: 0; overflow: hidden; transition: max-height .3s ease; }
    .faq-a .inner { padding: 0 0 18px; color: var(--ink-soft); line-height: 1.65; }

    /* ═══ SIDEBAR (ASIDE) ══════════════════════════════════════════════════ */
    aside { display: flex; flex-direction: column; gap: 16px; }
    .side-card { background: var(--white); border-radius: var(--r); padding: 22px; box-shadow: var(--shadow-sm); border: 1px solid var(--line); }
    .side-card h4 { font-size: 1rem; margin-bottom: 12px; }
    .side-card p { font-size: .92rem; color: var(--ink-soft); line-height: 1.6; }
    .avis-head { display: flex; align-items: center; gap: 10px; }
    .avis-head img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
    .avis-head .ph-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--grad); color: var(--white); display: flex; align-items: center; justify-content: center; font-weight: 700; font-family: 'Poppins', sans-serif; }
    .side-links { display: flex; flex-direction: column; gap: 10px; }
    .side-links a { font-size: .9rem; color: var(--rose-600); font-weight: 600; padding: 8px 12px; background: var(--rose-50); border-radius: 10px; transition: all .2s; }
    .side-links a:hover { background: var(--rose-100); transform: translateX(2px); }
    .stores { display: flex; flex-wrap: wrap; gap: 6px; }
    .stores a { font-size: .8rem; padding: 5px 10px; background: var(--rose-50); color: var(--rose-700); border-radius: 8px; font-weight: 600; transition: all .2s; }
    .stores a:hover { background: var(--rose-100); }

    /* ═══ SIMILAR BAND ═════════════════════════════════════════════════════ */
    .similar-band { background: linear-gradient(180deg, var(--white), var(--rose-50)); padding: 56px 0; }
    .similar-title { font-size: 1.6rem; margin-bottom: 8px; }
    .similar-sub { color: var(--ink-soft); margin-bottom: 28px; max-width: 70ch; }
    .similar-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    .similar-card { background: var(--white); border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 6px; border: 1px solid var(--line); transition: all .2s; }
    .similar-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--rose-200); }
    .sc-logo { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1.1rem; color: var(--ink); }
    .sc-deal { color: var(--rose-600); font-weight: 700; font-size: .9rem; }
    .sc-meta { font-size: .8rem; color: var(--ink-soft); }

    /* ═══ POPUP MODALE CODE ════════════════════════════════════════════════ */
    .modal-backdrop { position: fixed; inset: 0; background: rgba(37,29,39,.5); z-index: 200; display: none; align-items: center; justify-content: center; padding: 20px; }
    .modal-backdrop.active { display: flex; }
    .modal { background: var(--white); border-radius: 16px; padding: 40px 36px 32px; max-width: 540px; width: 100%; position: relative; box-shadow: 0 20px 60px rgba(0,0,0,.2); }
    .modal-close { position: absolute; top: 14px; right: 14px; width: 32px; height: 32px; background: none; border: 0; cursor: pointer; font-size: 1.4rem; color: var(--ink-soft); display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: all .2s; }
    .modal-close:hover { background: var(--rose-50); color: var(--rose-600); }
    .modal-logo { text-align: center; margin-bottom: 18px; }
    .modal-logo img { max-height: 44px; max-width: 140px; object-fit: contain; }
    .modal-logo .ph { font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 1.4rem; color: var(--ink); }
    .modal-title { text-align: center; font-size: 1.05rem; color: var(--ink); margin-bottom: 22px; font-weight: 400; }
    .modal-title strong { font-weight: 700; }
    .modal-code-box { display: flex; align-items: stretch; border: 2px dashed var(--green); border-radius: 10px; overflow: hidden; max-width: 360px; margin: 0 auto 14px; }
    .modal-code-box .code-text { flex: 1; padding: 14px 18px; font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1.05rem; letter-spacing: .12em; color: var(--ink); text-align: center; user-select: all; }
    .modal-code-box .code-copy-btn { background: var(--white); border: 0; border-left: 2px dashed var(--green); padding: 0 22px; font-weight: 700; font-size: .85rem; color: var(--ink); cursor: pointer; letter-spacing: .03em; transition: background .2s; }
    .modal-code-box .code-copy-btn:hover { background: var(--green-soft); }
    .modal-code-box .code-copy-btn.copied { background: var(--green); color: var(--white); border-left-color: var(--green); }
    .modal-sub { text-align: center; color: var(--ink-soft); font-size: .9rem; margin-bottom: 20px; }
    .modal-feedback { display: flex; align-items: center; gap: 12px; justify-content: center; margin-bottom: 22px; padding-bottom: 22px; border-bottom: 1px solid var(--line); }
    .modal-feedback-q { color: var(--ink-soft); font-size: .9rem; }
    .modal-feedback button { width: 40px; height: 40px; border-radius: 50%; border: 0; cursor: pointer; font-size: 1.1rem; transition: all .2s; }
    .modal-feedback .yes { background: var(--green-soft); color: var(--green); }
    .modal-feedback .yes:hover, .modal-feedback .yes.active { background: var(--green); color: var(--white); }
    .modal-feedback .no { background: var(--rose-50); color: var(--rose-600); }
    .modal-feedback .no:hover, .modal-feedback .no.active { background: var(--rose-500); color: var(--white); }
    .modal-detail { color: var(--ink-soft); font-size: .92rem; line-height: 1.55; margin-bottom: 24px; }
    .modal-cta { display: flex; justify-content: flex-end; }
    .modal-cta a { background: var(--green); color: var(--white); padding: 12px 22px; border-radius: 10px; font-weight: 700; font-size: .95rem; transition: all .2s; }
    .modal-cta a:hover { background: #259a62; transform: translateY(-1px); }

    /* ═══ FOOTER (identique aux autres pages cadeauclic) ═══════════════════ */
    footer { background: var(--ink); color: var(--white); padding: 56px 0 24px; }
    .foot-grid { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 36px; }
    .foot-grid h4 { font-size: 1rem; margin-bottom: 16px; }
    .foot-grid p, .foot-grid a { color: rgba(255,255,255,.7); font-size: .92rem; line-height: 1.7; }
    .foot-grid a { display: block; transition: color .2s; }
    .foot-grid a:hover { color: var(--white); }
    .foot-grid img { filter: brightness(0) invert(1); height: 36px; margin-bottom: 14px; }
    .foot-bottom { max-width: 1200px; margin: 32px auto 0; padding: 20px 24px 0; border-top: 1px solid rgba(255,255,255,.1); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; color: rgba(255,255,255,.5); font-size: .85rem; }

    /* ═══ COPIED TOAST ═════════════════════════════════════════════════════ */
    .copied-toast { position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%) translateY(120%); background: var(--ink); color: var(--white); padding: 14px 22px; border-radius: 12px; font-weight: 600; box-shadow: 0 10px 30px rgba(0,0,0,.2); z-index: 300; transition: transform .3s cubic-bezier(.4,0,.2,1); }
    .copied-toast.show { transform: translateX(-50%) translateY(0); }

    /* ═══ RESPONSIVE ═══════════════════════════════════════════════════════ */
    @media (max-width: 980px) {
      .nav-collapse { position: fixed; top: 0; right: 0; bottom: 0; width: min(320px, 85vw); background: var(--white); flex-direction: column; padding: 80px 28px 28px; transform: translateX(100%); transition: transform .3s cubic-bezier(.4,0,.2,1); z-index: 95; box-shadow: -10px 0 30px rgba(0,0,0,.1); justify-content: flex-start; gap: 18px; }
      body.menu-open .nav-collapse { transform: translateX(0); }
      body.menu-open .nav-backdrop { display: block; }
      body.menu-open { overflow: hidden; }
      body.menu-open .hamburger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      body.menu-open .hamburger span:nth-child(2) { opacity: 0; }
      body.menu-open .hamburger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
      .menu { flex-direction: column; gap: 4px; width: 100%; }
      .menu a { display: block; padding: 10px 0; }
      .nav-right { flex-direction: column; align-items: stretch; gap: 18px; width: 100%; margin-top: 12px; }
      .nav-right .btn { width: 100%; justify-content: center; }
      .hamburger { display: block; z-index: 100; }
      .layout { grid-template-columns: 1fr; }
      .page-head { flex-direction: column-reverse; align-items: flex-start; gap: 18px; }
      .page-head h1 { font-size: 1.8rem; }
      .brandbox { width: 86px; height: 86px; }
      .coupon { grid-template-columns: 80px 1fr; padding: 18px; }
      .coupon .reveal { grid-column: 1 / -1; flex-direction: row; justify-content: center; gap: 10px; }
      .val .big { font-size: 1.7rem; }
      .steps { grid-template-columns: 1fr; }
      .similar-grid { grid-template-columns: repeat(2, 1fr); }
      .foot-grid { grid-template-columns: 1fr; gap: 28px; }
      .panel { padding: 24px 22px; }
      .chart { gap: 6px; }
      .chart-x { gap: 6px; }
      .chart-x span { font-size: .65rem; }
    }
    @media (max-width: 600px) {
      .similar-grid { grid-template-columns: 1fr; }
      .modal { padding: 32px 22px 22px; }
      .modal-code-box { max-width: 100%; }
      .modal-code-box .code-text { font-size: .95rem; padding: 12px 14px; }
      .modal-code-box .code-copy-btn { padding: 0 14px; font-size: .8rem; }
    }
  </style>
</head>
<body>

<!-- ═══ HEADER ═══════════════════════════════════════════════════════════ -->
{# ─── Nav (partial site-local cadeauclic) ─────────────────────────────
   Source unique de vérité pour le header — modifs du menu dans
   platform/sites/cadeauclic-com/templates/base/_nav.html.j2 #}
{% include "base/_nav.html.j2" %}

<div class="wrap">
  <!-- BREADCRUMB -->
  <nav class="crumb">
    <a href="/">Accueil</a> ›
    <a href="/codes-promo/">Codes promo</a> ›
    <span>{{ brand.marque }}</span>
  </nav>

  <!-- PAGE HEAD -->
  <div class="page-head">
    <div>
      <h1>Codes promo <span class="pink">{{ brand.marque }}</span> — {{ build_month_year }}</h1>
      <span class="updated"><span class="dot"></span>{{ brand.n_total }} code{{ 's' if brand.n_total > 1 else '' }} promo {{ brand.marque }} vérifié{{ 's' if brand.n_total > 1 else '' }} le {{ build_date_fr }}</span>
    </div>
    <div class="brandbox">
      {% if brand.logo_url %}
      <img src="{{ brand.logo_url }}" alt="Logo {{ brand.marque }}" onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
      <div class="ph" style="display:none">{{ brand.marque }}</div>
      {% else %}
      <div class="ph">{{ brand.marque }}</div>
      {% endif %}
    </div>
  </div>

  <!-- TABS -->
  <div class="tabs" id="tabs">
    <button class="tab active" data-filter="all">Tout <span class="count">{{ brand.n_total }}</span></button>
    <button class="tab" data-filter="code">Codes promo <span class="count">{{ brand.n_codes }}</span></button>
    <button class="tab" data-filter="offer">Offres <span class="count">{{ brand.n_offres }}</span></button>
    <button class="tab" data-filter="best">Meilleure remise</button>
  </div>

  <!-- LAYOUT -->
  <div class="layout">
    <!-- ===== MAIN ===== -->
    <main id="list">
      {% for c in brand.codes_actifs %}
      <article class="coupon" data-type="{{ c.type }}" data-best="{{ '1' if c.meilleure_remise else '0' }}">
        <div class="val">
          <div class="big">{% if c.valeur %}{% if c.unite == '%' %}{{ c.valeur | int }}%{% elif c.unite == '€' %}{{ c.valeur | int }}€{% else %}{{ c.valeur }}{% endif %}{% else %}🎁{% endif %}</div>
          <span class="kind">{{ c.sous_type }}</span>
        </div>
        <div class="mid">
          <h3>{{ c.accroche }}</h3>
          <div class="meta">
            <span class="verif">✓ Vérifié le {{ build_date_short_fr }}</span>
            {% if c.nb_utilisations and c.nb_utilisations > 0 %}<span>Utilisé {{ '{:,}'.format(c.nb_utilisations).replace(',', ' ') }} fois</span>{% endif %}
            {% if c.expire_le %}<span>Expire le {{ c.expire_le | replace('2026-','') | replace('-', '/') }}</span>{% endif %}
          </div>
          {% if c.teste_par_sophie %}
          <div class="tested">
            {% if author.photo %}
            <img src="{{ author.photo }}" alt="" style="width:22px;height:22px;border-radius:50%;object-fit:cover" onerror="this.outerHTML='<span class=ava>{{ (author.name or 'S')[0] }}</span>'">
            {% else %}
            <span class="ava">{{ (author.name or 'Sophie')[0] }}</span>
            {% endif %}
            {{ c.teste_par_sophie }}
          </div>
          {% endif %}
          {% if c.detail %}
          <button class="detail" aria-expanded="false">Afficher le détail <span class="chev">⌄</span></button>
          <div class="detail-body"><div class="inner">{{ c.detail | replace('\n- ', '<br>• ') | replace('\n', '<br>') | safe }}</div></div>
          {% endif %}
        </div>
        <button class="reveal" data-type="{{ c.type }}" data-code="{{ c.code }}" data-id="{{ c.id }}">
          <span class="label">{% if c.type == 'code' %}Voir le code 🏷️{% else %}Profiter de l'offre →{% endif %}</span>
          {% if c.code %}<span class="peek">{{ c.code[:2] }}•••</span>{% endif %}
        </button>
      </article>
      {% endfor %}

      {% if brand.codes_expires %}
      <div class="expired">
        <h2>Codes récemment expirés <span style="font-weight:400;font-size:.85em;">parfois ils fonctionnent encore, tente ta chance&nbsp;!</span></h2>
        {% for c in brand.codes_expires %}
        <article class="coupon" data-type="{{ c.type }}" data-best="0">
          <div class="val">
            <div class="big">{% if c.valeur %}{% if c.unite == '%' %}{{ c.valeur | int }}%{% elif c.unite == '€' %}{{ c.valeur | int }}€{% else %}{{ c.valeur }}{% endif %}{% else %}🎁{% endif %}</div>
            <span class="kind">{{ c.sous_type }}</span>
          </div>
          <div class="mid">
            <h3>{{ c.accroche }}</h3>
            <div class="meta"><span style="color:var(--ink-soft)">Expiré</span></div>
          </div>
          <button class="reveal" data-type="{{ c.type }}" data-code="{{ c.code }}" data-id="{{ c.id }}">
            <span class="label">Tenter quand même</span>
            {% if c.code %}<span class="peek">{{ c.code[:2] }}•••</span>{% endif %}
          </button>
        </article>
        {% endfor %}
      </div>
      {% endif %}

      <!-- RATING -->
      {% if brand.rating and brand.rating.value %}
      <div class="rating">
        <div class="stars">{% for i in range(5) %}{% if i < (brand.rating.value | round(0, 'floor') | int) %}★{% else %}☆{% endif %}{% endfor %}</div>
        <b>{{ brand.rating.value }} / 5</b>
        <span style="color:var(--ink-soft);font-size:.9rem">— note des codes {{ brand.marque }} par {{ brand.rating.count }} lecteurs</span>
      </div>
      {% endif %}

      <!-- HOW TO -->
      {% if how_to_steps %}
      <div class="panel">
        <h2>Comment utiliser un code promo {{ brand.marque }}&nbsp;?</h2>
        <div class="steps">
          {% for s in how_to_steps %}
          <div class="step"><span class="num">{{ s.num }}</span><p>{{ s.html | safe }}</p></div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      <!-- HISTORY CHART -->
      {% if brand.historique_12_mois %}
      <div class="panel">
        <h2>Historique des remises {{ brand.marque }}</h2>
        <p style="color:var(--ink-soft);margin-bottom:20px;font-size:.95rem">La meilleure remise disponible chaque mois sur les 12 derniers mois.</p>
        {% set max_val = brand.historique_12_mois | map(attribute='valeur') | max %}
        <div class="chart">
          {% for h in brand.historique_12_mois %}
          <div class="bar" style="height: {{ (h.valeur / max_val * 100) | round(0) | int }}%" data-val="{{ h.valeur | int }}%"></div>
          {% endfor %}
        </div>
        <div class="chart-x">
          {% for h in brand.historique_12_mois %}<span>{{ format_mois_court(h.mois) }}</span>{% endfor %}
        </div>
      </div>
      {% endif %}

      <!-- FAQ -->
      {% if brand.faq %}
      <div class="panel">
        <h2>Foire aux questions</h2>
        <div id="faq">
          {% for q in brand.faq %}
          <div class="faq-item">
            <button class="faq-q">{{ q.question }} <span class="plus">+</span></button>
            <div class="faq-a"><div class="inner">{{ q.reponse }}</div></div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </main>

    <!-- ===== ASIDE ===== -->
    <aside>
      <div class="side-card">
        <h4 class="avis-head">
          {% if author.photo %}
          <img src="{{ author.photo }}" alt="{{ author.name or 'Sophie' }}" onerror="this.outerHTML='<span class=ph-avatar>{{ (author.name or 'S')[0] }}</span>'">
          {% else %}
          <span class="ph-avatar">{{ (author.name or 'S')[0] }}</span>
          {% endif %}
          L'avis de {{ (author.name or 'Sophie').split(' ')[0] }}
        </h4>
        <p>{{ brand.avis_sophie or ('Je rassemble pour toi les meilleurs codes promo ' ~ brand.marque ~ '. Tous testés à la main.') }}</p>
        <a href="{{ brand.url_cta }}" class="btn" target="_blank" rel="nofollow noopener sponsored" style="width:100%;justify-content:center;margin-top:16px">Aller sur {{ brand.marque }} →</a>
      </div>

      {% if brand.conseil_sophie %}
      <div class="side-card">
        <h4>💡 Le conseil de {{ (author.name or 'Sophie').split(' ')[0] }}</h4>
        <p>{{ brand.conseil_sophie }}</p>
      </div>
      {% endif %}

      <div class="side-card">
        <h4>Aussi par ici</h4>
        <div class="side-links">
          <a href="/blog/">Idées cadeau & guides</a>
          <a href="/codes-promo/">Tous les codes promo</a>
          <a href="/parrainage/">Offres de parrainage du mois</a>
        </div>
      </div>

      {% if brand.description_marque %}
      <div class="side-card">
        <h4>Qu'est-ce que {{ brand.marque }}&nbsp;?</h4>
        <p>{{ brand.description_marque }}</p>
      </div>
      {% endif %}

      {% if related_brands %}
      <div class="side-card">
        <h4>Boutiques populaires</h4>
        <div class="stores">
          {% for r in related_brands[:6] %}<a href="/codes-promo/{{ r.slug }}/">{{ r.marque }}</a>{% endfor %}
        </div>
      </div>
      {% endif %}
    </aside>
  </div>
</div>

<!-- ═══ SIMILAR BAND ═══════════════════════════════════════════════════ -->
{% if related_brands %}
<section class="similar-band">
  <div class="wrap">
    <h2 class="similar-title">Codes promo de marques similaires</h2>
    <p class="similar-sub">Tu cherches mieux qu'un code {{ brand.marque }}&nbsp;? Voici d'autres boutiques {{ brand.categorie_marque | lower }} où je déniche régulièrement de bonnes affaires.</p>
    <div class="similar-grid">
      {% for r in related_brands %}
      <a href="/codes-promo/{{ r.slug }}/" class="similar-card">
        <span class="sc-logo">{{ r.marque }}</span>
        <span class="sc-deal">{{ r.best_offer_label or 'Voir les codes' }}</span>
        <span class="sc-meta">{{ r.n_total }} code{{ 's' if r.n_total > 1 else '' }} promo · vérifié{{ 's' if r.n_total > 1 else '' }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- ═══ FOOTER ═══════════════════════════════════════════════════════════ -->
<footer>
  <div class="foot-grid">
    <div>
      <img src="/logo.png" alt="{{ site.name }}" onerror="this.style.display='none'">
      <p>Bons plans, codes promo et idées cadeau, vérifiés à la main par {{ author.name or 'Sophie' }}. Pas de spam, que des affaires.</p>
      <div class="socials" style="margin-top:18px">
        <a href="https://www.facebook.com/cadeauclic/" target="_blank" rel="nofollow noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.13 8.44 9.88v-6.99H7.9v-2.89h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.89h-2.33V22c4.78-.75 8.44-4.88 8.44-9.94z"/></svg></a>
        <a href="https://www.instagram.com/cadeauclic/" target="_blank" rel="nofollow noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.31-1.46.72-2.13 1.38C1.35 2.68.94 3.35.63 4.14.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.72 1.46 1.38 2.13.67.66 1.34 1.07 2.13 1.38.76.3 1.64.5 2.91.56 1.28.06 1.69.07 4.95.07s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56.79-.31 1.46-.72 2.13-1.38.66-.67 1.07-1.34 1.38-2.13.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91-.31-.79-.72-1.46-1.38-2.13C21.32 1.35 20.65.94 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84c-3.4 0-6.16 2.76-6.16 6.16S8.6 18.16 12 18.16s6.16-2.76 6.16-6.16S15.4 5.84 12 5.84zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm6.41-11.85c-.79 0-1.44.64-1.44 1.44s.64 1.44 1.44 1.44c.79 0 1.44-.64 1.44-1.44s-.64-1.44-1.44-1.44z"/></svg></a>
        <a href="https://fr.pinterest.com/cadeaucliccom/" target="_blank" rel="nofollow noopener" aria-label="Pinterest"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.5 2 2 6.5 2 12.04c0 4.24 2.64 7.86 6.36 9.32-.08-.79-.16-2 .03-2.86.18-.79 1.16-5.04 1.16-5.04s-.3-.6-.3-1.48c0-1.39.81-2.43 1.81-2.43.86 0 1.27.64 1.27 1.41 0 .86-.55 2.14-.83 3.34-.24 1 .5 1.81 1.49 1.81 1.79 0 3.16-1.89 3.16-4.6 0-2.41-1.73-4.09-4.21-4.09-2.86 0-4.54 2.15-4.54 4.37 0 .87.33 1.79.75 2.3.08.1.09.18.07.29-.08.31-.25 1-.28 1.14-.04.18-.15.22-.34.13-1.25-.58-2.03-2.4-2.03-3.86 0-3.14 2.28-6.03 6.59-6.03 3.46 0 6.15 2.47 6.15 5.76 0 3.44-2.17 6.21-5.18 6.21-1.01 0-1.97-.53-2.29-1.15 0 0-.5 1.91-.62 2.38-.23.88-.84 1.98-1.25 2.65A10 10 0 0 0 12.04 22c5.53 0 10.01-4.48 10.01-10 0-5.55-4.48-10-10.01-10z"/></svg></a>
      </div>
    </div>
    <div>
      <h4>{{ site.name }}</h4>
      <a href="/codes-promo/">Codes promo</a>
      <a href="/blog/">Blog</a>
      <a href="/parrainage/">Parrainage</a>
      <a href="/a-propos/">À propos</a>
      <a href="/contact">Contact</a>
    </div>
    <div>
      <h4>Légal</h4>
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/politique-confidentialite">Politique de confidentialité</a>
      <a href="/cookies">Cookies</a>
    </div>
  </div>
  <div class="foot-bottom">
    <span>© {{ year }} {{ site.name }} — Tous droits réservés</span>
    <span>Fait à Paris avec 🎀</span>
  </div>
</footer>

<!-- ═══ POPUP MODALE CODE ═══════════════════════════════════════════════ -->
<div class="modal-backdrop" id="codeModal" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="modal">
    <button class="modal-close" id="modalClose" aria-label="Fermer">×</button>
    <div class="modal-logo">
      {% if brand.logo_url %}
      <img src="{{ brand.logo_url }}" alt="{{ brand.marque }}" onerror="this.outerHTML='<div class=ph>{{ brand.marque }}</div>'">
      {% else %}
      <div class="ph">{{ brand.marque }}</div>
      {% endif %}
    </div>
    <p class="modal-title" id="modalTitle"></p>
    <div class="modal-code-box" id="modalCodeBox" style="display:none">
      <div class="code-text" id="modalCode"></div>
      <button class="code-copy-btn" id="modalCopy">COPIER</button>
    </div>
    <p class="modal-sub" id="modalSub">Entrez le code dans votre panier.</p>
    <div class="modal-feedback">
      <span class="modal-feedback-q">Le code promo fonctionne-t-il&nbsp;?</span>
      <button class="yes" data-feedback="yes" aria-label="Oui">👍</button>
      <button class="no" data-feedback="no" aria-label="Non">👎</button>
    </div>
    <div class="modal-detail" id="modalDetail"></div>
    <div class="modal-cta">
      <a href="{{ brand.url_cta }}" target="_blank" rel="nofollow noopener sponsored" id="modalCta">Vers {{ brand.marque }}</a>
    </div>
  </div>
</div>

<!-- ═══ COPIED TOAST ═══════════════════════════════════════════════════ -->
<div class="copied-toast" id="copiedToast">✓ Code copié dans le presse-papiers</div>

<!-- ═══ SCRIPTS ═══════════════════════════════════════════════════════════ -->
<script>
// Données des codes (pour la popup) — injectées par Jinja
const COUPONS = {
{% for c in brand.codes %}  "{{ c.id }}": { code: {{ c.code | tojson }}, accroche: {{ c.accroche | tojson }}, detail: {{ (c.detail or '') | tojson }}, valeur: {{ c.valeur | tojson }}, unite: {{ c.unite | tojson }}, type: {{ c.type | tojson }} },
{% endfor %}};
const URL_AFFILIATION = {{ brand.url_cta | tojson }};
const MARQUE = {{ brand.marque | tojson }};

// ── HAMBURGER MOBILE ─────────────────────────────────────────────────
(function(){
  const ham = document.getElementById('hamburger');
  const backdrop = document.getElementById('navBackdrop');
  const body = document.body;
  if (!ham) return;
  function toggle(open) {
    body.classList.toggle('menu-open', open);
    ham.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  ham.addEventListener('click', () => toggle(!body.classList.contains('menu-open')));
  backdrop.addEventListener('click', () => toggle(false));
})();

// ── TABS FILTRES ────────────────────────────────────────────────────
(function(){
  const tabs = document.querySelectorAll('.tab');
  const coupons = document.querySelectorAll('main#list > .coupon, main#list > .expired .coupon');
  tabs.forEach(t => t.addEventListener('click', () => {
    tabs.forEach(x => x.classList.remove('active'));
    t.classList.add('active');
    const f = t.dataset.filter;
    coupons.forEach(c => {
      let show = true;
      if (f === 'code') show = c.dataset.type === 'code';
      else if (f === 'offer') show = c.dataset.type === 'offer';
      else if (f === 'best') show = c.dataset.best === '1';
      c.style.display = show ? '' : 'none';
    });
  }));
})();

// ── DETAIL ACCORDÉON ───────────────────────────────────────────────
document.querySelectorAll('.detail').forEach(btn => {
  btn.addEventListener('click', () => {
    const body = btn.nextElementSibling;
    const open = btn.classList.toggle('open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    body.style.maxHeight = open ? body.scrollHeight + 'px' : '0';
  });
});

// ── FAQ ACCORDÉON ──────────────────────────────────────────────────
document.querySelectorAll('.faq-q').forEach(q => {
  q.addEventListener('click', () => {
    const item = q.parentElement;
    const a = item.querySelector('.faq-a');
    const open = item.classList.toggle('active');
    a.style.maxHeight = open ? a.scrollHeight + 'px' : '0';
  });
});

// ── REVEAL CODE + POPUP MODALE ─────────────────────────────────────
(function(){
  const modal = document.getElementById('codeModal');
  const titleEl = document.getElementById('modalTitle');
  const codeBox = document.getElementById('modalCodeBox');
  const codeEl = document.getElementById('modalCode');
  const subEl = document.getElementById('modalSub');
  const detailEl = document.getElementById('modalDetail');
  const copyBtn = document.getElementById('modalCopy');
  const closeBtn = document.getElementById('modalClose');
  const cta = document.getElementById('modalCta');

  function openModal(id) {
    const c = COUPONS[id];
    if (!c) return;
    // Titre dynamique
    let valLabel = '';
    if (c.valeur && c.unite === '%') valLabel = `${c.valeur}% de réduction`;
    else if (c.valeur && c.unite === '€') valLabel = `${c.valeur}€ offerts`;
    else valLabel = c.accroche.split(' ').slice(0, 4).join(' ');
    titleEl.innerHTML = `<strong>${valLabel}</strong> avec ce ${c.type === 'code' ? 'code promo' : 'bon plan'} ${MARQUE}`;
    // Code box (uniquement si type=code et code non vide)
    if (c.code && c.type === 'code') {
      codeEl.textContent = c.code;
      codeBox.style.display = 'flex';
      subEl.style.display = 'block';
    } else {
      codeBox.style.display = 'none';
      subEl.style.display = 'none';
    }
    detailEl.textContent = c.detail || '';
    detailEl.style.display = c.detail ? 'block' : 'none';
    modal.classList.add('active');
    modal.setAttribute('aria-hidden', 'false');
    // Reset feedback state
    modal.querySelectorAll('.modal-feedback button').forEach(b => b.classList.remove('active'));
    // Reset copy state
    copyBtn.classList.remove('copied');
    copyBtn.textContent = 'COPIER';
    // Ouvre l'URL d'affiliation en parallèle dans un nouvel onglet
    if (URL_AFFILIATION) window.open(URL_AFFILIATION, '_blank', 'noopener,noreferrer');
  }
  function closeModal() {
    modal.classList.remove('active');
    modal.setAttribute('aria-hidden', 'true');
  }
  document.querySelectorAll('.reveal').forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault();
      openModal(btn.dataset.id);
    });
  });
  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && modal.classList.contains('active')) closeModal(); });

  // Copy
  copyBtn.addEventListener('click', () => {
    const code = codeEl.textContent;
    if (!code) return;
    navigator.clipboard.writeText(code).then(() => {
      copyBtn.classList.add('copied');
      copyBtn.textContent = '✓ COPIÉ';
      showToast();
      setTimeout(() => {
        copyBtn.classList.remove('copied');
        copyBtn.textContent = 'COPIER';
      }, 2500);
    });
  });

  // Feedback 👍/👎 (visuel uniquement, pas de backend en V1)
  modal.querySelectorAll('.modal-feedback button').forEach(b => {
    b.addEventListener('click', () => {
      modal.querySelectorAll('.modal-feedback button').forEach(x => x.classList.remove('active'));
      b.classList.add('active');
    });
  });
})();

// ── COPIED TOAST ───────────────────────────────────────────────────
function showToast() {
  const t = document.getElementById('copiedToast');
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2400);
}
</script>

</body>
