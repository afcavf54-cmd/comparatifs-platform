{#
  base/_nav.html.j2 — Override SITE-LOCAL pour cadeauclic uniquement.
  
  Ce fichier prend le dessus sur platform/templates/base/_nav.html.j2 grâce au
  ChoiceLoader Jinja configuré dans generate.py (site-local templates passent
  AVANT les templates communs). Donc :
    - Pages cadeauclic (blog, avis, etc.) → utilisent ce header rose/coral
    - Autres sites du réseau → utilisent le header commun, inchangé

  Style identique au header de la home cadeauclic-com/templates/index.html.j2
  pour assurer la continuité visuelle. Le partial est autonome (CSS, HTML, JS
  inline) — il fonctionne sans dépendance externe, donc s'intègre sur toutes
  les pages cadeauclic (blog-index, blog-post, avis-*, classement-*, etc.).

  Liens du menu : Idées cadeaux / Blog / Parrainage / À propos (conditionnel
  sur site.has_a_propos défini par generate.py).
#}
<style>
  /* ─── Reset défensif ──────────────────────────────────────────────────
     Certains templates communs du réseau (contact.html.j2, plan-du-site,
     mentions-legales, politique-confidentialite…) ont des sélecteurs CSS
     **par tag** trop larges, du genre `nav { background: var(--ink); ... }`.
     Ces règles attrapent les <nav>, <header>, <button> de notre partial
     même s'il a ses propres classes préfixées `cdc-*`. On reset donc
     explicitement les propriétés critiques sur les éléments internes du
     partial pour qu'aucun style parent ne percole. */
  .cdc-header,
  .cdc-header * {
    background: transparent;
    height: auto;
    position: static;
    padding: 0;
    margin: 0;
    border-radius: 0;
  }
  .cdc-header { position: sticky; }   /* on remet le sticky uniquement sur le header */

  /* ─── Palette cadeauclic (scope local au partial) ────────────────────
     Variables redéfinies ici pour que le header fonctionne même sur les
     pages communes (blog, avis) qui n'ont pas le :root global de la home.
     Les noms commencent par --cdc-* pour éviter tout conflit avec d'autres
     variables CSS du site (--ink, --accent, etc. du thème commun). */
  :root {
    --cdc-rose-50: #fff5f8;
    --cdc-rose-100: #ffe7ef;
    --cdc-rose-200: #ffd0e0;
    --cdc-rose-600: #ec3f76;
    --cdc-rose-700: #cf2c61;
    --cdc-coral: #ff7a59;
    --cdc-ink: #251d27;
    --cdc-ink-soft: #5d5360;
    --cdc-line: #f0e3e9;
    --cdc-grad: linear-gradient(100deg, #ff5b8a, #ff7a59);
  }

  /* ─── Header sticky ────────────────────────────────────────────────── */
  .cdc-header { position: sticky; top: 0; z-index: 50;
    background: rgba(255,255,255,.92); backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--cdc-line);
    font-family: "Nunito Sans", system-ui, -apple-system, sans-serif; }
  .cdc-header * { box-sizing: border-box; }
  .cdc-header a { text-decoration: none; color: inherit; }

  .cdc-nav { display: flex; align-items: center; justify-content: space-between;
    padding: 18px 28px; gap: 24px; max-width: 1200px; margin: 0 auto; }

  .cdc-logo { display: flex; align-items: center; gap: 6px;
    font-family: "Poppins", system-ui, sans-serif;
    font-weight: 800; font-size: 1.35rem; color: var(--cdc-ink); }
  .cdc-logo .mark { font-size: 1.55rem; }
  .cdc-logo span.accent { color: var(--cdc-rose-600); }
  .cdc-logo-img { height: 40px; width: auto; max-width: 200px; display: block; }

  .cdc-nav-collapse { display: flex; align-items: center; gap: 30px; }
  .cdc-menu { display: flex; gap: 30px; list-style: none; margin: 0; padding: 0; }
  .cdc-menu a { font-family: "Poppins", system-ui, sans-serif; font-weight: 600;
    color: var(--cdc-ink-soft); font-size: .95rem; transition: color .15s; }
  .cdc-menu a:hover, .cdc-menu a.active { color: var(--cdc-rose-600); }

  .cdc-nav-right { display: flex; align-items: center; gap: 18px; }
  .cdc-btn { display: inline-flex; align-items: center; padding: 12px 22px;
    font-size: .92rem; font-family: "Poppins", sans-serif; font-weight: 700;
    color: #fff; background: var(--cdc-grad); border-radius: 999px;
    box-shadow: 0 8px 20px rgba(236,63,118,.28); transition: transform .15s, box-shadow .15s; }
  .cdc-btn:hover { transform: translateY(-1px); box-shadow: 0 10px 24px rgba(236,63,118,.36); }

  .cdc-socials { display: flex; gap: 10px; }
  .cdc-socials a { width: 36px; height: 36px; border-radius: 50%;
    background: var(--cdc-rose-50); display: inline-flex; align-items: center;
    justify-content: center; color: var(--cdc-rose-600); transition: background .15s; }
  .cdc-socials a:hover { background: var(--cdc-rose-100); }
  .cdc-socials svg { width: 16px; height: 16px; fill: currentColor; }

  /* ─── Hamburger ────────────────────────────────────────────────────── */
  .cdc-hamburger { display: none; flex-direction: column; gap: 5px;
    width: 28px; height: 28px; padding: 0; background: transparent;
    border: 0; cursor: pointer; justify-content: center; z-index: 51; }
  .cdc-hamburger span { display: block; width: 100%; height: 2px;
    background: var(--cdc-ink); border-radius: 2px;
    transition: transform .25s, opacity .2s; }
  body.cdc-menu-open .cdc-hamburger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  body.cdc-menu-open .cdc-hamburger span:nth-child(2) { opacity: 0; }
  body.cdc-menu-open .cdc-hamburger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .cdc-nav-backdrop { display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,.4); opacity: 0; pointer-events: none;
    transition: opacity .25s; z-index: 49; }
  body.cdc-menu-open .cdc-nav-backdrop { opacity: 1; pointer-events: auto; }

  /* ─── Mobile ───────────────────────────────────────────────────────── */
  @media (max-width: 880px) {
    .cdc-hamburger { display: flex; }
    .cdc-nav-backdrop { display: block; }
    .cdc-nav-collapse {
      position: fixed; top: 0; right: 0; bottom: 0;
      width: min(86vw, 360px); padding: 90px 28px 28px;
      background: #fff; transform: translateX(105%);
      transition: transform .3s cubic-bezier(.4,0,.2,1);
      z-index: 50; flex-direction: column; align-items: flex-start; gap: 26px;
      overflow-y: auto; box-shadow: -20px 0 60px rgba(0,0,0,.12);
    }
    body.cdc-menu-open .cdc-nav-collapse { transform: translateX(0); }
    .cdc-menu { flex-direction: column; gap: 18px; width: 100%; }
    .cdc-menu a { font-size: 1.1rem; padding: 6px 0; }
    .cdc-nav-right { flex-direction: column-reverse; align-items: flex-start; gap: 24px; width: 100%; }
    .cdc-socials { width: 100%; }
  }
</style>

<header class="cdc-header">
  <div class="cdc-nav">
    <a href="/" class="cdc-logo">
      {# Logo image avec fallback texte si /logo.png absent ou en 404 #}
      <img src="/logo.png" alt="{{ site.name | default('CadeauClic') }}" class="cdc-logo-img"
           onerror="this.onerror=null;this.style.display='none';var fb=this.parentNode.querySelector('.cdc-logo-fallback');if(fb)fb.style.display='inline-flex'">
      <span class="cdc-logo-fallback" style="display:none;align-items:center;gap:6px">
        <span class="mark">🎁</span>{{ site.logo_text | default('Cadeau') }}{% if site.logo_accent %}<span class="accent">{{ site.logo_accent }}</span>{% endif %}
      </span>
    </a>

    {# Bouton hamburger — visible uniquement sur mobile #}
    <button class="cdc-hamburger" aria-label="Ouvrir le menu" aria-controls="cdc-nav-drawer" aria-expanded="false"
            onclick="var o=document.body.classList.toggle('cdc-menu-open');this.setAttribute('aria-expanded',o);this.setAttribute('aria-label',o?'Fermer le menu':'Ouvrir le menu')">
      <span></span><span></span><span></span>
    </button>

    {# Wrapper menu + nav-right — devient drawer slide-in sur mobile #}
    <div class="cdc-nav-collapse" id="cdc-nav-drawer">
      <nav class="cdc-menu">
        <a href="/categorie-idees-cadeaux/">Idées cadeaux</a>
        <a href="/blog/">Blog</a>
        <a href="/categorie-bons-plans-parrainage/">Parrainage</a>
        {% if site.has_a_propos is defined and site.has_a_propos %}
        <a href="/a-propos/">À propos</a>
        {% endif %}
      </nav>
      <div class="cdc-nav-right">
        <a href="/codes-promo/" class="cdc-btn">Bons plans</a>
        <div class="cdc-socials">
          <a href="https://www.facebook.com/cadeauclic/" target="_blank" rel="nofollow noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24"><path d="M13 22v-8h2.7l.4-3.1H13V8.9c0-.9.3-1.5 1.6-1.5H16V4.6c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.4H7.2V14H9.9v8H13z"/></svg>
          </a>
          <a href="https://www.instagram.com/cadeauclic/" target="_blank" rel="nofollow noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24"><path d="M12 8.6A3.4 3.4 0 1 0 15.4 12 3.4 3.4 0 0 0 12 8.6zm0 5.6A2.2 2.2 0 1 1 14.2 12 2.2 2.2 0 0 1 12 14.2zm4.3-5.8a.8.8 0 1 1-.8-.8.8.8 0 0 1 .8.8zM18.7 8a3.9 3.9 0 0 0-1.1-2.8A3.9 3.9 0 0 0 14.8 4c-1.1-.1-4.5-.1-5.6 0A3.9 3.9 0 0 0 6.4 5.2 3.9 3.9 0 0 0 5.3 8c-.1 1.1-.1 4.5 0 5.6a3.9 3.9 0 0 0 1.1 2.8 3.9 3.9 0 0 0 2.8 1.1c1.1.1 4.5.1 5.6 0a3.9 3.9 0 0 0 2.8-1.1 3.9 3.9 0 0 0 1.1-2.8c.1-1.1.1-4.5 0-5.6z"/></svg>
          </a>
          <a href="https://fr.pinterest.com/cadeaucliccom/" target="_blank" rel="nofollow noopener" aria-label="Pinterest">
            <svg viewBox="0 0 24 24"><path d="M12 4a8 8 0 0 0-2.9 15.4c0-.6-.1-1.6.1-2.3l1-4.2s-.2-.5-.2-1.3c0-1.2.7-2.1 1.6-2.1.7 0 1.1.6 1.1 1.2 0 .8-.5 1.9-.7 2.9-.2.9.4 1.6 1.3 1.6 1.6 0 2.7-2 2.7-4.4 0-1.8-1.2-3.2-3.5-3.2a4 4 0 0 0-4.1 4c0 .8.3 1.4.6 1.8.2.2.2.3.1.5l-.2.8c0 .3-.2.4-.5.2-1.2-.5-1.7-1.9-1.7-3.4 0-2.5 2.1-5.5 6.3-5.5 3.4 0 5.6 2.4 5.6 5 0 3.4-1.9 6-4.7 6-1 0-1.8-.5-2.1-1.1l-.6 2.2c-.2.7-.6 1.5-1 2A8 8 0 1 0 12 4z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>
<div class="cdc-nav-backdrop" onclick="document.body.classList.remove('cdc-menu-open');var h=document.querySelector('.cdc-hamburger');if(h){h.setAttribute('aria-expanded','false');h.setAttribute('aria-label','Ouvrir le menu')}"></div>
