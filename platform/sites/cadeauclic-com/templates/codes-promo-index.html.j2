<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tous les codes promo — {{ build_month_year }} | {{ site.name }}</title>
  <meta name="description" content="Tous les codes promo et bons plans du moment, vérifiés à la main par {{ author.name or 'Sophie' }}. {{ brands | length }} marques, {{ total_codes }} codes promo actifs.">
  <link rel="canonical" href="{{ site.url }}/codes-promo/">
  <link rel="icon" href="/favicon.png" type="image/png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Tous les codes promo {{ site.name }}",
    "url": "{{ site.url }}/codes-promo/",
    "description": "{{ brands | length }} marques, {{ total_codes }} codes promo vérifiés."
  }
  </script>

  <style>
    :root {
      --rose-50: #fff5f8; --rose-100: #ffe7ef; --rose-200: #ffd0e0;
      --rose-300: #ffb1cc; --rose-500: #ff5b8a; --rose-600: #ec3f76;
      --rose-700: #cf2c61; --coral: #ff7a59;
      --ink: #251d27; --ink-soft: #5d5360; --line: #f0e3e9;
      --bg: #fafafa; --white: #fff;
      --grad: linear-gradient(135deg, var(--rose-500), var(--coral));
      --r: 22px;
      --shadow-sm: 0 1px 3px rgba(207,44,97,0.06);
      --shadow-md: 0 6px 20px rgba(207,44,97,0.10);
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:'Nunito Sans',-apple-system,sans-serif; font-size:16px; line-height:1.6; color:var(--ink); background:var(--bg); }
    h1,h2,h3 { font-family:'Poppins',sans-serif; font-weight:700; }
    a { color:inherit; text-decoration:none; }

    /* HEADER identique aux autres pages */
    header { background:var(--white); border-bottom:1px solid var(--line); position:sticky; top:0; z-index:100; }
    .nav { max-width:1200px; margin:0 auto; padding:16px 24px; display:flex; align-items:center; justify-content:space-between; gap:24px; }
    .logo { font-family:'Poppins',sans-serif; font-weight:800; font-size:1.4rem; display:flex; align-items:center; gap:8px; }
    .logo img { height:34px; }
    .logo-fallback { background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent; }
    .nav-collapse { display:flex; align-items:center; gap:28px; flex:1; justify-content:space-between; }
    .menu { display:flex; gap:22px; list-style:none; }
    .menu a { font-weight:600; font-size:.95rem; color:var(--ink-soft); }
    .menu a:hover { color:var(--rose-600); }
    .nav-right { display:flex; align-items:center; gap:16px; }
    .socials { display:flex; gap:10px; }
    .socials a { width:32px; height:32px; border-radius:50%; background:var(--rose-50); display:flex; align-items:center; justify-content:center; color:var(--rose-600); }
    .socials a:hover { background:var(--rose-500); color:var(--white); }
    .socials svg { width:16px; height:16px; }
    .btn { background:var(--grad); color:var(--white); padding:10px 20px; border-radius:999px; font-weight:700; font-size:.95rem; }
    .hamburger { display:none; background:none; border:0; cursor:pointer; padding:8px; }
    .hamburger span { display:block; width:22px; height:2px; background:var(--ink); margin:5px 0; transition:all .3s; }
    .nav-backdrop { display:none; position:fixed; inset:0; background:rgba(37,29,39,.5); z-index:90; }

    .wrap { max-width:1200px; margin:0 auto; padding:0 24px; }

    /* HERO */
    .hero { padding:64px 0 40px; text-align:center; }
    .hero h1 { font-size:2.6rem; line-height:1.15; margin-bottom:14px; }
    .hero h1 .pink { color:var(--rose-600); }
    .hero p { color:var(--ink-soft); max-width:620px; margin:0 auto; font-size:1.05rem; }

    /* FILTRE PAR CATÉGORIE */
    .filters { display:flex; gap:8px; flex-wrap:wrap; justify-content:center; padding:0 0 36px; }
    .filter { background:var(--white); border:1px solid var(--line); padding:8px 16px; border-radius:999px; cursor:pointer; font-weight:600; font-size:.9rem; color:var(--ink-soft); transition:all .2s; }
    .filter:hover { border-color:var(--rose-300); color:var(--ink); }
    .filter.active { background:var(--ink); color:var(--white); border-color:var(--ink); }

    /* GRID MARQUES */
    .grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; padding-bottom:64px; }
    .card { background:var(--white); border-radius:var(--r); padding:24px 20px; border:1px solid var(--line); display:flex; flex-direction:column; align-items:center; text-align:center; gap:10px; transition:all .2s; box-shadow:var(--shadow-sm); }
    .card:hover { transform:translateY(-3px); box-shadow:var(--shadow-md); border-color:var(--rose-200); }
    .card-logo { width:80px; height:80px; background:var(--rose-50); border-radius:16px; display:flex; align-items:center; justify-content:center; padding:10px; margin-bottom:6px; }
    .card-logo img { max-width:100%; max-height:100%; object-fit:contain; }
    .card-logo .ph { font-family:'Poppins',sans-serif; font-weight:700; color:var(--rose-600); font-size:.95rem; }
    .card-name { font-family:'Poppins',sans-serif; font-weight:700; color:var(--ink); font-size:1.05rem; }
    .card-deal { color:var(--rose-600); font-weight:700; font-size:.95rem; }
    .card-count { font-size:.82rem; color:var(--ink-soft); }
    .card-cat { font-size:.75rem; color:var(--rose-700); background:var(--rose-50); padding:3px 10px; border-radius:999px; font-weight:600; }

    .empty { text-align:center; padding:80px 0; color:var(--ink-soft); }
    .empty h2 { color:var(--ink); margin-bottom:8px; }

    /* FOOTER identique aux autres pages */
    footer { background:var(--ink); color:var(--white); padding:56px 0 24px; margin-top:40px; }
    .foot-grid { max-width:1200px; margin:0 auto; padding:0 24px; display:grid; grid-template-columns:2fr 1fr 1fr; gap:36px; }
    .foot-grid h4 { font-size:1rem; margin-bottom:16px; }
    .foot-grid p, .foot-grid a { color:rgba(255,255,255,.7); font-size:.92rem; line-height:1.7; }
    .foot-grid a { display:block; }
    .foot-grid a:hover { color:var(--white); }
    .foot-grid img { filter:brightness(0) invert(1); height:36px; margin-bottom:14px; }
    .foot-bottom { max-width:1200px; margin:32px auto 0; padding:20px 24px 0; border-top:1px solid rgba(255,255,255,.1); display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px; color:rgba(255,255,255,.5); font-size:.85rem; }

    @media (max-width:980px) {
      .nav-collapse { position:fixed; top:0; right:0; bottom:0; width:min(320px,85vw); background:var(--white); flex-direction:column; padding:80px 28px 28px; transform:translateX(100%); transition:transform .3s cubic-bezier(.4,0,.2,1); z-index:95; box-shadow:-10px 0 30px rgba(0,0,0,.1); justify-content:flex-start; gap:18px; }
      body.menu-open .nav-collapse { transform:translateX(0); }
      body.menu-open .nav-backdrop { display:block; }
      body.menu-open { overflow:hidden; }
      .menu { flex-direction:column; gap:4px; }
      .menu a { display:block; padding:10px 0; }
      .nav-right { flex-direction:column; align-items:stretch; gap:18px; width:100%; }
      .nav-right .btn { width:100%; text-align:center; }
      .hamburger { display:block; z-index:100; }
      .hero h1 { font-size:1.9rem; }
      .grid { grid-template-columns:repeat(2,1fr); gap:14px; }
      .foot-grid { grid-template-columns:1fr; gap:28px; }
    }
    @media (max-width:600px) {
      .grid { grid-template-columns:1fr; }
    }
  </style>
</head>
<body>

{# ─── Nav (partial site-local cadeauclic) ─────────────────────────────
   Source unique de vérité pour le header — modifs du menu dans
   platform/sites/cadeauclic-com/templates/base/_nav.html.j2 #}
{% include "base/_nav.html.j2" %}

<div class="wrap">
  <div class="hero">
    <h1>Tous les <span class="pink">codes promo</span> & bons plans</h1>
    <p>{{ brands | length }} marque{{ 's' if brands | length > 1 else '' }} référencée{{ 's' if brands | length > 1 else '' }}, {{ total_codes }} code{{ 's' if total_codes > 1 else '' }} promo vérifié{{ 's' if total_codes > 1 else '' }} par {{ author.name or 'Sophie' }}. Mis à jour {{ build_date_fr }}.</p>
  </div>

  {% if categories %}
  <div class="filters" id="filters">
    <button class="filter active" data-cat="all">Toutes ({{ brands | length }})</button>
    {% for cat in categories %}
    <button class="filter" data-cat="{{ cat.slug }}">{{ cat.name }} ({{ cat.count }})</button>
    {% endfor %}
  </div>
  {% endif %}

  {% if brands %}
  <div class="grid" id="grid">
    {% for b in brands %}
    <a href="/codes-promo/{{ b.slug }}/" class="card" data-cat="{{ b.categorie_marque | lower | replace(' ', '-') }}">
      <div class="card-logo">
        {% if b.logo_url %}
        <img src="{{ b.logo_url }}" alt="Logo {{ b.marque }}" onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
        <div class="ph" style="display:none">{{ b.marque }}</div>
        {% else %}
        <div class="ph">{{ b.marque }}</div>
        {% endif %}
      </div>
      <div class="card-name">{{ b.marque }}</div>
      <div class="card-deal">{{ b.best_offer_label or 'Voir les codes' }}</div>
      <div class="card-count">{{ b.n_total }} code{{ 's' if b.n_total > 1 else '' }} actif{{ 's' if b.n_total > 1 else '' }}</div>
      {% if b.categorie_marque %}<div class="card-cat">{{ b.categorie_marque }}</div>{% endif %}
    </a>
    {% endfor %}
  </div>
  {% else %}
  <div class="empty">
    <h2>Aucun code promo pour l'instant</h2>
    <p>Les bons plans arrivent bientôt. Reviens vite !</p>
  </div>
  {% endif %}
</div>

<footer>
  <div class="foot-grid">
    <div>
      <img src="/logo.png" alt="{{ site.name }}" onerror="this.style.display='none'">
      <p>Bons plans, codes promo et idées cadeau, vérifiés à la main par {{ author.name or 'Sophie' }}.</p>
    </div>
    <div>
      <h4>{{ site.name }}</h4>
      <a href="/codes-promo/">Codes promo</a>
      <a href="/blog/">Blog</a>
      <a href="/parrainage/">Parrainage</a>
      <a href="/a-propos/">À propos</a>
      <a href="/contact">Contact</a>
    </div>
    <div>
      <h4>Légal</h4>
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/politique-confidentialite">Politique de confidentialité</a>
      <a href="/cookies">Cookies</a>
    </div>
  </div>
  <div class="foot-bottom">
    <span>© {{ year }} {{ site.name }} — Tous droits réservés</span>
    <span>Fait à Paris avec 🎀</span>
  </div>
</footer>

<script>
(function(){
  const ham = document.getElementById('hamburger');
  const backdrop = document.getElementById('navBackdrop');
  const body = document.body;
  if (!ham) return;
  ham.addEventListener('click', () => body.classList.toggle('menu-open'));
  backdrop.addEventListener('click', () => body.classList.remove('menu-open'));
})();
(function(){
  const filters = document.querySelectorAll('.filter');
  const cards = document.querySelectorAll('.grid .card');
  filters.forEach(f => f.addEventListener('click', () => {
    filters.forEach(x => x.classList.remove('active'));
    f.classList.add('active');
    const cat = f.dataset.cat;
    cards.forEach(c => c.style.display = (cat === 'all' || c.dataset.cat === cat) ? '' : 'none');
  }));
})();
</script>

</body>
</html>
