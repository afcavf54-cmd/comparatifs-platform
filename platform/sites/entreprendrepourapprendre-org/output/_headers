# Headers HTTP custom pour Cloudflare Pages
# Format Netlify-compatible : <pattern> puis indentation 2 espaces pour chaque header
#
# Bug fix juin 2026 : par défaut, Cloudflare cachait les HTML jusqu'à 7 jours
# (s-maxage=604800), ce qui faisait que les pages désactivées via
# enabled_classements.json restaient servies depuis le cache zone Cloudflare
# pendant 1 semaine même après suppression côté Pages. Ce _headers force un
# TTL court (5 min CDN, revalidation côté browser) pour que les changements
# se propagent en quelques minutes max.

# HTML : court TTL CDN + revalidation forcée côté navigateur
/*.html
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate

# Sitemap, robots, manifest : court TTL pour refléter rapidement les changements
/sitemap.xml
  Cache-Control: public, max-age=300, s-maxage=300

/robots.txt
  Cache-Control: public, max-age=300, s-maxage=300

# Page racine (sert index.html)
/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate

# Assets statiques (CSS, JS, images, fonts) : long TTL OK car contenu immuable
# (les noms incluent un hash ou changent en cas de modif)
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Sécurité headers (s'applique partout)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
