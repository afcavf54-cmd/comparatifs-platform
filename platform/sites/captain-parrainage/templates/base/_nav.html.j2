{# Override captain-parrainage : header maquette (navy, logo, menu + CTA),
   remplace le _nav global pour toutes les pages générées (mentions, contact,
   blog, avis, 404…). Cohérent avec la home et cp-chrome.js. #}
<style>
@import url('https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&display=swap');
nav.cp-nav{background:#082044 !important;position:sticky;top:0;z-index:100;height:auto !important;padding:0 !important;border-bottom:1px solid rgba(255,255,255,0.08);font-family:Lexend,system-ui,sans-serif}
nav.cp-nav .cp-inner{max-width:1200px;margin:0 auto;padding:0 clamp(16px,4vw,40px);height:76px;display:flex;align-items:center;gap:clamp(16px,3vw,40px)}
nav.cp-nav .cp-links{flex:0 0 auto;white-space:nowrap;display:flex;gap:32px;font:600 13px/1 Lexend,sans-serif;text-transform:uppercase;letter-spacing:0.08em}
nav.cp-nav .cp-links a{color:#fff;text-decoration:none;padding:10px 0;border-bottom:3px solid transparent}
nav.cp-nav .cp-right{margin-left:auto;flex:0 0 auto;display:flex;align-items:center;gap:10px}
nav.cp-nav .cp-cta{flex:0 0 auto;display:inline-flex;align-items:center;height:44px;padding:0 clamp(14px,3vw,20px);border-radius:999px;background:#F9BD43;color:#082044;text-decoration:none;text-transform:uppercase;letter-spacing:0.06em;font:600 13px/1 Lexend,sans-serif;white-space:nowrap}
nav.cp-nav .cp-ico{display:inline-grid;place-items:center;width:42px;height:42px;border-radius:50%;color:#fff;border:1px solid rgba(255,255,255,0.22);text-decoration:none;flex:0 0 auto}
@media(max-width:820px){nav.cp-nav .cp-links{display:none}}
</style>
<nav class="cp-nav" aria-label="Navigation principale">
  <div class="cp-inner">
    <a href="/" aria-label="Captain Parrainage" style="display:flex;align-items:center;gap:10px;text-decoration:none">{% if site.logo_img is defined and site.logo_img %}<img src="{{ site.logo_img }}" alt="{{ site.name | default('Captain Parrainage') }}" style="height:42px;width:auto;object-fit:contain;display:block">{% else %}<span style="font:600 20px/1.02 Lexend,sans-serif;color:#fff;letter-spacing:-0.01em">Captain<span style="color:#13BFA6">Parrainage</span></span>{% endif %}</a>
    <div class="cp-links">
      <a href="/">Accueil</a>
      <a href="/offres/">Meilleures offres</a>
      <a href="/#comment-ca-marche">Comment ça marche</a>
    </div>
    <div class="cp-right">
      <a href="/inscription/" class="cp-cta">Recevoir les offres gratuites</a>
      <a href="/inscription/" class="cp-ico" title="S'inscrire" aria-label="S'inscrire"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="16" y1="11" x2="22" y2="11"></line></svg></a>
      <a href="/connexion/" class="cp-ico" title="Se connecter" aria-label="Se connecter"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg></a>
    </div>
  </div>
</nav>
