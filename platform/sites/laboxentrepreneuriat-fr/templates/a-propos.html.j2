              <circle r="30" fill="#7C3AED" opacity="0.12"></circle>
              <circle r="24" fill="#fff"></circle>
              <circle cx="0" cy="-4" r="7" fill="#334155"></circle>
              <path d="M-11 18 a11 11 0 0122 0" fill="#334155"></path>
            </g>
            <!-- bulle loupe (recherche) -->
            <g transform="translate(100,280)">
              <circle r="30" fill="#10B981" opacity="0.12"></circle>
              <circle r="24" fill="#fff"></circle>
              <circle cx="-2" cy="-2" r="8" fill="none" stroke="#10B981" stroke-width="2.4"></circle>
              <line x1="5" y1="5" x2="12" y2="12" stroke="#10B981" stroke-width="2.4" stroke-linecap="round"></line>
            </g>
            <!-- bulle étoile (note) -->
            <g transform="translate(326,310)">
              <circle r="28" fill="#0F172A" opacity="0.08"></circle>
              <circle r="22" fill="#fff"></circle>
              <path d="M0 -10 L2.5 -3 L10 -3 L4 2 L6.5 9 L0 5 L-6.5 9 L-4 2 L-10 -3 L-2.5 -3 Z" fill="#14808A"></path>
            </g>
            <!-- dots décoratifs -->
            <circle cx="200" cy="55" r="4" fill="#14808A" opacity="0.5"></circle>
            <circle cx="350" cy="150" r="3.5" fill="#10B981" opacity="0.5"></circle>
            <circle cx="60" cy="200" r="3" fill="#7C3AED" opacity="0.5"></circle>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ======== POURQUOI CE MÉDIA ======== -->
  <section id="story" style="max-width:1200px; margin:0 auto; padding:96px 40px;">
    <div style="display:grid; grid-template-columns:1.1fr 0.9fr; gap:72px; align-items:center;">
      <div>
        <span style="display:inline-block; padding:8px 16px; border-radius:8px; background:rgba(20,128,138,0.12); color:#14808A; font-size:14px; font-weight:700;">Notre histoire</span>
        <h2 style="margin:22px 0 0; font-size:42px; line-height:1.1; font-weight:800; letter-spacing:-0.02em; color:#0F172A; text-wrap:balance;">Pourquoi ce média existe</h2>
        <p style="margin:22px 0 0; font-size:17px; line-height:1.75; color:#475569;">Choisir un logiciel RH ou de gestion représente souvent <strong style="color:#0F172A;">plusieurs milliers d'euros</strong>, plusieurs mois de déploiement et un impact fort sur les équipes. Pourtant, la plupart des comparatifs en ligne sont rédigés sans jamais avoir ouvert l'outil.</p>
        <p style="margin:18px 0 0; font-size:17px; line-height:1.75; color:#475569;">Nous avons créé La Box Entrepreneuriat pour changer ça : des analyses <strong style="color:#0F172A;">rigoureuses et documentées</strong>, issues de tests en conditions réelles, pour vous aider à choisir en confiance.</p>
        <div style="margin-top:32px; display:flex; gap:12px; flex-wrap:wrap;">
          <span style="padding:10px 18px; border-radius:999px; background:#fff; border:1px solid #E9ECF2; font-size:14px; font-weight:600; color:#334155;">Tests en conditions réelles</span>
          <span style="padding:10px 18px; border-radius:999px; background:#fff; border:1px solid #E9ECF2; font-size:14px; font-weight:600; color:#334155;">Méthodologie transparente</span>
          <span style="padding:10px 18px; border-radius:999px; background:#fff; border:1px solid #E9ECF2; font-size:14px; font-weight:600; color:#334155;">Mis à jour en continu</span>
        </div>
      </div>
      <!-- Compteurs animés -->
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
        <div style="background:#0F172A; border-radius:20px; padding:32px; text-align:center;">
          <div style="font-size:46px; font-weight:800; color:#10B981; line-height:1;"><span>120+</span></div>
          <div style="margin-top:10px; font-size:14px; color:#8FA0B5; line-height:1.4;">logiciels analysés</div>
        </div>
        <div style="background:#fff; border:1px solid #E9ECF2; border-radius:20px; padding:32px; text-align:center;">
          <div style="font-size:46px; font-weight:800; color:#14808A; line-height:1;"><span>2400+</span></div>
          <div style="margin-top:10px; font-size:14px; color:#64748B; line-height:1.4;">heures de tests</div>
        </div>
        <div style="background:#fff; border:1px solid #E9ECF2; border-radius:20px; padding:32px; text-align:center;">
          <div style="font-size:46px; font-weight:800; color:#14808A; line-height:1;"><span>80+</span></div>
          <div style="margin-top:10px; font-size:14px; color:#64748B; line-height:1.4;">comparatifs publiés</div>
        </div>
        <div style="background:#0F172A; border-radius:20px; padding:32px; text-align:center;">
          <div style="font-size:46px; font-weight:800; color:#10B981; line-height:1;"><span>50k</span></div>
          <div style="margin-top:10px; font-size:14px; color:#8FA0B5; line-height:1.4;">lecteurs / mois</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======== NOS VALEURS ======== -->
  <section style="background:#fff; border-top:1px solid #EDEFF3; border-bottom:1px solid #EDEFF3;">
    <div style="max-width:1200px; margin:0 auto; padding:90px 40px;">
      <div style="text-align:center; max-width:640px; margin:0 auto;">
        <span style="display:inline-block; padding:8px 16px; border-radius:8px; background:rgba(20,128,138,0.12); color:#14808A; font-size:14px; font-weight:700;">Ce qui nous guide</span>
        <h2 style="margin:20px 0 0; font-size:42px; font-weight:800; letter-spacing:-0.02em; color:#0F172A; text-wrap:balance;">Nos valeurs</h2>
      </div>
      <div style="margin-top:52px; display:grid; grid-template-columns:repeat(4,1fr); gap:22px;">
          <div style="background:#FAFAFC; border:1px solid #E9ECF2; border-radius:20px; padding:30px;"><div style="font-size:13px; font-weight:800; color:#10B981; letter-spacing:0.06em;">01</div><h3 style="margin:14px 0 0; font-size:21px; font-weight:800; color:#0F172A;">Rigueur</h3><p style="margin:12px 0 0; font-size:15px; line-height:1.65; color:#64748B;">Chaque logiciel est soumis à notre protocole d'évaluation en 7 étapes avant toute publication. Pas de raccourci.</p></div>
          <div style="background:#FAFAFC; border:1px solid #E9ECF2; border-radius:20px; padding:30px;"><div style="font-size:13px; font-weight:800; color:#10B981; letter-spacing:0.06em;">02</div><h3 style="margin:14px 0 0; font-size:21px; font-weight:800; color:#0F172A;">Transparence</h3><p style="margin:12px 0 0; font-size:15px; line-height:1.65; color:#64748B;">Nous expliquons toujours pourquoi un logiciel est mieux classé. Notre méthodologie est publique.</p></div>
          <div style="background:#FAFAFC; border:1px solid #E9ECF2; border-radius:20px; padding:30px;"><div style="font-size:13px; font-weight:800; color:#10B981; letter-spacing:0.06em;">03</div><h3 style="margin:14px 0 0; font-size:21px; font-weight:800; color:#0F172A;">Expertise</h3><p style="margin:12px 0 0; font-size:15px; line-height:1.65; color:#64748B;">Chaque logiciel est étudié en conditions réelles avant publication. Pas de contenu généré sans test.</p></div>
          <div style="background:#FAFAFC; border:1px solid #E9ECF2; border-radius:20px; padding:30px;"><div style="font-size:13px; font-weight:800; color:#10B981; letter-spacing:0.06em;">04</div><h3 style="margin:14px 0 0; font-size:21px; font-weight:800; color:#0F172A;">Utilité</h3><p style="margin:12px 0 0; font-size:15px; line-height:1.65; color:#64748B;">Notre priorité : vous aider à choisir le bon outil, pas à faire du volume. Qualité avant quantité.</p></div>
      </div>
    </div>
  </section>

  <!-- ======== MÉTHODOLOGIE ======== -->
  <section id="methodologie" style="background:#0F172A; color:#fff;">
    <div style="max-width:1200px; margin:0 auto; padding:92px 40px;">
      <div style="display:grid; grid-template-columns:0.85fr 1.15fr; gap:72px; align-items:start;">
        <div style="position:sticky; top:120px;">
          <span style="font-size:13px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:#9DE6E0;">Transparence totale</span>
          <h2 style="margin:16px 0 0; font-size:40px; font-weight:800; letter-spacing:-0.02em; line-height:1.1; text-wrap:balance;">Notre processus d'évaluation, étape par étape</h2>
          <p style="margin:20px 0 0; font-size:17px; line-height:1.7; color:#AEBACB;">Chaque logiciel est soumis à un protocole rigoureux en 7 étapes. Aucun raccourci, aucune complaisance.</p>
          <div style="margin-top:28px; padding:22px 24px; background:rgba(16,185,129,0.08); border:1px solid rgba(16,185,129,0.2); border-radius:16px;">
            <div style="display:flex; align-items:center; gap:12px;">
              <div style="width:36px; height:36px; border-radius:50%; background:#10B981; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4M5 12a7 7 0 1014 0A7 7 0 005 12z" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </div>
              <p style="margin:0; font-size:15px; color:#9DE6E0; line-height:1.5;">Chaque logiciel est évalué selon notre protocole en 7 étapes, documenté et appliqué sans exception.</p>
            </div>
          </div>
        </div>
        <!-- Timeline -->
        <div>
            <div style="display:grid; grid-template-columns:52px 1fr; gap:20px; position:relative;"><div style="display:flex; flex-direction:column; align-items:center;"><div style="width:44px; height:44px; border-radius:50%; background:#10B981; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:16px; color:#fff; flex-shrink:0; z-index:1;">1</div><div style="width:2px; flex:1; min-height:36px; background:rgba(255,255,255,0.07); margin-top:4px;"></div></div><div style="padding-bottom:40px;"><h3 style="margin:10px 0 0; font-size:19px; font-weight:700; color:#fff;">Sélection des logiciels</h3><p style="margin:8px 0 0; font-size:15px; line-height:1.65; color:#8FA0B5;">Identification des solutions leaders du marché par catégorie via veille permanente et retours utilisateurs.</p></div></div>
            <div style="display:grid; grid-template-columns:52px 1fr; gap:20px; position:relative;"><div style="display:flex; flex-direction:column; align-items:center;"><div style="width:44px; height:44px; border-radius:50%; background:#10B981; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:16px; color:#fff; flex-shrink:0; z-index:1;">2</div><div style="width:2px; flex:1; min-height:36px; background:rgba(255,255,255,0.07); margin-top:4px;"></div></div><div style="padding-bottom:40px;"><h3 style="margin:10px 0 0; font-size:19px; font-weight:700; color:#fff;">Création d'un compte réel</h3><p style="margin:8px 0 0; font-size:15px; line-height:1.65; color:#8FA0B5;">Nous créons un compte sans traitement de faveur, pour tester dans les mêmes conditions que vous.</p></div></div>
            <div style="display:grid; grid-template-columns:52px 1fr; gap:20px; position:relative;"><div style="display:flex; flex-direction:column; align-items:center;"><div style="width:44px; height:44px; border-radius:50%; background:#10B981; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:16px; color:#fff; flex-shrink:0; z-index:1;">3</div><div style="width:2px; flex:1; min-height:36px; background:rgba(255,255,255,0.07); margin-top:4px;"></div></div><div style="padding-bottom:40px;"><h3 style="margin:10px 0 0; font-size:19px; font-weight:700; color:#fff;">Test des fonctionnalités</h3><p style="margin:8px 0 0; font-size:15px; line-height:1.65; color:#8FA0B5;">Exploration complète de chaque module : saisie, automatisations, reporting, gestion des droits…</p></div></div>
            <div style="display:grid; grid-template-columns:52px 1fr; gap:20px; position:relative;"><div style="display:flex; flex-direction:column; align-items:center;"><div style="width:44px; height:44px; border-radius:50%; background:#10B981; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:16px; color:#fff; flex-shrink:0; z-index:1;">4</div><div style="width:2px; flex:1; min-height:36px; background:rgba(255,255,255,0.07); margin-top:4px;"></div></div><div style="padding-bottom:40px;"><h3 style="margin:10px 0 0; font-size:19px; font-weight:700; color:#fff;">Analyse des tarifs</h3><p style="margin:8px 0 0; font-size:15px; line-height:1.65; color:#8FA0B5;">Décryptage des grilles tarifaires, identification des coûts cachés et des options payantes.</p></div></div>
            <div style="display:grid; grid-template-columns:52px 1fr; gap:20px; position:relative;"><div style="display:flex; flex-direction:column; align-items:center;"><div style="width:44px; height:44px; border-radius:50%; background:#10B981; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:16px; color:#fff; flex-shrink:0; z-index:1;">5</div><div style="width:2px; flex:1; min-height:36px; background:rgba(255,255,255,0.07); margin-top:4px;"></div></div><div style="padding-bottom:40px;"><h3 style="margin:10px 0 0; font-size:19px; font-weight:700; color:#fff;">Comparaison concurrentielle</h3><p style="margin:8px 0 0; font-size:15px; line-height:1.65; color:#8FA0B5;">Mise en regard des forces et faiblesses face aux alternatives directes du marché.</p></div></div>
