<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>À propos · {{ site.name }}</title>
<meta name="description" content="À propos de {{ site.name }} : notre média de comparatifs de logiciels de gestion, notre méthodologie de test et notre auteur.">
<link rel="canonical" href="{{ site.domain }}/a-propos/">
{% if site.favicon_file is defined and site.favicon_file %}<link rel="icon" href="{{ site.favicon_file }}">{% else %}<link rel="icon" href="/favicon.svg" type="image/svg+xml">{% endif %}
{% if site.google_site_verification is defined and site.google_site_verification %}<meta name="google-site-verification" content="{{ site.google_site_verification }}">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@500;700&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ===================================================================
   A PROPOS - laboxentrepreneuriat-fr.
   Design « La Box Entrepreneuriat » (Claude Design), aplati en statique.
   En-tete + pied = partials _nav / _footer (autoportants) : ils ne
   reclament que les variables :root ci-dessous (theme.*).
   Le corps du design garde sa palette inline (#0F172A / #10B981 /
   #14808A) et ses polices Plus Jakarta Sans + JetBrains Mono.
   =================================================================== */
:root{
  --bg:{{ theme.bg }};
  --surface:#fff;
  --ink:{{ theme.ink }};
  --accent:{{ theme.accent }};
  --accent2:{{ theme.accent2 }};
  --cta:{{ theme.cta_color if theme.cta_color is defined and theme.cta_color else "#127C8A" }};
  --cta-text:{{ theme.cta_text_color if theme.cta_text_color is defined and theme.cta_text_color else "#ffffff" }};
  --border:#E2E8F0;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans',system-ui,-apple-system,sans-serif;background:var(--bg);color:#1C2733;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
a{text-decoration:none;color:inherit}
nav.site-nav .nav-logo{font-family:'{{ theme.font_title }}',serif}
nav.site-nav .nav-links a,nav.site-nav .nav-cta,nav.site-nav .nav-mobile a,.footer{font-family:'{{ theme.font_body }}',system-ui,-apple-system,sans-serif}
/* FAQ accordeon natif (icone « + » qui pivote en croix sur fond vert, sans JS) */
details.faq-item{background:#fff;border:1px solid #E9ECF2;border-radius:16px;overflow:hidden}
details.faq-item>summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 26px}
details.faq-item>summary::-webkit-details-marker{display:none}
details.faq-item>summary .faq-q{font-size:17px;font-weight:700;color:#0F172A;line-height:1.4}
details.faq-item>summary .faq-ico{width:32px;height:32px;border-radius:50%;background:#F1F5F9;flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:transform .25s ease,background .25s ease}
details.faq-item[open]>summary .faq-ico{transform:rotate(45deg);background:#10B981}
details.faq-item[open]>summary .faq-ico svg path{stroke:#fff}
details.faq-item>.faq-a{padding:0 26px 24px}
details.faq-item>.faq-a p{margin:0;font-size:16px;line-height:1.75;color:#475569}
</style>
</head>
<body>
{% include 'base/_nav.html.j2' %}
<div style="background:#FAFAFC; min-height:100vh; overflow-x:hidden;">

  <!-- ======== HEADER ======== -->

  <!-- ======== HERO ======== -->
  <section id="top" style="position:relative; background:#0F172A; color:#fff; overflow:hidden;">
    <div style="position:absolute; top:-140px; left:-120px; width:420px; height:420px; border-radius:50%; background:radial-gradient(circle, rgba(20,128,138,0.22), transparent 70%); pointer-events:none;"></div>
    <div style="position:absolute; bottom:-60px; right:-40px; width:260px; height:240px; border-radius:55% 45% 50% 50%/45% 55% 45% 55%; background:rgba(124,58,237,0.15); pointer-events:none;"></div>
    <div style="position:absolute; top:10%; right:44%; width:100px; height:120px; border-radius:60% 40% 55% 45%/50% 55% 45% 50%; background:rgba(20,128,138,0.28); pointer-events:none;"></div>
    <div style="position:relative; max-width:1240px; margin:0 auto; padding:88px 40px 90px; display:grid; grid-template-columns:1.1fr 0.9fr; gap:64px; align-items:center;">
      <div>
        <span style="display:inline-block; padding:8px 16px; border-radius:8px; background:rgba(16,185,129,0.14); color:#9DE6E0; font-size:14px; font-weight:700; letter-spacing:0.04em;">À propos</span>
        <h1 style="margin:22px 0 0; font-size:52px; line-height:1.07; font-weight:800; letter-spacing:-0.02em; text-wrap:balance;">Nous aidons les entreprises à choisir les meilleurs logiciels RH.</h1>
        <p style="margin:24px 0 0; max-width:520px; font-size:19px; line-height:1.65; color:#AEBACB; text-wrap:pretty;">La Box Entrepreneuriat est un média spécialisé dans l'analyse et le comparatif des logiciels de gestion. Notre mission : vous faire gagner du temps et vous aider à faire le bon choix.</p>
        <div style="margin-top:36px; display:flex; gap:16px; flex-wrap:wrap; align-items:center;">
          <a href="/nos-comparateurs" style="display:inline-flex; align-items:center; gap:9px; padding:16px 32px; border-radius:999px; background:#10B981; color:#fff; font-weight:700; font-size:16px; box-shadow:0 10px 28px rgba(16,185,129,0.30); transition:transform .18s, box-shadow .18s;" style-hover="transform:translateY(-2px); box-shadow:0 14px 34px rgba(16,185,129,0.42);">Découvrir nos comparatifs
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
          <a href="#methodologie" style="display:inline-flex; align-items:center; padding:16px 32px; border-radius:999px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.14); color:#fff; font-weight:700; font-size:16px; transition:background .18s;" style-hover="background:rgba(255,255,255,0.12);">Notre méthodologie</a>
        </div>
      </div>
      <!-- illustration éditoriale -->
      <div style="position:relative; aspect-ratio:1/1;">
        <div style="position:absolute; inset:0; border-radius:58% 42% 48% 52%/52% 48% 52% 48%; overflow:hidden; box-shadow:0 30px 70px rgba(0,0,0,0.35);">
          <svg viewBox="0 0 420 420" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" style="display:block;">
            <defs>
              <linearGradient id="apbg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#EBF3FA"></stop><stop offset="1" stop-color="#D4E4F2"></stop></linearGradient>
            </defs>
            <rect width="420" height="420" fill="url(#apbg)"></rect>
            <circle cx="380" cy="50" r="90" fill="#fff" opacity="0.4"></circle>
            <circle cx="30" cy="370" r="70" fill="#fff" opacity="0.35"></circle>
            <!-- document / article principal -->
            <rect x="130" y="80" width="160" height="200" rx="14" fill="#fff" filter="drop-shadow(0 8px 24px rgba(15,23,42,0.10))"></rect>
            <rect x="148" y="108" width="80" height="10" rx="5" fill="#0F172A"></rect>
            <rect x="148" y="126" width="124" height="7" rx="3.5" fill="#CBD5E1"></rect>
            <rect x="148" y="140" width="100" height="7" rx="3.5" fill="#CBD5E1"></rect>
            <rect x="148" y="163" width="124" height="7" rx="3.5" fill="#E2E8F0"></rect>
            <rect x="148" y="177" width="90" height="7" rx="3.5" fill="#E2E8F0"></rect>
            <rect x="148" y="191" width="110" height="7" rx="3.5" fill="#E2E8F0"></rect>
            <!-- note bar -->
            <rect x="148" y="214" width="124" height="18" rx="6" fill="#F1F5F9"></rect>
            <rect x="148" y="214" width="96" height="18" rx="6" fill="#10B981"></rect>
            <text x="196" y="227" text-anchor="middle" font-size="10" font-weight="700" fill="#fff" font-family="Plus Jakarta Sans,sans-serif">9.2 / 10</text>
            <!-- badge vérifié -->
            <circle cx="270" cy="95" r="20" fill="#10B981"></circle>
            <path d="M262 95 L267 101 L279 88" stroke="#fff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
            <!-- bulle personne 1 (rédacteur) -->
            <g transform="translate(94,160)">
              <circle r="32" fill="#14808A" opacity="0.12"></circle>
              <circle r="26" fill="#fff"></circle>
