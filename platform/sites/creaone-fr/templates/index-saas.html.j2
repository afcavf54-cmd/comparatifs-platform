<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
{% if site.favicon_file is defined and site.favicon_file %}
<link rel="icon" href="{{ site.favicon_file }}">
{% else %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
{% endif %}
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if home_title is defined and home_title %}{{ home_title }}{% else %}{{ site.name }}{% endif %}</title>
<meta name="description" content="{% if home_description is defined and home_description %}{{ home_description }}{% else %}Conseils, ressources et actualités pour créer et développer votre entreprise en {{ site.year }}.{% endif %}">
<link rel="canonical" href="{{ site.domain }}/">
<meta property="og:title" content="{{ home_title | default(site.name) }}">
<meta property="og:description" content="{{ home_description | default('') }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.domain }}/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=Lora:ital,wght@1,500;1,600&display=swap" rel="stylesheet">
{% if theme.google_fonts %}<link href="{{ theme.google_fonts }}&v={{ site.slug }}" rel="stylesheet">{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "WebSite",
  "name": "{{ site.name }}",
  "url": "{{ site.domain }}",
  "description": "{{ home_description | default('') }}",
  "author": { "@type": "Person", "name": "{{ site.author_name | default(site.name) }}" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ site.domain }}/recherche?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

<style>
/* ============================================================
   HOME CUSTOM — creaone-fr (design « CreaOne », éditorial).
   Classes scopées .cr-* — n'interfèrent pas avec _nav / _footer.
   Variables --ink/--accent/--accent2/--cta/--cta-text/--bg
   REQUISES par les partials nav/footer (header + footer actuels).
   Marges latérales via .cr-shell ; sections en padding-top/bottom.
   ============================================================ */
:root{
  --bg:{{ theme.bg }};
  --surface:#fff;
  --ink:{{ theme.ink }};
  --accent:{{ theme.accent }};
  --accent2:{{ theme.accent2 }};
  --cta:{{ theme.cta_color if theme.cta_color is defined and theme.cta_color else "#168551" }};
  --cta-text:{{ theme.cta_text_color if theme.cta_text_color is defined and theme.cta_text_color else "#ffffff" }};
  --border:#E2E8F0;
  /* palette locale du design */
  --cr-navy:#1C2733;
  --cr-petrol:#0F3D5E;
  --cr-blue:#1D70A2;
  --cr-green:#168551;
  --cr-green-d:#137447;
  --cr-bg:#F4F7FA;
  --cr-ink:#1C2733;
  --cr-sub:#64748B;
  --cr-mut:#94A3B8;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans',system-ui,-apple-system,sans-serif;background:#fff;color:var(--cr-ink);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;font-size:16px;line-height:1.6}
a{text-decoration:none;color:inherit}
/* Aligne header/footer sur la police du site (sinon ils héritent de la police de la home) */
nav.site-nav .nav-links a,nav.site-nav .nav-cta,nav.site-nav .nav-mobile a,.footer{font-family:'{{ theme.font_body }}',system-ui,-apple-system,sans-serif}
::selection{background:var(--cr-blue);color:#fff}
.cr-shell{max-width:1180px;margin:0 auto;padding-left:56px;padding-right:56px}
.cr-sg{font-family:'Space Grotesk',sans-serif}
.cr-kick{font-family:'Space Grotesk',sans-serif;font-size:12px;font-weight:700;letter-spacing:.13em;text-transform:uppercase}

/* ── HERO ── */
.cr-hero{background:var(--cr-navy);position:relative;overflow:hidden;display:flex;align-items:center;min-height:560px}
.cr-hero .stripe{position:absolute;top:-220px;height:1060px;transform:rotate(-22deg);transform-origin:center;z-index:0;pointer-events:none}
.cr-hero .st1{left:-130px;width:230px;background:var(--cr-petrol)}
.cr-hero .st2{left:62px;width:155px;background:var(--cr-blue);opacity:.85}
.cr-hero .st3{right:-100px;width:320px;background:var(--cr-green);opacity:.45}
.cr-hero-inner{position:relative;z-index:1;display:flex;align-items:center;gap:72px;padding-top:72px;padding-bottom:72px;width:100%}
.cr-hero-illu{flex:0 0 440px;height:440px;border-radius:30px;overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,.45);background:linear-gradient(135deg,#0D1C28 0%,#1A2D3E 100%);display:flex;align-items:center;justify-content:center}
.cr-hero-illu svg{width:100%;height:100%;display:block}
.cr-hero-txt{flex:1;min-width:0}
.cr-hero-txt h1{font-family:'Space Grotesk',sans-serif;font-size:clamp(40px,5.4vw,74px);font-weight:700;line-height:1.05;color:#fff;margin:0 0 26px}
.cr-hero-txt h1 .hl{color:var(--cr-blue)}
.cr-hero-desc{font-size:16px;line-height:1.72;color:rgba(255,255,255,.5);margin:0 0 44px;max-width:430px}
.cr-hero-cta{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.cr-btn-green{background:var(--cr-green);color:#fff;padding:15px 36px;border-radius:8px;font-family:'Plus Jakarta Sans',sans-serif;font-size:15px;font-weight:600;box-shadow:0 4px 20px rgba(22,133,81,.3);transition:background .18s}
.cr-btn-green:hover{background:var(--cr-green-d)}
.cr-btn-ghost{color:#fff;padding:15px 30px;border-radius:8px;font-size:15px;font-weight:600;border:1px solid rgba(255,255,255,.2);transition:border-color .18s,background .18s}
.cr-btn-ghost:hover{border-color:rgba(255,255,255,.45);background:rgba(255,255,255,.05)}

/* ── STATS ── */
.cr-stats{background:var(--cr-navy)}
.cr-stats-inner{padding-top:56px;padding-bottom:56px;display:grid;grid-template-columns:repeat(4,1fr)}
.cr-stat{text-align:center;padding:0 20px;border-right:1px solid rgba(255,255,255,.08)}
.cr-stat:last-child{border-right:none}
.cr-stat .n{font-family:'Space Grotesk',sans-serif;font-size:44px;font-weight:700;color:#fff;line-height:1;margin-bottom:8px}
.cr-stat .c{font-size:13.5px;color:rgba(255,255,255,.45)}

/* ── THÉMATIQUES ── */
.cr-themes{background:#fff}
.cr-themes-inner{padding-top:96px;padding-bottom:96px}
.cr-head-center{text-align:center;margin-bottom:60px}
.cr-head-center .cr-kick{color:var(--cr-blue)}
.cr-head-center h2{font-family:'Space Grotesk',sans-serif;font-size:clamp(28px,3vw,38px);font-weight:700;color:var(--cr-ink);margin:14px 0 0;line-height:1.2}
.cr-themes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
.cr-theme{background:var(--cr-bg);border-radius:18px;padding:38px 34px;border:1px solid var(--border);transition:transform .2s,box-shadow .2s,background .2s}
.cr-theme:hover{background:#fff;box-shadow:0 12px 40px rgba(15,61,94,.09);transform:translateY(-5px)}
.cr-theme .ic{width:54px;height:54px;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:24px}
.cr-theme h3{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:700;color:var(--cr-ink);margin-bottom:12px}
.cr-theme p{font-size:14px;line-height:1.72;color:var(--cr-sub);margin:0}

/* ── POURQUOI ── */
.cr-why{background:#fff;border-top:1px solid #F0F4F8}
.cr-why-inner{padding-top:96px;padding-bottom:96px}
.cr-why-head{text-align:center;margin-bottom:68px}
.cr-why-head .cr-kick{color:var(--cr-green)}
.cr-why-head h2{font-family:'Space Grotesk',sans-serif;font-size:clamp(30px,3.6vw,46px);font-weight:700;color:var(--cr-ink);margin:16px 0 0;line-height:1.15}
.cr-why-head h2 em{font-family:'Lora',serif;font-style:italic;font-weight:600;color:var(--cr-petrol)}
.cr-why-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.cr-pill{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:22px 32px;border:1.5px solid var(--border);border-radius:999px;transition:background .18s,border-color .18s}
.cr-pill:hover{background:var(--cr-bg);border-color:#CBD5E1}
.cr-pill .l{display:flex;align-items:center;gap:18px}
.cr-pill .num{font-family:'Space Grotesk',sans-serif;font-size:13.5px;font-weight:700;color:var(--cr-blue);flex-shrink:0;min-width:26px}
.cr-pill .tx{font-size:15px;color:var(--cr-ink)}
.cr-pill svg{flex-shrink:0}

/* ── BLOG ── */
.cr-blog{background:#F8FAFC}
.cr-blog-inner{padding-top:96px;padding-bottom:96px}
.cr-blog-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:52px;gap:24px;flex-wrap:wrap}
.cr-blog-head .cr-kick{color:var(--cr-blue)}
.cr-blog-head h2{font-family:'Space Grotesk',sans-serif;font-size:clamp(28px,3vw,38px);font-weight:700;color:var(--cr-ink);margin:12px 0 0;line-height:1.2}
.cr-blog-all{background:var(--cr-petrol);color:#fff;padding:13px 26px;border-radius:8px;font-size:14px;font-weight:600;flex-shrink:0;transition:background .18s}
.cr-blog-all:hover{background:var(--cr-blue)}
.cr-blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.cr-art{display:flex;flex-direction:column;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 1px 12px rgba(0,0,0,.06);border:1px solid #EBF0F7;transition:transform .2s,box-shadow .2s}
.cr-art:hover{box-shadow:0 8px 32px rgba(15,61,94,.12);transform:translateY(-4px)}
.cr-art-img{height:210px;background:repeating-linear-gradient(-45deg,#EEF3F8 0px,#EEF3F8 12px,#E2EAF3 12px,#E2EAF3 24px);display:flex;align-items:center;justify-content:center;overflow:hidden}
.cr-art-img img{width:100%;height:100%;object-fit:cover;display:block}
.cr-art-img .ph{opacity:.45}
.cr-art-body{padding:20px 22px 22px;display:flex;flex-direction:column;flex:1}
.cr-art-cat{display:flex;align-items:center;gap:7px;margin-bottom:11px;font-size:13px;color:var(--cr-blue);font-weight:500}
.cr-art-body h3{font-family:'Space Grotesk',sans-serif;font-size:17px;font-weight:700;line-height:1.45;color:var(--cr-ink);margin-bottom:20px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.cr-art-foot{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #F1F5F9;padding-top:14px;margin-top:auto;gap:10px}
.cr-art-date{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--cr-mut)}
.cr-art-auth{display:flex;align-items:center;gap:7px}
.cr-art-auth .av{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--cr-petrol),var(--cr-blue));display:flex;align-items:center;justify-content:center;font-family:'Space Grotesk',sans-serif;font-size:9px;font-weight:700;color:#fff;flex-shrink:0}
.cr-art-auth .nm{font-size:12px;color:var(--cr-sub)}

/* ── AUTEUR ── */
.cr-author{background:var(--cr-navy)}
.cr-author-inner{padding-top:90px;padding-bottom:90px}
.cr-author-label{display:flex;align-items:center;gap:18px;margin-bottom:44px}
.cr-author-label span{font-family:'Space Grotesk',sans-serif;font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.3)}
.cr-author-label .ln{flex:1;height:1px;background:rgba(255,255,255,.1)}
.cr-author-grid{display:grid;grid-template-columns:220px 1fr 200px;gap:64px;align-items:start}
.cr-author-id{display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px}
.cr-author-ava{position:relative;width:144px;height:144px}
.cr-author-ava .ph{width:144px;height:144px;border-radius:50%;overflow:hidden;background:linear-gradient(135deg,var(--cr-petrol),var(--cr-blue));display:flex;align-items:center;justify-content:center;font-family:'Space Grotesk',sans-serif;font-size:44px;font-weight:700;color:#fff;position:relative;z-index:1;box-shadow:0 12px 36px rgba(0,0,0,.3)}
.cr-author-ava .ph img{width:100%;height:100%;object-fit:cover;display:block}
.cr-author-ava .r1{position:absolute;inset:-6px;border-radius:50%;border:1.5px solid rgba(29,112,162,.35);z-index:0}
.cr-author-ava .r2{position:absolute;inset:-12px;border-radius:50%;border:1px solid rgba(29,112,162,.15);z-index:0}
.cr-author-id .nm{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:700;color:#fff;margin-bottom:6px;line-height:1.2}
.cr-author-id .role{font-size:13.5px;color:var(--cr-blue);font-weight:500}
.cr-author-id .loc{display:flex;align-items:center;gap:6px;font-size:12px;color:rgba(255,255,255,.35)}
.cr-author-id .loc .dot{width:6px;height:6px;border-radius:50%;background:var(--cr-green)}
.cr-author-bio{padding-top:6px}
.cr-author-bio .q{font-family:'Lora',serif;font-style:italic;font-size:80px;line-height:.7;color:rgba(29,112,162,.3);margin-bottom:12px;margin-left:-6px}
.cr-author-bio p{font-size:16px;line-height:1.85;color:rgba(255,255,255,.6);margin-bottom:36px}
.cr-author-bio a{font-size:14px;font-weight:600;color:var(--cr-green);display:inline-flex;align-items:center;gap:8px;border-bottom:1.5px solid rgba(22,133,81,.35);padding-bottom:3px;transition:border-color .18s}
.cr-author-bio a:hover{border-color:var(--cr-green)}
.cr-author-metrics{display:flex;flex-direction:column;padding-top:6px}
.cr-metric{padding:22px 0;border-top:1px solid rgba(255,255,255,.1)}
.cr-metric:last-child{border-bottom:1px solid rgba(255,255,255,.1)}
.cr-metric .n{font-family:'Space Grotesk',sans-serif;font-weight:700;line-height:1;margin-bottom:5px}
.cr-metric .c{font-size:12.5px;color:rgba(255,255,255,.38)}

/* ── NEWSLETTER ── */
.cr-news{background:linear-gradient(135deg,#0F3D5E 0%,#1C2733 100%);position:relative;overflow:hidden}
.cr-news .b1{position:absolute;right:-60px;bottom:-60px;width:420px;height:420px;border-radius:50%;background:rgba(29,112,162,.12);pointer-events:none}
.cr-news .b2{position:absolute;left:-80px;top:-80px;width:300px;height:300px;border-radius:50%;background:rgba(22,133,81,.07);pointer-events:none}
.cr-news-inner{padding-top:100px;padding-bottom:100px;max-width:660px;margin:0 auto;text-align:center;position:relative;z-index:1}
.cr-news .cr-kick{color:rgba(255,255,255,.4);font-weight:600}
.cr-news h2{font-family:'Space Grotesk',sans-serif;font-size:clamp(30px,3.4vw,40px);font-weight:700;color:#fff;margin:16px 0 18px;line-height:1.2}
.cr-news-desc{font-size:16px;line-height:1.75;color:rgba(255,255,255,.6);margin-bottom:44px}
.cr-news-form{display:flex;gap:12px;max-width:480px;margin:0 auto}
.cr-news-form input{flex:1;padding:15px 20px;border-radius:8px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.07);color:#fff;font-family:inherit;font-size:15px;outline:none;min-width:0}
.cr-news-form input::placeholder{color:rgba(255,255,255,.4)}
.cr-news-form button{background:var(--cr-green);color:#fff;padding:15px 28px;border-radius:8px;border:none;font-family:'Plus Jakarta Sans',sans-serif;font-size:15px;font-weight:600;cursor:pointer;flex-shrink:0;white-space:nowrap;transition:background .18s}
.cr-news-form button:hover{background:var(--cr-green-d)}
.cr-news-fine{font-size:12px;color:rgba(255,255,255,.28);margin-top:16px}

/* ── RESPONSIVE ── */
@media(max-width:980px){
  .cr-hero-inner{flex-direction:column;gap:48px}
  .cr-hero-txt{order:1}
  .cr-hero-illu{order:2;flex:0 0 auto;width:100%;max-width:440px;height:auto;aspect-ratio:1/1}
  .cr-hero-desc{color:#fff}
  .cr-stats-inner{grid-template-columns:1fr 1fr;gap:32px 0}
  .cr-stat:nth-child(2){border-right:none}
  .cr-themes-grid,.cr-blog-grid{grid-template-columns:1fr 1fr}
  .cr-author-grid{grid-template-columns:1fr;gap:48px;justify-items:center;text-align:center}
  .cr-author-metrics{width:100%;max-width:360px}
}
@media(max-width:880px){
  .cr-shell{padding-left:22px;padding-right:22px}
}
@media(max-width:600px){
  .cr-hero{min-height:0}
  .cr-hero-inner{padding-top:56px;padding-bottom:56px}
  .cr-themes-inner,.cr-why-inner,.cr-blog-inner,.cr-author-inner{padding-top:60px;padding-bottom:60px}
  .cr-news-inner{padding-top:64px;padding-bottom:64px}
  .cr-stats-inner{grid-template-columns:1fr 1fr;gap:28px 0}
  .cr-themes-grid,.cr-blog-grid,.cr-why-grid{grid-template-columns:1fr}
  .cr-news-form{flex-direction:column}
}
</style>
{% if site.google_site_verification is defined and site.google_site_verification %}
<meta name="google-site-verification" content="{{ site.google_site_verification }}">
{% endif %}
{% if site.analytics_clicky is defined and site.analytics_clicky %}
{% if '<script' in site.analytics_clicky %}
{{ site.analytics_clicky | safe }}
{% else %}
<script async data-id="{{ site.analytics_clicky }}" src="//static.getclicky.com/js"></script>
{% endif %}
{% endif %}
</head>
<body>

<!-- NAV (header actuel, inchangé) -->
{% include 'base/_nav.html.j2' %}

{# Photo auteur robuste : ignore les URL blob: (cassées) et retombe sur le fichier public #}
{% set cr_author_img = site.author_photo if (site.author_photo is defined and site.author_photo and not site.author_photo.startswith('blob:')) else '/author-photo.png' %}
{% set cr_initials = (site.author_name | default('') | replace('-', ' ')).split() | map('first') | join | upper %}

<!-- ============ HERO ============ -->
<section class="cr-hero">
  <div class="stripe st1"></div><div class="stripe st2"></div><div class="stripe st3"></div>
  <div class="cr-shell cr-hero-inner">
    <div class="cr-hero-illu">
      <svg viewBox="0 0 440 440" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Illustration : croissance d'activité">
        <line x1="44" y1="340" x2="406" y2="340" stroke="rgba(255,255,255,0.09)" stroke-width="1"></line>
        <line x1="44" y1="280" x2="406" y2="280" stroke="rgba(255,255,255,0.05)" stroke-width="1"></line>
        <line x1="44" y1="220" x2="406" y2="220" stroke="rgba(255,255,255,0.05)" stroke-width="1"></line>
        <line x1="44" y1="160" x2="406" y2="160" stroke="rgba(255,255,255,0.05)" stroke-width="1"></line>
        <line x1="44" y1="100" x2="406" y2="100" stroke="rgba(255,255,255,0.05)" stroke-width="1"></line>
        <rect x="50" y="275" width="48" height="65" rx="7" fill="#1D70A2" opacity="0.28"></rect>
        <rect x="120" y="230" width="48" height="110" rx="7" fill="#1D70A2" opacity="0.45"></rect>
        <rect x="190" y="182" width="48" height="158" rx="7" fill="#1D70A2" opacity="0.62"></rect>
        <rect x="260" y="138" width="48" height="202" rx="7" fill="#1D70A2" opacity="0.8"></rect>
        <rect x="330" y="98" width="48" height="242" rx="7" fill="#1D70A2"></rect>
        <rect x="330" y="98" width="48" height="9" rx="4" fill="rgba(255,255,255,0.14)"></rect>
        <polyline points="74,275 144,230 214,182 284,138 354,98" stroke="#168551" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"></polyline>
        <circle cx="74" cy="275" r="4" fill="#168551" opacity="0.65"></circle>
        <circle cx="144" cy="230" r="4" fill="#168551" opacity="0.72"></circle>
        <circle cx="214" cy="182" r="4" fill="#168551" opacity="0.82"></circle>
        <circle cx="284" cy="138" r="4" fill="#168551" opacity="0.9"></circle>
        <circle cx="354" cy="98" r="7" fill="#168551"></circle>
        <circle cx="354" cy="98" r="13" stroke="#168551" stroke-width="2" fill="none" opacity="0.32"></circle>
        <rect x="358" y="72" width="48" height="20" rx="10" fill="#168551" opacity="0.9"></rect>
        <circle cx="74" cy="72" r="5" fill="#1D70A2" opacity="0.38"></circle>
        <circle cx="56" cy="380" r="6" fill="#168551" opacity="0.28"></circle>
        <circle cx="408" cy="370" r="4" fill="#1D70A2" opacity="0.25"></circle>
      </svg>
    </div>
    <div class="cr-hero-txt">
      <h1>{% if site.home_h1 is defined and site.home_h1 %}{{ site.home_h1 | safe }}{% else %}Toutes les clés pour <span class="hl">lancer</span> votre activité.{% endif %}</h1>
      <p class="cr-hero-desc">{{ home_description | default("CreaOne accompagne les créateurs d'entreprise avec des conseils, actualités, ressources pratiques et analyses pour réussir leurs projets.") }}</p>
      <div class="cr-hero-cta">
        <a href="#blog" class="cr-btn-green">Lire le blog</a>
        <a href="/nos-comparateurs" class="cr-btn-ghost">Voir les comparatifs</a>
      </div>
    </div>
  </div>
</section>

<!-- ============ STATS (chiffres du modèle — à valider) ============ -->
<section class="cr-stats">
  <div class="cr-shell cr-stats-inner">
    <div class="cr-stat"><div class="n">500+</div><div class="c">Articles publiés</div></div>
    <div class="cr-stat"><div class="n">50K+</div><div class="c">Lecteurs par mois</div></div>
    <div class="cr-stat"><div class="n" style="color:var(--cr-green)">200+</div><div class="c">Ressources pratiques</div></div>
    <div class="cr-stat"><div class="n" style="color:var(--cr-blue)">5</div><div class="c">Ans d'expertise</div></div>
  </div>
</section>

<!-- ============ THÉMATIQUES ============ -->
<section class="cr-themes">
  <div class="cr-shell cr-themes-inner">
    <div class="cr-head-center">
      <span class="cr-kick">Nos thématiques</span>
      <h2>Ce que vous trouverez ici</h2>
    </div>
    <div class="cr-themes-grid">
      <div class="cr-theme">
        <div class="ic" style="background:linear-gradient(135deg,#0F3D5E 0%,#1D70A2 100%)"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path><polyline points="9,22 9,12 15,12 15,22"></polyline></svg></div>
        <h3>Création &amp; Statuts</h3>
        <p>Toutes les étapes pour créer votre entreprise : statut juridique, immatriculation, formalités administratives et premiers pas.</p>
      </div>
      <div class="cr-theme">
        <div class="ic" style="background:linear-gradient(135deg,#168551 0%,#0F8060 100%)"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"></line><line x1="18" y1="20" x2="18" y2="4"></line><line x1="6" y1="20" x2="6" y2="16"></line></svg></div>
        <h3>Gestion &amp; Finance</h3>
        <p>Comptabilité, fiscalité, financement et gestion financière. Tout ce que les dirigeants doivent maîtriser pour piloter leur activité.</p>
      </div>
      <div class="cr-theme">
        <div class="ic" style="background:linear-gradient(135deg,#1D70A2 0%,#0F3D5E 100%)"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22,7 13.5,15.5 8.5,10.5 2,17"></polyline><polyline points="16,7 22,7 22,13"></polyline></svg></div>
        <h3>Croissance &amp; Marketing</h3>
        <p>Développez votre activité avec des stratégies commerciales efficaces, des techniques d'acquisition client et les bons outils digitaux.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ POURQUOI CREAONE ============ -->
<section class="cr-why">
  <div class="cr-shell cr-why-inner">
    <div class="cr-why-head">
      <span class="cr-kick">Pourquoi CreaOne ?</span>
      <h2 class="cr-sg">Les ressources créées pour<br><em>réussir votre lancement.</em></h2>
    </div>
    <div class="cr-why-grid">
      {% set cr_pills = [
        '01.|Des conseils concrets et actionnables dès aujourd\'hui',
        '02.|Un contenu mis à jour aux dernières réglementations',
        '03.|Des comparatifs honnêtes, sans publicité déguisée',
        '04.|Des guides adaptés à chaque type de statut juridique',
        '05.|Une veille permanente sur les aides à la création',
        '06.|Des ressources gratuites et accessibles à tous'
      ] %}
      {% for pill in cr_pills %}
      <div class="cr-pill">
        <div class="l"><span class="num">{{ pill.split('|')[0] }}</span><span class="tx">{{ pill.split('|')[1] }}</span></div>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#1D70A2" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ============ BLOG (articles récents, automatique) ============ -->
{% if recent_blog_posts and recent_blog_posts | length > 0 %}
<section id="blog" class="cr-blog">
  <div class="cr-shell cr-blog-inner">
    <div class="cr-blog-head">
      <div>
        <span class="cr-kick">Articles récents</span>
        <h2>Les dernières publications</h2>
      </div>
      <a href="/blog/" class="cr-blog-all">Voir tous les articles &rarr;</a>
    </div>
    <div class="cr-blog-grid">
      {% for p in recent_blog_posts %}
      <a href="/{{ p.slug }}" class="cr-art">
        <div class="cr-art-img">
          {% if p.featured_image %}<img src="{{ p.featured_image }}" alt="{{ p.title }}" loading="lazy">{% else %}<span class="ph"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg></span>{% endif %}
        </div>
        <div class="cr-art-body">
          {% if p.categorie %}<div class="cr-art-cat"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z"></path></svg><span>{{ p.categorie }}</span></div>{% endif %}
          <h3>{{ p.title }}</h3>
          <div class="cr-art-foot">
            <div class="cr-art-date"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg><span>{{ p.date_display }}</span></div>
            {% if site.author_name %}<div class="cr-art-auth"><span class="av">{{ cr_initials }}</span><span class="nm">{{ site.author_name }}</span></div>{% endif %}
          </div>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- ============ AUTEUR ============ -->
{% if site.author_name is defined and site.author_name %}
<section class="cr-author">
  <div class="cr-shell cr-author-inner">
    <div class="cr-author-label">
      <span>L'expert derrière {{ site.name | replace('.fr','') | replace('.com','') }}</span>
      <div class="ln"></div>
    </div>
    <div class="cr-author-grid">
      <div class="cr-author-id">
        <div class="cr-author-ava">
          <div class="ph">{% if cr_author_img %}<img src="{{ cr_author_img }}" alt="{{ site.author_name }}">{% else %}{{ cr_initials }}{% endif %}</div>
          <div class="r1"></div><div class="r2"></div>
        </div>
        <div>
          <div class="nm">{{ site.author_name }}</div>
          {% if site.author_job is defined and site.author_job %}<div class="role">{{ site.author_job }}</div>{% endif %}
        </div>
      </div>
      <div class="cr-author-bio">
        <div class="q">&ldquo;</div>
        {% if site.author_bio is defined and site.author_bio %}<p>{{ site.author_bio }}</p>{% endif %}
        <a href="/blog/">Voir tous ses articles &rarr;</a>
      </div>
      <div class="cr-author-metrics">
        <div class="cr-metric"><div class="n" style="font-size:42px;color:#fff">200+</div><div class="c">Entreprises conseillées</div></div>
        <div class="cr-metric"><div class="n" style="font-size:26px;color:var(--cr-green);letter-spacing:.04em">FR &amp; INT</div><div class="c">Normes maîtrisées</div></div>
        <div class="cr-metric"><div class="n" style="font-size:32px;color:var(--cr-blue);letter-spacing:.02em">Bac+5</div><div class="c">Niveau académique</div></div>
      </div>
    </div>
  </div>
</section>
{% endif %}

<!-- ============ NEWSLETTER ============ -->
<section id="contact" class="cr-news">
  <div class="b1"></div><div class="b2"></div>
  <div class="cr-shell cr-news-inner">
    <span class="cr-kick">Newsletter</span>
    <h2>Restez informé,<br>prenez de l'avance</h2>
    <p class="cr-news-desc">Recevez chaque semaine les meilleurs articles, actualités et ressources pour développer votre activité. Pas de spam, uniquement l'essentiel.</p>
    <form class="cr-news-form" action="/contact" method="get">
      <input type="email" name="email" placeholder="votre@email.com" aria-label="Votre adresse e-mail">
      <button type="submit">S'abonner</button>
    </form>
    <p class="cr-news-fine">Désinscription à tout moment. Vos données sont protégées.</p>
  </div>
</section>

<!-- FOOTER (footer actuel, inchangé) -->
{% include "base/_footer.html.j2" %}

</body>
</html>
