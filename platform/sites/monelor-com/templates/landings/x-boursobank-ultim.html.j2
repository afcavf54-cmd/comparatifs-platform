<script>
(() => {
  const params = new URLSearchParams(window.location.search);
  const source = params.get("utm_source");
  const creative = params.get("utm_content") || "";

  // Accepte uniquement des références publicitaires simples.
  const validCreative = /^[a-zA-Z0-9_-]{1,80}$/.test(creative);

  const clickref =
    source === "meta" && validCreative
      ? `meta_bourso_${creative}`
      : "lp_bourso_non_attribue";

  document.querySelectorAll("a.cta").forEach((button) => {
    const link = new URL(
      "https://www.awin1.com/awclick.php?gid=309815&mid=6992&awinaffid=420025&linkid=643198"
    );

    link.searchParams.set("clickref", clickref);
    button.href = link.toString();
  });
})();
</script>
