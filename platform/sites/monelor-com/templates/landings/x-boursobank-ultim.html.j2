{# ──────────────────────────────────────────────────────────────────────────
   Landing BoursoBank / Visa Ultim 180€ — clone fidèle (ads).
   Variables : lp.seo_title, lp.meta_description, lp.canonical, site.*, build_date
   CTA : lien Awin de base (fonctionne sans JS) ; le script en bas ajoute le clickref d'attribution.
   noindex + hors sitemap + hors navigation (géré par le générateur).
────────────────────────────────────────────────────────────────────────── #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <title>{{ lp.seo_title }}</title>
  <meta name="description" content="{{ lp.meta_description }}">
  <link rel="canonical" href="{{ lp.canonical }}">
  {% if site.favicon_file %}<link rel="icon" href="{{ site.favicon_file }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{
      --pink:#E80B87; --pink2:#FF2BA0; --pink-ink:#C70874;
      --grad:linear-gradient(90deg,#FF2BA0,#E60A82);
      --ink:#241933; --muted:#8A8599; --line:#EFEAF2; --soft:#FAF8FC;
      --green:#17B978; --green-bg:#E7F8F0; --green-ink:#0E9E63; --gold:#F5B301;
      --r:16px; --cardsh:0 10px 30px rgba(36,25,51,.06);
    }
    *{box-sizing:border-box}html,body{margin:0}
    body{font-family:'Poppins',system-ui,sans-serif;color:var(--ink);background:#fff;line-height:1.6;font-size:15px;-webkit-font-smoothing:antialiased}
    .wrap{max-width:640px;margin:0 auto}
    .sec{padding:0 20px}
    a{color:inherit}
    /* Zone rose continue : header + hero partagent le même fond rose (pas de blanc) */
    .topzone{background:linear-gradient(180deg,#FBDCEE 0%,#FDE8F4 46%,#fff 100%)}
    /* Header 2 logos (sur le fond rose) */
    .top{padding:16px 20px;display:flex;align-items:center;justify-content:center;gap:16px}
    .top .hlogo{height:26px;width:auto;display:block}
    .top .sep{width:1px;height:22px;background:rgba(36,25,51,.14)}
    /* Carte bancaire (image) */
    .cardimg{display:block;margin:0 auto;height:auto;border-radius:10px;filter:drop-shadow(0 16px 26px rgba(0,0,0,.26))}
    /* Carte du hero : halo rose derrière + inclinaison + flottement lent */
    .cardwrap{position:relative;display:flex;justify-content:center;padding:18px 0 8px}
    .cardwrap::before{content:"";position:absolute;left:50%;top:52%;transform:translate(-50%,-50%);
      width:320px;height:230px;border-radius:50%;z-index:0;pointer-events:none;
      background:radial-gradient(ellipse at center,rgba(255,43,160,.45),rgba(255,43,160,0) 68%);filter:blur(10px)}
    .cardwrap .cardimg{position:relative;z-index:1;transform:rotate(-4deg)}
    .float{animation:cardfloat 5.5s ease-in-out infinite}
    @keyframes cardfloat{0%,100%{transform:rotate(-4deg) translateY(3px)}50%{transform:rotate(-4deg) translateY(-3px)}}
    @media (prefers-reduced-motion:reduce){.float{animation:none}}
    /* Hero */
    .hero{padding:12px 20px 34px;text-align:center}
    .hero h1{font-size:clamp(23px,5.2vw,30px);font-weight:600;margin:22px 0 10px;letter-spacing:-.02em}
    .hero p{color:var(--muted);max-width:430px;margin:0 auto;font-size:14.5px}
    .hero p b{color:var(--ink);font-weight:600}
    .cta{display:block;width:100%;max-width:440px;margin:22px auto 0;background:var(--grad);color:#fff;font-weight:700;font-size:16px;text-align:center;text-decoration:none;padding:16px 22px;border-radius:999px;box-shadow:0 12px 26px rgba(232,11,135,.32);transition:transform .15s,box-shadow .15s}
    .cta:hover{transform:translateY(-2px);box-shadow:0 16px 32px rgba(232,11,135,.4)}
    .cta-note{color:var(--muted);font-size:11px;text-align:center;margin:14px 0 0}
    .hero .cta-note{margin-top:28px}
    .lbl{color:var(--pink);font-weight:700;font-size:11px;letter-spacing:.12em;text-transform:uppercase;text-align:center;margin:0 0 12px}
    /* Offre */
    .offer{border:2px solid var(--pink);border-radius:20px;padding:22px;margin:8px 0 30px;box-shadow:0 14px 36px rgba(232,11,135,.12)}
    .offer .cardimg{margin-bottom:14px}
    .offer h2{text-align:center;font-size:20px;font-weight:800;margin:4px 0 10px}
    .pill{display:block;width:max-content;margin:0 auto 14px;background:#FDE9F4;color:var(--pink-ink);font-weight:700;font-size:12px;padding:5px 14px;border-radius:999px}
    .big{text-align:center;color:var(--pink);font-weight:800;font-size:46px;line-height:1;margin:6px 0 2px}
    .big-sub{text-align:center;color:var(--muted);font-size:13px;margin:0 0 16px}
    .hr{border:0;border-top:1px dashed var(--line);margin:16px 0}
    .chk{list-style:none;padding:0;margin:0 0 18px}
    .chk li{display:flex;gap:10px;align-items:flex-start;font-size:14px;margin:9px 0}
    .chk li::before{content:"✓";color:var(--green);font-weight:800;flex:none}
    /* Guide */
    .box{border:1px solid var(--line);border-radius:var(--r);padding:24px 22px;margin:30px 0;box-shadow:var(--cardsh)}
    .box h3{text-align:center;font-size:18px;font-weight:800;margin:0 0 4px}
    .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:18px 0}
    .step{text-align:center}
    .step .e{font-size:26px}
    .step .t{font-size:11.5px;color:var(--muted);margin-top:6px;line-height:1.35}
    .step .t b{color:var(--ink);display:block}
    .box p{color:var(--muted);font-size:14px;text-align:center;margin:14px 0}
    .box .strong{color:var(--ink);font-weight:700}
    /* Bénéfices */
    .benes{display:grid;gap:12px;margin:30px 0}
    .bene{display:flex;gap:14px;align-items:flex-start;border:1px solid var(--line);border-radius:var(--r);padding:16px 18px;box-shadow:var(--cardsh)}
    .bene .ic{font-size:24px;flex:none;line-height:1}
    .bene b{display:block;font-size:15px;margin-bottom:2px}
    .bene span{color:var(--muted);font-size:13.5px}
    /* Avis */
    .rev{border:1px solid var(--line);border-radius:var(--r);padding:18px 20px;margin:14px 0;box-shadow:var(--cardsh)}
    .stars{color:var(--gold);font-size:14px;letter-spacing:2px}
    .rev q{display:block;font-style:italic;font-size:14px;margin:9px 0 14px;quotes:none}
    .rev q::before,.rev q::after{content:""}
    .who{display:flex;align-items:center;gap:10px}
    .av{width:34px;height:34px;border-radius:50%;background:var(--grad);color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:14px;flex:none}
    .who .nm{font-weight:700;font-size:13px}
    .who .mt{color:var(--muted);font-size:12px}
    .badge{margin-left:auto;background:var(--green-bg);color:var(--green-ink);font-weight:700;font-size:11px;padding:4px 10px;border-radius:999px;white-space:nowrap}
    /* Stats */
    .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;text-align:center;margin:34px 0 4px}
    .stats .n{font-weight:800;font-size:20px}
    .stats .l{color:var(--muted);font-size:11px;margin-top:2px}
    /* Footer */
    .legal{border-top:1px solid var(--line);margin-top:34px;padding:22px 20px 44px}
    .legal p{color:#A7A2B3;font-size:10.5px;line-height:1.6;text-align:center;margin:0}
    @media(max-width:420px){.steps{grid-template-columns:repeat(2,1fr);gap:16px}.stats{grid-template-columns:repeat(2,1fr);gap:16px}}
  </style>
</head>
