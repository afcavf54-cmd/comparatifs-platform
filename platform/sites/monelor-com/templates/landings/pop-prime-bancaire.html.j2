{# ──────────────────────────────────────────────────────────────────────────
   Landing PopAds — « Primes de bienvenue bancaires » (ads, trafic froid).
   Objectif : clics qualifiés vers les liens d'affiliation BoursoBank & Fortuneo.
   noindex + hors sitemap (générateur). Clicky injecté automatiquement.

   ⚠️ CONFIG CENTRALISÉE dans le <script> en bas (objet OFFERS + PRIME_MAX) :
   les montants et conditions sont des PLACEHOLDERS [..] à remplir — rien n'est
   inventé. Les liens d'affiliation Bourso (Awin) et Fortuneo (publicidees) sont
   déjà renseignés ; un bouton sans lien est automatiquement désactivé.
────────────────────────────────────────────────────────────────────────── #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <title>{{ lp.seo_title }}</title>
  <meta name="description" content="{{ lp.meta_description }}">
  <link rel="canonical" href="{{ lp.canonical }}">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root{
      --ink:#122039;--ink2:#56688A;--bg:#F4F7FC;--card:#fff;--line:#E3E9F2;
      --green:#12A150;--green2:#0C8A43;--green-soft:#E7F7EE;--green-ink:#0B6B35;
      --blue:#1D4ED8;--amber-soft:#FFF4E0;--amber-ink:#8A5A00;
      --r:18px;--r2:12px;--shadow:0 10px 30px rgba(18,32,57,.07);
    }
    *{box-sizing:border-box}html{scroll-behavior:smooth}html,body{margin:0}
    body{font-family:'Nunito',system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.55;font-size:16px;-webkit-font-smoothing:antialiased;padding-bottom:0}
    .wrap{max-width:900px;margin:0 auto;padding:0 18px}
    a{color:inherit}
    /* En-tête minimal */
    .top{display:flex;justify-content:center;padding:16px 18px;background:var(--card);border-bottom:1px solid var(--line)}
    .top img{height:28px;width:auto;display:block}
    /* Boutons */
    .btn{display:inline-block;background:var(--green);color:#fff;font-weight:800;font-size:16px;text-align:center;text-decoration:none;border:0;border-radius:999px;padding:15px 26px;cursor:pointer;box-shadow:0 10px 24px rgba(18,161,80,.28);transition:transform .15s,box-shadow .15s}
    .btn:hover{transform:translateY(-2px);box-shadow:0 14px 30px rgba(18,161,80,.36)}
    .btn.block{display:block;width:100%}
    .btn.disabled{background:#C7D0DF;color:#6C7A93;box-shadow:none;cursor:not-allowed}
    /* Hero */
    .hero{text-align:center;padding:30px 0 10px}
    .hero-top{display:flex;align-items:center;gap:30px;text-align:left;margin-bottom:10px}
    .hero-img{flex:1 1 46%;min-width:0}
    .hero-img img{width:100%;height:auto;display:block}
    .hero-txt{flex:1 1 50%}
    .hero-txt h1{text-align:left;margin:0 0 12px}
    .hero-txt .sub{text-align:left;margin:0}
    @media(min-width:721px){.hero-top{margin-bottom:44px}}
    @media(max-width:720px){.hero-top{flex-direction:column;gap:18px;text-align:center}.hero-txt h1,.hero-txt .sub{text-align:center}.hero-img{max-width:420px;width:100%;order:-1}}
    .eyebrow{display:inline-block;background:var(--green-soft);color:var(--green-ink);font-weight:800;font-size:12.5px;letter-spacing:.04em;text-transform:uppercase;padding:6px 14px;border-radius:999px}
    .hero h1{font-size:clamp(27px,6vw,42px);font-weight:900;line-height:1.1;letter-spacing:-.02em;margin:16px auto 12px;max-width:640px}
    .hero h1 .amt{color:var(--green)}
    .hero .sub{color:var(--ink2);font-size:clamp(15px,2.4vw,18px);max-width:540px;margin:0 auto 22px}
    .hero .note{color:var(--ink2);font-size:12.5px;margin:12px 0 0}
    .hero-illus{margin:6px auto 20px;max-width:260px}
    /* Section générique */
    section{padding:34px 0}
    .sec-h{font-size:clamp(21px,3.4vw,28px);font-weight:900;text-align:center;letter-spacing:-.01em;margin:0 0 10px}
    .sec-lead{color:var(--ink2);text-align:center;max-width:620px;margin:0 auto 24px;font-size:15.5px}
    /* 3 étapes */
    .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    .step{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:20px 18px;text-align:center;box-shadow:var(--shadow)}
    .step .n{width:38px;height:38px;border-radius:50%;background:var(--green-soft);color:var(--green-ink);font-weight:900;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;font-size:17px}
    .step b{display:block;font-size:16px;margin-bottom:4px}
    .step span{color:var(--ink2);font-size:13.5px}
    /* Offres */
    /* Offres : présentation horizontale (logo · texte · CTA), empilées */
    .offers{display:flex;flex-direction:column;gap:14px;text-align:left;margin-top:6px}
    .ocard{display:flex;align-items:center;gap:18px;background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:16px 20px;box-shadow:var(--shadow)}
    .ologo{width:68px;height:68px;border-radius:14px;background:#fff;border:1px solid var(--line);flex:none;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:4px}
    .ologo img{width:100%;height:100%;object-fit:contain}
    .o-name{flex:0 1 255px;font-weight:900;font-size:16px;line-height:1.3}
    .o-name .amt{color:var(--green)}
    .opts{flex:1 1 auto;list-style:none;padding:0;margin:0}
    .opts li{position:relative;padding-left:22px;font-size:14px;color:var(--ink);margin:5px 0}
    .opts li::before{content:"✓";color:var(--green);font-weight:900;position:absolute;left:0;top:0}
    .octa{flex:none;background:var(--green);color:#fff;font-weight:800;font-size:14px;text-decoration:none;padding:13px 22px;border-radius:999px;white-space:nowrap;box-shadow:0 8px 18px rgba(18,161,80,.26);transition:transform .15s}
    .octa:hover{transform:translateY(-2px)}
    .octa.disabled{background:#C7D0DF;color:#6C7A93;box-shadow:none;cursor:not-allowed}
    /* Mobile : logo + titre (ligne 1), puces (ligne 2), CTA pleine largeur (ligne 3) */
    @media(max-width:720px){.ocard{flex-wrap:wrap;gap:12px 16px}.o-name{flex:1 1 auto}.opts{flex:1 1 100%}.octa{width:100%;text-align:center}}
    .oresume{color:var(--ink2);font-size:14px;margin:6px 0 12px}
    .mob{display:flex;flex-direction:column;gap:4px;background:var(--green-soft);border-radius:var(--r2);padding:10px 12px;font-size:13px;color:var(--green-ink);margin:0 0 12px}
    .odetails{list-style:none;padding:0;margin:0 0 16px}
    .odetails li{display:flex;flex-direction:column;gap:1px;padding:9px 0;border-bottom:1px solid var(--line);font-size:14px}
    .odetails li:last-child{border-bottom:0}
    .odetails .k{color:var(--ink2);font-size:12.5px;font-weight:700}
    .odetails .v{color:var(--ink)}
    .odetails li.hl{background:var(--amber-soft);border-radius:var(--r2);padding:10px 12px;border-bottom:0;margin:4px 0}
    .odetails li.hl .k{color:var(--amber-ink)}
    .ocard .cta{margin-top:auto}
    .cond{margin-top:12px;border-top:1px solid var(--line);padding-top:10px}
    .cond summary{cursor:pointer;color:var(--blue);font-weight:700;font-size:13.5px;list-style:none}
    .cond summary::-webkit-details-marker{display:none}
    .cond summary::after{content:" ↓"}
    .cond[open] summary::after{content:" ↑"}
    .cond-body{color:var(--ink2);font-size:13px;margin-top:8px;line-height:1.5}
    /* FAQ */
    .faq{max-width:680px;margin:0 auto}
    .faq details{background:var(--card);border:1px solid var(--line);border-radius:var(--r2);margin:10px 0;box-shadow:var(--shadow)}
    .faq summary{cursor:pointer;font-weight:800;font-size:15px;padding:16px 18px;list-style:none;display:flex;justify-content:space-between;gap:10px;align-items:center}
    .faq summary::-webkit-details-marker{display:none}
    .faq summary::after{content:"+";color:var(--green);font-weight:900;font-size:20px}
    .faq details[open] summary::after{content:"–"}
    .faq .a{padding:0 18px 16px;color:var(--ink2);font-size:14px;line-height:1.55}
    /* CTA final */
    .final{background:var(--ink);color:#fff;border-radius:var(--r);padding:30px 24px;text-align:center}
    .final h2{font-size:clamp(20px,3vw,26px);font-weight:900;margin:0 0 8px}
    .final p{color:rgba(255,255,255,.8);font-size:15px;margin:0 0 18px;max-width:520px;margin-left:auto;margin-right:auto}
    /* Footer */
    footer{text-align:center;padding:30px 18px 100px;color:var(--ink2);font-size:12.5px;line-height:1.6}
    footer .links{margin-top:10px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
    footer .links a{color:var(--blue);text-decoration:none}
    /* Bouton fixe mobile */
    .sticky{position:fixed;left:50%;transform:translateX(-50%) translateY(120%);bottom:14px;z-index:40;background:var(--green);color:#fff;font-weight:800;font-size:14px;padding:12px 22px;border-radius:999px;box-shadow:0 10px 26px rgba(18,161,80,.4);text-decoration:none;transition:transform .25s ease;white-space:nowrap}
    .sticky.show{transform:translateX(-50%) translateY(0)}
    @media(min-width:721px){.sticky{display:none}}
    @media(max-width:720px){.offers{grid-template-columns:1fr}.steps{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <header class="top"><img src="/landings/monelor-logo.png" alt="Monelor"></header>

  <div class="wrap">
    <!-- 1. HERO + offres directement -->
    <section class="hero">
      <div class="hero-top">
        <div class="hero-img"><img src="/landings/pop/hero-prime.png" alt="Exemple de prime de bienvenue créditée sur un compte bancaire" loading="eager"></div>
        <div class="hero-txt">
          <h1>Recevez jusqu'à <span class="amt" id="primeMax">440</span> € en ouvrant un compte bancaire</h1>
          <p class="sub">Certaines banques vous versent une prime lorsque vous ouvrez un compte et remplissez les conditions de leur offre. Choisissez votre offre ci-dessous.</p>
        </div>
      </div>
      <div class="offers" id="offres"></div>
      <p class="note" style="margin-top:14px">* Offres soumises à conditions, détails et éligibilité sur le site de chaque banque.</p>
    </section>

    <!-- 2. PRINCIPE -->
    <section>
      <h2 class="sec-h">Pourquoi les banques vous versent-elles une prime ?</h2>
      <p class="sec-lead">Pour attirer de nouveaux clients, certaines banques proposent une prime de bienvenue. Vous ouvrez un compte, vous remplissez les conditions de l'offre et la banque vous verse la prime sur votre compte.</p>
      <div class="steps">
        <div class="step"><div class="n">1</div><b>Choisissez votre offre</b><span>Comparez la prime et les conditions.</span></div>
        <div class="step"><div class="n">2</div><b>Ouvrez votre compte</b><span>Faites votre demande sur le site officiel de la banque.</span></div>
        <div class="step"><div class="n">3</div><b>Recevez votre prime</b><span>Effectuez les actions demandées et respectez les délais de l'offre.</span></div>
      </div>
    </section>

    <!-- 4. FAQ -->
    <section>
      <h2 class="sec-h">Les réponses à vos questions</h2>
      <div class="faq">
        <details><summary>Faut-il quitter ma banque actuelle ?</summary><div class="a">Non, vous pouvez tout à fait conserver votre banque actuelle : l'ouverture d'un nouveau compte n'oblige pas à fermer l'ancien. Une partie de la prime peut toutefois être liée à une mobilité bancaire (transfert de vos prélèvements et virements) ; dans ce cas, les conditions spécifiques de cette prime sont précisées par la banque.</div></details>
        <details><summary>Le premier versement est-il un paiement ?</summary><div class="a">Non. Le premier versement alimente votre nouveau compte : c'est votre argent, qui reste disponible sur le compte. Les modalités de disponibilité et de maintien de ce montant dépendent des conditions de l'offre de chaque banque.</div></details>
        <details><summary>La carte bancaire est-elle gratuite ?</summary><div class="a">Cela dépend de la carte choisie et de ses conditions. Certaines cartes sont gratuites sous réserve d'une utilisation régulière (par exemple au moins un paiement par mois). Les conditions exactes sont indiquées par la banque.</div></details>
        <details><summary>Quand vais-je recevoir la prime ?</summary><div class="a">La prime n'est pas immédiate. Son versement intervient après le respect des conditions de l'offre (ouverture, premier versement, utilisation de la carte, éventuelle mobilité…) et dans les délais fixés par la banque.</div></details>
        <details><summary>Quels documents faut-il prévoir ?</summary><div class="a">Les justificatifs demandés (pièce d'identité, justificatif de domicile, RIB…) sont précisés par chaque banque au moment de l'ouverture du compte.</div></details>
        <details><summary>Puis-je fermer le compte après avoir reçu la prime ?</summary><div class="a">Une durée minimale de conservation du compte peut être imposée par l'offre. Si elle n'est pas respectée, la banque peut reprendre tout ou partie de la prime. Vérifiez cette durée dans les conditions de l'offre.</div></details>
      </div>
    </section>

    <!-- 5. CTA FINAL -->
    <section>
      <div class="final">
        <h2>Prêt à choisir votre offre ?</h2>
        <p>Comparez la prime, le premier versement demandé et les conditions avant de vous lancer.</p>
        <a class="btn" href="#offres" data-scroll>Comparer les offres</a>
      </div>
    </section>
  </div>

  <!-- 6. FOOTER -->
  <footer>
    <div class="wrap">
      Monelor est un site indépendant. Certains liens sont des liens d'affiliation : nous pouvons percevoir une commission si vous ouvrez un compte via ces liens, sans surcoût pour vous.
      <div class="links">
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/politique-confidentialite/">Confidentialité</a>
        <a href="/contact/">Contact</a>
      </div>
    </div>
  </footer>

  <!-- Bouton fixe mobile (apparaît après le hero) -->
  <a class="sticky" id="stickyBtn" href="#offres" data-scroll>Voir les offres</a>

<script>
(function(){
  var $=function(s,el){return (el||document).querySelector(s);};

  // ══════════════════════════════════════════════════════════════════════
  //  CONFIGURATION CENTRALISÉE — à éditer ici.
  //  Montants & conditions = PLACEHOLDERS [..] à remplir (rien n'est inventé).
  //  Liens d'affiliation déjà renseignés ; un lien vide désactive le bouton.
  //  subidParam : nom du paramètre d'identifiant de sous-suivi accepté par la
  //  plateforme (Awin = "clickref"). Laisser "" tant qu'il n'est pas confirmé.
  // ══════════════════════════════════════════════════════════════════════
  var PRIME_MAX = "440";

  var OFFERS = [
    {
      id:"boursobank", name:"BoursoBank", logo:"/landings/banks/boursobank.png",
      montant:"180",
      pts:["Carte Welcome et compte gratuit*","Sans condition de revenus"],
      url:"https://www.awin1.com/awclick.php?gid=309815&mid=6992&awinaffid=420025&linkid=643198",
      subidParam:"clickref",
      cta:"Voir l'offre BoursoBank"
    },
    {
      id:"fortuneo", name:"Fortuneo", logo:"/landings/banks/fortuneo.png",
      montant:"260",
      pts:["Carte Gold gratuite*","0 € de frais de tenue"],
      url:"https://tracking.publicidees.com/clic.php?promoid=272621&progid=1325&partid=64100",
      subidParam:"", // param de sous-suivi publicidees à confirmer
      cta:"Voir l'offre Fortuneo"
    }
  ];

  if(PRIME_MAX) $("#primeMax").textContent = PRIME_MAX;

  // ── Suivi : conserve les UTM/identifiants reçus et construit un subid ────
  var params = new URLSearchParams(location.search);
  function clean(s){ return String(s||"").replace(/[^a-zA-Z0-9_-]/g,"").slice(0,40); }
  function subid(bankId, loc){
    var src = clean(params.get("utm_source")) || "pop";
    var camp = clean(params.get("utm_campaign"));
    var content = clean(params.get("utm_content"));
    return [src, bankId, loc, camp, content].filter(Boolean).join("_").slice(0,90);
  }
  function buildUrl(o, loc){
    if(!o.url) return null;
    try{
      var u = new URL(o.url);
      if(o.subidParam){ u.searchParams.set(o.subidParam, subid(o.id, loc)); }
      return u.toString();
    }catch(e){ return o.url; }
  }

  function esc(s){ var d=document.createElement("div"); d.textContent=String(s==null?"":s); return d.innerHTML; }

  function card(o, loc){
    var url = buildUrl(o, loc);
    var btn = url
      ? '<a class="octa cta" href="'+url+'" target="_blank" rel="nofollow sponsored noopener" data-bank="'+o.id+'" data-loc="'+loc+'">J\'en profite →</a>'
      : '<span class="octa cta disabled" role="button" aria-disabled="true" title="Lien d\'affiliation à renseigner">Bientôt dispo</span>';
    var pts = o.pts.map(function(p){ return '<li>'+esc(p)+'</li>'; }).join("");
    return '<div class="ocard">'+
      '<span class="ologo"><img src="'+o.logo+'" alt="'+esc(o.name)+'"></span>'+
      '<div class="o-name">'+esc(o.name)+' vous offre <span class="amt">'+esc(o.montant)+' €</span> !</div>'+
      '<ul class="opts">'+pts+'</ul>'+
      btn+
    '</div>';
  }

  $("#offres").innerHTML = OFFERS.map(function(o){ return card(o,"offres"); }).join("");

  // Suivi des clics sortants (Clicky, best-effort) + param banque/emplacement.
  document.addEventListener("click", function(e){
    var a = e.target.closest ? e.target.closest("a.cta") : null;
    if(!a) return;
    if(window.clicky){ try{ clicky.goal("clic_"+(a.getAttribute("data-bank")||"offre")); }catch(_){} }
  });

  // Défilement doux vers les offres (fallback si scroll-behavior non supporté).
  document.querySelectorAll('[data-scroll]').forEach(function(el){
    el.addEventListener("click", function(ev){
      var t = document.getElementById("offres"); if(!t) return;
      ev.preventDefault(); t.scrollIntoView({behavior:"smooth"});
    });
  });

  // Bouton fixe mobile : visible après avoir quitté le premier écran.
  var sticky = $("#stickyBtn"), hero = $(".hero");
  function onScroll(){
    var past = hero.getBoundingClientRect().bottom < 0;
    var atOffers = (function(){ var o=document.getElementById("offres"); if(!o) return false; var r=o.getBoundingClientRect(); return r.top < window.innerHeight && r.bottom > 0; })();
    sticky.classList.toggle("show", past && !atOffers);
  }
  window.addEventListener("scroll", onScroll, {passive:true});
  window.addEventListener("resize", onScroll); onScroll();
})();
</script>
</body>
</html>
