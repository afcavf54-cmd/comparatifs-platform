      <a class="cta" href="#" rel="nofollow sponsored">Ouvrir mon compte maintenant</a>
    </div>

    <!-- Bénéfices -->
    <div class="benes">
      <div class="bene"><span class="ic">🏦</span><div><b>Compte gratuit</b><span>0€ de frais de tenue de compte. Pas de frais cachés, promis.</span></div></div>
      <div class="bene"><span class="ic">🏆</span><div><b>Banque la moins chère</b><span>Élue n°1 depuis 18 ans, avec en moyenne 10€ de frais bancaires par an.</span></div></div>
      <div class="bene"><span class="ic">📱</span><div><b>100% mobile</b><span>Virements instantanés gratuits, Apple Pay &amp; Google Pay. Tout depuis l'appli.</span></div></div>
