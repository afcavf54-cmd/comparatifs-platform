<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>À propos · {{ site.name }}</title>
<meta name="description" content="À propos de {{ site.name }} : notre média de comparatifs de logiciels pour dirigeants de TPE et PME, notre méthodologie de test et notre auteur.">
<link rel="canonical" href="{{ site.domain }}/a-propos/">
{% if site.favicon_file is defined and site.favicon_file %}<link rel="icon" href="{{ site.favicon_file }}">{% else %}<link rel="icon" href="/favicon.svg" type="image/svg+xml">{% endif %}
{% if site.google_site_verification is defined and site.google_site_verification %}<meta name="google-site-verification" content="{{ site.google_site_verification }}">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Spectral:ital,wght@0,400;0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
<style>
/* ===================================================================
   A PROPOS - editions-dp-com.
   Design « Editions des Pros » (Claude Design), aplati en statique.
   En-tete + pied = partials _nav / _footer (autoportants) : ils ne
   reclament que les variables :root ci-dessous (theme.*).
   Le corps du design garde sa palette inline (#1B4FD8 / #E8410A /
   #0F1A2E) et ses polices Manrope + Spectral.
   =================================================================== */
:root{
  --bg:{{ theme.bg }};
  --surface:{{ theme.surface if theme.surface is defined and theme.surface else "#fff" }};
  --ink:{{ theme.ink }};
  --accent:{{ theme.accent }};
  --accent2:{{ theme.accent2 }};
  --cta:{{ theme.cta_color if theme.cta_color is defined and theme.cta_color else "#F59E0B" }};
  --cta-text:{{ theme.cta_text_color if theme.cta_text_color is defined and theme.cta_text_color else "#ffffff" }};
  --border:#E2E8F0;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Manrope',system-ui,-apple-system,sans-serif;background:var(--bg);color:#0F1A2E;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
a{text-decoration:none;color:inherit}
/* Ce site n'a pas de theme.font_title / font_body en config -> fallback sur les polices du design */
/* FAQ accordeon natif (indicateur « + » qui pivote en croix, sans JS) */
details.faq-item:not(:last-child){border-bottom:1px solid #EEF1F7}
details.faq-item>summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:16px;padding:22px 28px}
details.faq-item>summary::-webkit-details-marker{display:none}
details.faq-item>summary .faq-q{flex:1;font-family:'Manrope',sans-serif;font-weight:700;font-size:16px;color:#0F1A2E;line-height:1.4}
details.faq-item>summary .faq-ico{display:inline-flex;align-items:center;justify-content:center;flex:none;width:28px;height:28px;border-radius:8px;font-size:20px;font-weight:300;line-height:1;color:#8893A6;background:rgba(15,26,46,.05);transition:transform .3s ease,background .2s ease,color .2s ease}
details.faq-item[open]>summary .faq-ico{transform:rotate(45deg);color:#1B4FD8;background:rgba(27,79,216,.10)}
details.faq-item>.faq-a{padding:0 28px 24px}
details.faq-item>.faq-a p{margin:0;font-size:15px;line-height:1.75;color:#5A6679}
/* ===== Responsive mobile (ajoute apres coup : export Claude Design en styles inline figes, sans media query) ===== */
@media(max-width:768px){
.ap-root [style*="grid-template-columns"]:not([style*="columns:52px"]):not([style*="columns: 52px"]):not([style*="columns:80px"]):not([style*="columns: 80px"]):not([style*="columns:auto"]):not([style*="columns: auto"]){grid-template-columns:1fr !important}
.ap-root [style*="padding:48px"]{padding:28px 20px !important}
.ap-root [style*="padding:96px 48px"]{padding:56px 20px !important}
.ap-root [style*="padding:80px 48px"]{padding:48px 20px !important}
.ap-root [style*="padding:44px 48px"]{padding:32px 20px !important}
.ap-root [style*="padding:48px 52px"]{padding:30px 22px !important}
.ap-root [style*="padding:100px 48px"]{padding:56px 20px !important}
.ap-root [style*="padding:0 48px 96px"]{padding:0 20px 56px !important}
.ap-root [style*="padding:0 48px 100px"]{padding:0 20px 56px !important}
.ap-root [style*="padding:84px 48px 92px"]{padding:48px 20px 52px !important}
.ap-root [style*="padding:80px 48px 56px"]{padding:44px 20px 36px !important}
.ap-root [style*="font-size:80px"]{font-size:40px !important}
.ap-root [style*="font-size:64px"]{font-size:34px !important}
.ap-root [style*="font-size:52px"]{font-size:32px !important}
.ap-root [style*="font-size:48px"]{font-size:30px !important}
.ap-root [style*="font-size:46px"]{font-size:29px !important}
.ap-root [style*="font-size:44px"]{font-size:28px !important}
.ap-root [style*="font-size:42px"]{font-size:27px !important}
.ap-root [style*="font-size:40px"]{font-size:26px !important}
.ap-root [style*="font-size:38px"]{font-size:25px !important}
.ap-root [style*="font-size:36px"]{font-size:24px !important}
.ap-root [style*="font-size:34px"]{font-size:23px !important}
.ap-root [style*="gap:72px"]{gap:34px !important}
.ap-root [style*="gap:64px"]{gap:32px !important}
.ap-root [style*="gap:52px"]{gap:30px !important}
.ap-root [style*="gap:44px"]{gap:26px !important}
.ap-root [style*="gap:40px"]{gap:24px !important}
.ap-root [style*="gap:36px"]{gap:22px !important}
.ap-root [style*="gap:34px"]{gap:21px !important}
.ap-root [style*="gap:32px"]{gap:20px !important}
.ap-root [style*="gap:30px"]{gap:19px !important}
.ap-root [style*="gap:28px"]{gap:18px !important}
.ap-root{overflow-x:hidden}
.ap-root img{max-width:100%;height:auto}
}
</style>
</head>
<body>
{% include 'base/_nav.html.j2' %}
<div class="ap-root" id="top" style="background:#F4F6FB;min-height:100vh;overflow-x:hidden">

<!-- ===== HEADER ===== -->

<!-- ===== 1. HERO ===== -->
<section style="position:relative;background:#0F1A2E;overflow:hidden">
  <div style="position:absolute;top:-160px;left:50%;transform:translateX(-50%);width:760px;height:520px;background:radial-gradient(closest-side,rgba(27,79,216,.45),transparent 70%);filter:blur(20px);animation:glowpulse 7s ease-in-out infinite;pointer-events:none"></div>
  <div style="position:absolute;top:120px;right:-120px;width:460px;height:460px;background:radial-gradient(closest-side,rgba(232,65,10,.22),transparent 70%);filter:blur(20px);pointer-events:none"></div>
  <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.05) 1px,transparent 1px);background-size:34px 34px;opacity:.5;pointer-events:none"></div>
  <div style="position:relative;max-width:1280px;margin:0 auto;padding:88px 40px 104px;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center">

    <div>
      <span style="display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:.16em;color:#FBA94C;background:rgba(245,158,11,.10);border:1px solid rgba(245,158,11,.28);padding:8px 16px;border-radius:999px">
        <span style="width:6px;height:6px;border-radius:50%;background:#F59E0B;display:inline-block"></span>
        MON HISTOIRE
      </span>
      <h1 style="font-family:'Spectral',serif;font-weight:700;font-size:52px;line-height:1.06;color:#fff;margin:24px 0 0;letter-spacing:-.01em;text-wrap:balance">J'aide les entrepreneurs et les dirigeants à mieux piloter leur entreprise.</h1>
      <p style="font-size:17px;line-height:1.7;color:#A8B3C7;margin:20px 0 0;max-width:500px">Comparatifs de logiciels, guides de gestion, conseils RH et financiers : tout ce qu'un dirigeant de TPE ou PME doit savoir, écrit par quelqu'un qui le vit au quotidien.</p>
      <div style="display:flex;align-items:center;gap:14px;margin-top:34px;flex-wrap:wrap">
        <a href="/nos-comparateurs" style="display:inline-flex;align-items:center;gap:10px;background:#F59E0B;color:#fff;font-weight:700;font-size:16px;padding:16px 28px;border-radius:12px;box-shadow:0 14px 30px -12px rgba(245,158,11,.65)">Nos comparatifs →</a>
        <a href="#methodologie" style="display:inline-flex;align-items:center;gap:9px;color:#E7ECF5;font-weight:700;font-size:16px;padding:16px 22px;border-radius:12px;border:1.5px solid rgba(255,255,255,.18)">Notre méthodologie</a>
      </div>
    </div>

    <div style="position:relative">
      <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.10);border-radius:26px;padding:36px 32px">
        <div style="display:flex;justify-content:center;margin-bottom:22px">
          <div style="width:100px;height:100px;border-radius:50%;border:3px solid #1B3A6B;background:#1B4FD8;overflow:hidden">
            {% if site.author_photo is defined and site.author_photo %}<img src="{{ site.author_photo }}" alt="{{ author.name or 'Pierre Petit' }}" style="width:100px;height:100px;display:block;object-fit:cover">{% else %}<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#fff;font-family:'Spectral',serif;font-weight:700;font-size:34px">PP</div>{% endif %}
          </div>
        </div>
        <div style="text-align:center">
          <div style="font-family:'Spectral',serif;font-weight:700;font-size:20px;color:#fff">{{ author.name or 'Pierre Petit' }}</div>
          <p style="font-size:14px;color:#A8B3C7;margin-top:4px">Fondateur · Dirigeant TPE · Strasbourg</p>
          <p style="font-size:13px;color:#7E8AA0;margin-top:4px">Logiciels · Gestion · RH · Finances · Marketing</p>
        </div>
        <div style="display:flex;margin-top:26px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);border-radius:14px;overflow:hidden">
          <div style="flex:1;padding:16px 8px;text-align:center;border-right:1px solid rgba(255,255,255,.08)">
            <div style="font-family:'Spectral',serif;font-weight:700;font-size:26px;color:#fff">340+</div>
            <div style="font-size:11.5px;color:#8E9AB0;margin-top:2px">Logiciels</div>
          </div>
          <div style="flex:1;padding:16px 8px;text-align:center;border-right:1px solid rgba(255,255,255,.08)">
            <div style="font-family:'Spectral',serif;font-weight:700;font-size:26px;color:#fff">48</div>
            <div style="font-size:11.5px;color:#8E9AB0;margin-top:2px">Comparatifs</div>
          </div>
          <div style="flex:1;padding:16px 8px;text-align:center">
            <div style="font-family:'Spectral',serif;font-weight:700;font-size:26px;color:#F59E0B">2020</div>
            <div style="font-size:11.5px;color:#8E9AB0;margin-top:2px">Depuis</div>
          </div>
        </div>
      </div>
      <div style="position:absolute;top:-18px;right:20px;background:#1B4FD8;color:#fff;padding:10px 16px;border-radius:12px;box-shadow:0 18px 40px -16px rgba(27,79,216,.7);animation:floaty 5s ease-in-out infinite;font-size:13px;font-weight:700;white-space:nowrap">✓ 100 % indépendant</div>
    </div>

  </div>
</section>

<!-- ===== 2. POURQUOI CE MÉDIA EXISTE ===== -->
<section style="background:#fff;border-bottom:1px solid #ECEFF6">
  <div style="max-width:1280px;margin:0 auto;padding:88px 40px;display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center">
    <div>
      <span style="font-size:12.5px;font-weight:700;letter-spacing:.16em;color:#E8410A">MA MISSION</span>
      <h2 style="font-family:'Spectral',serif;font-weight:700;font-size:40px;color:#0F1A2E;margin-top:12px;letter-spacing:-.01em;line-height:1.1">Pourquoi j'ai créé ce média</h2>
      <p style="font-size:16px;line-height:1.75;color:#41506A;margin-top:20px">Gérer une entreprise, c'est prendre des dizaines de décisions chaque semaine : quel logiciel adopter, comment structurer ses RH, comment piloter sa trésorerie. Chaque mauvais choix coûte <strong style="color:#0F1A2E">du temps et de l'argent</strong>. Pourtant, les bons contenus pour les dirigeants de TPE et PME sont rares, souvent biaisés ou réservés aux grandes entreprises.</p>
      <p style="font-size:16px;line-height:1.75;color:#41506A;margin-top:14px">J'ai créé Éditions des Pros par frustration : je ne trouvais pas de contenus vraiment fiables, écrits par quelqu'un qui utilise ces outils au quotidien dans sa propre entreprise.</p>
      <p style="font-size:16px;line-height:1.75;color:#41506A;margin-top:14px">Mon objectif : <strong style="color:#0F1A2E">vous faire gagner du temps</strong>, vous aider à éviter les mauvais choix coûteux, et vous offrir des analyses fondées sur mes propres tests en conditions réelles.</p>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      <div style="background:#F4F6FB;border:1px solid #E8ECF4;border-radius:20px;padding:28px 22px;text-align:center">
        <div style="font-family:'Spectral',serif;font-weight:700;font-size:44px;color:#1B4FD8;letter-spacing:-.02em;line-height:1">340+</div>
        <div style="font-size:14px;font-weight:600;color:#5A6679;margin-top:8px">Logiciels analysés</div>
      </div>
      <div style="background:#F4F6FB;border:1px solid #E8ECF4;border-radius:20px;padding:28px 22px;text-align:center">
        <div style="font-family:'Spectral',serif;font-weight:700;font-size:44px;color:#E8410A;letter-spacing:-.02em;line-height:1">1 200h</div>
        <div style="font-size:14px;font-weight:600;color:#5A6679;margin-top:8px">Heures de tests</div>
      </div>
      <div style="background:#0F1A2E;border-radius:20px;padding:28px 22px;text-align:center">
        <div style="font-family:'Spectral',serif;font-weight:700;font-size:44px;color:#F59E0B;letter-spacing:-.02em;line-height:1">85k+</div>
        <div style="font-size:14px;font-weight:600;color:#A8B3C7;margin-top:8px">Lecteurs / mois</div>
      </div>
      <div style="background:#1B4FD8;border-radius:20px;padding:28px 22px;text-align:center">
        <div style="font-family:'Spectral',serif;font-weight:700;font-size:44px;color:#fff;letter-spacing:-.02em;line-height:1">48</div>
        <div style="font-size:14px;font-weight:600;color:#C9D6F5;margin-top:8px">Comparatifs publiés</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== 3. NOS VALEURS ===== -->
<section style="background:#F4F6FB">
  <div style="max-width:1280px;margin:0 auto;padding:88px 40px">
    <div style="text-align:center;margin-bottom:52px">
      <span style="font-size:12.5px;font-weight:700;letter-spacing:.16em;color:#E8410A">CE QUI NOUS GUIDE</span>
      <h2 style="font-family:'Spectral',serif;font-weight:700;font-size:40px;color:#0F1A2E;margin-top:12px;letter-spacing:-.01em">Nos valeurs</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:22px">

      <div style="background:#fff;border:1px solid #ECEFF6;border-radius:24px;padding:32px 26px;box-shadow:0 1px 3px rgba(15,26,46,.04);transition:transform .15s ease,box-shadow .15s ease" style-hover="transform:translateY(-4px);box-shadow:0 24px 48px -24px rgba(15,26,46,.28)">
        <div style="width:50px;height:50px;border-radius:14px;background:rgba(27,79,216,.10);display:flex;align-items:center;justify-content:center;margin-bottom:20px">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1B4FD8" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4v5c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V7l8-4z"></path><path d="M9 12l2 2 4-4"></path></svg>
        </div>
        <h3 style="font-family:'Spectral',serif;font-weight:700;font-size:21px;color:#0F1A2E">Indépendance</h3>
        <p style="font-size:14.5px;line-height:1.65;color:#5A6679;margin-top:10px">Nos évaluations reposent sur une grille de 6 critères objectifs, testés en conditions réelles. Les notes sont documentées et consultables par tous.</p>
      </div>

      <div style="background:#fff;border:1px solid #ECEFF6;border-radius:24px;padding:32px 26px;box-shadow:0 1px 3px rgba(15,26,46,.04);transition:transform .15s ease,box-shadow .15s ease" style-hover="transform:translateY(-4px);box-shadow:0 24px 48px -24px rgba(15,26,46,.28)">
        <div style="width:50px;height:50px;border-radius:14px;background:rgba(232,65,10,.10);display:flex;align-items:center;justify-content:center;margin-bottom:20px">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E8410A" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4M12 16h.01"></path></svg>
        </div>
        <h3 style="font-family:'Spectral',serif;font-weight:700;font-size:21px;color:#0F1A2E">Transparence</h3>
        <p style="font-size:14.5px;line-height:1.65;color:#5A6679;margin-top:10px">Nous expliquons toujours pourquoi un logiciel est mieux classé. Nos critères sont publics et vérifiables.</p>
      </div>

      <div style="background:#fff;border:1px solid #ECEFF6;border-radius:24px;padding:32px 26px;box-shadow:0 1px 3px rgba(15,26,46,.04);transition:transform .15s ease,box-shadow .15s ease" style-hover="transform:translateY(-4px);box-shadow:0 24px 48px -24px rgba(15,26,46,.28)">
        <div style="width:50px;height:50px;border-radius:14px;background:rgba(245,158,11,.14);display:flex;align-items:center;justify-content:center;margin-bottom:20px">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D98300" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.5 5.5L20 9.3l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.8L12 3z"></path></svg>
        </div>
        <h3 style="font-family:'Spectral',serif;font-weight:700;font-size:21px;color:#0F1A2E">Expertise</h3>
        <p style="font-size:14.5px;line-height:1.65;color:#5A6679;margin-top:10px">Chaque logiciel est étudié en profondeur avant publication. Nos rédacteurs sont des praticiens RH, pas des journalistes généralistes.</p>
      </div>

      <div style="background:#fff;border:1px solid #ECEFF6;border-radius:24px;padding:32px 26px;box-shadow:0 1px 3px rgba(15,26,46,.04);transition:transform .15s ease,box-shadow .15s ease" style-hover="transform:translateY(-4px);box-shadow:0 24px 48px -24px rgba(15,26,46,.28)">
        <div style="width:50px;height:50px;border-radius:14px;background:rgba(27,79,216,.10);display:flex;align-items:center;justify-content:center;margin-bottom:20px">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1B4FD8" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4l3 3"></path></svg>
        </div>
        <h3 style="font-family:'Spectral',serif;font-weight:700;font-size:21px;color:#0F1A2E">Utilité</h3>
        <p style="font-size:14.5px;line-height:1.65;color:#5A6679;margin-top:10px">Notre priorité est d'aider concrètement les entreprises pas de générer du trafic pour son propre compte.</p>
      </div>

    </div>
  </div>
</section>

<!-- ===== 4. MÉTHODOLOGIE ===== -->
<section id="methodologie" style="background:#0F1A2E;position:relative;overflow:hidden">
  <div style="position:absolute;bottom:-140px;left:-100px;width:420px;height:420px;background:radial-gradient(closest-side,rgba(27,79,216,.30),transparent 70%);filter:blur(10px);pointer-events:none"></div>
  <div style="position:absolute;top:-80px;right:-80px;width:320px;height:320px;background:radial-gradient(closest-side,rgba(232,65,10,.20),transparent 70%);filter:blur(10px);pointer-events:none"></div>
  <div style="position:relative;max-width:860px;margin:0 auto;padding:88px 40px">
    <div style="text-align:center;margin-bottom:60px">
      <span style="font-size:12.5px;font-weight:700;letter-spacing:.16em;color:#FBA94C">EN 7 ÉTAPES</span>
      <h2 style="font-family:'Spectral',serif;font-weight:700;font-size:40px;color:#fff;margin-top:12px;letter-spacing:-.01em">Notre méthodologie</h2>
      <p style="font-size:16px;color:#A8B3C7;margin-top:12px;max-width:540px;margin-left:auto;margin-right:auto">Chaque comparatif suit un processus rigoureux en 7 étapes pour garantir des analyses fiables et indépendantes.</p>
    </div>

    <div style="position:relative;display:flex;flex-direction:column;gap:0">
      <div style="position:absolute;left:27px;top:56px;bottom:56px;width:2px;background:linear-gradient(to bottom, rgba(27,79,216,.6), rgba(27,79,216,.1));pointer-events:none"></div>

      <div style="display:flex;gap:28px;align-items:flex-start;padding-bottom:36px">
        <div style="flex:none;width:56px;height:56px;border-radius:50%;background:#1B4FD8;border:3px solid rgba(27,79,216,.3);display:flex;align-items:center;justify-content:center;font-family:'Spectral',serif;font-weight:700;font-size:17px;color:#fff;z-index:1">01</div>
        <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);border-radius:16px;padding:22px 24px;flex:1">
          <h3 style="font-family:'Spectral',serif;font-weight:600;font-size:19px;color:#fff">Sélection des logiciels</h3>
          <p style="font-size:14.5px;line-height:1.6;color:#A8B3C7;margin-top:8px">Nous identifions toutes les solutions disponibles sur le marché français, en ciblant celles adaptées aux TPE, PME et ETI.</p>
        </div>
