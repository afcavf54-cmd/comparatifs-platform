<!-- ============ SERVICES / LOGICIELS (dynamique) ============ -->
<section id="services" class="slp-serv">
  <div class="slp-shell slp-serv-inner">
    <div class="slp-head-center">
      <div class="slp-kick">Nos comparatifs</div>
      <h2>Les outils qui font gagner du temps aux indépendants</h2>
      <p>Nous testons et comparons les meilleurs logiciels de gestion pour les entrepreneurs locaux.</p>
    </div>

    {% set slp_icons = [
      '<circle cx="12" cy="8" r="3.5"></circle><path d="M5 20c0-4 3-6 7-6s7 2 7 6"></path><path d="M16 4l2 2 3-3"></path>',
      '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"></path><line x1="9" y1="8" x2="15" y2="8"></line><line x1="9" y1="12" x2="15" y2="12"></line>',
      '<rect x="4" y="13" width="4" height="7"></rect><rect x="10" y="8" width="4" height="12"></rect><rect x="16" y="4" width="4" height="16"></rect>',
      '<path d="M7 3h7l4 4v14H7z"></path><line x1="10" y1="11" x2="16" y2="11"></line><line x1="10" y1="15" x2="16" y2="15"></line><path d="M14 3v4h4"></path>',
      '<path d="M3 11l16-6-3 16-4-5-5 3z"></path>',
      '<rect x="2" y="6" width="20" height="12" rx="2"></rect><circle cx="12" cy="12" r="2.4"></circle>'
    ] %}
    {% if classements_by_category and classements_by_category | length > 0 %}
    <div class="slp-serv-grid">
      {% for cat, lst in classements_by_category.items() %}
      {% set c = (lst | sort(attribute='count', reverse=true))[0] %}
      <a href="/meilleur-{{ c.slug }}" class="slp-serv-item">
        <svg class="ic" width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">{{ slp_icons[loop.index0 % 6] | safe }}</svg>
        <h3>{{ c.label }}</h3>
        <p>{{ cat }} · {{ c.count }} logiciel{{ 's' if c.count > 1 else '' }} comparé{{ 's' if c.count > 1 else '' }}.</p>
      </a>
      {% endfor %}
    </div>
    {% endif %}

    <div class="slp-serv-cta">
      <a href="/nos-comparateurs" class="slp-btn-dark">Tous nos comparateurs <span class="arr">&rarr;</span></a>
    </div>
  </div>
</section>

<!-- ============ MÉTHODOLOGIE ============ -->
<section class="slp-method">
  <div class="slp-shell slp-method-inner">
    <div class="slp-head-center">
      <div class="slp-kick">Notre méthode</div>
      <h2>Comment nous classons les logiciels</h2>
      <p>Chaque comparatif suit une méthodologie rigoureuse et transparente. Pas de classement payant, uniquement des critères objectifs au service des entrepreneurs.</p>
    </div>
    <div class="slp-method-grid">
      <div class="slp-step"><div class="num">01</div><h3>Test en conditions réelles</h3><p>Chaque logiciel est utilisé sur des cas concrets d'indépendants et de petites structures.</p></div>
      <div class="slp-step"><div class="num">02</div><h3>Rapport qualité-prix</h3><p>Nous évaluons les fonctionnalités au regard du coût réel, abonnements et options inclus.</p></div>
      <div class="slp-step"><div class="num">03</div><h3>Avis utilisateurs vérifiés</h3><p>Les retours de la communauté d'entrepreneurs pondèrent et confirment nos tests.</p></div>
      <div class="slp-step"><div class="num">04</div><h3>Mises à jour régulières</h3><p>Nos classements sont réévalués à chaque évolution majeure des outils testés.</p></div>
    </div>
  </div>
</section>

<!-- ============ AUTEUR ============ -->
{% if site.author_name is defined and site.author_name %}
<section class="slp-author">
  <div class="slp-shell slp-author-inner">
    <div class="slp-author-photo">
      <div class="frame">
        {% if site.author_photo is defined and site.author_photo %}
        <img src="{{ site.author_photo }}" alt="{{ site.author_name }}">
        {% else %}
        <span class="ph">portrait</span>
        {% endif %}
      </div>
    </div>
    <div class="slp-author-txt">
      <div class="slp-kick">L'auteur</div>
      <h2>{{ site.author_name }}</h2>
      {% if site.author_bio is defined and site.author_bio %}<p>{{ site.author_bio }}</p>{% endif %}
      <div class="slp-author-id">
        <span class="nm">{{ site.author_name }}</span>
        {% if site.author_job is defined and site.author_job %}<span class="dot"></span><span class="role">{{ site.author_job }}</span>{% endif %}
      </div>
    </div>
  </div>
</section>
{% endif %}

<!-- ============ ARTICLES RÉCENTS (automatique) ============ -->
{% if recent_blog_posts and recent_blog_posts | length > 0 %}
<section id="articles" class="slp-articles">
  <div class="slp-shell slp-articles-inner">
    <div class="slp-articles-head">
      <div>
        <div class="slp-kick">Le blog</div>
        <h2>Nos derniers articles</h2>
      </div>
      <a href="/blog/" class="slp-articles-all">Tous les articles &rarr;</a>
    </div>
    <div class="slp-articles-grid">
      {% for p in recent_blog_posts %}
      <a href="/{{ p.slug }}" class="slp-art">
        <div class="slp-art-img">
          {% if p.featured_image %}<img src="{{ p.featured_image }}" alt="{{ p.title }}" loading="lazy">{% else %}<span class="ph">photo 16:9</span>{% endif %}
        </div>
        <div class="slp-art-body">
          {% if p.categorie %}<span class="slp-art-cat">{{ p.categorie }}</span>{% endif %}
          <h3>{{ p.title }}</h3>
          <div class="slp-art-meta">{{ p.date_display }}{% if p.reading_time %} · {{ p.reading_time }} min de lecture{% endif %}</div>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- ============ NEWSLETTER ============ -->
<section class="slp-news">
  <div class="slp-shell slp-news-inner">
    <div class="slp-news-txt">
      <h2>Recevez nos analyses et bons plans</h2>
      <p>Conseils, comparatifs et actualités pour les entrepreneurs locaux, directement dans votre boîte mail.</p>
    </div>
    <form class="slp-news-form" action="/contact" method="get">
      <input type="email" name="email" placeholder="Votre adresse e-mail" aria-label="Votre adresse e-mail">
      <button type="submit">S'inscrire</button>
    </form>
  </div>
</section>

<!-- FOOTER (footer actuel, inchangé) -->
{% include "base/_footer.html.j2" %}

</body>
</html>
