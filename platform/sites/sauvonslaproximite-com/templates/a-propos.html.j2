<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>À propos · {{ site.name }}</title>
<meta name="description" content="À propos de {{ site.name }} : notre média indépendant de comparatifs de logiciels, notre méthodologie de test et notre auteure.">
<link rel="canonical" href="{{ site.domain }}/a-propos/">
{% if site.favicon_file is defined and site.favicon_file %}<link rel="icon" href="{{ site.favicon_file }}">{% else %}<link rel="icon" href="/favicon.svg" type="image/svg+xml">{% endif %}
{% if site.google_site_verification is defined and site.google_site_verification %}<meta name="google-site-verification" content="{{ site.google_site_verification }}">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ===================================================================
   A PROPOS - sauvonslaproximite-com.
   Design « Sauvons la Proximite » (Claude Design), aplati en statique.
   En-tete + pied = partials _nav / _footer (autoportants) : ils ne
   reclament que les variables :root ci-dessous (theme.*).
   Le corps du design garde sa palette inline (#121826 / #2563EB /
   #0EA5A5) et sa police Plus Jakarta Sans.
   =================================================================== */
:root{
  --bg:{{ theme.bg }};
  --surface:#fff;
  --ink:{{ theme.ink }};
  --accent:{{ theme.accent }};
  --accent2:{{ theme.accent2 }};
  --cta:{{ theme.cta_color if theme.cta_color is defined and theme.cta_color else "#0EA5A5" }};
  --cta-text:{{ theme.cta_text_color if theme.cta_text_color is defined and theme.cta_text_color else "#ffffff" }};
  --border:#E2E8F0;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans',system-ui,-apple-system,sans-serif;background:var(--bg);color:#0F172A;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
a{text-decoration:none;color:inherit}
/* Aligne header/footer sur les polices du site (sinon herites du corps du design) */
nav.site-nav .nav-logo{font-family:'{{ theme.font_title }}',serif}
nav.site-nav .nav-links a,nav.site-nav .nav-cta,nav.site-nav .nav-mobile a,.footer{font-family:'{{ theme.font_body }}',system-ui,-apple-system,sans-serif}
/* FAQ accordeon natif (look « + / - » teal du design, sans JS) */
details.faq-item:not(:last-child){border-bottom:1px solid #e4e9f1}
details.faq-item>summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 28px}
details.faq-item>summary::-webkit-details-marker{display:none}
details.faq-item>summary:hover{background:#f8fafc}
details.faq-item>summary .faq-q{font-size:17px;font-weight:700;color:#0F172A}
details.faq-item>summary .faq-ico{font-size:22px;font-weight:300;color:#0EA5A5;flex-shrink:0;width:24px;text-align:center;line-height:1}
details.faq-item>summary .faq-ico::after{content:"+"}
details.faq-item[open]>summary .faq-ico::after{content:"\2212"}
details.faq-item>.faq-a{padding:0 28px 24px}
details.faq-item>.faq-a p{font-size:16px;line-height:1.7;color:#475569;margin:16px 0 0}
</style>
</head>
