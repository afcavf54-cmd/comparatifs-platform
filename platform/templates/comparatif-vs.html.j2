    <div class="avis-block">
      <div style="margin-bottom:8px"><span style="font-size:12px;color:var(--ink3);text-transform:uppercase;letter-spacing:.06em">{{ prod_a.marque }}</span> · {{ prod_a.nom }}</div>
      <span class="avis-score">{{ prod_a.note_amazon }}</span>
      <span class="stars" style="font-size:18px">{{ '★' * prod_a.note_amazon | float | int }}{{ '☆' * (5 - prod_a.note_amazon | float | int) }}</span>
      <span style="color:var(--ink3);font-size:13px">/5</span>
      <p style="font-size:13px;color:var(--ink2);margin-top:10px">
        Les parents soulignent la <strong>qualité de fabrication</strong> et le confort du bébé.
        Quelques retours mentionnent le poids et l'encombrement à l'usage.
        Note globale très satisfaisante sur Amazon France.
      </p>
    </div>
    <div class="avis-block">
      <div style="margin-bottom:8px"><span style="font-size:12px;color:var(--ink3);text-transform:uppercase;letter-spacing:.06em">{{ prod_b.marque }}</span> · {{ prod_b.nom }}</div>
      <span class="avis-score">{{ prod_b.note_amazon }}</span>
      <span class="stars" style="font-size:18px">{{ '★' * prod_b.note_amazon | float | int }}{{ '☆' * (5 - prod_b.note_amazon | float | int) }}</span>
      <span style="color:var(--ink3);font-size:13px">/5</span>
      <p style="font-size:13px;color:var(--ink2);margin-top:10px">
        Les utilisateurs apprécient la <strong>praticité et la polyvalence</strong>.
        Quelques commentaires négatifs portent sur la livraison.
        Rapport qualité/prix bien noté dans l'ensemble.
      </p>
    </div>
  </div>

  <!-- FAQ SCHEMA.ORG -->
  <h2>Questions fréquentes</h2>
  <div class="faq">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "{{ prod_a.nom }} ou {{ prod_b.nom }} : laquelle est la meilleure ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cela dépend de votre usage. La {{ prod_a.nom }} ({{ prod_a.prix }}€, {{ prod_a.poids }} kg) est idéale si {{ prod_a.verdict_si[0] | lower }}. La {{ prod_b.nom }} ({{ prod_b.prix }}€, {{ prod_b.poids }} kg) convient mieux si {{ prod_b.verdict_si[0] | lower }}."
          }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence de prix entre {{ prod_a.nom }} et {{ prod_b.nom }} ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La {{ prod_a.nom }} est vendue {{ prod_a.prix }}€ et la {{ prod_b.nom }} {{ prod_b.prix }}€, soit une différence de {{ (prod_a.prix - prod_b.prix) | abs }}€. Les prix peuvent varier selon les promotions Amazon."
          }
        },
        {
          "@type": "Question",
          "name": "{{ prod_a.nom }} ou {{ prod_b.nom }} est-elle plus légère ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{% if prod_a.poids < prod_b.poids %}La {{ prod_a.nom }} est plus légère avec {{ prod_a.poids }} kg contre {{ prod_b.poids }} kg pour la {{ prod_b.nom }}.{% elif prod_b.poids < prod_a.poids %}La {{ prod_b.nom }} est plus légère avec {{ prod_b.poids }} kg contre {{ prod_a.poids }} kg pour la {{ prod_a.nom }}.{% else %}Elles ont le même poids : {{ prod_a.poids }} kg.{% endif %}"
          }
        }
      ]
    }
    </script>
    <div class="faq-item">
      <div class="faq-q">{{ prod_a.nom }} ou {{ prod_b.nom }} : laquelle est la meilleure ?</div>
      <div class="faq-a">
        Cela dépend de votre usage. La <strong>{{ prod_a.nom }}</strong> ({{ prod_a.prix }}€, {{ prod_a.poids }} kg)
        est idéale si {{ prod_a.verdict_si[0] | lower }}.
        La <strong>{{ prod_b.nom }}</strong> ({{ prod_b.prix }}€, {{ prod_b.poids }} kg)
        convient mieux si {{ prod_b.verdict_si[0] | lower }}.
      </div>
    </div>
    <div class="faq-item">
      <div class="faq-q">Quelle est la différence de prix ?</div>
      <div class="faq-a">
        La {{ prod_a.nom }} est vendue <strong>{{ prod_a.prix }}€</strong> et la {{ prod_b.nom }}
        <strong>{{ prod_b.prix }}€</strong>, soit une différence de
        <strong>{{ (prod_a.prix - prod_b.prix) | abs }}€</strong>.
        Les prix varient selon les offres Amazon du moment.
      </div>
    </div>
    <div class="faq-item">
      <div class="faq-q">Laquelle est la plus légère ?</div>
      <div class="faq-a">
        {% if prod_a.poids < prod_b.poids %}
        La <strong>{{ prod_a.nom }}</strong> est plus légère avec <strong>{{ prod_a.poids }} kg</strong>
        contre {{ prod_b.poids }} kg pour la {{ prod_b.nom }}.
        {% elif prod_b.poids < prod_a.poids %}
        La <strong>{{ prod_b.nom }}</strong> est plus légère avec <strong>{{ prod_b.poids }} kg</strong>
        contre {{ prod_a.poids }} kg pour la {{ prod_a.nom }}.
        {% else %}
        Elles ont le même poids : <strong>{{ prod_a.poids }} kg</strong>.
        {% endif %}
      </div>
    </div>
  </div>

  <!-- VERDICT -->
  <div class="verdict">
    <h2>Quelle poussette choisir ?</h2>
    <p style="color:rgba(255,255,255,.7);font-size:18px;line-height:1.75;margin-bottom:0;text-align:center">
