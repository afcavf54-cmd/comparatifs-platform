<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
{% if site.favicon_file is defined and site.favicon_file %}
<link rel="icon" href="{{ site.favicon_file }}">
{% else %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
{% endif %}
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ seo.title }}</title>
<meta name="description" content="{{ seo.meta }}">
<link rel="canonical" href="{{ site.domain }}/{{ page_slug }}">
<meta property="og:title" content="{{ seo.title }}">
<meta property="og:description" content="{{ seo.meta }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.domain }}/{{ page_slug }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
{% if theme.google_fonts %}<link href="{{ theme.google_fonts }}&v={{ site.slug }}" rel="stylesheet">{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "ItemList",
  "name": "{{ seo.title }}",
  "description": "{{ seo.meta }}",
  "url": "{{ site.domain }}/{{ page_slug }}",
  "author": { "@type": "Organization", "name": "{{ site.author_name | default(site.name) }}" },
  "itemListElement": [
    {% for prod in products %}
    { "@type": "ListItem", "position": {{ loop.index }}, "item": { "@type": "SoftwareApplication", "name": "{{ prod.nom }}", "applicationCategory": "BusinessApplication"{% if prod.prix_achat is defined and prod.prix_achat %}, "offers": { "@type": "Offer", "price": "{{ prod.prix_achat }}", "priceCurrency": "EUR" }{% endif %} } }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>

{% if editorial.faq is defined and editorial.faq %}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "FAQPage",
  "mainEntity": [
    {% set faq_list = [] %}
    {% if editorial.faq is iterable and editorial.faq is not mapping %}
      {% set faq_list = editorial.faq %}
    {% elif editorial.faq is mapping %}
      {% if editorial.faq.faq is defined and editorial.faq.faq.questions is defined %}
        {% set faq_list = editorial.faq.faq.questions %}
      {% elif editorial.faq.questions is defined %}
        {% set faq_list = editorial.faq.questions %}
      {% endif %}
    {% endif %}
    {% for item in faq_list %}
    {% set q = item.q if item.q is defined else item.question if item.question is defined else '' %}
    {% set a = item.a if item.a is defined else item.answer if item.answer is defined else '' %}
    {% if q and a %}
    { "@type": "Question", "name": {{ q | tojson }}, "acceptedAnswer": { "@type": "Answer", "text": {{ a | tojson }} } }{% if not loop.last %},{% endif %}
    {% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

<style>
:root{
  --bg:{{ theme.bg }};--surface:#fff;--surface2:#F0ECE5;--ink:{{ theme.ink }};
  --ink2:#6B6560;--ink3:#A09890;--accent:{{ theme.accent }};--accent2:{{ theme.accent2 }};--cta:{{ theme.cta_color if theme.cta_color is defined and theme.cta_color else "#F59E0B" }};--cta-text:{{ theme.cta_text_color if theme.cta_text_color is defined and theme.cta_text_color else "#ffffff" }};
  --border:#E2DDD6;--r:12px;--r2:20px;--green:#1A7A4A;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'{{ theme.font_body }}',sans-serif;background:var(--bg);color:var(--ink);font-size:16px;line-height:1.75}
a{color:inherit;text-decoration:none}
nav{background:var(--ink);padding:0 5vw;display:flex;align-items:center;justify-content:space-between;height:64px;position:sticky;top:0;z-index:100}
.nav-inner{max-width:1200px;width:100%;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px;position:relative}
.nav-logo{font-family:'{{ theme.font_title }}',serif;font-weight:400;font-size:17px;color:#fff;flex-shrink:0}.nav-logo span{color:var(--accent2)}
.nav-links{display:flex;align-items:center;gap:4px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:30px;padding:4px 8px;position:absolute;left:50%;transform:translateX(-50%)}
.nav-links a{color:rgba(255,255,255,.65);font-size:13px;font-weight:500;padding:6px 14px;border-radius:24px;transition:.15s}
.nav-links a:hover{color:#fff;background:rgba(255,255,255,.1)}
.nav-cta{display:inline-flex;align-items:center;gap:6px;padding:8px 18px;border-radius:24px;background:var(--cta);color:var(--cta-text);font-size:13px;font-weight:700;transition:.15s}
.nav-cta:hover{opacity:.88}
.nav-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;background:none;border:none}
.nav-burger span{display:block;width:22px;height:2px;background:#fff;border-radius:2px}
.nav-mobile{display:none;position:absolute;top:64px;left:0;right:0;background:var(--ink);border-top:1px solid rgba(255,255,255,.08);padding:16px 5vw;flex-direction:column;gap:4px;z-index:99}
.nav-mobile.open{display:flex}
.nav-mobile a{color:rgba(255,255,255,.75);font-size:15px;padding:12px 16px;border-radius:10px;transition:.15s}
/* Espacements compressés (juin 2026) :
   - .hero padding-top    : 48 → 38px (-10) entre header noir et titre H1
   - .hero padding-bottom : 40 → 25px (-15) entre "Rédigé par" et fin de la box
   - main padding-top     : 48 → 25px (-23) entre fin du hero et début du contenu */
.hero{background:var(--ink);padding:38px 5vw 25px;text-align:center}
.hero h1{font-family:'{{ theme.font_title }}',serif;font-size:clamp(28px,4vw,48px);font-weight:400;color:#fff;line-height:1.15;letter-spacing:-.02em;max-width:800px;margin:0 auto 16px}
.hero h1 em{font-style:italic;color:var(--accent2)}
.hero-meta{font-size:14px;color:rgba(255,255,255,.85);margin-top:8px}
.hero-author{display:flex;align-items:center;gap:8px;justify-content:center;margin-top:8px;font-size:13px;color:rgba(255,255,255,.7)}
.hero-author-avatar{width:28px;height:28px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,.3)}
main{max-width:1200px;margin:0 auto;padding:25px 5vw 80px}
.intro{font-size:18px;color:var(--ink2);line-height:1.75;margin:0 0 30px}
.intro p{margin-bottom:16px}
.intro strong{color:var(--ink);font-weight:700}
.logiciel-desc p{margin-bottom:14px}
.logiciel-desc ul{margin:0 0 14px 20px}
.en-bref{background:var(--surface);border:2px solid var(--accent);border-radius:var(--r2);padding:24px 28px;margin:0 0 30px}
.en-bref-title{font-family:'{{ theme.font_title }}',serif;font-size:20px;font-weight:400;color:var(--ink);margin:0 0 6px}
.en-bref-sub{font-size:14px;color:var(--ink2);margin:0 0 16px}
.en-bref ul{list-style:none;margin:0;padding:0}
.en-bref li{padding:8px 0;border-bottom:1px solid var(--border);font-size:15px;color:var(--ink2);display:flex;align-items:flex-start;gap:8px}
.en-bref li:last-child{border-bottom:none}
.en-bref li::before{content:"→";color:var(--accent);font-weight:700;flex-shrink:0}
.logiciel-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);overflow:hidden;margin:0 0 32px}
.logiciel-header{background:var(--ink);padding:18px 24px;display:flex;align-items:center;gap:14px}
.logiciel-name{font-family:'{{ theme.font_title }}',serif;font-size:24px;font-weight:400;color:#fff;margin:0}
.logiciel-tagline{font-size:12px;color:rgba(255,255,255,.5);margin-top:2px}
.logiciel-body{padding:20px 24px}
.logiciel-placeholder{width:100%;height:140px;background:var(--surface2);border:2px dashed var(--border);border-radius:var(--r);display:flex;align-items:center;justify-content:center;color:var(--ink3);font-size:13px;margin:0 0 16px}
.logiciel-desc{font-size:16px;color:var(--ink2);line-height:1.75;margin:0 0 16px}
.logiciel-desc strong{color:var(--ink);font-weight:700}
.avantages-table{width:100%;border-collapse:collapse;margin:0 0 16px;border-radius:var(--r);overflow:hidden;border:1px solid var(--border)}
.avantages-table th{padding:14px 16px;font-size:18px;font-weight:600;background:var(--ink);color:#fff;text-align:center}
.avantages-table td{padding:10px 14px;font-size:16px;border-top:1px solid var(--border);vertical-align:top;color:var(--ink2)}
.avantages-table td:first-child:not(:empty)::before{content:"✓ ";font-weight:700;color:var(--green)}
.avantages-table td:last-child:not(:empty)::before{content:"✗ ";font-weight:700;color:#A32D2D}
.logiciel-prix{font-size:14px;color:var(--ink2);margin-bottom:12px}
.logiciel-prix strong{color:var(--accent);font-size:18px}
.logiciel-prix .essai{color:var(--green);font-weight:600;margin-left:8px}
.logiciel-cta{display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border-radius:var(--r);background:var(--cta,var(--accent2));color:var(--cta-text,#fff);font-size:17px;font-weight:700;text-decoration:none;transition:.15s}
.logiciel-cta:hover{opacity:.88}
.section-title{font-family:'{{ theme.font_title }}',serif;font-size:clamp(24px,3vw,36px);font-weight:400;letter-spacing:-.02em;margin:40px 0 20px}
.content-custom{font-size:16px;color:var(--ink2);line-height:1.8}
.content-custom p{margin-bottom:16px}
.content-custom h2{font-family:'{{ theme.font_title }}',serif;font-size:24px;font-weight:400;color:var(--ink);margin:32px 0 12px}
.content-custom h3{font-size:18px;font-weight:600;color:var(--ink);margin:24px 0 10px}
.content-custom ul{margin:0 0 16px 20px}
.content-custom li{margin-bottom:6px}
.faq-item{border-bottom:1px solid var(--border);padding:20px 0}
.faq-q{font-size:17px;font-weight:600;color:var(--ink);margin-bottom:10px}
.faq-a{font-size:15px;color:var(--ink2);line-height:1.7}
/* ── AUTHOR BOX ── */
.author-box{display:flex;align-items:flex-start;gap:24px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:28px;margin:48px 0 0}
.author-avatar{width:80px;height:80px;border-radius:50%;object-fit:cover;flex-shrink:0;border:3px solid var(--border)}
.author-avatar-placeholder{width:80px;height:80px;border-radius:50%;background:var(--bg);border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:32px;flex-shrink:0}
.author-info{flex:1}
.author-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--ink3);margin-bottom:4px}
.author-name{font-family:'{{ theme.font_title }}',serif;font-size:20px;font-weight:400;color:var(--ink);margin-bottom:2px}
.author-job{font-size:13px;color:var(--ink3);margin-bottom:12px}
.author-bio{font-size:15px;color:var(--ink2);line-height:1.7;margin-bottom:14px}
.author-socials{display:flex;gap:10px;flex-wrap:wrap}
.author-social{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:20px;border:1px solid var(--border);font-size:12px;font-weight:600;color:var(--ink2);transition:.15s}
.author-social:hover{border-color:var(--accent);color:var(--accent)}
@media(max-width:600px){.author-box{flex-direction:column;align-items:center;text-align:center}.author-socials{justify-content:center}}
/* ── MAILLAGE INTERNE ── */
.maillage-section{margin:56px 0 0}
.maillage-section h3{font-family:'{{ theme.font_title }}',serif;font-size:clamp(20px,2.5vw,28px);font-weight:400;letter-spacing:-.02em;margin-bottom:24px;color:var(--ink)}
.maillage-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.maillage-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:16px 18px;display:flex;align-items:center;justify-content:space-between;transition:.15s;cursor:pointer;text-decoration:none;color:inherit}
.maillage-card:hover{border-color:var(--accent);box-shadow:0 4px 16px rgba(0,0,0,.06);transform:translateY(-1px)}
.maillage-card-left{display:flex;align-items:center;gap:10px}
.maillage-card-icon{width:34px;height:34px;border-radius:8px;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.maillage-card-name{font-size:13px;font-weight:600;color:var(--ink);line-height:1.3}
.maillage-card-count{font-size:11px;color:var(--ink3);margin-top:2px}
.maillage-card-arrow{color:var(--accent);font-size:16px;opacity:0;transition:.15s;flex-shrink:0}
.maillage-card:hover .maillage-card-arrow{opacity:1}
.logiciel-screenshot{display:block;width:100%;height:400px;object-fit:cover;object-position:top;border-radius:var(--r);border:1px solid var(--border)}
@media(max-width:900px){.maillage-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:500px){.maillage-grid{grid-template-columns:1fr}}
@media(max-width:768px){
  .nav-links,.nav-cta{display:none}
  .nav-burger{display:flex}
  .avantages-table{display:block;overflow-x:auto}
  .logiciel-screenshot{height:auto;aspect-ratio:16/10}
}
</style>
{% if site.google_site_verification is defined and site.google_site_verification %}
<meta name="google-site-verification" content="{{ site.google_site_verification }}">
{% endif %}
{% if site.analytics_clicky is defined and site.analytics_clicky %}
{% if '<script' in site.analytics_clicky %}
{{ site.analytics_clicky | safe }}
{% else %}
<script async data-id="{{ site.analytics_clicky }}" src="//static.getclicky.com/js"></script>
{% endif %}
{% endif %}
</head>
<body>

{% include "base/_nav.html.j2" %}

<div class="hero">
  <h1>{{ seo.h1 | safe }}</h1>
  <div class="hero-meta">⏰ Mis à jour le {{ build_date }} - {{ products | length }} logiciels analysés</div>
  {% if site.author_name is defined and site.author_name %}
  <div class="hero-author">
    {% if site.author_photo is defined and site.author_photo %}
    <img src="{{ site.author_photo }}" alt="Photo de {{ site.author_name }}" class="hero-author-avatar">
    {% endif %}
    <span>Rédigé par {{ site.author_name }}</span>
  </div>
  {% endif %}
</div>

<main>

  {% if editorial.intro is defined and editorial.intro %}
  <div class="intro">{{ editorial.intro | safe }}</div>
  {% endif %}

  {% if editorial.en_bref is defined and editorial.en_bref %}
  <div class="en-bref">
    <div class="en-bref-title">⚡ En bref</div>
    {{ editorial.en_bref | safe }}
  </div>
  {% endif %}

  <h2 class="section-title">{{ editorial.titre_analyse if editorial.titre_analyse is defined and editorial.titre_analyse else 'Comparatif complet ' ~ (cat_name if cat_name is defined and cat_name else '') }}</h2>

  {% for prod in products %}
  <div class="logiciel-card" id="{{ prod.slug }}">
    <div class="logiciel-header">
      <div style="flex:1">
        <h2 class="logiciel-name">{{ prod.nom }}</h2>
        {% if prod.tagline is defined and prod.tagline %}
        <div class="logiciel-tagline">{{ prod.tagline }}</div>
        {% endif %}
      </div>
      {% if prod.prix_achat is defined and prod.prix_achat %}
      <div style="text-align:right;flex-shrink:0">
        <div style="font-size:13px;color:rgba(255,255,255,.5)">À partir de</div>
        <div style="font-size:20px;font-weight:700;color:#fff">{{ prod.prix_achat | string | replace('.0','') }}€<span style="font-size:12px;font-weight:400;color:rgba(255,255,255,.5)">/mois</span></div>
      </div>
      {% endif %}
    </div>
    <div class="logiciel-body">
      {# `screenshot_file` est précalculé par generate.py : il pointe vers le
         fichier physiquement présent (png/jpg/jpeg/webp) dans le dossier d'images
         du schema. Fallback sur `<slug>-screenshot.png` si non défini, et
         `onerror` cache l'image si elle n'existe vraiment pas. #}
      {% set screenshot_file = prod.screenshot_file if (prod.screenshot_file is defined and prod.screenshot_file) else (prod.slug ~ "-screenshot.png") %}
      {% if prod.url_affiliation is defined and prod.url_affiliation %}
      <a href="{{ prod.url_affiliation }}" rel="nofollow" target="_blank" style="display:block;margin:0 0 16px">
        <img src="/{{ screenshot_file }}" alt="Aperçu {{ prod.nom }}"
          class="logiciel-screenshot"
          onerror="this.style.display='none'">
      </a>
      {% else %}
      <img src="/{{ screenshot_file }}" alt="Aperçu {{ prod.nom }}"
        class="logiciel-screenshot" style="margin:0 0 16px"
        onerror="this.style.display='none'">
      {% endif %}

      <div class="logiciel-desc">
        {% if prod.description is defined and prod.description %}
          {% set desc = prod.description %}
          {% if ('<p>' in desc or '<h' in desc or '<ul>' in desc) %}
            {{ desc | safe }}
          {% elif '##' in desc or '**' in desc or '- ' in desc %}
            {% for line in desc.split('\n') %}
              {% if line.startswith('## ') or line.startswith('# ') %}
                <h3 style="font-family:'{{ theme.font_title }}',serif;font-size:18px;font-weight:400;margin:16px 0 8px">{{ line.replace('## ','').replace('# ','') }}</h3>
              {% elif line.startswith('### ') %}
                <h4 style="font-size:16px;font-weight:600;margin:12px 0 6px">{{ line.replace('### ','') }}</h4>
              {% elif line.startswith('- ') %}
                <li style="margin-left:20px;margin-bottom:4px">{{ line[2:] | replace('**','') }}</li>
              {% elif line.strip() %}
                <p style="margin-bottom:10px">{{ line | replace('**','') | replace('*','') }}</p>
              {% endif %}
            {% endfor %}
          {% else %}
            {{ desc | safe }}
          {% endif %}
        {% else %}
          <p><strong>{{ prod.nom }}</strong> est une solution développée par <strong>{{ prod.marque | default(prod.nom) }}</strong>.</p>
        {% endif %}
      </div>

      {% set pf = prod.points_forts if (prod.points_forts is defined and prod.points_forts) else [] %}
      {% set pfa = prod.points_faibles if (prod.points_faibles is defined and prod.points_faibles) else [] %}
      {% if pf or pfa %}
      <table class="avantages-table">
        <thead><tr><th>✅ Avantages</th><th>❌ Inconvénients</th></tr></thead>
        <tbody>
          {% for i in range([pf | length, pfa | length] | max) %}
          <tr>
            <td>{% if i < pf | length %}{{ pf[i] }}{% endif %}</td>
            <td>{% if i < pfa | length %}{{ pfa[i] }}{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p style="font-size:13px;color:var(--ink3);font-style:italic">Analyse en cours...</p>
      {% endif %}

      {% if prod.url_affiliation is defined and prod.url_affiliation %}
      <a href="{{ prod.url_affiliation }}" class="logiciel-cta" rel="nofollow" target="_blank" style="display:flex;justify-content:center;width:100%;box-sizing:border-box">
        {{ prod.cta_text if prod.cta_text is defined and prod.cta_text else '→ Essayer ' ~ prod.nom }}
      </a>
      {% endif %}
    </div>
  </div>
  {% endfor %}

  {% if editorial.contenu_custom is defined and editorial.contenu_custom %}
  <div class="content-custom">{{ editorial.contenu_custom | safe }}</div>
  {% endif %}

  {% if editorial.faq is defined and editorial.faq %}
  <h2 class="section-title">Questions fréquentes</h2>
  {% set faq_items = [] %}
  {% if editorial.faq is iterable and editorial.faq is not mapping %}
    {% set faq_items = editorial.faq %}
  {% elif editorial.faq is mapping %}
    {% if editorial.faq.faq is defined %}
      {% if editorial.faq.faq.questions is defined %}
        {% set faq_items = editorial.faq.faq.questions %}
      {% endif %}
    {% elif editorial.faq.questions is defined %}
      {% set faq_items = editorial.faq.questions %}
    {% endif %}
  {% endif %}
  {% for item in faq_items %}
  <div class="faq-item">
    {% if item is mapping %}
      {% if item.q is defined %}
      <div class="faq-q">{{ item.q }}</div>
      <div class="faq-a">{{ item.a }}</div>
      {% elif item.question is defined %}
      <div class="faq-q">{{ item.question }}</div>
      <div class="faq-a">{{ item.answer }}</div>
      {% endif %}
    {% endif %}
  </div>
  {% endfor %}
  {% endif %}


  {% if site.author_name is defined and site.author_name %}
  {# ── BOX AUTEUR ── #}
  <aside class="author-box" itemscope itemtype="https://schema.org/Person">
    {% if site.author_photo is defined and site.author_photo %}
    <img src="{{ site.author_photo }}" alt="Photo de {{ site.author_name }}" class="author-avatar" loading="lazy" itemprop="image">
    {% else %}
    <div class="author-avatar-placeholder">✍️</div>
    {% endif %}
    <div class="author-info">
      <div class="author-label">À propos de l'auteur</div>
      <div class="author-name" itemprop="name">{{ site.author_name }}</div>
      {% if site.author_job is defined and site.author_job %}
      <div class="author-job" itemprop="jobTitle">{{ site.author_job }}</div>
      {% endif %}
      {% if site.author_bio is defined and site.author_bio %}
      <p class="author-bio" itemprop="description">{{ site.author_bio }}</p>
      {% endif %}
      {% if site.author_socials is defined and site.author_socials %}
      <nav class="author-socials" aria-label="Réseaux sociaux de {{ site.author_name }}">
        {% for social in site.author_socials %}
        {% if social.url and social.label %}
        <a href="{{ social.url }}" class="author-social" rel="noopener noreferrer" target="_blank" itemprop="sameAs">
          {{ social.label }}
        </a>
        {% endif %}
        {% endfor %}
      </nav>
      {% endif %}
    </div>
  </aside>

  {# Schema.org JSON-LD Person #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{{ site.author_name }}",
    {% if site.author_job is defined and site.author_job %}"jobTitle": "{{ site.author_job }}",{% endif %}
    {% if site.author_bio is defined and site.author_bio %}"description": "{{ site.author_bio | striptags }}",{% endif %}
    {% if site.author_photo is defined and site.author_photo %}"image": "{{ site.domain }}{{ site.author_photo }}",{% endif %}
    {% if site.author_socials is defined and site.author_socials %}"sameAs": [{% for social in site.author_socials %}{% if social.url %}"{{ social.url }}"{% if not loop.last %},{% endif %}{% endif %}{% endfor %}],{% endif %}
    "url": "{{ site.domain }}"
  }
  </script>
  {% endif %}

  {% if siblings is defined and siblings | length > 0 %}
  <section class="maillage-section">
    <h3>Nos autres comparateurs <span style="color:var(--accent)">{{ cat_parent }}</span></h3>
    <div class="maillage-grid">
      {% for cls in siblings %}
      <a href="/meilleur-{{ cls.slug }}" class="maillage-card">
        <div class="maillage-card-left">
          <div class="maillage-card-icon">💻</div>
          <div>
            <div class="maillage-card-name">{{ cls.label }}</div>
            <div class="maillage-card-count">{{ cls.count }} logiciel{{ 's' if cls.count > 1 else '' }}</div>
          </div>
        </div>
        <span class="maillage-card-arrow">→</span>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

</main>



{% include "base/_footer.html.j2" %}

<script>
function toggleMenu(){
  document.getElementById('nav-mobile').classList.toggle('open');
}
document.addEventListener('click',function(e){
  var m=document.getElementById('nav-mobile'),b=document.getElementById('burger');
  if(m&&b&&!m.contains(e.target)&&!b.contains(e.target)){m.classList.remove('open');}
});
</script>
</body>
</html>
