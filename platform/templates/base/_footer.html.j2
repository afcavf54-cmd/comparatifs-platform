<style>
.footer{background:var(--ink);color:rgba(255,255,255,.5);padding:56px 5vw 32px;font-size:14px}
.footer-inner{max-width:1200px;margin:0 auto}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:40px;margin-bottom:48px}
.footer-brand .footer-logo{font-family:'{{ theme.font_title }}',serif;font-size:26px;font-weight:400;color:#fff;margin-bottom:12px;display:block}
.footer-brand .footer-logo span{color:var(--accent2)}
.footer-brand p{font-size:13px;color:rgba(255,255,255,.45);line-height:1.7;max-width:260px;margin:0;padding:0}
/* Anciennement .footer-col h4 — passé en div pour respecter la hiérarchie Hn (le footer ne doit pas introduire de Hn) */
.footer-col .footer-col-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.35);margin-bottom:16px}
.footer-col a{display:block;color:rgba(255,255,255,.55);font-size:14px;margin-bottom:10px;transition:.15s}
.footer-col a:hover{color:#fff}
.footer-bottom{border-top:1px solid rgba(255,255,255,.08);padding-top:24px;text-align:center}
.footer-bottom-left{font-size:13px;color:rgba(255,255,255,.3)}
@media(max-width:768px){
  .footer-grid{grid-template-columns:1fr 1fr;gap:32px}
  .footer-brand{grid-column:1/-1}
}
</style>
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        {% if site.logo_img is defined and site.logo_img %}
        <a href="/" style="display:block;margin-bottom:12px"><img src="{{ site.logo_img }}" alt="{{ site.name }}" style="height:36px;width:auto;object-fit:contain"></a>
        {% else %}
        <div class="footer-logo">{{ site.logo_text }}<span>{{ site.logo_accent }}</span></div>
        {% endif %}
        <p>{{ site.tagline | default('') }}</p>
      </div>
      <div class="footer-col">
        <div class="footer-col-label">Navigation</div>
        {# Liens conditionnels : alignés sur la logique du _nav.html.j2.
           - "Nos comparateurs" : caché si site.has_comparateurs est défini ET false
             (sites blog-only). Affiché si non défini (rétro-compat sites legacy).
           - "Avis" / "Blog" : affichés uniquement si flag explicitement défini à true. #}
        {% if site.has_comparateurs is not defined or site.has_comparateurs %}
        <a href="/nos-comparateurs">Nos comparateurs</a>
        {% endif %}
        {% if site.has_avis is defined and site.has_avis %}
        <a href="/avis">Avis</a>
        {% endif %}
        {% if site.has_blog is defined and site.has_blog %}
        <a href="/blog/">Blog</a>
        {% endif %}
        <a href="/plan-du-site">Plan du site</a>
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/politique-confidentialite">Confidentialité</a>
      </div>
      <div class="footer-col">
        <div class="footer-col-label">À propos</div>
        <a href="/contact">Nous contacter</a>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-bottom-left">
        © {{ site.year }} {{ site.domain | replace('https://www.', '') | replace('https://', '') }} — Données actualisées le {{ build_date | fr_date }}
      </div>
    </div>
  </div>
</footer>
{% include "base/_scroll_to_top.html.j2" %}
