<style>
.footer{background:var(--ink);color:rgba(255,255,255,.5);padding:56px 5vw 32px;font-size:14px}
.footer-inner{max-width:1200px;margin:0 auto}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:40px;margin-bottom:48px}
.footer-brand .footer-logo{font-family:'{{ theme.font_title }}',serif;font-size:26px;font-weight:400;color:#fff;margin-bottom:12px;display:block}
.footer-brand .footer-logo span{color:var(--accent2)}
.footer-brand p{font-size:15px;color:rgba(255,255,255,.45);line-height:1.7;max-width:380px;margin:0;padding:0}
.footer-socials{display:flex;gap:12px;margin-top:20px}
.footer-socials a{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,.06);color:rgba(255,255,255,.55);transition:background .15s,color .15s}
.footer-socials a:hover{background:rgba(255,255,255,.13);color:#fff}
.footer-socials svg{width:19px;height:19px;fill:currentColor;display:block}
/* Anciennement .footer-col h4 — passé en div pour respecter la hiérarchie Hn (le footer ne doit pas introduire de Hn) */
.footer-col .footer-col-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.35);margin-bottom:16px}
.footer-col a{display:block;color:rgba(255,255,255,.55);font-size:14px;margin-bottom:10px;transition:.15s}
.footer-col a:hover{color:#fff}
.footer-bottom{border-top:1px solid rgba(255,255,255,.08);padding-top:24px;text-align:center}
.footer-bottom-left{font-size:13px;color:rgba(255,255,255,.3)}
@media(max-width:768px){
  .footer-grid{grid-template-columns:1fr 1fr;gap:32px}
  .footer-brand{grid-column:1/-1}
}
</style>
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        {% if site.logo_img is defined and site.logo_img %}
        <a href="/" style="display:block;margin-bottom:12px"><img src="{{ site.logo_img }}" alt="{{ site.name }}" style="height:36px;width:auto;object-fit:contain"></a>
        {% else %}
        <div class="footer-logo">{{ site.logo_text }}<span>{{ site.logo_accent }}</span></div>
        {% endif %}
        <p>{% if site.footer_description is defined and site.footer_description %}{{ site.footer_description }}{% else %}{{ site.tagline | default('') }}{% endif %}</p>
        {% if (site.social_facebook is defined and site.social_facebook) or (site.social_linkedin is defined and site.social_linkedin) or (site.social_x is defined and site.social_x) or (site.social_youtube is defined and site.social_youtube) %}
        <div class="footer-socials">
          {% if site.social_facebook is defined and site.social_facebook %}<a href="{{ site.social_facebook }}" target="_blank" rel="noopener noreferrer nofollow" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M13 22v-8h2.7l.4-3.1H13V8.9c0-.9.3-1.5 1.6-1.5H16V4.6c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.4H7.2V14H9.9v8H13z"/></svg></a>{% endif %}
          {% if site.social_linkedin is defined and site.social_linkedin %}<a href="{{ site.social_linkedin }}" target="_blank" rel="noopener noreferrer nofollow" aria-label="LinkedIn"><svg viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.34 18.34v-7.2H6v7.2h2.34zM7.17 10.1a1.36 1.36 0 1 0 0-2.72 1.36 1.36 0 0 0 0 2.72zM18 18.34v-3.95c0-2.1-1.12-3.08-2.62-3.08-1.21 0-1.75.67-2.05 1.13v-.97h-2.34c.03.66 0 7.2 0 7.2h2.34v-4.02c0-.21.01-.42.08-.57.18-.42.56-.85 1.22-.85.86 0 1.2.65 1.2 1.61v3.83H18z"/></svg></a>{% endif %}
          {% if site.social_x is defined and site.social_x %}<a href="{{ site.social_x }}" target="_blank" rel="noopener noreferrer nofollow" aria-label="X"><svg viewBox="0 0 24 24"><path d="M18.9 2H22l-7.1 8.1L23.2 22h-6.6l-5.2-6.8L5.5 22H2.4l7.6-8.7L1.7 2h6.7l4.7 6.2L18.9 2zm-1.2 18h1.8L7.3 3.9H5.4L17.7 20z"/></svg></a>{% endif %}
          {% if site.social_youtube is defined and site.social_youtube %}<a href="{{ site.social_youtube }}" target="_blank" rel="noopener noreferrer nofollow" aria-label="YouTube"><svg viewBox="0 0 24 24"><path d="M23 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.8-1.8C19.4 5.1 12 5.1 12 5.1s-7.4 0-8.8.4a2.5 2.5 0 0 0-1.8 1.8C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 0 0 1.8 1.8c1.4.4 8.8.4 8.8.4s7.4 0 8.8-.4a2.5 2.5 0 0 0 1.8-1.8C23 15.2 23 12 23 12zM9.8 15.3V8.7l5.7 3.3-5.7 3.3z"/></svg></a>{% endif %}
        </div>
        {% endif %}
      </div>
      <div class="footer-col">
        <div class="footer-col-label">Navigation</div>
        {# Liens conditionnels : alignés sur la logique du _nav.html.j2.
           - "Nos comparateurs" : caché si site.has_comparateurs est défini ET false
             (sites blog-only). Affiché si non défini (rétro-compat sites legacy).
           - "Avis" / "Blog" : affichés uniquement si flag explicitement défini à true. #}
        {% if site.has_comparateurs is not defined or site.has_comparateurs %}
        <a href="/nos-comparateurs">Nos comparateurs</a>
        {% endif %}
        {% if site.has_avis is defined and site.has_avis %}
        <a href="/avis">Avis</a>
        {% endif %}
        {% if site.has_blog is defined and site.has_blog %}
        <a href="/blog/">Blog</a>
        {% endif %}
        <a href="/plan-du-site">Plan du site</a>
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/politique-confidentialite">Confidentialité</a>
      </div>
      <div class="footer-col">
        <div class="footer-col-label">À propos</div>
        {# Lien vers la page À propos : conditionnel sur site.has_a_propos, défini
           par generate.py si le template a-propos.html.j2 existe (site-local OU base).
           Évite un 404 sur les sites qui n'ont pas encore créé leur page. #}
        {% if site.has_a_propos is defined and site.has_a_propos %}
        <a href="/a-propos/">À propos</a>
        {% endif %}
        <a href="/contact">Nous contacter</a>
        {% if site.has_a_propos is defined and site.has_a_propos %}
        <a href="/a-propos/">Notre équipe</a>
        {% endif %}
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-bottom-left">
        © {{ site.year }} {{ site.domain | replace('https://www.', '') | replace('https://', '') }} — Données actualisées le {{ build_date | fr_date }}
      </div>
    </div>
  </div>
</footer>
{% include "base/_scroll_to_top.html.j2" %}
