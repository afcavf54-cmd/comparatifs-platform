{# ============================================================
   PARTIAL : Navigation principale du site (autoportant)

   Inclus par : classement-saas, nos-comparateurs, convertisseur,
                comparatif-vs, avis-*, blog-*, contact, etc.

   Variables attendues dans le contexte :
   - site.logo_img         : (optionnel) URL d'une image logo
   - site.logo_text        : texte du logo (fallback si pas d'image)
   - site.logo_accent      : suffixe coloré du logo texte
   - site.name             : nom du site (alt de l'image logo)
   - site.has_avis         : (bool) afficher le lien "Avis"
   - site.has_blog         : (bool) afficher le lien "Blog"
   - site.outils_menu      : (list[{label,url}]) liens vers les outils
   - theme.ink, theme.accent2, theme.font_title : CSS vars/fonts

   La fonction JS toggleMenu() doit être déclarée par le template
   parent (déjà le cas dans tous nos templates standards).
============================================================ #}
<style>
nav{background:var(--ink);padding:0 5vw;display:flex;align-items:center;justify-content:space-between;height:64px;position:sticky;top:0;z-index:100}
.nav-inner{max-width:1200px;width:100%;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px;position:relative}
.nav-logo{font-family:'{{ theme.font_title }}',serif;font-weight:400;font-size:17px;color:#fff;flex-shrink:0}
.nav-logo span{color:var(--accent2)}
.nav-links{display:flex;align-items:center;gap:4px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:30px;padding:4px 8px;position:absolute;left:50%;transform:translateX(-50%)}
.nav-links a{color:rgba(255,255,255,.65);font-size:13px;font-weight:500;padding:6px 14px;border-radius:24px;transition:.15s}
.nav-links a:hover{color:#fff;background:rgba(255,255,255,.1)}
.nav-cta{display:inline-flex;align-items:center;gap:6px;padding:8px 18px;border-radius:24px;background:var(--cta);color:var(--cta-text);font-size:13px;font-weight:700;transition:.15s}
.nav-cta:hover{opacity:.88}
.nav-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;background:none;border:none}
.nav-burger span{display:block;width:22px;height:2px;background:#fff;border-radius:2px}
.nav-mobile{display:none;position:absolute;top:64px;left:0;right:0;background:var(--ink);border-top:1px solid rgba(255,255,255,.08);padding:16px 5vw;flex-direction:column;gap:4px;z-index:99}
.nav-mobile.open{display:flex}
.nav-mobile a{color:rgba(255,255,255,.75);font-size:15px;padding:12px 16px;border-radius:10px;transition:.15s}
@media(max-width:768px){.nav-links,.nav-cta{display:none}.nav-burger{display:flex}}
</style>

<nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo">{% if site.logo_img is defined and site.logo_img %}<img src="{{ site.logo_img }}" alt="{{ site.name }}" style="height:36px;width:auto;object-fit:contain;vertical-align:middle">{% else %}{{ site.logo_text }}<span>{{ site.logo_accent }}</span>{% endif %}</a>
    <div class="nav-links">
      <a href="/nos-comparateurs">Nos comparateurs</a>
      {% if site.has_avis is defined and site.has_avis %}
        <a href="/avis">Avis</a>
      {% endif %}
      {% if site.has_blog is defined and site.has_blog %}
        <a href="/blog">Blog</a>
      {% endif %}
      {% if site.outils_menu is defined and site.outils_menu %}
        {% for outil in site.outils_menu %}
          <a href="{{ outil.url }}">{{ outil.label }}</a>
        {% endfor %}
      {% endif %}
    </div>
    <a href="/contact" class="nav-cta">Contact</a>
    <button class="nav-burger" id="burger" onclick="toggleMenu()" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="nav-mobile" id="nav-mobile">
    <a href="/nos-comparateurs">Nos comparateurs</a>
    {% if site.has_avis is defined and site.has_avis %}
      <a href="/avis">Avis</a>
    {% endif %}
    {% if site.has_blog is defined and site.has_blog %}
      <a href="/blog">Blog</a>
    {% endif %}
    {% if site.outils_menu is defined and site.outils_menu %}
      {% for outil in site.outils_menu %}
        <a href="{{ outil.url }}">{{ outil.label }}</a>
      {% endfor %}
    {% endif %}
    <a href="/contact" class="nav-cta">Contact</a>
  </div>
</nav>
