{# ============================================================
   PARTIAL : Navigation principale du site (autoportant)

   Inclus par : classement-saas, nos-comparateurs, convertisseur,
                comparatif-vs, avis-*, blog-*, contact, etc.

   IMPORTANT : tous les sélecteurs CSS sont scopés à `.site-nav`
   pour ne pas interférer avec d'autres éléments <nav> de la page
   (ex: sommaire <nav class="avis-toc"> dans les pages avis).

   Variables attendues dans le contexte :
   - site.logo_img         : (optionnel) URL d'une image logo
   - site.logo_text        : texte du logo (fallback si pas d'image)
   - site.logo_accent      : suffixe coloré du logo texte
   - site.name             : nom du site (alt de l'image logo)
   - site.has_comparateurs : (bool) afficher le lien "Nos comparateurs".
                             Si NON DÉFINI dans config.yaml (sites legacy
                             créés avant juin 2026), affiché par défaut
                             pour préserver la rétro-compat. Si défini à
                             false explicitement (sites blog-only créés
                             via le wizard refondu, ex: cadeauclic.com),
                             le lien est masqué.
   - site.has_avis         : (bool) afficher le lien "Avis"
   - site.has_blog         : (bool) afficher le lien "Blog"
   - site.outils_menu      : (list[{label,url}]) liens vers les outils
   - theme.ink, theme.accent2, theme.font_title : CSS vars/fonts

   La fonction JS toggleMenu() est déclarée à la fin de ce partial
   (fallback safe). Les templates qui la définissent eux-mêmes en
   amont conservent leur version (pattern `window.x = window.x || …`).
============================================================ #}
<style>
nav.site-nav{background:var(--ink);padding:0 5vw;display:flex;align-items:center;justify-content:space-between;height:64px;position:sticky;top:0;z-index:100}
nav.site-nav .nav-inner{max-width:1200px;width:100%;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px;position:relative}
nav.site-nav .nav-logo{font-family:'{{ theme.font_title }}',serif;font-weight:400;font-size:17px;color:#fff;flex-shrink:0}
nav.site-nav .nav-logo span{color:var(--accent2)}
nav.site-nav .nav-links{display:flex;align-items:center;gap:4px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:30px;padding:4px 8px;position:absolute;left:50%;transform:translateX(-50%)}
nav.site-nav .nav-links a{color:rgba(255,255,255,.65);font-size:13px;font-weight:500;padding:6px 14px;border-radius:24px;transition:.15s}
nav.site-nav .nav-links a:hover{color:#fff;background:rgba(255,255,255,.1)}
nav.site-nav .nav-cta{display:inline-flex;align-items:center;gap:6px;padding:8px 18px;border-radius:24px;background:var(--cta);color:var(--cta-text);font-size:13px;font-weight:700;transition:.15s}
nav.site-nav .nav-cta:hover{opacity:.88}
nav.site-nav .nav-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;background:none;border:none}
nav.site-nav .nav-burger span{display:block;width:22px;height:2px;background:#fff;border-radius:2px}
nav.site-nav .nav-mobile{display:none;position:absolute;top:64px;left:0;right:0;background:var(--ink);border-top:1px solid rgba(255,255,255,.08);padding:16px 5vw;flex-direction:column;gap:4px;z-index:99}
nav.site-nav .nav-mobile.open{display:flex}
nav.site-nav .nav-mobile a{color:rgba(255,255,255,.75);font-size:15px;padding:12px 16px;border-radius:10px;transition:.15s}
@media(max-width:768px){nav.site-nav .nav-links,nav.site-nav .nav-cta{display:none}nav.site-nav .nav-burger{display:flex}}
</style>

<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">{% if site.logo_img is defined and site.logo_img %}<img src="{{ site.logo_img }}" alt="{{ site.name }}" style="height:36px;width:auto;object-fit:contain;vertical-align:middle">{% else %}{{ site.logo_text }}<span>{{ site.logo_accent }}</span>{% endif %}</a>
    <div class="nav-links">
      {# Lien "Nos comparateurs" : caché si site.has_comparateurs est défini
         ET false (sites blog-only). Sinon affiché (rétro-compat avec les
         sites legacy qui n'ont pas le flag dans leur config). #}
      {% if site.has_comparateurs is not defined or site.has_comparateurs %}
        <a href="/nos-comparateurs">Nos comparateurs</a>
      {% endif %}
      {% if site.has_avis is defined and site.has_avis %}
        <a href="/avis">Avis</a>
      {% endif %}
      {% if site.has_blog is defined and site.has_blog %}
        <a href="/blog/">Blog</a>
      {% endif %}
      {% if site.outils_menu is defined and site.outils_menu %}
        {% for outil in site.outils_menu %}
          <a href="{{ outil.url }}">{{ outil.label }}</a>
        {% endfor %}
      {% endif %}
    </div>
    <a href="/contact" class="nav-cta">Contact</a>
    <button class="nav-burger" id="burger" onclick="toggleMenu()" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="nav-mobile" id="nav-mobile">
    {% if site.has_comparateurs is not defined or site.has_comparateurs %}
      <a href="/nos-comparateurs">Nos comparateurs</a>
    {% endif %}
    {% if site.has_avis is defined and site.has_avis %}
      <a href="/avis">Avis</a>
    {% endif %}
    {% if site.has_blog is defined and site.has_blog %}
      <a href="/blog/">Blog</a>
    {% endif %}
    {% if site.outils_menu is defined and site.outils_menu %}
      {% for outil in site.outils_menu %}
        <a href="{{ outil.url }}">{{ outil.label }}</a>
      {% endfor %}
    {% endif %}
    <a href="/contact" class="nav-cta">Contact</a>
  </div>
</nav>

<script>
/* Fallback safe pour toggleMenu() : déclarée ici pour que TOUS les templates
   qui incluent _nav.html.j2 aient un burger fonctionnel par défaut, sans
   devoir redéfinir la fonction côté template parent.

   Pattern `window.x = window.x || …` : on ne remplace pas une éventuelle
   définition déjà existante en amont (cf. classement-saas.html.j2 et autres
   templates standards qui peuvent vouloir une version enrichie). Ils gagnent
   s'ils déclarent toggleMenu AVANT l'include _nav. Dans le cas (le plus
   fréquent) où l'include arrive AVANT le script du parent, c'est ce fallback
   qui est actif et le parent réécrit derrière s'il en a un.

   Bug d'origine corrigé (juin 2026) : blog-post.html.j2 et blog-index.html.j2
   ne définissaient pas toggleMenu → onclick="toggleMenu()" donnait
   "ReferenceError: toggleMenu is not defined" sur mobile, et le burger
   ne faisait rien. */
(function(){
  if (typeof window.toggleMenu === 'function') return;
  window.toggleMenu = function(){
    var menu = document.getElementById('nav-mobile');
    if (menu) menu.classList.toggle('open');
  };
  // UX bonus : fermer le menu mobile en cliquant en dehors
  document.addEventListener('click', function(e){
    var menu = document.getElementById('nav-mobile');
    var burger = document.getElementById('burger');
    if (!menu || !burger) return;
    if (!menu.classList.contains('open')) return;
    if (menu.contains(e.target) || burger.contains(e.target)) return;
    menu.classList.remove('open');
  });
  // Et fermer aussi en cliquant sur un lien du menu (pour les ancres internes)
  document.addEventListener('DOMContentLoaded', function(){
    var menu = document.getElementById('nav-mobile');
    if (!menu) return;
    menu.querySelectorAll('a').forEach(function(a){
      a.addEventListener('click', function(){ menu.classList.remove('open'); });
    });
  });
})();
</script>
