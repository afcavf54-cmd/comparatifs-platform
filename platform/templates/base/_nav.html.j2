<style>
nav{background:var(--ink);padding:0 5vw;position:sticky;top:0;z-index:100;display:flex;align-items:center}
.nav-inner{max-width:1200px;width:100%;margin:0 auto;display:flex;align-items:center;justify-content:center;position:relative;padding:20px 0}
.nav-box{display:flex;align-items:center;gap:6px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:40px;padding:8px 12px 8px 10px;margin:20px auto}
.nav-box-logo{font-family:'{{ theme.font_title }}',serif;font-weight:400;font-size:18px;color:#fff;padding:8px 18px;white-space:nowrap}
.nav-box-logo span{color:var(--accent2)}
.nav-box-sep{width:1px;height:20px;background:rgba(255,255,255,.15);flex-shrink:0}
.nav-box-links{display:flex;align-items:center;gap:2px}
.nav-box-links a{color:rgba(255,255,255,.65);font-size:15px;font-weight:500;padding:9px 20px;border-radius:30px;transition:.15s;white-space:nowrap}
.nav-box-links a:hover,.nav-box-links a.active{color:#fff;background:rgba(255,255,255,.1)}
.nav-box-cta{display:inline-flex;align-items:center;gap:6px;padding:10px 22px;border-radius:30px;background:var(--accent2);color:#fff;font-size:15px;font-weight:700;transition:.15s;white-space:nowrap;margin-left:6px}
.nav-box-cta:hover{opacity:.88}
.nav-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;background:none;border:none;position:absolute;right:0}
.nav-burger span{display:block;width:22px;height:2px;background:#fff;border-radius:2px;transition:.25s}
.nav-burger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.nav-burger.open span:nth-child(2){opacity:0}
.nav-burger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
.nav-mobile{display:none;position:absolute;top:calc(100% + 0px);left:0;right:0;background:var(--ink);border-top:1px solid rgba(255,255,255,.08);padding:16px 5vw;flex-direction:column;gap:4px;z-index:99}
.nav-mobile.open{display:flex}
.nav-mobile a{color:rgba(255,255,255,.75);font-size:15px;font-weight:500;padding:12px 16px;border-radius:10px;transition:.15s}
.nav-mobile a:hover{color:#fff;background:rgba(255,255,255,.08)}
.nav-mobile .nav-box-cta{margin-top:8px;justify-content:center;border-radius:12px}
@media(max-width:768px){.nav-box{display:none}.nav-burger{display:flex}}
</style>

<nav>
  <div class="nav-inner">
    <div class="nav-box">
      <a href="/" class="nav-box-logo">{{ site.logo_text }}<span>{{ site.logo_accent }}</span></a>
      <div class="nav-box-sep"></div>
      <div class="nav-box-links">
        <a href="/comparatifs-scpi.html">Comparatifs SCPI</a>
        <a href="/avis-scpi.html">Avis SCPI</a>
      </div>
      <div class="nav-box-sep"></div>
      <a href="/contact.html" class="nav-box-cta">Contact →</a>
    </div>
    <button class="nav-burger" id="burger" aria-label="Menu" onclick="toggleMenu()">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="nav-mobile" id="nav-mobile">
    <a href="/">Accueil</a>
    <a href="/comparatifs-scpi.html">Comparatifs SCPI</a>
    <a href="/avis-scpi.html">Avis SCPI</a>
    <a href="/contact.html" class="nav-box-cta">Contact →</a>
  </div>
</nav>

<script>
function toggleMenu(){
  var m=document.getElementById('nav-mobile');
  var b=document.getElementById('burger');
  m.classList.toggle('open');b.classList.toggle('open');
}
document.addEventListener('click',function(e){
  var m=document.getElementById('nav-mobile');var b=document.getElementById('burger');
  if(m&&b&&!m.contains(e.target)&&!b.contains(e.target)){m.classList.remove('open');b.classList.remove('open');}
});
</script>
