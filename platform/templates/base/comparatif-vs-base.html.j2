<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ seo.title }}</title>
<meta name="description" content="{{ seo.meta }}">
<link rel="canonical" href="{{ site.domain }}/{{ slug_a }}-vs-{{ slug_b }}">
<meta property="og:title" content="{{ seo.title }}">
<meta property="og:description" content="{{ seo.meta }}">
<meta property="og:type" content="article">
<meta property="og:url" content="{{ site.domain }}/{{ slug_a }}-vs-{{ slug_b }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="{{ theme.google_fonts }}" rel="stylesheet">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ prod_a.nom }} vs {{ prod_b.nom }} : comparatif {{ site.year }}",
  "description": "{{ seo.meta }}",
  "url": "{{ site.domain }}/{{ slug_a }}-vs-{{ slug_b }}",
  "dateModified": "{{ build_date }}",
  "publisher": {"@type": "Organization", "name": "{{ site.name }}"}
}
</script>
{% block extra_head %}{% endblock %}
<style>
:root{
  --bg:{{ theme.bg }};
  --surface:#FFFFFF;
  --surface2:#F0ECE5;
  --ink:{{ theme.ink }};
  --ink2:#6B6560;
  --ink3:#A09890;
  --accent:{{ theme.accent }};
  --accent2:{{ theme.accent2 }};
  --border:#E2DDD6;
  --r:12px;
  --r2:20px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'{{ theme.font_body }}',sans-serif;background:var(--bg);color:var(--ink);font-size:18px;line-height:1.75}
a{color:inherit;text-decoration:none}
nav{background:var(--ink);padding:0 5vw;display:flex;align-items:center;justify-content:space-between;height:64px;position:sticky;top:0;z-index:100}
.nav-inner{max-width:1200px;width:100%;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px}
.nav-logo{font-family:'{{ theme.font_title }}',serif;font-weight:400;font-size:17px;color:#fff;flex-shrink:0}.nav-logo span{color:var(--accent2)}
.nav-links{display:flex;align-items:center;gap:4px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:30px;padding:4px 8px}
.nav-links a{color:rgba(255,255,255,.65);font-size:13px;font-weight:500;padding:6px 14px;border-radius:24px;transition:.15s}
.nav-links a:hover{color:#fff;background:rgba(255,255,255,.1)}
.nav-links a.active{color:#fff;font-weight:600}
.nav-cta{display:inline-flex;align-items:center;gap:6px;padding:8px 18px;border-radius:24px;background:var(--accent2);color:#fff;font-size:13px;font-weight:700;transition:.15s;flex-shrink:0}
.nav-cta:hover{opacity:.88}
.nav-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;background:none;border:none}
.nav-burger span{display:block;width:22px;height:2px;background:#fff;border-radius:2px;transition:.25s}
.nav-burger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.nav-burger.open span:nth-child(2){opacity:0}
.nav-burger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
.nav-mobile{display:none;position:absolute;top:64px;left:0;right:0;background:var(--ink);border-top:1px solid rgba(255,255,255,.08);padding:16px 5vw;flex-direction:column;gap:4px;z-index:99}
.nav-mobile.open{display:flex}
.nav-mobile a{color:rgba(255,255,255,.75);font-size:15px;font-weight:500;padding:12px 16px;border-radius:10px;transition:.15s}
.nav-mobile a:hover,.nav-mobile a.active{color:#fff;background:rgba(255,255,255,.08)}
.nav-mobile .nav-cta{margin-top:8px;justify-content:center;border-radius:12px}
.crumb{max-width:1200px;margin:0 auto;padding:8px 5vw;font-size:12px;color:var(--ink3)}
.crumb a{color:var(--accent)}
main{max-width:1200px;margin:0 auto;padding:0 5vw 16px}
.hero-vs{text-align:center;padding:16px 0 0}
.eyebrow{display:inline-flex;align-items:center;gap:6px;background:var(--accent);color:#fff;font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:4px 12px;border-radius:20px;margin-bottom:16px}
h1{font-family:'{{ theme.font_title }}',serif;font-size:clamp(38px,5.5vw,72px);font-weight:400;line-height:1.05;letter-spacing:-.025em;margin-bottom:16px;max-width:100%;width:100%}
h1 em{font-style:italic;color:var(--accent)}
.intro{font-size:18px;color:var(--ink2);max-width:100%;line-height:1.75;margin:30px 0 40px;text-align:center}
.comp-block{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);overflow:hidden;margin:32px 0}
.comp-block-header{background:var(--ink);padding:20px 24px;display:grid;grid-template-columns:220px 1fr 1fr;gap:16px;align-items:center}
.comp-block-header .col-title{font-family:'{{ theme.font_title }}',serif;font-weight:400;font-size:20px;color:#fff;text-align:center;display:block}
.comp-block-header .col-brand{font-size:13px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.05em;text-align:center;display:block}
.col-label{font-size:15px;color:rgba(255,255,255,.7);font-weight:500;text-align:center}
table.comp{width:100%;border-collapse:collapse;table-layout:fixed}
table.comp tr{border-bottom:1px solid var(--border);transition:.1s}
table.comp tr:hover{background:var(--surface2)}
td.crit-label{width:220px;padding:14px 24px;font-size:12px;font-weight:600;color:#6B6560;text-transform:uppercase;letter-spacing:.05em;text-align:left;white-space:nowrap}
table.comp td{padding:14px 16px;font-size:18px;font-weight:400;text-align:center;vertical-align:middle}
.stars{color:var(--accent)}
.tag{display:inline-block;padding:3px 9px;border-radius:6px;font-size:11px;font-weight:600}
.tag-rendement{background:#EAF3DE;color:#1A5C2A}
.tag-diversifiee{background:#E6F1FB;color:#0C447C}
.tag-specialisee{background:#FAEEDA;color:#633806}
.tag-europeenne{background:#F5E6FB;color:#5B2185}
.cta-amz{display:inline-flex;align-items:center;gap:8px;padding:13px 22px;border-radius:var(--r);font-size:14px;font-weight:600;transition:.15s;cursor:pointer;border:none}
.cta-amz-primary{background:#E8410A;color:#fff}.cta-amz-primary:hover{background:#c93508}h2{font-family:'{{ theme.font_title }}',serif;font-size:32px;font-weight:400;letter-spacing:-.01em;margin:40px 0 16px}
h3{font-family:'{{ theme.font_title }}',serif;font-size:24px;font-weight:400;margin:24px 0 12px;display:flex;align-items:center;gap:8px}
.model-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:24px;margin:16px 0}
.model-price{font-size:24px;font-weight:700;color:var(--accent)}
.model-price span{font-size:13px;font-weight:400;color:var(--ink3)}
.model-body{display:flex;gap:24px;align-items:flex-start;margin-bottom:16px}
.model-photo-wrap{flex-shrink:0;width:200px;text-align:center}
.model-photo-wrap img{width:100%;height:auto;border-radius:12px;object-fit:contain}
.model-photo-placeholder{width:200px;height:200px;border-radius:12px;border:2px dashed var(--border);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--ink3);font-size:12px;background:var(--surface2)}
.model-text{flex:1;font-size:18px;color:var(--ink2);line-height:1.75}
.model-text p{margin:0 0 20px}
.model-text p:last-child{margin-bottom:0}
.pros-cons{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:20px;padding-top:20px;border-top:1px solid var(--border)}
.pros,.cons{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:18px 20px;text-align:center}
.pros h3{color:#1A7A4A;font-size:17px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-bottom:14px;text-align:center;display:block}
.cons h3{color:#A32D2D;font-size:17px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-bottom:14px;text-align:center;display:block}
.pros li,.cons li{font-size:16px;line-height:1.7;margin-bottom:8px;text-align:left;list-style:none;padding-left:22px;position:relative}
.pros li::before{content:"→";position:absolute;left:0;color:#1A7A4A;font-weight:700}
.cons li::before{content:"→";position:absolute;left:0;color:#A32D2D;font-weight:700}
.verdict{background:var(--ink);border-radius:var(--r2);padding:32px;margin:32px 0;color:#fff}
.verdict h2{color:#fff;margin-top:0;text-align:center}
.verdict-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:16px}
.verdict-box{background:rgba(255,255,255,.08);border-radius:var(--r);padding:18px;display:flex;flex-direction:column;justify-content:space-between}
.verdict-box h3{color:#fff;font-size:19px;font-weight:700;margin-top:0;margin-bottom:14px;display:flex;justify-content:center;align-items:center;gap:6px}
.verdict-box li{font-size:18px;color:rgba(255,255,255,.8);margin-bottom:8px;line-height:1.75;text-align:center;list-style:none}
.verdict-box .verdict-cta{margin-top:auto;padding-top:14px;border-top:1px solid rgba(255,255,255,.1)}
.cta-amz-primary{background:#E8410A;color:#fff}.cta-amz-primary:hover{background:#c93508}
.rel-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;margin-top:12px}
.rel-link{display:block;background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px 18px;font-size:16px;font-weight:500;transition:.15s}
.rel-link:hover{border-color:var(--accent);color:var(--accent)}
.avis-block{background:var(--surface);border-radius:var(--r2);border:1px solid var(--border);padding:24px;margin:24px 0}
.avis-score{font-size:32px;font-weight:700;color:var(--accent);display:inline-block;margin-right:8px}
.faq{margin:40px 0}
.faq-item{border-bottom:1px solid var(--border);padding:16px 0}
.faq-q{font-size:18px;font-weight:600;cursor:pointer;display:flex;justify-content:space-between;align-items:center}
.faq-q::after{content:'+';font-size:24px;color:var(--accent);font-weight:300}
.faq-a{font-size:17px;color:var(--ink2);line-height:1.75;margin-top:12px}
footer{background:var(--ink);color:rgba(255,255,255,.5);text-align:center;padding:32px;font-size:13px}
footer a{color:rgba(255,255,255,.4)}
.aff-notice{font-size:13px;color:var(--ink3);text-align:center;padding:20px 5vw;line-height:1.6;max-width:900px;margin:0 auto}
{% block extra_css %}{% endblock %}
@media(max-width:768px){
  .nav-links,.nav-cta{display:none}
  .nav-burger{display:flex}
  .comp-block{overflow-x:auto;-webkit-overflow-scrolling:touch}
  .comp-block-header{grid-template-columns:90px 1fr 1fr;gap:6px;padding:12px}
  .comp-block-header .col-title{font-size:14px}
  .comp-block-header .col-brand{font-size:10px}
  td.crit-label{width:90px;min-width:90px;padding:10px 8px;font-size:10px;white-space:normal;word-break:break-word}
  table.comp{table-layout:fixed;width:100%}
  table.comp td{padding:10px 8px;font-size:13px;word-break:break-word;overflow-wrap:break-word;text-align:center}
  colgroup col:first-child{width:90px}
  colgroup col{width:calc((100% - 90px) / 2)}
  .pros-cons{grid-template-columns:1fr}
  .verdict-grid{grid-template-columns:1fr}
  .model-body{flex-direction:column}
  .model-photo-wrap{width:100%}
  .aff-notice{padding:20px 16px}
  /* Fix tous les tableaux inline (frais, performance, accessibilité) */
  table{width:100%!important;table-layout:fixed}
  table td,table th{word-break:break-word;overflow-wrap:break-word;hyphens:auto;font-size:13px!important;padding:9px 8px!important}
  table td:first-child,table th:first-child{width:40%!important;font-size:11px!important}
  table td:not(:first-child),table th:not(:first-child){width:30%!important;text-align:center}
}
</style>
</head>
<body>

{% include "base/_nav.html.j2" %}<div class="crumb">
  <a href="/">Accueil</a> ›
  <a href="comparatifs-scpi.html">{{ site.seo.category_label }}</a> ›
  {{ prod_a.nom }} vs {{ prod_b.nom }}
</div>

<main>
  <div class="hero-vs">
    <div class="eyebrow">{{ site.seo.eyebrow | replace('{year}', site.year|string) }}</div>
    <h1>{{ seo.h1 | safe }}</h1>
    <div style="display:flex;justify-content:center;margin:-10px 0 20px">
      <div style="display:inline-flex;align-items:center;gap:6px;background:#EAF3DE;color:#27500A;font-size:11px;font-weight:600;padding:4px 12px;border-radius:20px;border:none">
        <span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:#27500A"></span>
        Mis à jour le {{ build_date | fr_date }}
      </div>
    </div>
    <p class="intro">{% if editorial is defined and editorial.intro_edito %}{{ editorial.intro_edito }}{% endif %}</p>
  </div>

  <h2 style="margin-top:0">Comparaison détaillée : {{ prod_a.nom }} vs {{ prod_b.nom }}</h2>

  <!-- TABLEAU COMPARATIF -->
  <div class="comp-block">
    <div class="comp-block-header">
      <div class="col-label">Critère</div>
      <div style="text-align:center">
        <div class="col-brand">{{ prod_a.marque }}</div>
        <div class="col-title">{{ prod_a.nom }}</div>
      </div>
      <div style="text-align:center">
        <div class="col-brand">{{ prod_b.marque }}</div>
        <div class="col-title">{{ prod_b.nom }}</div>
      </div>
    </div>
    <table class="comp">
      <colgroup>
        <col style="width:220px;min-width:90px">
        <col>
        <col>
      </colgroup>
      <tbody>
        {% for crit in criteria %}
        <tr>
          <td class="crit-label">{{ crit.label }}</td>
          {% set val_a = prod_a[crit.field] if crit.field in prod_a else 'N/A' %}
          {% set val_b = prod_b[crit.field] if crit.field in prod_b else 'N/A' %}
          {% if crit.type == 'price' %}
            <td style="text-align:center">{{ val_a }}€</td><td style="text-align:center">{{ val_b }}€</td>
          {% elif crit.type == 'stars' %}
            <td style="text-align:center"><span class="stars">{{ '★' * val_a|int }}{{ '☆' * (5 - val_a|int) }}</span></td>
            <td style="text-align:center"><span class="stars">{{ '★' * val_b|int }}{{ '☆' * (5 - val_b|int) }}</span></td>
          {% elif crit.type == 'tag' %}
            <td style="text-align:center"><span class="tag tag-{{ val_a }}">{{ val_a|capitalize }}</span></td>
            <td style="text-align:center"><span class="tag tag-{{ val_b }}">{{ val_b|capitalize }}</span></td>
          {% elif crit.type == 'bool' %}
            <td style="text-align:center">{{ 'Oui' if val_a else 'Non' }}</td>
            <td style="text-align:center">{{ 'Oui' if val_b else 'Non' }}</td>
          {% else %}
            <td style="text-align:center">{{ val_a }}{{ crit.suffix if crit.suffix is defined else '' }}</td>
            <td style="text-align:center">{{ val_b }}{{ crit.suffix if crit.suffix is defined else '' }}</td>
          {% endif %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- FICHES PRODUITS -->
  {% for prod, idx in [(prod_a, 'a'), (prod_b, 'b')] %}
  <div class="model-card">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--border)">
      <div>
        <h2 style="font-size:26px;font-weight:700;letter-spacing:-.01em;margin-bottom:8px;margin-top:0">
          Notre avis sur {{ prod.nom }}
        </h2>
        <div style="display:flex;align-items:center;gap:8px">
          {% if prod.note_redaction is defined and prod.note_redaction %}
          {% set note = prod.note_redaction | float %}
          <span style="font-size:22px;color:#F5A623;letter-spacing:2px">
            {%- for i in range(5) -%}
              {%- if i < note | int -%}★{%- else -%}☆{%- endif -%}
            {%- endfor -%}
          </span>
          <span style="font-size:15px;font-weight:600;color:var(--ink2)">{{ note }}/5</span>
          {% elif prod.note_confort is defined %}
          <span style="font-size:22px;color:var(--accent)">{{ '★' * prod.note_confort|int }}{{ '☆' * (5 - prod.note_confort|int) }}</span>
          {% endif %}
          {% if prod.note_amazon is defined %}
          <span style="font-size:16px;font-weight:600;color:var(--ink2)" data-note-{{ idx }}>{{ prod.note_amazon }}</span>
          <span style="font-size:14px;color:var(--ink3)">/5</span>
          {% endif %}
        </div>
      </div>
      <div style="text-align:right">
        {% set prix = prod.prix if prod.prix is defined else prod.prix_achat if prod.prix_achat is defined else '' %}
        {% set prix_display = prix | string | replace('.0', '') if prix else '' %}
        <div class="model-price" id="model-price-{{ idx }}">{{ prix_display }}{% if prix_display %}€{% endif %} <span>prix indicatif</span></div>
        <div style="font-size:13px;color:var(--ink3)">
          {% if prod.poids is defined %}{{ prod.poids }} kg{% endif %}
          {% if prod.poids is defined and prod.age is defined %} · {% endif %}
          {% if prod.age is defined %}{{ prod.age }}{% endif %}
        </div>
      </div>
    </div>
    <div class="model-body">
      <div class="model-photo-wrap">
        {% if prod.logo_url is defined and prod.logo_url %}
        <img src="{{ prod.logo_url }}" alt="Logo {{ prod.nom }}" style="width:100%;height:auto;border-radius:12px;object-fit:contain;max-height:160px">
        {% else %}
        <img src="{{ prod.slug }}.png" alt="Logo {{ prod.nom }}"
             style="width:100%;height:auto;border-radius:12px;object-fit:contain;max-height:160px;padding:16px;background:#fff;border:1px solid var(--border)"
             onerror="this.style.display='none';document.getElementById('placeholder-{{ idx }}').style.display='flex'">
        <div class="model-photo-placeholder" id="placeholder-{{ idx }}" style="display:none">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/>
            <path d="M21 15l-5-5L5 21"/>
          </svg>
          <span>{{ prod.nom }}</span>
        </div>
        {% endif %}
        <a href="avis-{{ prod.slug }}.html" style="display:block;margin-top:10px;font-size:13px;color:var(--accent);font-weight:600;text-decoration:underline;text-underline-offset:3px;text-align:center">
          → Notre avis sur {{ prod.nom }}
        </a>
      </div>
      <div class="model-text">{{ prod.description | safe }}</div>
    </div>
    <div class="pros-cons">
      <div class="pros"><h3>✓ Points forts</h3><ul>{% for p in prod.points_forts %}<li>{{ p }}</li>{% endfor %}</ul></div>
      <div class="cons"><h3>✗ Points faibles</h3><ul>{% for p in prod.points_faibles %}<li>{{ p }}</li>{% endfor %}</ul></div>
    </div>
    <div style="margin-top:20px;padding-top:20px;border-top:1px solid var(--border)">
      <a href="{{ prod.url_affiliation if prod.url_affiliation else '#' }}" class="cta-amz cta-amz-primary" rel="nofollow" target="_blank" style="width:100%;justify-content:center">
        {% block cta_label scoped %}→ Voir {{ prod.nom }}{% endblock %}
      </a>
    </div>
  </div>
  {% endfor %}

  <!-- COMPARAISON DÉTAILLÉE, surchargée par chaque template niche -->
  {% block comparaison_detail %}
  <p style="color:var(--ink2);font-size:18px;line-height:1.75">
    Consultez le tableau comparatif ci-dessus pour une analyse complète des deux produits.
  </p>
  {% endblock %}

  <!-- AVIS, surchargé par template niche si nécessaire -->
  {% block section_avis %}
  {% if prod_a.note_amazon is defined or prod_b.note_amazon is defined %}
  <h2>Avis clients : {{ prod_a.nom }} vs {{ prod_b.nom }}</h2>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
    {% for prod, idx in [(prod_a, 'a'), (prod_b, 'b')] %}
    <div class="avis-block">
      <div style="margin-bottom:8px"><span style="font-size:12px;color:var(--ink3);text-transform:uppercase;letter-spacing:.06em">{{ prod.marque }}</span> · {{ prod.nom }}</div>
      {% if prod.note_amazon is defined %}
      <span class="avis-score">{{ prod.note_amazon }}</span>
      <span class="stars" style="font-size:18px">{{ '★' * prod.note_amazon|float|int }}{{ '☆' * (5 - prod.note_amazon|float|int) }}</span>
      <span style="color:var(--ink3);font-size:13px">/5</span>
      {% endif %}
      <p style="font-size:13px;color:var(--ink2);margin-top:10px">
        {% block avis_text scoped %}Les utilisateurs apprécient la qualité et la fiabilité du produit.{% endblock %}
      </p>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% endblock %}

  <!-- FAQ, surchargée par template niche -->
  <h2>Questions fréquentes</h2>
  {% set prix_a = prod_a.prix if prod_a.prix is defined else prod_a.prix_achat if prod_a.prix_achat is defined else '' %}
  {% set prix_b = prod_b.prix if prod_b.prix is defined else prod_b.prix_achat if prod_b.prix_achat is defined else '' %}
  <div class="faq">
    {% block faq_schema %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {"@type":"Question","name":"{{ prod_a.nom }} ou {{ prod_b.nom }} : lequel choisir ?","acceptedAnswer":{"@type":"Answer","text":"Cela dépend de vos priorités. {{ prod_a.nom }} est idéal si {{ prod_a.verdict_si[0]|lower }}. {{ prod_b.nom }} convient mieux si {{ prod_b.verdict_si[0]|lower }}."}},
        {"@type":"Question","name":"Quelle différence entre {{ prod_a.nom }} et {{ prod_b.nom }} ?","acceptedAnswer":{"@type":"Answer","text":"{{ prod_a.nom }} et {{ prod_b.nom }} se distinguent sur plusieurs critères clés. Consultez notre tableau comparatif pour une analyse détaillée."}}
      ]
    }
    </script>
    {% endblock %}
    {% block faq_items %}
    <div class="faq-item">
      <div class="faq-q">{{ prod_a.nom }} ou {{ prod_b.nom }} : lequel choisir ?</div>
      <div class="faq-a"><strong>{{ prod_a.nom }}</strong> est idéal si {{ prod_a.verdict_si[0]|lower }}. <strong>{{ prod_b.nom }}</strong> convient mieux si {{ prod_b.verdict_si[0]|lower }}.</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">Quelle est la différence de prix ?</div>
      <div class="faq-a">
        {% if prix_a and prix_b %}<strong>{{ prod_a.nom }}</strong> à <strong>{{ prix_a }}€</strong> · <strong>{{ prod_b.nom }}</strong> à <strong>{{ prix_b }}€</strong>.
        {% else %}Consultez les prix actuels directement auprès des vendeurs.{% endif %}
      </div>
    </div>
    {% endblock %}
  </div>

  <!-- VERDICT -->
  <div class="verdict">
    <h2>{% block verdict_title %}Que choisir entre {{ prod_a.nom }} et {{ prod_b.nom }} ?{% endblock %}</h2>
    <p style="color:rgba(255,255,255,.7);font-size:18px;line-height:1.75;margin-bottom:16px;text-align:center">
      {% block verdict_subtitle %}Notre verdict basé sur les données et notre analyse comparative.{% endblock %}
    </p>
    <div class="verdict-grid">
      <div class="verdict-box">
        <div>
          <h3>👉 Choisissez {{ prod_a.nom }} si :</h3>
          <ul>{% for si in prod_a.verdict_si %}<li>{{ si }}</li>{% endfor %}</ul>
        </div>
        <div class="verdict-cta">
          <a href="{{ prod_a.url_affiliation if prod_a.url_affiliation else "#" }}" class="cta-amz cta-amz-primary" rel="nofollow" target="_blank" style="width:100%;justify-content:center;font-size:15px">
            {% block verdict_cta_a %}→ Voir {{ prod_a.nom }}{% endblock %}
          </a>
        </div>
      </div>
      <div class="verdict-box">
        <div>
          <h3>👉 Choisissez {{ prod_b.nom }} si :</h3>
          <ul>{% for si in prod_b.verdict_si %}<li>{{ si }}</li>{% endfor %}</ul>
        </div>
        <div class="verdict-cta">
          <a href="{{ prod_b.url_affiliation if prod_b.url_affiliation else "#" }}" class="cta-amz cta-amz-primary" rel="nofollow" target="_blank" style="width:100%;justify-content:center;font-size:15px">
            {% block verdict_cta_b %}→ Voir {{ prod_b.nom }}{% endblock %}
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- MAILLAGE INTERNE -->
  <div style="margin:24px 0 0">
    <h2 style="font-size:32px;font-family:'{{ theme.font_title }}',serif;font-weight:400;letter-spacing:-.01em;margin-bottom:16px">
      Comparatifs similaires
    </h2>
    <div class="rel-grid">
      <!-- Liens vers pages avis -->
      <a href="avis-{{ slug_a }}.html" class="rel-link" style="background:var(--surface2)">📋 Avis complet {{ prod_a.nom }} →</a>
      <a href="avis-{{ slug_b }}.html" class="rel-link" style="background:var(--surface2)">📋 Avis complet {{ prod_b.nom }} →</a>
      {% for rel in related_pages %}
      <a href="{{ rel.url }}" class="rel-link">{{ rel.label }} →</a>
      {% endfor %}
      <a href="comparatifs-scpi.html" class="rel-link">← Comparatifs SCPI</a>
    </div>
  </div>

</main>

<p class="aff-notice" style="margin-top:0">{% block aff_notice %}Ce site peut percevoir une commission sur les achats effectués via les liens présents. Nos recommandations restent indépendantes.{% endblock %}</p>

{% include "base/_footer.html.j2" %}

{% if site.analytics_clicky %}
<script async data-id="{{ site.analytics_clicky }}" src="//static.getclicky.com/js"></script>
{% endif %}
<script>
document.querySelectorAll('.faq-q').forEach(function(q){
  q.addEventListener('click',function(){
    var a=this.nextElementSibling;
    if(a){a.style.display=a.style.display==='block'?'none':'block';}
  });
});
</script>
{% block extra_js %}{% endblock %}
<script>
function toggleMenu(){
  var m=document.getElementById('nav-mobile');
  var b=document.getElementById('burger');
  m.classList.toggle('open');
  b.classList.toggle('open');
}
document.addEventListener('click',function(e){
  var m=document.getElementById('nav-mobile');
  var b=document.getElementById('burger');
  if(m&&b&&!m.contains(e.target)&&!b.contains(e.target)){
    m.classList.remove('open');b.classList.remove('open');
  }
});
</script>
</body>
</html>
