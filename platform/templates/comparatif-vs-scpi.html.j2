    {% if prod_a.frais_souscription is defined and prod_b.frais_souscription is defined %}{"@type":"Question","name":"Quels sont les frais de souscription ?","acceptedAnswer":{"@type":"Answer","text":"{% if prod_a.frais_souscription == 0 %}{{ prod_a.nom }} : 0% (sans frais).{% else %}{{ prod_a.nom }} : {{ prod_a.frais_souscription }}%.{% endif %} {% if prod_b.frais_souscription == 0 %}{{ prod_b.nom }} : 0% (sans frais).{% else %}{{ prod_b.nom }} : {{ prod_b.frais_souscription }}%.{% endif %}"}},{% endif %}
    {"@type":"Question","name":"Peut-on investir en assurance-vie ?","acceptedAnswer":{"@type":"Answer","text":"Cela dépend de votre contrat. Renseignez-vous auprès de votre assureur ou CGP."}},
    {"@type":"Question","name":"Quel est le risque de perte en capital ?","acceptedAnswer":{"@type":"Answer","text":"Comme toute SCPI, {{ prod_a.nom }} et {{ prod_b.nom }} présentent un risque de perte en capital. Les performances passées ne préjugent pas des performances futures."}},
    {"@type":"Question","name":"Le démembrement est-il possible ?","acceptedAnswer":{"@type":"Answer","text":"Le démembrement dépend des conditions proposées par {{ prod_a.marque }} et {{ prod_b.marque }}. Consultez votre CGP pour les modalités."}}
