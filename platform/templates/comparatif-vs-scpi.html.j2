    <strong>{{ prod_b.nom }}</strong> : {% if prod_b.frais_souscription == 0 %}<strong>0%, sans frais</strong>{% else %}<strong>{{ prod_b.frais_souscription }}%</strong>{% endif %}. Horizon recommandé : 8 ans minimum.
