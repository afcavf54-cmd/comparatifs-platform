{% block extra_js %}
{% if (prod_a.geo is defined and prod_b.geo is defined) or (prod_a.secteurs is defined and prod_b.secteurs is defined) %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
(function(){
  var GEO_COLORS=['#185FA5','#378ADD','#85B7EB','#B5D4F4','#E6F1FB','#0C447C'];
  var SEC_COLORS=['#1D9E75','#5DCAA5','#9FE1CB','#3B6D11','#639922','#97C459'];

  function parseData(str){
    if(!str || str === 'None' || str === '') return {labels:[],data:[]};
    // Nettoie les guillemets éventuels
    str = str.replace(/^["']|["']$/g, '').trim();
    var labels=[],data=[];
    str.split(',').forEach(function(s){
      var p=s.trim().split(':');
      if(p.length===2 && p[0].trim() && !isNaN(parseFloat(p[1]))){
        labels.push(p[0].trim());
        data.push(parseFloat(p[1]));
      }
    });
    return {labels:labels,data:data};
  }

  function makeDonut(id,d,colors){
    var el=document.getElementById(id);
    if(!el) return;
    new Chart(el,{
      type:'doughnut',
      data:{
        labels:d.labels,
        datasets:[{data:d.data,backgroundColor:colors.slice(0,d.data.length),borderWidth:2,borderColor:'transparent',hoverOffset:6}]
      },
      options:{
        responsive:true,maintainAspectRatio:true,cutout:'62%',
        plugins:{
          legend:{display:false},
          tooltip:{callbacks:{label:function(c){return ' '+c.label+' : '+c.parsed+'%';}}}
        }
      }
    });
  }

  function makeLegend(id,labels,colors){
    var el=document.getElementById(id);
    if(!el) return;
    labels.forEach(function(l,i){
      var s=document.createElement('span');
      s.style.cssText='display:flex;align-items:center;gap:4px;';
      s.innerHTML='<span style="width:10px;height:10px;border-radius:2px;background:'+colors[i]+'"></span>'+l;
      el.appendChild(s);
    });
  }

  {% if prod_a.geo and prod_b.geo and prod_a.geo != 'None' and prod_b.geo != 'None' %}
  var geoA=parseData('{{ prod_a.geo | replace("'", "\\'") }}');
  var geoB=parseData('{{ prod_b.geo | replace("'", "\\'") }}');
  if(geoA.labels.length > 0 && geoB.labels.length > 0){
    makeDonut('geo-a-{{ slug_a }}',geoA,GEO_COLORS);
    makeDonut('geo-b-{{ slug_b }}',geoB,GEO_COLORS);
    var allGeoLabels=[...new Set([...geoA.labels,...geoB.labels])];
    makeLegend('legend-geo-{{ slug_a }}',allGeoLabels,GEO_COLORS);
  }
  {% endif %}

  {% if prod_a.secteurs and prod_b.secteurs and prod_a.secteurs != 'None' and prod_b.secteurs != 'None' %}
  var secA=parseData('{{ prod_a.secteurs | replace("'", "\\'") }}');
  var secB=parseData('{{ prod_b.secteurs | replace("'", "\\'") }}');
  if(secA.labels.length > 0 && secB.labels.length > 0){
    makeDonut('sec-a-{{ slug_a }}',secA,SEC_COLORS);
    makeDonut('sec-b-{{ slug_b }}',secB,SEC_COLORS);
    var allSecLabels=[...new Set([...secA.labels,...secB.labels])];
    makeLegend('legend-sec-{{ slug_a }}',allSecLabels,SEC_COLORS);
  }
  {% endif %}
})();
</script>
{% endif %}
{% endblock %}
