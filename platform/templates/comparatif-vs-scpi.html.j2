  "mainEntity": [
    {"@type":"Question","name":"{{ prod_a.nom }} ou {{ prod_b.nom }} : laquelle choisir en {{ site.year }} ?","acceptedAnswer":{"@type":"Answer","text":"{{ prod_a.nom }} est recommandée si {{ prod_a.verdict_si[0]|lower }}. {{ prod_b.nom }} convient mieux si {{ prod_b.verdict_si[0]|lower }}. Les deux peuvent être complémentaires dans un portefeuille SCPI diversifié."}},
