<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
{% if site.favicon_file is defined and site.favicon_file %}
<link rel="icon" href="{{ site.favicon_file }}">
{% else %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
{% endif %}
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ post.meta_title or post.title }}</title>
<meta name="description" content="{{ post.meta_description }}">
<link rel="canonical" href="{{ site.domain }}/{{ post.slug }}/">
<meta property="og:title" content="{{ post.meta_title or post.title }}">
<meta property="og:description" content="{{ post.meta_description }}">
<meta property="og:type" content="article">
<meta property="og:url" content="{{ site.domain }}/{{ post.slug }}/">
{% if post.featured_image %}<meta property="og:image" content="{{ site.domain }}{{ post.featured_image }}">{% endif %}
<meta property="article:published_time" content="{{ post.date }}">
{% if post.updated %}<meta property="article:modified_time" content="{{ post.updated }}">{% endif %}
{% if post.categorie %}<meta property="article:section" content="{{ post.categorie }}">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
{% if theme.google_fonts %}<link href="{{ theme.google_fonts }}&v={{ site.slug }}" rel="stylesheet">{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ post.title | tojson }},
  "description": {{ (post.meta_description | default(''))  | tojson }},
  "datePublished": "{{ post.date }}",
  {% if post.updated %}"dateModified": "{{ post.updated }}",{% endif %}
  {% if post.featured_image %}"image": "{{ site.domain }}{{ post.featured_image }}",{% endif %}
  "author": {
    "@type": "Person",
    "name": "{{ site.author_name | default(site.name) }}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.domain }}"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.domain }}/{{ post.slug }}/"
  }
  {% if post.categorie %},"articleSection": {{ post.categorie | tojson }}{% endif %}
}
</script>

{% if post.faq and post.faq | length >= 2 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in post.faq %}
    {
      "@type": "Question",
      "name": {{ item.question | tojson }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ item.answer | tojson }}
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

{% if post.howto_steps and post.howto_steps | length >= 3 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": {{ post.title | tojson }},
  "description": {{ (post.meta_description | default(post.title)) | tojson }},
  {% if post.featured_image %}"image": "{{ site.domain }}{{ post.featured_image }}",{% endif %}
  "step": [
    {% for step in post.howto_steps %}
    {
      "@type": "HowToStep",
      "position": {{ loop.index }},
      "name": {{ step.name | tojson }},
      "text": {{ step.text | tojson }},
      "url": "{{ site.domain }}/{{ post.slug }}/#{{ step.id }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
:root{
  --bg:{{ theme.bg | default('#FAF9F6') }};--surface:{{ theme.surface | default('#fff') }};--surface2:{{ theme.surface2 | default('#F5F3EE') }};
  --ink:{{ theme.ink | default('#0F1419') }};--ink2:{{ theme.ink2 | default('#3D434B') }};--ink3:{{ theme.ink3 | default('#8B9CB0') }};
  --accent:{{ theme.accent | default('#C9A961') }};--accent2:{{ theme.accent2 | default('#1E5F8B') }};--green:{{ theme.green | default('#3D7A4F') }};
  --border:{{ theme.border | default('#E6E1D8') }};--r:8px;--r2:14px;
  {% if theme.cta_color %}--cta:{{ theme.cta_color }};{% endif %}{% if theme.cta_text_color %}--cta-text:{{ theme.cta_text_color }};{% endif %}
}
body{font-family:'{{ theme.font_body }}',system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.65;font-size:16px}
a{color:var(--accent2);text-decoration:none}
a:hover{text-decoration:underline}
.container{max-width:1180px;margin:0 auto;padding:0 5vw}
.article-layout{display:grid;grid-template-columns:1fr 280px;gap:48px;align-items:start}
.article-main{min-width:0;padding-bottom:80px}
.article-sidebar{position:sticky;top:88px}
.sidebar-block{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:20px 22px;margin-bottom:20px}
.sidebar-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--ink3);margin:0 0 14px}
.sidebar-cat-list{list-style:none;margin:0;padding:0}
.sidebar-cat-item{padding:0;margin:0}
.sidebar-cat-link{display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);color:var(--ink2);font-size:14px;text-decoration:none;transition:.15s}
.sidebar-cat-item:last-child .sidebar-cat-link{border-bottom:none}
.sidebar-cat-link:hover{color:var(--accent);text-decoration:none}
.sidebar-cat-link.active{color:var(--accent);font-weight:600}
.sidebar-cat-count{font-size:11px;color:var(--ink3);background:var(--bg);padding:2px 8px;border-radius:10px;flex-shrink:0;margin-left:8px}
.sidebar-cat-link:hover .sidebar-cat-count{color:var(--accent)}
.sidebar-recent-list{list-style:none;margin:0;padding:0}
.sidebar-recent-item{padding:10px 0;border-bottom:1px solid var(--border)}
.sidebar-recent-item:last-child{border-bottom:none}
.sidebar-recent-link{color:var(--ink2);font-size:13px;line-height:1.45;text-decoration:none;display:block}
.sidebar-recent-link:hover{color:var(--accent);text-decoration:none}
.sidebar-recent-cat{font-size:10px;color:var(--ink3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px}
.article-header{padding:23px 0 24px}
.breadcrumb{font-size:13px;color:var(--ink3);margin-bottom:16px}
.breadcrumb a{color:var(--ink3)}
.breadcrumb a:hover{color:var(--accent)}
.article-cat{display:inline-block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--accent);background:var(--surface2);padding:4px 10px;border-radius:20px;text-decoration:none;transition:.15s}
.article-cat:hover{background:var(--accent);color:#fff;text-decoration:none}
.article-title{font-family:'{{ theme.font_title }}',serif;font-size:clamp(28px,5vw,48px);font-weight:400;letter-spacing:-.02em;line-height:1.15;color:var(--ink);margin-bottom:16px}
.article-meta{font-size:14px;color:var(--ink3);margin-bottom:7px;display:flex;flex-wrap:wrap;gap:14px;align-items:center}
.article-meta-item{display:inline-flex;align-items:center;gap:6px}
.article-meta-dot{width:3px;height:3px;border-radius:50%;background:var(--ink3)}
.article-featured{width:100%;border-radius:var(--r2);overflow:hidden;margin-bottom:15px;border:1px solid var(--border)}
.article-featured img{display:block;width:100%;height:auto}
.article-toc{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r2);padding:22px 26px;margin:0 0 40px;position:relative;z-index:0}
.article-toc-title{font-family:'{{ theme.font_title }}',serif;font-size:18px;font-weight:600;color:var(--ink);margin:0 0 14px;letter-spacing:-.01em}
.article-toc-list{list-style:none;padding:0;margin:0;counter-reset:toc}
/* L'incrément du compteur est appliqué UNIQUEMENT sur les items H2 (level-2),
   pas sur les H3 (level-3). Avant : tous les items incrémentaient → si on avait
   un H3 entre deux H2, la numérotation visible sautait (1, 3, 4...) car le H3
   consommait silencieusement le 2 (il affichait ›). Maintenant les H3 ne touchent
   plus au compteur, et les H2 se suivent proprement (1, 2, 3, ...). */
.article-toc-item{position:relative;padding:6px 0 6px 28px;line-height:1.5}
.article-toc-level-2{counter-increment:toc}
.article-toc-level-2::before{content:counter(toc) ".";position:absolute;left:0;top:6px;color:var(--accent);font-weight:600;font-size:14px;width:22px;text-align:right}
.article-toc-level-3{padding-left:48px;font-size:14px}
.article-toc-level-3::before{content:"›";position:absolute;left:24px;top:6px;color:var(--ink2);font-weight:600}
.article-toc-item a{color:var(--ink2);text-decoration:none;font-size:15px;transition:color .15s}
.article-toc-item a:hover{color:var(--accent);text-decoration:underline}
.article-toc-level-3 a{font-size:14px;color:var(--ink2)}
/* Scroll offset pour que les ancres ne soient pas masquées par un éventuel header sticky */
.article-body h2,.article-body h3{scroll-margin-top:80px}
.article-body{font-size:17px;color:var(--ink2);line-height:1.8}
.article-body p{margin-bottom:20px}
.article-body h1{font-family:'{{ theme.font_title }}',serif;font-size:32px;font-weight:400;color:var(--ink);margin:48px 0 16px;letter-spacing:-.02em}
.article-body h2{font-family:'{{ theme.font_title }}',serif;font-size:28px;font-weight:400;color:var(--ink);margin:40px 0 14px;letter-spacing:-.02em}
.article-body h3{font-size:20px;font-weight:600;color:var(--ink);margin:32px 0 12px}
.article-body ul,.article-body ol{margin:0 0 20px 24px}
.article-body li{margin-bottom:8px}
.article-body img{display:block;max-width:100%;height:auto;border-radius:var(--r);margin:24px auto;border:1px solid var(--border)}
.article-body blockquote{border-left:3px solid var(--accent);padding:8px 20px;margin:24px 0;color:var(--ink2);font-style:italic;background:var(--surface2);border-radius:0 var(--r) var(--r) 0}
.article-body code{background:var(--surface2);padding:2px 6px;border-radius:4px;font-size:.92em;font-family:Menlo,Monaco,Consolas,monospace}
.article-body strong{color:var(--ink);font-weight:700}
.article-body a{color:var(--accent2);text-decoration:underline;text-decoration-color:var(--border);text-underline-offset:3px}
.article-body a:hover{text-decoration-color:var(--accent2)}
/* Author box (réutilise le style de classement-saas) */
.author-box{display:flex;align-items:flex-start;gap:24px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:28px;margin:25px 0 0}
.author-avatar{width:72px;height:72px;border-radius:50%;object-fit:cover;flex-shrink:0;border:3px solid var(--border)}
.author-avatar-placeholder{width:72px;height:72px;border-radius:50%;background:var(--bg);border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:28px;flex-shrink:0}
.author-info{flex:1}
.author-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--ink3);margin-bottom:4px}
.author-name{font-family:'{{ theme.font_title }}',serif;font-size:20px;font-weight:400;color:var(--ink);margin-bottom:2px}
.author-job{font-size:13px;color:var(--ink3);margin-bottom:12px}
.author-bio{font-size:14px;color:var(--ink2);line-height:1.7}
@media(max-width:600px){.author-box{flex-direction:column;align-items:center;text-align:center}}
/* Maillage interne */
.related-section{margin:25px 0 0;padding-top:25px;border-top:1px solid var(--border)}
.related-title{font-family:'{{ theme.font_title }}',serif;font-size:24px;font-weight:400;letter-spacing:-.02em;margin-bottom:24px;color:var(--ink)}
.related-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.related-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:20px;text-decoration:none;transition:.15s;display:block}
.related-card:hover{border-color:var(--accent);box-shadow:0 4px 16px rgba(0,0,0,.06);transform:translateY(-1px);text-decoration:none}
.related-card-cat{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--accent);margin-bottom:8px}
.related-card-title{font-size:15px;font-weight:600;color:var(--ink);line-height:1.4;margin-bottom:6px}
.related-card-excerpt{font-size:13px;color:var(--ink3);line-height:1.5}
@media(max-width:600px){.related-grid{grid-template-columns:1fr}}
/* Footer : on n'override PLUS — c'est _footer.html.j2 qui gère son propre CSS */
@media(max-width:960px){
  .article-layout{grid-template-columns:1fr;gap:25px}
  .article-sidebar{position:static}
  /* Sur mobile, la sidebar passe sous le contenu : on retire le padding-bottom
     de article-main qui ne sert plus à rien (l'écart est géré par le gap du
     grid). 80 (padding) + 32 (gap) = 112px → désormais 0 + 25 = 25px. */
  .article-main{padding-bottom:0}
}
@media(max-width:768px){.nav-links,.nav-cta{display:none}.nav-burger{display:flex}}

/* ── PATCH : tableaux du contenu blog ─────────────────────────────
   Ajout chirurgical en toute fin du <style>, après les media queries
   existantes. Aucune modif au CSS au-dessus. */
.article-body .table-wrap{overflow-x:auto;margin:28px 0;border-radius:10px;border:1px solid var(--border);background:var(--surface)}
.article-body table{width:100%;border-collapse:collapse;font-size:15px;background:var(--surface);margin:28px 0;color:var(--ink)}
.article-body .table-wrap > table{margin:0;border:none}
.article-body thead{background:var(--surface2)}
.article-body thead th{text-align:left;padding:14px 18px;font-weight:600;color:var(--ink);font-size:14px;border-bottom:2px solid var(--border);vertical-align:middle;white-space:nowrap}
.article-body thead th:not(:last-child){border-right:1px solid var(--border)}
.article-body tbody td{padding:14px 18px;color:var(--ink);border-bottom:1px solid var(--border);vertical-align:top;line-height:1.5}
.article-body tbody td:not(:last-child){border-right:1px solid var(--border)}
.article-body tbody tr:nth-child(even){background:var(--surface2)}
.article-body tbody tr:hover{background:var(--surface2)}
.article-body tbody tr:last-child td{border-bottom:none}
.article-body table caption{caption-side:top;padding:12px 18px;font-weight:600;color:var(--ink);text-align:left;background:var(--surface2);border-bottom:1px solid var(--border)}
@media (max-width:680px){
  .article-body table{font-size:14px}
  .article-body thead th,.article-body tbody td{padding:10px 12px;white-space:normal}
}
</style>
{% if site.google_site_verification is defined and site.google_site_verification %}
<meta name="google-site-verification" content="{{ site.google_site_verification }}">
{% endif %}
{% if site.analytics_clicky is defined and site.analytics_clicky %}
{% if '<script' in site.analytics_clicky %}
{{ site.analytics_clicky | safe }}
{% else %}
<script async data-id="{{ site.analytics_clicky }}" src="//static.getclicky.com/js"></script>
{% endif %}
{% endif %}
</head>
<body>

{% include 'base/_nav.html.j2' %}

<div class="container">
<article class="article-layout">
  <div class="article-main">
  <header class="article-header">
    <div class="breadcrumb">
      <a href="/">Accueil</a> &rsaquo; <a href="/blog/">Blog</a>
      {% if post.categorie %} &rsaquo; <a href="/{{ post.categorie_slug }}/">{{ post.categorie }}</a>{% endif %}
    </div>
    <h1 class="article-title">{{ post.title }}</h1>
    <div class="article-meta">
      {% if post.categorie %}<a href="/{{ post.categorie_slug }}/" class="article-cat">{{ post.categorie }}</a><span class="article-meta-dot"></span>{% endif %}
      {% if post.date_display %}<span class="article-meta-item">📅 {{ post.date_display }}</span><span class="article-meta-dot"></span>{% endif %}
      {% if post.reading_time %}<span class="article-meta-item">⏱ {{ post.reading_time }} min de lecture</span><span class="article-meta-dot"></span>{% endif %}
      <span class="article-meta-item">✍️ {{ site.author_name | default(site.name) }}</span>
    </div>
  </header>

  {% if post.featured_image %}
  <div class="article-featured">
    <img src="{{ post.featured_image }}" alt="{{ post.title }}" loading="eager">
  </div>
  {% endif %}

  {% if post.toc and post.toc | length > 1 %}
  <nav class="article-toc" aria-label="Sommaire de l'article">
    <div class="article-toc-title">📑 Sommaire</div>
    <ol class="article-toc-list">
      {% for item in post.toc %}
      <li class="article-toc-item article-toc-level-{{ item.level }}">
        <a href="#{{ item.id }}">{{ item.text }}</a>
      </li>
      {% endfor %}
    </ol>
  </nav>
  {% endif %}

  <div class="article-body">
    {{ post.content_html | safe }}
  </div>

  {% if site.author_name is defined and site.author_name %}
  <div class="author-box">
    {% if site.author_photo is defined and site.author_photo %}
    <img src="{{ site.author_photo }}" alt="{{ site.author_name }}" class="author-avatar">
    {% else %}
    <div class="author-avatar-placeholder">👤</div>
    {% endif %}
    <div class="author-info">
      <div class="author-label">Auteur</div>
      <div class="author-name">{{ site.author_name }}</div>
      {% if site.author_job %}<div class="author-job">{{ site.author_job }}</div>{% endif %}
      {% if site.author_bio %}<div class="author-bio">{{ site.author_bio }}</div>{% endif %}
    </div>
  </div>
  {% endif %}

  {% if related_posts %}
  <section class="related-section">
    <h3 class="related-title">À lire aussi</h3>
    <div class="related-grid">
      {% for rp in related_posts %}
      <a href="/{{ rp.slug }}/" class="related-card">
        {% if rp.categorie %}<div class="related-card-cat">{{ rp.categorie }}</div>{% endif %}
        <div class="related-card-title">{{ rp.title }}</div>
        {% if rp.excerpt %}<div class="related-card-excerpt">{{ rp.excerpt }}</div>{% endif %}
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}
  </div><!-- /.article-main -->

  <aside class="article-sidebar">
    {% if blog_categories and blog_categories | length > 0 %}
    <div class="sidebar-block">
      <h3 class="sidebar-title">Catégories</h3>
      <ul class="sidebar-cat-list">
        <li class="sidebar-cat-item">
          <a href="/blog/" class="sidebar-cat-link">
            <span>Tous les articles</span>
            <span class="sidebar-cat-count">{{ all_posts | length }}</span>
          </a>
        </li>
        {% for cat in blog_categories %}
        <li class="sidebar-cat-item">
          <a href="/{{ cat.slug }}/" class="sidebar-cat-link{% if post.categorie and cat.name == post.categorie %} active{% endif %}">
            <span>{{ cat.name }}</span>
            <span class="sidebar-cat-count">{{ cat.count }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if all_posts and all_posts | length > 1 %}
    <div class="sidebar-block">
      <h3 class="sidebar-title">Articles récents</h3>
      <ul class="sidebar-recent-list">
        {% for rp in all_posts[:5] %}
        {% if rp.slug != post.slug %}
        <li class="sidebar-recent-item">
          <a href="/{{ rp.slug }}/" class="sidebar-recent-link">
            {% if rp.categorie %}<div class="sidebar-recent-cat">{{ rp.categorie }}</div>{% endif %}
            {{ rp.title }}
          </a>
        </li>
        {% endif %}
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </aside>
</article>
</div>

{% include 'base/_footer.html.j2' ignore missing %}

</body>
</html>
