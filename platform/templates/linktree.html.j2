<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set lt = site.linktree %}
<title>{{ lt.title | default('Bons plans') }} — {{ site.name }}</title>
<meta name="description" content="{{ lt.subtitle | default('Mes codes promo et parrainages.') }}">
<link rel="canonical" href="{{ site.domain }}/bons-plans/">
<meta property="og:title" content="{{ lt.title | default('Bons plans') }} — {{ site.name }}">
<meta property="og:description" content="{{ lt.subtitle | default('') }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.domain }}/bons-plans/">
{% if site.favicon_file is defined and site.favicon_file %}<link rel="icon" href="{{ site.favicon_file }}" type="image/png">{% else %}<link rel="icon" href="/favicon.png" type="image/png">{% endif %}
{% if theme.google_fonts %}<link href="{{ theme.google_fonts }}" rel="stylesheet">{% endif %}
{% if site.analytics_clicky is defined and site.analytics_clicky %}{% if '<script' in site.analytics_clicky %}{{ site.analytics_clicky | safe }}{% else %}<script async data-id="{{ site.analytics_clicky }}" src="//static.getclicky.com/js"></script>{% endif %}{% endif %}
<style>
  :root{
    --ink:{{ theme.ink | default('#000921') }};
    --cta:{{ theme.cta_color | default('#E8410A') }};
    --bg:#f4f5f8; --card:#fff; --muted:#5b6478; --faint:#8a95a8; --line:rgba(0,9,33,.10);
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);
    font-family:{{ theme.font_body | default('"Hanken Grotesk",system-ui,sans-serif') }};-webkit-font-smoothing:antialiased}
  .wrap{max-width:600px;margin:0 auto;padding:44px 18px 60px}
  .head{text-align:center;margin-bottom:30px}
  .avatar{width:96px;height:96px;border-radius:50%;object-fit:cover;margin:0 auto 18px;display:block;box-shadow:0 8px 30px rgba(0,9,33,.18)}
  .avatar-fallback{width:96px;height:96px;border-radius:50%;margin:0 auto 18px;display:flex;align-items:center;justify-content:center;background:var(--ink);color:#fff;font-size:38px;box-shadow:0 8px 30px rgba(0,9,33,.18)}
  h1{font-family:{{ theme.font_heading | default('"Spline Sans","Hanken Grotesk",sans-serif') }};font-size:27px;font-weight:800;margin:0 0 8px;letter-spacing:-.5px}
  .subtitle{color:var(--muted);font-size:15px;margin:0 auto;max-width:400px;line-height:1.5}
  /* Socials */
  .socials{display:flex;justify-content:center;gap:14px;margin:22px 0 8px}
  .socials a{width:46px;height:46px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:var(--card);box-shadow:0 3px 12px rgba(0,9,33,.10);transition:transform .15s,box-shadow .15s}
  .socials a:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(0,9,33,.18)}
  .socials svg{width:22px;height:22px;display:block}
  /* Catégories */
  .cat-label{text-align:center;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--faint);margin:34px 0 14px}
  /* Cartes */
  .card{background:var(--card);border-radius:16px;padding:18px;margin-bottom:14px;box-shadow:0 2px 10px rgba(0,9,33,.05);display:flex;align-items:center;gap:16px}
  .logo{width:58px;height:58px;border-radius:12px;object-fit:cover;flex:none;background:#f0f1f5}
  .logo-fallback{width:58px;height:58px;border-radius:12px;flex:none;display:flex;align-items:center;justify-content:center;color:#fff;font-size:24px;font-weight:800}
  .card-body{flex:1;min-width:0}
  .card-name{font-weight:800;font-size:16px;margin:0 0 3px}
  .card-desc{color:var(--muted);font-size:13.5px;margin:0 0 8px;line-height:1.4}
  .code-row{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--faint)}
  .code-chip{display:inline-flex;align-items:center;gap:6px;border:1px dashed currentColor;border-radius:7px;padding:4px 9px;font-weight:800;font-size:12.5px;cursor:pointer;background:none;font-family:inherit}
  .code-chip svg{width:13px;height:13px}
  .card-cta{flex:none}
  .btn-offer{display:inline-flex;align-items:center;gap:6px;padding:11px 18px;border-radius:10px;color:#fff;font-weight:800;font-size:13px;text-decoration:none;white-space:nowrap;transition:filter .15s}
  .btn-offer:hover{filter:brightness(1.08)}
  .foot{margin-top:38px;text-align:center;color:var(--faint);font-size:12.5px;line-height:1.6;border-top:1px solid var(--line);padding-top:24px}
  .foot a{color:var(--muted)}
  .toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(20px);background:var(--ink);color:#fff;padding:11px 20px;border-radius:10px;font-size:13px;font-weight:600;opacity:0;pointer-events:none;transition:.25s;z-index:99}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
  @media(max-width:520px){
    .card{flex-wrap:wrap}
    .card-cta{width:100%}
    .btn-offer{width:100%;justify-content:center}
  }
</style>
</head>
<body>
<div class="wrap">

  <div class="head">
    {% if site.logo_avatar is defined and site.logo_avatar %}<img class="avatar" src="{{ site.logo_avatar }}" alt="{{ site.name }}">
    {% elif site.favicon_file is defined and site.favicon_file %}<img class="avatar" src="{{ site.favicon_file }}" alt="{{ site.name }}">
    {% else %}<div class="avatar-fallback">🧪</div>{% endif %}
    <h1>{{ lt.title | default('Mes codes promo & parrainages') }}</h1>
    <p class="subtitle">{{ lt.subtitle | default('') }}</p>

    <div class="socials">
      {% set soc = lt.socials | default({}) %}
      {% if soc.youtube %}<a href="{{ soc.youtube }}" target="_blank" rel="noopener nofollow" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="#FF0000"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.5 15.5v-7l6.3 3.5-6.3 3.5z"/></svg></a>{% endif %}
      {% if soc.instagram %}<a href="{{ soc.instagram }}" target="_blank" rel="noopener nofollow" aria-label="Instagram"><svg viewBox="0 0 24 24"><defs><linearGradient id="ig" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#FEDA75"/><stop offset=".3" stop-color="#FA7E1E"/><stop offset=".6" stop-color="#D62976"/><stop offset="1" stop-color="#962FBF"/></linearGradient></defs><path fill="url(#ig)" d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .4 1.4.9.5.4.7.8.9 1.4.1.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.4 1-.9 1.4-.4.5-.8.7-1.4.9-.4.1-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.4-1.4-.9-.5-.4-.7-.8-.9-1.4-.1-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.4-1 .9-1.4.4-.5.8-.7 1.4-.9.4-.1 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.1A6.7 6.7 0 1 0 18.7 12 6.7 6.7 0 0 0 12 5.3zm0 11A4.3 4.3 0 1 1 16.3 12 4.3 4.3 0 0 1 12 16.3zm6.9-11.3a1.6 1.6 0 1 0 0 3.1 1.6 1.6 0 0 0 0-3.1z"/></svg></a>{% endif %}
      {% if soc.tiktok %}<a href="{{ soc.tiktok }}" target="_blank" rel="noopener nofollow" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M16.6 5.8a4.3 4.3 0 0 1-1-2.8h-3.1v12.4a2.5 2.5 0 1 1-1.8-2.4V7.8a5.6 5.6 0 1 0 4.9 5.5V8.7a7.3 7.3 0 0 0 4.3 1.4V7a4.3 4.3 0 0 1-2.3-1.2z"/></svg></a>{% endif %}
    </div>
  </div>

  {% for cat in lt.categories | default([]) %}
  {% if cat.name %}<div class="cat-label">{{ cat.name }}</div>{% endif %}
  {% for it in cat['items'] | default([]) %}
  {% set acc = it.color | default(theme.cta_color) | default('#E8410A') %}
  <div class="card">
    {% if it.logo %}<img class="logo" src="{{ it.logo }}" alt="{{ it.name }}">
    {% else %}<div class="logo-fallback" style="background:{{ acc }}">{{ it.name[:1] | upper }}</div>{% endif %}
    <div class="card-body">
      <div class="card-name" style="color:{{ acc }}">{{ it.name }}</div>
      {% if it.desc %}<div class="card-desc">{{ it.desc }}</div>{% endif %}
      {% if it.code %}
      <div class="code-row">MON CODE :
        <button class="code-chip" style="color:{{ acc }}" data-code="{{ it.code }}" onclick="copyCode(this)">{{ it.code }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
        </button>
      </div>
      {% endif %}
    </div>
    {% if it.url %}
    <div class="card-cta">
      <a class="btn-offer" style="background:{{ acc }}" href="{{ it.url }}" target="_blank" rel="noopener nofollow sponsored">VOIR L'OFFRE ›</a>
    </div>
    {% endif %}
  </div>
  {% endfor %}
  {% endfor %}

  <div class="foot">
    {{ lt.disclaimer | default("Certains liens de cette page sont des liens affiliés ou de parrainage. Ils ne changent rien aux conditions dont vous bénéficiez. Les offres évoluent régulièrement : le détail des conditions est à consulter sur les sites officiels.") }}
    <div style="margin-top:14px"><a href="/">← Retour sur {{ site.name }}</a></div>
  </div>

</div>

<div class="toast" id="toast">Code copié ✓</div>
<script>
function copyCode(el){
  var code = el.getAttribute('data-code');
  var done = function(){ var t=document.getElementById('toast'); t.classList.add('show'); clearTimeout(t._t); t._t=setTimeout(function(){t.classList.remove('show')},1800); };
  if(navigator.clipboard){ navigator.clipboard.writeText(code).then(done).catch(done); } else { done(); }
}
</script>
</body>
</html>
