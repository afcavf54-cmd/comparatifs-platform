<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
{% if site.favicon_file is defined and site.favicon_file %}
<link rel="icon" href="{{ site.favicon_file }}">
{% else %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
{% endif %}
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact | {{ site.name }}</title>
<meta name="description" content="Contactez {{ site.name }} pour toute question ou suggestion.">
<link rel="canonical" href="{{ site.domain }}/contact">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="{{ theme.google_fonts }}&v={{ site.slug }}" rel="stylesheet">
<style>
:root{
  --bg:{{ theme.bg }};
  --surface:#fff;
  --ink:{{ theme.ink }};
  --ink2:#6B6560;
  --ink3:#A09890;
  --accent:{{ theme.accent }};
  --accent2:{{ theme.accent2 }};
  --cta:{{ theme.cta_color if theme.cta_color is defined and theme.cta_color else "#F59E0B" }};
  --cta-text:{{ theme.cta_text_color if theme.cta_text_color is defined and theme.cta_text_color else "#ffffff" }};
  --border:#E2DDD6;
  --r:12px;
  --r2:20px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'{{ theme.font_body }}',sans-serif;background:var(--bg);color:var(--ink);font-size:16px;line-height:1.75}
a{color:var(--accent);text-decoration:none}
nav{background:var(--ink);padding:0 5vw;display:flex;align-items:center;height:64px;position:sticky;top:0;z-index:100}
.nav-inner{max-width:1200px;width:100%;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px;position:relative}
.nav-logo{font-family:'{{ theme.font_title }}',serif;font-weight:400;font-size:17px;color:#fff;flex-shrink:0}.nav-logo span{color:var(--accent2)}
.nav-links{display:flex;align-items:center;gap:4px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:30px;padding:4px 8px;position:absolute;left:50%;transform:translateX(-50%)}
.nav-links a{color:rgba(255,255,255,.65);font-size:13px;font-weight:500;padding:6px 14px;border-radius:24px;transition:.15s}
.nav-links a:hover{color:#fff;background:rgba(255,255,255,.1)}
.nav-cta{display:inline-flex;align-items:center;gap:6px;padding:8px 18px;border-radius:24px;background:var(--cta);color:var(--cta-text);font-size:13px;font-weight:700;transition:.15s;flex-shrink:0}
.nav-cta:hover{opacity:.88}
.nav-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;background:none;border:none}
.nav-burger span{display:block;width:22px;height:2px;background:#fff;border-radius:2px}
.nav-mobile{display:none;position:absolute;top:64px;left:0;right:0;background:var(--ink);border-top:1px solid rgba(255,255,255,.08);padding:16px 5vw;flex-direction:column;gap:4px;z-index:99}
.nav-mobile.open{display:flex}
.nav-mobile a{color:rgba(255,255,255,.75);font-size:15px;padding:12px 16px;border-radius:10px;transition:.15s}
main{max-width:1200px;margin:0 auto;padding:48px 5vw 80px}
h1{font-family:'{{ theme.font_title }}',serif;font-size:clamp(32px,4vw,48px);font-weight:400;letter-spacing:-.02em;margin-bottom:12px}
.subtitle{font-size:16px;color:var(--ink2);margin-bottom:48px}
.contact-block{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:32px;margin-bottom:24px}
.contact-block h2{font-family:'{{ theme.font_title }}',serif;font-size:20px;font-weight:400;margin-bottom:16px;color:var(--ink)}
.contact-block p{color:var(--ink2);font-size:15px;margin-bottom:8px}
.contact-block a{color:var(--accent);font-weight:600}
/* Formulaire */
.contact-form{display:flex;flex-direction:column;gap:18px}
.contact-row{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.contact-field{display:flex;flex-direction:column;gap:6px}
.contact-field label{font-size:13px;font-weight:600;color:var(--ink);text-transform:uppercase;letter-spacing:.04em}
.contact-field input,.contact-field select,.contact-field textarea{padding:12px 14px;border:1px solid var(--border);border-radius:var(--r);background:#fff;color:var(--ink);font-family:inherit;font-size:15px;line-height:1.5;outline:none;transition:border-color .15s}
.contact-field input:focus,.contact-field select:focus,.contact-field textarea:focus{border-color:var(--accent)}
.contact-field textarea{min-height:140px;resize:vertical}
.contact-field-hint{font-size:12px;color:var(--ink3);margin-top:2px}
.contact-submit{padding:14px 28px;border-radius:var(--r);background:var(--cta);color:var(--cta-text);font-size:15px;font-weight:700;border:none;cursor:pointer;transition:.15s;align-self:flex-start}
.contact-submit:hover{opacity:.88}
.contact-submit:disabled{opacity:.5;cursor:not-allowed}
.contact-status{padding:14px 18px;border-radius:var(--r);font-size:14px;font-weight:500;display:none}
.contact-status.success{background:rgba(34,197,94,.08);border:1px solid #22c55e;color:#15803d;display:block}
.contact-status.error{background:rgba(239,68,68,.08);border:1px solid #ef4444;color:#b91c1c;display:block}
.contact-honeypot{position:absolute;left:-9999px;opacity:0;pointer-events:none}
@media(max-width:768px){.nav-links,.nav-cta{display:none}.nav-burger{display:flex}.contact-row{grid-template-columns:1fr}}
</style>
{% if site.analytics_clicky is defined and site.analytics_clicky %}
{% if '<script' in site.analytics_clicky %}
{{ site.analytics_clicky | safe }}
{% else %}
<script async data-id="{{ site.analytics_clicky }}" src="//static.getclicky.com/js"></script>
{% endif %}
{% endif %}
</head>
<body>

{% include 'base/_nav.html.j2' %}

<main>
  <h1>Nous contacter</h1>
  <p class="subtitle">Une question, une suggestion ou un partenariat ? Écrivez-nous.</p>

  {% if site.contact_form_key is defined and site.contact_form_key %}
  {# Formulaire de contact via Web3Forms (clé requise dans config.yaml) #}
  <div class="contact-block">
    <h2>✉️ Nous écrire</h2>
    <p style="margin-bottom:24px">Remplissez ce formulaire, nous vous répondrons sous 24 à 48h ouvrées.</p>

    <form class="contact-form" id="contact-form" novalidate>
      <input type="hidden" name="access_key" value="{{ site.contact_form_key }}">
      <input type="hidden" name="from_name" value="{{ site.name }}">
      <input type="hidden" name="redirect" value="false">
      <input type="hidden" name="subject" id="contact-subject" value="{{ site.name }} - Nouveau message">

      <div class="contact-row">
        <div class="contact-field">
          <label for="contact-name">Nom & Prénom *</label>
          <input type="text" id="contact-name" name="name" required autocomplete="name" placeholder="Jean Dupont">
        </div>
        <div class="contact-field">
          <label for="contact-email">Email *</label>
          <input type="email" id="contact-email" name="email" required autocomplete="email" placeholder="jean@exemple.com">
        </div>
      </div>

      <div class="contact-field">
        <label for="contact-objet">Objet *</label>
        <select id="contact-objet" name="objet" required>
          <option value="">— Choisissez —</option>
          <option value="Question générale">Question générale</option>
          <option value="Partenariat">Partenariat</option>
          <option value="Signalement d'erreur">Signalement d'erreur</option>
          <option value="Suggestion d'article">Suggestion d'article</option>
          <option value="Autre">Autre</option>
        </select>
      </div>

      <div class="contact-field">
        <label for="contact-message">Votre message *</label>
        <textarea id="contact-message" name="message" required placeholder="Détaillez votre demande…"></textarea>
      </div>

      <div class="contact-field">
        <label for="contact-captcha">Question anti-spam : combien font <strong id="captcha-q">3 + 4</strong> ? *</label>
        <input type="text" id="contact-captcha" name="captcha_answer" required autocomplete="off" inputmode="numeric" style="max-width:120px">
        <div class="contact-field-hint">Une simple addition pour prouver que vous êtes humain.</div>
      </div>

      {# Honeypot pour les bots — champ caché, doit rester vide #}
      <div class="contact-honeypot" aria-hidden="true">
        <input type="text" name="botcheck" tabindex="-1" autocomplete="off">
      </div>

      <button type="submit" class="contact-submit" id="contact-submit">Envoyer le message</button>
      <div class="contact-status" id="contact-status" role="status" aria-live="polite"></div>
    </form>
  </div>

  <script>
  (function() {
    var form = document.getElementById('contact-form');
    var statusBox = document.getElementById('contact-status');
    var submitBtn = document.getElementById('contact-submit');
    // Question anti-spam aléatoire (entre 2 et 9, addition simple)
    var a = Math.floor(Math.random() * 7) + 2;
    var b = Math.floor(Math.random() * 7) + 2;
    var expected = a + b;
    document.getElementById('captcha-q').textContent = a + ' + ' + b;

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      statusBox.className = 'contact-status';
      statusBox.textContent = '';

      // Vérif anti-spam côté client
      var captchaInput = document.getElementById('contact-captcha').value.trim();
      if (parseInt(captchaInput, 10) !== expected) {
        statusBox.className = 'contact-status error';
        statusBox.textContent = '✗ La réponse à la question anti-spam est incorrecte.';
        return;
      }
      // Honeypot : si rempli, on bloque silencieusement (bot)
      if (form.querySelector('input[name="botcheck"]').value !== '') {
        statusBox.className = 'contact-status success';
        statusBox.textContent = '✓ Message envoyé. Nous vous répondrons rapidement.';
        form.reset();
        return;
      }

      // Met à jour le sujet avec l'objet choisi : "<site> - <objet>"
      var objet = document.getElementById('contact-objet').value || 'Message';
      document.getElementById('contact-subject').value = '{{ site.name }} - ' + objet;

      submitBtn.disabled = true;
      submitBtn.textContent = '⏳ Envoi en cours…';
      try {
        var formData = new FormData(form);
        var resp = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
        });
        var data = await resp.json();
        if (resp.ok && data.success) {
          statusBox.className = 'contact-status success';
          statusBox.textContent = '✓ Message envoyé. Nous vous répondrons rapidement.';
          form.reset();
          // Re-génère une nouvelle question anti-spam
          a = Math.floor(Math.random() * 7) + 2;
          b = Math.floor(Math.random() * 7) + 2;
          expected = a + b;
          document.getElementById('captcha-q').textContent = a + ' + ' + b;
        } else {
          statusBox.className = 'contact-status error';
          statusBox.textContent = '✗ Erreur d\u0027envoi : ' + (data.message || 'merci de réessayer');
        }
      } catch (err) {
        statusBox.className = 'contact-status error';
        statusBox.textContent = '✗ Erreur réseau : merci de réessayer.';
      }
      submitBtn.disabled = false;
      submitBtn.textContent = 'Envoyer le message';
    });
  })();
  </script>
  {% else %}
  {# Fallback : pas de clé Web3Forms configurée → on retombe sur l'email simple #}
  <div class="contact-block">
    <h2>📧 Par email</h2>
    <p>Pour toute demande générale, partenariat ou signalement d'erreur :</p>
    <p><a href="mailto:contact@{{ site.domain | replace('https://www.', '') | replace('https://', '') | replace('http://', '') | replace('/', '') }}">contact@{{ site.domain | replace('https://www.', '') | replace('https://', '') | replace('http://', '') | replace('/', '') }}</a></p>
  </div>
  {% endif %}

  <div class="contact-block">
    <h2>⏱️ Délai de réponse</h2>
    <p>Nous répondons généralement sous 24 à 48h ouvrées.</p>
  </div>

  <div class="contact-block">
    <h2>🔗 Liens utiles</h2>
    <p><a href="/mentions-legales">Mentions légales</a></p>
    <p><a href="/politique-confidentialite">Politique de confidentialité</a></p>
  </div>
</main>

{% include "base/_footer.html.j2" %}


</body>
</html>
