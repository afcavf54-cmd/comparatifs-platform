<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if home_title is defined and home_title %}{{ home_title }}{% else %}Comparatif SCPI {{ site.year }}, Trouvez la meilleure SCPI | {{ site.name }}{% endif %}</title>
<meta name="description" content="Comparez les meilleures SCPI {{ site.year }} : taux de distribution, frais, TRI, TOF. Outil de comparaison gratuit pour trouver la SCPI adaptée à votre profil d'investisseur.">
<link rel="canonical" href="{{ site.domain }}/index">
<meta property="og:title" content="Comparatif SCPI {{ site.year }}, {{ site.name }}">
<meta property="og:description" content="Comparez les SCPI sur tous les critères : TD, TRI, frais, TOF, délai de jouissance.">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.domain }}/index">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="{{ theme.google_fonts }}" rel="stylesheet">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "{{ site.name }}",
  "url": "{{ site.domain }}/index",
  "description": "Comparatif des meilleures SCPI {{ site.year }}, taux de distribution, frais, TRI, TOF",
  "publisher": {
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.domain }}"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Meilleures SCPI {{ site.year }}",
  "itemListElement": [
    {% for prod in products %}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "name": "{{ prod.nom }}",
      "description": "SCPI {{ prod.type }}, TD {{ prod.td }}%{% if prod.frais_souscription == 0 %}, 0% de frais{% endif %}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
<style>
:root{
  --bg:{{ theme.bg }};
  --surface:#FFFFFF;
  --surface2:#EEF2FF;
  --ink:{{ theme.ink }};
  --ink2:#4A5568;
  --ink3:#718096;
  --accent:{{ theme.accent }};
  --accent2:{{ theme.accent2 }};
  --border:#E2E8F0;
  --green:#1A7A4A;
  --r:12px;
  --r2:20px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'{{ theme.font_body }}',sans-serif;background:var(--bg);color:var(--ink);font-size:16px;line-height:1.7}
a{color:inherit;text-decoration:none}

/* NAV */
nav{background:var(--ink);padding:0 5vw;display:flex;flex-direction:column;position:sticky;top:0;z-index:100}
.nav-inner{max-width:1200px;width:100%;margin:0 auto;display:flex;align-items:center;justify-content:space-between;height:64px;gap:16px}
.nav-logo{font-family:'{{ theme.font_title }}',serif;font-weight:400;font-size:17px;color:#fff;flex-shrink:0}.nav-logo span{color:var(--accent2)}
.nav-links{display:flex;align-items:center;gap:4px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:30px;padding:4px 8px}
.nav-links a{color:rgba(255,255,255,.65);font-size:13px;font-weight:500;padding:6px 14px;border-radius:24px;transition:.15s}
.nav-links a:hover,.nav-links a.active{color:#fff;background:rgba(255,255,255,.1)}
.nav-cta{display:inline-flex;align-items:center;gap:6px;padding:8px 18px;border-radius:24px;background:var(--accent2);color:#fff;font-size:13px;font-weight:700;transition:.15s;flex-shrink:0}
.nav-cta:hover{opacity:.88}
.nav-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;background:none;border:none}
.nav-burger span{display:block;width:22px;height:2px;background:#fff;border-radius:2px;transition:.25s}
.nav-burger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.nav-burger.open span:nth-child(2){opacity:0}
.nav-burger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
.nav-mobile{display:none;position:absolute;top:64px;left:0;right:0;background:var(--ink);border-top:1px solid rgba(255,255,255,.08);padding:16px 5vw;flex-direction:column;gap:4px;z-index:99}
.nav-mobile.open{display:flex}
.nav-mobile a{color:rgba(255,255,255,.75);font-size:15px;font-weight:500;padding:12px 16px;border-radius:10px;transition:.15s}
.nav-mobile a:hover,.nav-mobile a.active{color:#fff;background:rgba(255,255,255,.08)}
.nav-mobile .nav-cta{margin-top:8px;justify-content:center;border-radius:12px}

/* HERO */
.hero{background:var(--ink);padding:72px 5vw 0;text-align:center;position:relative;overflow:hidden}
.hero::after{content:'';position:absolute;bottom:0;left:0;right:0;height:60px;background:var(--bg);border-radius:40px 40px 0 0}
.hero-eyebrow{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.1);color:rgba(255,255,255,.8);font-size:12px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;padding:5px 14px;border-radius:20px;margin-bottom:20px;border:1px solid rgba(255,255,255,.15)}
.hero h1{font-family:'{{ theme.font_title }}',serif;font-size:clamp(36px,5vw,64px);font-weight:400;line-height:1.06;letter-spacing:-.025em;color:#fff;margin-bottom:20px}
.hero h1 em{font-style:italic;color:var(--accent2)}
.hero-sub{font-size:18px;color:rgba(255,255,255,.65);max-width:580px;margin:0 auto 48px;line-height:1.7}
.hero-stats{display:flex;justify-content:center;gap:40px;margin-bottom:64px;flex-wrap:wrap}
.hero-stat{text-align:center}
.hero-stat-val{font-size:28px;font-weight:700;color:#fff;font-family:'{{ theme.font_title }}',serif}
.hero-stat-label{font-size:12px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.05em;margin-top:2px}

/* COMPARATEUR */
.comparator{max-width:1100px;margin:-10px auto 0;padding:0 5vw;position:relative;z-index:2}
.comp-card{background:var(--surface);border-radius:24px;box-shadow:0 8px 40px rgba(0,0,0,.12);overflow:hidden}
.comp-header{background:var(--ink);padding:20px 28px;display:flex;align-items:center;justify-content:space-between}
.comp-header-title{font-family:'{{ theme.font_title }}',serif;font-size:18px;color:#fff;font-weight:400}
.comp-header-badge{background:var(--accent);color:#fff;font-size:11px;font-weight:600;padding:4px 10px;border-radius:10px;letter-spacing:.04em}
.comp-body{padding:28px}
.comp-selects{display:grid;grid-template-columns:1fr auto 1fr;gap:16px;align-items:center;margin-bottom:20px}
.comp-vs{font-family:'{{ theme.font_title }}',serif;font-size:22px;color:var(--accent);font-weight:400;text-align:center}
.select-wrap{display:flex;flex-direction:column;gap:6px}
.select-label{font-size:11px;font-weight:600;color:var(--ink3);text-transform:uppercase;letter-spacing:.05em}
select.comp-select{width:100%;padding:12px 16px;border:1.5px solid var(--border);border-radius:var(--r);font-size:15px;font-family:'{{ theme.font_body }}',sans-serif;background:var(--surface);color:var(--ink);appearance:none;background-image:url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 7L11 1' stroke='%23718096' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E");background-repeat:no-repeat;background-position:right 14px center;cursor:pointer;transition:.15s}
select.comp-select:hover{border-color:var(--accent)}
select.comp-select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(27,79,216,.1)}
.comp-preview{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px}
.comp-preview-card{background:var(--surface2);border-radius:var(--r);padding:14px 16px;min-height:80px}
.cpcard-name{font-size:14px;font-weight:600;margin-bottom:8px;color:var(--ink)}
.cpcard-stats{display:flex;flex-wrap:wrap;gap:8px}
.cpcard-stat{font-size:12px;background:var(--surface);padding:3px 9px;border-radius:6px;border:0.5px solid var(--border);color:var(--ink2)}
.cpcard-stat strong{color:var(--accent);font-weight:700}
.comp-cta{width:100%;padding:15px;background:var(--accent);color:#fff;border:none;border-radius:var(--r);font-size:16px;font-weight:600;cursor:pointer;transition:.15s;font-family:'{{ theme.font_body }}',sans-serif;display:flex;align-items:center;justify-content:center;gap:8px}
.comp-cta:hover{background:var(--accent2)}
.comp-cta:disabled{background:var(--border);color:var(--ink3);cursor:not-allowed}

/* MAIN */
main{max-width:1200px;margin:0 auto;padding:64px 5vw}
h2.section-title{font-family:'{{ theme.font_title }}',serif;font-size:36px;font-weight:400;letter-spacing:-.02em;margin-bottom:8px}
.section-sub{font-size:16px;color:var(--ink3);margin-bottom:32px}

/* FILTRES */
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px}
.filter-btn{padding:7px 16px;border-radius:20px;font-size:13px;font-weight:500;cursor:pointer;border:1.5px solid var(--border);background:var(--surface);color:var(--ink2);transition:.15s}
.filter-btn:hover{border-color:var(--accent);color:var(--accent)}
.filter-btn.active{background:var(--accent);color:#fff;border-color:var(--accent)}

/* GRILLE SCPI */
.scpi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px}
.scpi-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:20px;transition:.2s;cursor:pointer}
.scpi-card:hover{border-color:var(--accent);transform:translateY(-2px)}
.scpi-card-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px}
.scpi-card-top-left{display:flex;align-items:center;gap:12px}
.scpi-card-logo{width:44px;height:44px;border-radius:8px;border:1px solid var(--border);background:#fff;padding:4px;object-fit:contain;flex-shrink:0}
.scpi-name{font-family:'{{ theme.font_title }}',serif;font-size:24px;font-weight:400;margin-bottom:2px}
.scpi-manager{font-size:14px;color:var(--ink3);text-transform:uppercase;letter-spacing:.05em}
.scpi-tag{display:inline-block;padding:3px 9px;border-radius:6px;font-size:11px;font-weight:600}
.tag-rendement{background:#EAF3DE;color:#27500A}
.tag-diversifiee{background:#E6F1FB;color:#0C447C}
.tag-specialisee{background:#FAEEDA;color:#633806}
.tag-europeenne{background:#F5E6FB;color:#5B2185}
.scpi-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}
.scpi-metric{background:var(--bg);border-radius:8px;padding:10px 12px;text-align:center}
.scpi-metric-val{font-size:24px;font-weight:700;color:var(--ink);line-height:1}
.scpi-metric-val.accent{color:var(--accent)}
.scpi-metric-label{font-size:12px;color:var(--ink3);margin-top:3px;text-transform:uppercase;letter-spacing:.04em}
.scpi-badges{display:flex;gap:6px;flex-wrap:wrap}
.badge-zero{background:#EAF3DE;color:#27500A;font-size:12px;font-weight:600;padding:3px 8px;border-radius:5px}
.badge-info{background:var(--surface2);color:var(--accent);font-size:12px;font-weight:500;padding:3px 8px;border-radius:5px}
.scpi-card-links{display:flex;gap:8px;margin-top:14px;padding-top:14px;border-top:0.5px solid var(--border)}
.scpi-link{flex:1;padding:10px;text-align:center;border-radius:8px;font-size:15px;font-weight:600;transition:.15s}
.scpi-link-primary{background:var(--accent);color:#fff}.scpi-link-primary:hover{background:var(--accent2)}
.scpi-link-secondary{background:var(--surface2);color:var(--accent)}.scpi-link-secondary:hover{background:var(--border)}

/* TOP COMPARATIFS */
.comparatifs-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px;margin-top:20px}
.comp-link{display:flex;align-items:center;justify-content:space-between;background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:14px 18px;font-size:14px;font-weight:500;transition:.15s}
.comp-link:hover{border-color:var(--accent);color:var(--accent)}
.comp-link-arrow{color:var(--accent);font-size:18px}

/* WHY */
.why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:32px}
.why-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:24px}
.why-icon{font-size:28px;margin-bottom:12px}
.why-title{font-size:16px;font-weight:600;margin-bottom:8px}
.why-text{font-size:14px;color:var(--ink3);line-height:1.65}

/* DISCLAIMER */
.disclaimer-bar{background:#FFF8E6;border-top:1px solid #FAC775;padding:14px 5vw;text-align:center;font-size:12px;color:#633806;line-height:1.6}
.disclaimer-inner{max-width:860px;margin:0 auto}

/* FOOTER */
footer{background:var(--ink);color:rgba(255,255,255,.45);text-align:center;padding:40px 5vw;font-size:13px}
footer .footer-logo{font-family:'{{ theme.font_title }}',serif;font-size:20px;color:#fff;margin-bottom:12px}
footer a{color:rgba(255,255,255,.4)}.footer-links{display:flex;justify-content:center;gap:24px;margin-top:12px}

@media(max-width:768px){
  .nav-links,.nav-cta{display:none}
  .nav-burger{display:flex}

  .comp-selects{grid-template-columns:1fr}
  .comp-vs{display:none}
  .comp-preview{grid-template-columns:1fr}
  .scpi-grid{grid-template-columns:1fr}
  .why-grid{grid-template-columns:1fr}
  .hero-stats{gap:24px}
  .nav-links{display:none}
}
</style>
</head>
<body>

{% include "base/_nav.html.j2" %}<!-- HERO -->
<div class="hero">
  <h1>Trouvez la <em>meilleure SCPI</em><br>pour votre profil</h1>
  <p class="hero-sub">Comparez {{ products|length }} SCPI sur tous les critères qui comptent : taux de distribution, frais, TRI, TOF et délai de jouissance.</p>
  <div class="hero-stats" style="margin-top:20px">
    <div class="hero-stat">
      <div class="hero-stat-val">{{ products|length }}</div>
      <div class="hero-stat-label">SCPI analysées</div>
    </div>
    <div class="hero-stat">
      <div class="hero-stat-val">{{ total_pairs }}</div>
      <div class="hero-stat-label">Comparatifs</div>
    </div>
    <div class="hero-stat">
      <div class="hero-stat-val">{{ zero_frais_count }}</div>
      <div class="hero-stat-label">SCPI sans frais</div>
    </div>
    <div class="hero-stat">
      <div class="hero-stat-val">{{ site.year }}</div>
      <div class="hero-stat-label">Données actualisées</div>
    </div>
  </div>
</div>

<!-- COMPARATEUR INTERACTIF -->
<div class="comparator" id="comparateur">
  <div class="comp-card">
    <div class="comp-header">
      <div class="comp-header-title">Comparez deux SCPI</div>
      <div class="comp-header-badge">OUTIL GRATUIT</div>
    </div>
    <div class="comp-body">
      <div class="comp-selects">
        <div class="select-wrap">
          <div class="select-label">Première SCPI</div>
          <select class="comp-select" id="scpi-a" onchange="updateComparator()">
            <option value="">-- Choisir une SCPI --</option>
            {% for prod in products %}
            <option value="{{ prod.slug }}" data-td="{{ prod.td }}" data-frais="{{ prod.frais_souscription }}" data-min="{{ prod.investissement_min | default(prod.prix_achat ~ '€') }}" data-nom="{{ prod.nom }}">{{ prod.nom }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="comp-vs">VS</div>
        <div class="select-wrap">
          <div class="select-label">Deuxième SCPI</div>
          <select class="comp-select" id="scpi-b" onchange="updateComparator()">
            <option value="">-- Choisir une SCPI --</option>
            {% for prod in products %}
            <option value="{{ prod.slug }}" data-td="{{ prod.td }}" data-frais="{{ prod.frais_souscription }}" data-min="{{ prod.investissement_min | default(prod.prix_achat ~ '€') }}" data-nom="{{ prod.nom }}">{{ prod.nom }}</option>
            {% endfor %}
          </select>
        </div>
      </div>

      <div class="comp-preview" id="comp-preview" style="display:none">
        <div class="comp-preview-card" id="preview-a"></div>
        <div class="comp-preview-card" id="preview-b"></div>
      </div>

      <button class="comp-cta" id="comp-btn" onclick="goCompare()" disabled>
        ⚖️ Voir le comparatif complet
      </button>
    </div>
  </div>
</div>

<!-- TOUTES LES SCPI -->
<main>
  <section id="scpi">
    <h2 class="section-title">Toutes les SCPI analysées</h2>
    <p class="section-sub">Données {{ site.year }}, Cliquez sur une SCPI pour accéder à sa fiche détaillée</p>

    <div class="filters">
      <button class="filter-btn active" onclick="filterSCPI('all', this)">Toutes</button>
      <button class="filter-btn" onclick="filterSCPI('rendement', this)">Rendement</button>
      <button class="filter-btn" onclick="filterSCPI('diversifiee', this)">Diversifiées</button>
      <button class="filter-btn" onclick="filterSCPI('europeenne', this)">Européennes</button>
      <button class="filter-btn" onclick="filterSCPI('specialisee', this)">Spécialisées</button>
      <button class="filter-btn" onclick="filterSCPI('zero-frais', this)">0% frais</button>
    </div>

    <div class="scpi-grid" id="scpi-grid">
      {% for prod in products %}
      <div class="scpi-card" data-type="{{ prod.type }}" data-frais="{{ prod.frais_souscription }}" onclick="goFiche('{{ prod.slug }}')">
        <div class="scpi-card-top">
          <div class="scpi-card-top-left">
            <img src="{{ prod.slug }}.png" alt="Logo {{ prod.nom }}" class="scpi-card-logo" onerror="this.style.display='none'">
            <div>
              <div class="scpi-name">{{ prod.nom }}</div>
              <div class="scpi-manager">{{ prod.marque }}</div>
            </div>
          </div>
          <span class="scpi-tag tag-{{ prod.type }}">{{ prod.type }}</span>
        </div>
        <div class="scpi-metrics">
          <div class="scpi-metric">
            <div class="scpi-metric-val accent">{{ prod.td }}%</div>
            <div class="scpi-metric-label">TD {{ site.year }}</div>
          </div>
          <div class="scpi-metric">
            <div class="scpi-metric-val">{{ prod.tri if prod.tri is defined else 'N/A' }}%</div>
            <div class="scpi-metric-label">TRI {{ prod.tri_horizon if prod.tri_horizon is defined else 'objectif' }}</div>
          </div>
          <div class="scpi-metric">
            <div class="scpi-metric-val">{{ prod.tof if prod.tof is defined else 'N/A' }}%</div>
            <div class="scpi-metric-label">TOF</div>
          </div>
        </div>
        <div class="scpi-badges">
          {% if prod.frais_souscription == 0 %}
          <span class="badge-zero">✓ 0% frais</span>
          {% endif %}
          {% if prod.delai_jouissance is defined and prod.delai_jouissance <= 3 %}
          <span class="badge-info">{{ prod.delai_jouissance }} mois jouissance</span>
          {% endif %}
          {% if prod.investissement_min is defined %}
          <span class="badge-info">Dès {{ prod.investissement_min }}</span>
          {% elif prod.prix_achat is defined %}
          <span class="badge-info">Dès {{ prod.prix_achat }}€</span>
          {% endif %}
          {% if prod.exposition_etrangere is defined %}
          <span class="badge-info">{{ prod.exposition_etrangere }} étranger</span>
          {% endif %}
        </div>
        <div class="scpi-card-links" onclick="event.stopPropagation()">
          <a href="avis-{{ prod.slug }}" class="scpi-link scpi-link-primary">📖 Avis {{ prod.nom }}</a>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- TOP COMPARATIFS -->
  <section id="comparatifs" style="margin-top:64px">
    <h2 class="section-title">Comparatifs populaires</h2>
    <p class="section-sub">Les analyses les plus consultées par nos lecteurs</p>
    <div class="comparatifs-grid">
      {% for pair in top_pairs %}
      <a href="{{ pair.url }}" class="comp-link">
        <span>{{ pair.label }}</span>
        <span class="comp-link-arrow">→</span>
      </a>
      {% endfor %}
    </div>
  </section>

  <!-- POURQUOI NOUS -->
  <section style="margin-top:64px">
    <h2 class="section-title">Pourquoi comparer les SCPI ?</h2>
    <p class="section-sub">Un écart de 1% sur les frais représente des milliers d'euros sur 10 ans</p>
    <div class="why-grid">
{% for card in site_editorial.why_cards %}
      <div class="why-card">
        <div class="why-icon">{{ card.icon }}</div>
        <div class="why-title">{{ card.title }}</div>
        <div class="why-text">{{ card.text }}</div>
      </div>
      {% endfor %}
    </div>
  </section>
</main>

<div class="disclaimer-bar">
  <div class="disclaimer-inner">⚠️ Ce site est fourni à titre informatif uniquement et ne constitue pas un conseil en investissement. Investir en SCPI comporte des risques dont la perte en capital. Les performances passées ne préjugent pas des performances futures. Consultez un CGP agréé AMF avant tout investissement.</div>
</div>

{% include "base/_footer.html.j2" %}

{% if site.analytics_clicky %}
<script async data-id="{{ site.analytics_clicky }}" src="//static.getclicky.com/js"></script>
{% endif %}
<script>
const SCPI_DATA = {
  {% for prod in products %}
  '{{ prod.slug }}': {
    nom: '{{ prod.nom }}',
    marque: '{{ prod.marque }}',
    td: '{{ prod.td }}',
    frais: {{ prod.frais_souscription }},
    min: '{{ prod.investissement_min | default(prod.prix_achat ~ "€") }}',
    tof: '{{ prod.tof | default('N/A') }}',
    tri: '{{ prod.tri | default('N/A') }}'
  }{% if not loop.last %},{% endif %}
  {% endfor %}
};

const BASE_PATH = '{{ site.base_path }}';

function updateComparator() {
  const a = document.getElementById('scpi-a').value;
  const b = document.getElementById('scpi-b').value;
  const btn = document.getElementById('comp-btn');
  const preview = document.getElementById('comp-preview');

  if (a && b && a !== b) {
    btn.disabled = false;
    btn.textContent = '⚖️ Comparer ' + SCPI_DATA[a].nom + ' vs ' + SCPI_DATA[b].nom;
    preview.style.display = 'grid';
    renderPreview('preview-a', SCPI_DATA[a]);
    renderPreview('preview-b', SCPI_DATA[b]);
  } else {
    btn.disabled = true;
    btn.textContent = '⚖️ Voir le comparatif complet';
    preview.style.display = 'none';
    if (a && b && a === b) btn.textContent = '⚠️ Choisissez deux SCPI différentes';
  }
}

function renderPreview(id, d) {
  var rows = [
    ['TD 2025', d.td + '%'],
    ['Frais entrée', d.frais == 0 ? '0% ✓' : d.frais + '%'],
    ['Invest. min.', d.min],
    ['TOF', d.tof !== 'N/A' ? d.tof + '%' : 'N/A'],
    ['TRI', d.tri !== 'N/A' ? d.tri + '%' : 'N/A'],
  ];
  var html = '<div class="cpcard-name">' + d.nom + '</div><table style="width:100%;border-collapse:collapse;margin-top:8px;font-size:13px">';
  rows.forEach(function(r) {
    html += '<tr style="border-bottom:1px solid var(--border)"><td style="padding:6px 4px;color:var(--ink3)">' + r[0] + '</td><td style="padding:6px 4px;font-weight:600;text-align:right">' + r[1] + '</td></tr>';
  });
  html += '</table>';
  document.getElementById(id).innerHTML = html;
}

function goCompare() {
  const a = document.getElementById('scpi-a').value;
  const b = document.getElementById('scpi-b').value;
  if (!a || !b || a === b) return;
  const sorted = [a, b].sort();
  window.location.href = sorted[0] + '-vs-' + sorted[1] ;
}

function preselectA(slug) {
  document.getElementById('scpi-a').value = slug;
  updateComparator();
}

function goFiche(slug) {
  window.location.href = 'avis-' + slug ;
}

function filterSCPI(type, btn) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.scpi-card').forEach(card => {
    if (type === 'all') { card.style.display = ''; return; }
    if (type === 'zero-frais') { card.style.display = card.dataset.frais == '0' ? '' : 'none'; return; }
    card.style.display = card.dataset.type === type ? '' : 'none';
  });
}


</script>
</body>
</html>
