<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if home_title is defined and home_title %}{{ home_title }}{% else %}{{ site.name }} | Comparateur de logiciels {{ site.year }}{% endif %}</title>
<meta name="description" content="{% if home_description is defined and home_description %}{{ home_description }}{% else %}Comparez les meilleurs logiciels professionnels en {{ site.year }} : avis, prix, fonctionnalités.{% endif %}">
<link rel="canonical" href="{{ site.domain }}/">
<meta property="og:title" content="{{ home_title | default(site.name) }}">
<meta property="og:description" content="{{ home_description | default('') }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.domain }}/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="{{ theme.google_fonts }}&v={{ site.slug }}" rel="stylesheet">

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "WebSite",
  "name": "{{ site.name }}",
  "url": "{{ site.domain }}",
  "description": "{{ home_description | default('') }}",
  "author": { "@type": "Organization", "name": "{{ site.author_name | default(site.name) }}" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ site.domain }}/recherche?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

<style>
:root{
  --bg:{{ theme.bg }};
  --surface:#fff;
  --surface2:#F0ECE5;
  --ink:{{ theme.ink }};
  --ink2:#6B6560;
  --ink3:#A09890;
  --accent:{{ theme.accent }};
  --accent2:{{ theme.accent2 }};
  --border:#E2DDD6;
  --r:12px;
  --r2:20px;
  --green:#1A7A4A;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'{{ theme.font_body }}',sans-serif;background:var(--bg);color:var(--ink);font-size:16px;line-height:1.75}
a{color:inherit;text-decoration:none}

/* ── NAV ── */
nav{background:var(--ink);padding:0 5vw;display:flex;align-items:center;justify-content:space-between;height:64px;position:sticky;top:0;z-index:100}
.nav-inner{max-width:1200px;width:100%;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px}
.nav-logo{font-family:'{{ theme.font_title }}',serif;font-weight:400;font-size:17px;color:#fff;flex-shrink:0}.nav-logo span{color:var(--accent2)}
.nav-links{display:flex;align-items:center;gap:4px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:30px;padding:4px 8px}
.nav-links a{color:rgba(255,255,255,.65);font-size:13px;font-weight:500;padding:6px 14px;border-radius:24px;transition:.15s}
.nav-links a:hover{color:#fff;background:rgba(255,255,255,.1)}
.nav-cta{display:inline-flex;align-items:center;gap:6px;padding:8px 18px;border-radius:24px;background:var(--accent2);color:#fff;font-size:13px;font-weight:700;transition:.15s;flex-shrink:0}
.nav-cta:hover{opacity:.88}
.nav-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;background:none;border:none}
.nav-burger span{display:block;width:22px;height:2px;background:#fff;border-radius:2px;transition:.25s}
.nav-mobile{display:none;position:absolute;top:64px;left:0;right:0;background:var(--ink);border-top:1px solid rgba(255,255,255,.08);padding:16px 5vw;flex-direction:column;gap:4px;z-index:99}
.nav-mobile.open{display:flex}
.nav-mobile a{color:rgba(255,255,255,.75);font-size:15px;padding:12px 16px;border-radius:10px;transition:.15s}
.nav-mobile a:hover{color:#fff;background:rgba(255,255,255,.08)}

/* ── HERO ── */
.hero{background:var(--ink);padding:72px 5vw 80px;text-align:center;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;top:-50%;left:-20%;width:60%;height:200%;background:radial-gradient(ellipse,rgba(255,255,255,.04) 0%,transparent 70%);pointer-events:none}
.hero-eyebrow{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.7);font-size:12px;font-weight:600;padding:5px 14px;border-radius:20px;margin-bottom:20px;letter-spacing:.06em;text-transform:uppercase}
.hero h1{font-family:'{{ theme.font_title }}',serif;font-size:clamp(34px,5vw,62px);font-weight:400;color:#fff;line-height:1.1;letter-spacing:-.025em;max-width:800px;margin:0 auto 20px}
.hero h1 em{font-style:italic;color:var(--accent2)}
.hero-desc{font-size:18px;color:rgba(255,255,255,.6);max-width:580px;margin:0 auto 40px;line-height:1.7}

/* ── MOTEUR DE RECHERCHE ── */
.search-wrap{max-width:600px;margin:0 auto;position:relative}
.search-box{display:flex;align-items:center;background:#fff;border-radius:50px;padding:6px 6px 6px 22px;box-shadow:0 8px 40px rgba(0,0,0,.25);gap:10px}
.search-box input{flex:1;border:none;outline:none;font-size:16px;font-family:'{{ theme.font_body }}',sans-serif;color:var(--ink);background:transparent}
.search-box input::placeholder{color:var(--ink3)}
.search-btn{padding:11px 24px;border-radius:40px;background:var(--accent);color:#fff;font-size:14px;font-weight:700;border:none;cursor:pointer;white-space:nowrap;transition:.15s;flex-shrink:0}
.search-btn:hover{opacity:.88}
.search-suggestions{position:absolute;top:calc(100% + 8px);left:0;right:0;background:#fff;border-radius:var(--r2);box-shadow:0 8px 40px rgba(0,0,0,.15);z-index:50;overflow:hidden;display:none}
.search-suggestions.open{display:block}
.suggestion-item{padding:12px 20px;cursor:pointer;font-size:15px;color:var(--ink2);display:flex;align-items:center;gap:10px;transition:.1s;border-bottom:1px solid var(--border)}
.suggestion-item:last-child{border-bottom:none}
.suggestion-item:hover{background:var(--bg);color:var(--accent)}
.suggestion-item::before{content:'🔍';font-size:13px;opacity:.5}
.suggestion-highlight{font-weight:700;color:var(--ink)}

/* ── STATS ── */
.stats-bar{background:rgba(255,255,255,.05);border-top:1px solid rgba(255,255,255,.08);padding:20px 5vw;display:flex;justify-content:center;gap:48px}
.stat-item{text-align:center}
.stat-value{font-size:24px;font-weight:700;color:#fff;font-family:'{{ theme.font_title }}',serif}
.stat-label{font-size:12px;color:rgba(255,255,255,.45);margin-top:2px}

/* ── CONTENU PRINCIPAL ── */
main{max-width:1200px;margin:0 auto;padding:64px 5vw 80px}

/* ── COMPARATEURS ── */
.comparateurs-section{margin-bottom:56px}
.comparateurs-section h2{font-family:'{{ theme.font_title }}',serif;font-size:clamp(28px,3.5vw,40px);font-weight:400;letter-spacing:-.02em;margin-bottom:6px}
.comparateurs-subtitle{font-size:16px;color:var(--ink2);margin-bottom:36px}
.cat-group{margin-bottom:36px}
.cat-group-title{font-size:13px;font-weight:700;color:var(--ink3);text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px;display:flex;align-items:center;gap:8px}
.cat-group-title::after{content:'';flex:1;height:1px;background:var(--border)}
.cat-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px}
.cat-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:18px 20px;display:flex;align-items:center;justify-content:space-between;transition:.15s;cursor:pointer}
.cat-card:hover{border-color:var(--accent);box-shadow:0 4px 20px rgba(0,0,0,.06);transform:translateY(-1px)}
.cat-card-left{display:flex;align-items:center;gap:12px}
.cat-card-icon{width:38px;height:38px;border-radius:10px;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.cat-card-name{font-size:14px;font-weight:600;color:var(--ink);line-height:1.4}
.cat-card-count{font-size:11px;color:var(--ink3);margin-top:2px}
.cat-card-arrow{color:var(--accent);font-size:18px;opacity:0;transition:.15s}
.cat-card:hover .cat-card-arrow{opacity:1}



/* ── FOOTER ── */
footer{background:var(--ink);color:rgba(255,255,255,.5);padding:40px 5vw;font-size:13px}
.footer-inner{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
.footer-logo{font-family:'{{ theme.font_title }}',serif;font-size:16px;color:#fff}.footer-logo span{color:var(--accent2)}
.footer-links{display:flex;gap:20px;flex-wrap:wrap}
.footer-links a{color:rgba(255,255,255,.4);transition:.15s}.footer-links a:hover{color:#fff}
.footer-copy{color:rgba(255,255,255,.25);font-size:12px;width:100%;text-align:center;margin-top:20px;padding-top:20px;border-top:1px solid rgba(255,255,255,.06)}

@media(max-width:768px){
  .nav-links,.nav-cta{display:none}
  .nav-burger{display:flex}
  .stats-bar{gap:24px;flex-wrap:wrap}
  .cat-cards{grid-template-columns:1fr}
  .top-grid{grid-template-columns:repeat(2,1fr)}
  .footer-inner{flex-direction:column;text-align:center}
  .footer-links{justify-content:center}
}
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo">{{ site.logo_text }}<span>{{ site.logo_accent }}</span></a>
    <div class="nav-links">
      <a href="/" class="active">Accueil</a>
      <a href="/contact">Contact</a>
    </div>
    <a href="/contact" class="nav-cta">Nous contacter</a>
    <button class="nav-burger" id="burger" onclick="toggleMenu()" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="nav-mobile" id="nav-mobile">
    <a href="/">Accueil</a>
    <a href="/contact">Contact</a>
  </div>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-eyebrow">{{ site.tagline }}</div>
  <h1>{% if site.home_h1 is defined and site.home_h1 %}{{ site.home_h1 | safe }}{% else %}{{ site.name }} : <em>le comparateur qui compare vraiment</em>{% endif %}</h1>
  <p class="hero-desc">{{ home_description | default('Trouvez le logiciel professionnel qui correspond exactement à vos besoins, votre budget et votre secteur.') }}</p>

  <!-- Moteur de recherche -->
  <div class="search-wrap">
    <div class="search-box">
      <input type="text" id="search-input" placeholder="Recherchez un type de logiciel..." autocomplete="off" aria-label="Rechercher">
      <button class="search-btn" onclick="submitSearch()">Rechercher →</button>
    </div>
    <div class="search-suggestions" id="search-suggestions"></div>
  </div>

  <!-- Stats bar -->
  <div class="stats-bar" style="margin-top:48px;border-radius:var(--r2)">
    <div class="stat-item">
      <div class="stat-value" id="stat-logiciels">{{ total_products | default(products | length) }}+</div>
      <div class="stat-label">Logiciels analysés</div>
    </div>
    <div class="stat-item">
      <div class="stat-value" id="stat-categories">{{ total_categories | default(0) }}</div>
      <div class="stat-label">Catégories</div>
    </div>
    <div class="stat-item">
      <div class="stat-value">{{ site.year }}</div>
      <div class="stat-label">Mis à jour</div>
    </div>
  </div>
</section>

<!-- MAIN -->
<main>

  <!-- NOS COMPARATEURS -->
  <section class="comparateurs-section">
    <h2>Nos comparateurs</h2>
    <p class="comparateurs-subtitle">Trouvez le meilleur logiciel selon votre métier et vos besoins</p>

    {# Grouper produits par categorie #}
    {% set categories = [] %}
    {% for prod in products %}
      {% if prod.categorie is defined and prod.categorie %}
        {% if prod.categorie not in categories %}
          {% set _ = categories.append(prod.categorie) %}
        {% endif %}
      {% endif %}
    {% endfor %}

    {% if categories | length > 0 %}
    <div class="cat-cards">
      {% for cat in categories %}
        {% set cat_slug = cat | lower | replace('’', '-') | replace('‘', '-') | replace("'", '-') | replace(' ', '-') | replace('é', 'e') | replace('è', 'e') | replace('ê', 'e') | replace('à', 'a') | replace('â', 'a') | replace('ù', 'u') | replace('û', 'u') | replace('î', 'i') | replace('ï', 'i') | replace('ô', 'o') | replace('ç', 'c') %}
        {% set count = products | selectattr('categorie', 'equalto', cat) | list | length %}
        <a href="/meilleur-{{ cat_slug }}" class="cat-card">
          <div class="cat-card-left">
            <div class="cat-card-icon">💻</div>
            <div>
              <div class="cat-card-name">{{ cat | capitalize }}</div>
              <div class="cat-card-count">{{ count }} logiciel{{ 's' if count > 1 else '' }}</div>
            </div>
          </div>
          <span class="cat-card-arrow">→</span>
        </a>
      {% endfor %}
    </div>
    {% else %}
    <div style="color:var(--ink3);font-size:14px;padding:20px 0">Ajoutez une colonne <code>categorie</code> dans votre Google Sheet pour afficher les comparateurs.</div>
    {% endif %}
  </section>



</main>

<!-- FOOTER -->
<footer>
  <div class="footer-inner">
    <div class="footer-logo">{{ site.logo_text }}<span>{{ site.logo_accent }}</span></div>
    <div class="footer-links">
      <a href="/">Accueil</a>
      {% if site.footer_pages is defined %}
        {% for page in site.footer_pages %}
        <a href="/{{ page.slug }}">{{ page.label }}</a>
        {% endfor %}
      {% else %}
      <a href="/contact">Contact</a>
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/politique-confidentialite">Confidentialité</a>
      {% endif %}
    </div>
    <div class="footer-copy">© {{ site.year }} {{ site.name }} · Tous droits réservés</div>
  </div>
</footer>

{% if site.analytics_clicky %}
<script async data-id="{{ site.analytics_clicky }}" src="//static.getclicky.com/js"></script>
{% endif %}

<script>
// Données de recherche (chargées en JS après DOM pour éviter footprint)
const ALL_CATEGORIES = [
  {% for prod in products %}
  {% if prod.categorie is defined and prod.categorie %}
  { label: "{{ prod.categorie }}", slug: "meilleur-{{ prod.categorie | lower | replace(' ', '-') }}" },
  {% endif %}
  {% endfor %}
].filter((v,i,a) => a.findIndex(t=>t.label===v.label)===i);

const searchInput = document.getElementById('search-input');
const suggestions = document.getElementById('search-suggestions');

searchInput.addEventListener('input', function() {
  const q = this.value.toLowerCase().trim();
  suggestions.innerHTML = '';
  if (!q) { suggestions.classList.remove('open'); return; }
  const matches = ALL_CATEGORIES.filter(c => c.label.toLowerCase().includes(q)).slice(0, 6);
  if (!matches.length) { suggestions.classList.remove('open'); return; }
  matches.forEach(m => {
    const div = document.createElement('div');
    div.className = 'suggestion-item';
    const idx = m.label.toLowerCase().indexOf(q);
    div.innerHTML = '<span class="suggestion-highlight">' + m.label.substring(0,idx) + '</span>'
      + '<strong>' + m.label.substring(idx, idx+q.length) + '</strong>'
      + m.label.substring(idx+q.length);
    div.onclick = () => window.location.href = '/' + m.slug;
    suggestions.appendChild(div);
  });
  suggestions.classList.add('open');
});

document.addEventListener('click', e => {
  if (!e.target.closest('.search-wrap')) suggestions.classList.remove('open');
});

searchInput.addEventListener('keydown', e => {
  if (e.key === 'Enter') submitSearch();
});

function submitSearch() {
  const q = searchInput.value.toLowerCase().trim();
  if (!q) return;
  const match = ALL_CATEGORIES.find(c => c.label.toLowerCase().includes(q));
  if (match) window.location.href = '/' + match.slug;
}

// Menu mobile
function toggleMenu() {
  document.getElementById('nav-mobile').classList.toggle('open');
  document.getElementById('burger').classList.toggle('open');
}
document.addEventListener('click', function(e) {
  const m = document.getElementById('nav-mobile');
  const b = document.getElementById('burger');
  if (m && b && !m.contains(e.target) && !b.contains(e.target)) {
    m.classList.remove('open'); b.classList.remove('open');
  }
});
</script>
</body>
</html>
