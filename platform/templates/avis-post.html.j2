<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
{% if site.favicon_file is defined and site.favicon_file %}
<link rel="icon" href="{{ site.favicon_file }}">
{% else %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
{% endif %}
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ post.meta_title or post.h1 }}</title>
<meta name="description" content="{{ post.meta_description }}">
<link rel="canonical" href="{{ site.domain }}/{{ post.slug }}">
<meta property="og:title" content="{{ post.meta_title or post.h1 }}">
<meta property="og:description" content="{{ post.meta_description }}">
<meta property="og:type" content="article">
<meta property="og:url" content="{{ site.domain }}/{{ post.slug }}">
<meta property="article:published_time" content="{{ post.date }}">
{% if post.updated %}<meta property="article:modified_time" content="{{ post.updated }}">{% endif %}
{% if post.categorie %}<meta property="article:section" content="{{ post.categorie }}">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="{{ theme.google_fonts }}&v={{ site.slug }}" rel="stylesheet">

{# ── Schema.org : Review (avec aggregateRating optionnel) ─────────────── #}
{# C'est ce JSON-LD qui permet à Google d'afficher les étoiles dans les SERP. #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Review",
  "itemReviewed": {
    "@type": "Product",
    "name": {{ post.marque | tojson }}
    {% if post.categorie %},"category": {{ post.categorie | tojson }}{% endif %}
  },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": {{ post.note }},
    "bestRating": 5,
    "worstRating": 1
  },
  "name": {{ (post.meta_title or post.h1) | tojson }},
  "datePublished": "{{ post.date }}",
  {% if post.updated %}"dateModified": "{{ post.updated }}",{% endif %}
  "author": {
    "@type": "Organization",
    "name": {{ (site.author_name | default(site.name)) | tojson }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ site.name | tojson }},
    "url": {{ site.domain | tojson }}
  }
  {% if post.note_trustpilot and post.nb_avis_trustpilot %},
  "positiveNotes": {{ (post.points_forts or []) | tojson }},
  "negativeNotes": {{ (post.points_faibles or []) | tojson }}
  {% endif %}
}
</script>

{% if post.note_trustpilot and post.nb_avis_trustpilot %}
{# AggregateRating séparé pour bien dire à Google qu'il y a une vraie base d'avis externes #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ post.marque | tojson }},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ post.note_trustpilot }},
    "reviewCount": {{ post.nb_avis_trustpilot }},
    "bestRating": 5,
    "worstRating": 1
  }
}
</script>
{% endif %}

{% if post.faq and post.faq | length >= 2 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in post.faq %}
    {
      "@type": "Question",
      "name": {{ item.q | tojson }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ item.r | tojson }}
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:{{ theme.bg | default('#FAF9F6') }};--surface:{{ theme.surface | default('#fff') }};--surface2:{{ theme.surface2 | default('#F5F3EE') }};
  --ink:{{ theme.ink | default('#0F1419') }};--ink2:{{ theme.ink2 | default('#3D434B') }};--ink3:{{ theme.ink3 | default('#8B9CB0') }};
  --accent:{{ theme.accent | default('#C9A961') }};--accent2:{{ theme.accent2 | default('#1E5F8B') }};--green:{{ theme.green | default('#3D7A4F') }};
  --red:{{ theme.red | default('#C0392B') }};
  --border:{{ theme.border | default('#E6E1D8') }};--r:8px;--r2:14px;
  {% if theme.cta_color %}--cta:{{ theme.cta_color }};{% endif %}{% if theme.cta_text_color %}--cta-text:{{ theme.cta_text_color }};{% endif %}
}
body{font-family:'{{ theme.font_body }}',system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.65;font-size:16px}
a{color:var(--accent2);text-decoration:none}
.container{max-width:1180px;margin:0 auto;padding:0 5vw}

/* ─── Hero / titre ─── */
.avis-hero{padding:48px 0 24px;text-align:center}
h1{font-family:'{{ theme.font_title }}',serif;font-size:clamp(28px,4.5vw,42px);font-weight:400;letter-spacing:-.02em;color:var(--ink);margin-bottom:16px;line-height:1.2}
/* Meta façon blog : catégorie · date · durée · auteur */
.article-cat{display:inline-block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--accent);background:var(--surface2);padding:4px 10px;border-radius:20px;text-decoration:none;transition:.15s}
.article-cat:hover{background:var(--accent);color:#fff;text-decoration:none}
.article-meta{font-size:14px;color:var(--ink3);margin-bottom:8px;display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:center}
.article-meta-item{display:inline-flex;align-items:center;gap:6px}
.article-meta-dot{width:3px;height:3px;border-radius:50%;background:var(--ink3)}

/* ─── Intro : paragraphe sous le H1 ─── */
.avis-intro{font-size:18px;line-height:1.7;color:var(--ink2);margin:24px auto 32px;max-width:760px;text-align:left}
.avis-intro p{margin:0}

/* ─── Encart "Mon avis en Bref" : titre + note à droite / logo + texte ─── */
.avis-bref-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:24px 28px;margin:32px 0 24px;box-shadow:0 1px 3px rgba(0,0,0,.04)}
.avis-bref-header{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid var(--border);flex-wrap:wrap}
.avis-bref-title{font-family:'{{ theme.font_title }}',serif;font-size:22px;font-weight:500;color:var(--ink);margin:0;letter-spacing:-.01em}
.avis-bref-note{display:flex;align-items:center;gap:10px}
.avis-bref-note-num{font-family:'{{ theme.font_title }}',serif;font-size:28px;font-weight:600;color:var(--accent);line-height:1}
.avis-bref-note-num small{font-size:14px;color:var(--ink3);font-weight:400}
.avis-bref-note .stars{font-size:18px}

.avis-bref-body{display:grid;grid-template-columns:96px 1fr;gap:24px;align-items:center}
.avis-bref-logo{width:96px;height:96px;border-radius:16px;background:var(--surface2);display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0}
.avis-bref-logo img{max-width:100%;max-height:100%;object-fit:contain}
.avis-bref-logo-placeholder{font-family:'{{ theme.font_title }}',serif;font-size:48px;font-weight:600;color:var(--accent);text-transform:uppercase}
.avis-bref-text{color:var(--ink2);font-size:15px;line-height:1.65}
.avis-bref-text p{margin:0 0 10px}
.avis-bref-text p:last-child{margin:0}

/* ─── Étoiles (réutilisées dans avis-bref-note) ─── */
.stars{display:inline-flex;gap:2px;font-size:22px;color:var(--accent)}
.stars span{position:relative;display:inline-block;width:1em;color:#E0DCD2}
.stars span.full{color:var(--accent)}
.stars span.half{color:#E0DCD2}
.stars span.half::before{content:'★';position:absolute;left:0;top:0;width:50%;overflow:hidden;color:var(--accent)}

/* ─── Sentiment badge (affiché sous le en_bref) ─── */
.score-sentiment{display:inline-block;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-top:6px}
.score-sentiment.positif{background:#E8F4EA;color:var(--green)}
.score-sentiment.mitige{background:#FDF6E3;color:#9F7918}
.score-sentiment.negatif{background:#FBE9E7;color:var(--red)}

/* ─── Points forts / faibles en 2 colonnes (sortis de l'ancien score-card) ─── */
.pros-cons{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:24px 0}
.pros,.cons{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:20px}
.pros h3,.cons h3{font-size:13px;text-transform:uppercase;letter-spacing:.05em;font-weight:700;margin:0 0 12px}
.pros h3{color:var(--green)}
.cons h3{color:var(--red)}
.pros ul,.cons ul{list-style:none;padding:0;margin:0}
.pros li,.cons li{position:relative;padding:6px 0 6px 24px;font-size:14px;color:var(--ink2);line-height:1.5}
.pros li::before{content:'✓';position:absolute;left:0;top:6px;color:var(--green);font-weight:700}
.cons li::before{content:'✕';position:absolute;left:0;top:6px;color:var(--red);font-weight:700}

/* ─── CTA principal centré ─── */
.cta-btn{display:inline-block;background:var(--cta,var(--accent));color:var(--cta-text,#fff);padding:14px 28px;border-radius:var(--r);font-weight:600;font-size:16px;transition:transform .15s,box-shadow .15s;box-shadow:0 2px 8px rgba(0,0,0,.08)}
.cta-btn:hover{transform:translateY(-1px);box-shadow:0 4px 14px rgba(0,0,0,.12);color:var(--cta-text,#fff)}
.cta-wrap,.cta-wrap-main{text-align:center}
.cta-wrap-main{margin:32px 0 48px}

/* Responsive */
@media(max-width:680px){
  .avis-bref-header{flex-direction:column;align-items:flex-start;gap:12px}
  .avis-bref-body{grid-template-columns:1fr;gap:16px;text-align:center}
  .avis-bref-logo{margin:0 auto}
  .pros-cons{grid-template-columns:1fr}
}

/* ─── En bref ─── */
.en-bref{background:var(--surface2);border-left:4px solid var(--accent);padding:18px 24px;border-radius:var(--r);margin:32px 0;font-size:16px;color:var(--ink2)}
.en-bref strong{color:var(--ink);font-weight:600}
/* Sommaire : compact, sobre, sans cassure visuelle avec En bref qui le précède.
   isolation:isolate + z-index:0 garantissent que le sommaire reste DERRIÈRE
   le menu (qui est en position:sticky z-index:1000), même quand on scroll. */
.avis-toc{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:18px 24px;margin:24px 0 40px;font-size:15px;position:relative;z-index:0;isolation:isolate}
.avis-toc .toc-title{margin:0 0 10px;font-family:'{{ theme.font_title }}',serif;font-size:14px;font-weight:600;text-transform:uppercase;letter-spacing:0.6px;color:var(--ink2)}
.avis-toc ol{margin:0;padding:0 0 0 22px;color:var(--ink2)}
.avis-toc li{margin:6px 0;line-height:1.5}
.avis-toc a{color:var(--ink);text-decoration:none;border-bottom:1px solid transparent;transition:border-color .15s ease}
.avis-toc a:hover{border-bottom-color:var(--accent)}
/* Décalage au scroll pour ne pas que le H2 cible soit caché par le menu sticky
   en haut (~64px de hauteur d'après _nav.html.j2). 80px laisse une marge. */
.tarifs-section,.analyse-section,.avis-clients,.faq-section,.verdict{scroll-margin-top:80px}

/* Box auteur en bas de page (copie du style blog-post).
   Le margin-bottom 96px aère visuellement avant le footer (le blog n'avait pas
   ce souci car il a des related_posts entre la box et le footer). */
.author-box{display:flex;align-items:flex-start;gap:24px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:28px;margin:64px 0 96px}
.author-avatar{width:72px;height:72px;border-radius:50%;object-fit:cover;flex-shrink:0;border:3px solid var(--border)}
.author-avatar-placeholder{width:72px;height:72px;border-radius:50%;background:var(--bg);border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:28px;flex-shrink:0}
.author-info{flex:1}
.author-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--ink3);margin-bottom:4px}
.author-name{font-family:'{{ theme.font_title }}',serif;font-size:20px;font-weight:400;color:var(--ink);margin-bottom:2px}
.author-job{font-size:13px;color:var(--ink3);margin-bottom:12px}
.author-bio{font-size:14px;color:var(--ink2);line-height:1.7}
@media(max-width:600px){.author-box{flex-direction:column;align-items:center;text-align:center}}

/* ─── Tableau tarifs ─── */
.tarifs-section{margin:40px 0}
.tarifs-section h2{font-family:'{{ theme.font_title }}',serif;font-size:28px;font-weight:400;margin-bottom:20px;color:var(--ink)}
.tarifs-table{width:100%;border-collapse:collapse;background:var(--surface);border-radius:var(--r);overflow:hidden;border:1px solid var(--border);font-size:15px}
.tarifs-table th,.tarifs-table td{padding:14px 16px;text-align:left;border-bottom:1px solid var(--border);vertical-align:top}
.tarifs-table th{background:var(--surface2);font-weight:700;color:var(--ink);text-transform:uppercase;letter-spacing:.04em;font-size:12px}
.tarifs-table tr:last-child td{border-bottom:none}
.tarifs-table .price{font-weight:700;color:var(--accent2);white-space:nowrap}

/* ─── Sections d'analyse ─── */
/* Note : ce bloc style à la fois les sections "ancien format" (3 H2 nommés
   h2_fonctionnalites/support/qualite_prix générés par le 1er appel Claude)
   ET les sections custom rendues via post.sections_html (HTML libre généré
   par le 2e appel Claude à partir du prompt custom de l'éditeur). Le contenu
   custom contient librement des h2, h3, p, ul, ol, li, strong, em : on les
   stylise tous ici pour garantir un rendu propre. */
.analyse-section{margin:40px 0}
.analyse-section h2{font-family:'{{ theme.font_title }}',serif;font-size:28px;font-weight:400;margin:48px 0 16px;color:var(--ink);line-height:1.3;scroll-margin-top:80px}
.analyse-section h2:first-child{margin-top:0}
.analyse-section h3{font-family:'{{ theme.font_title }}',serif;font-size:20px;font-weight:600;margin:32px 0 12px;color:var(--ink);line-height:1.35;scroll-margin-top:80px}
.analyse-section h3:first-child{margin-top:0}
.analyse-section p{margin:0 0 16px;color:var(--ink2)}
.analyse-section p:last-child{margin-bottom:0}
.analyse-section ul,.analyse-section ol{margin:8px 0 24px;padding-left:24px;color:var(--ink2)}
.analyse-section li{margin-bottom:8px;line-height:1.7}
.analyse-section li:last-child{margin-bottom:0}
.analyse-section ul{list-style:disc}
.analyse-section ol{list-style:decimal}
.analyse-section strong{color:var(--ink);font-weight:600}
/* Espace généreux entre un bloc de liste et le H2/H3 qui suit, sinon visuellement
   on a l'impression que la liste mange le titre de la section suivante. */
.analyse-section ul + h2,.analyse-section ol + h2,.analyse-section p + h2{margin-top:48px}
.analyse-section ul + h3,.analyse-section ol + h3,.analyse-section p + h3{margin-top:28px}

/* ─── Avis clients (preuve sociale) ─── */
.avis-clients{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:24px;margin:32px 0}
.avis-clients-header{display:flex;align-items:center;gap:16px;margin-bottom:12px}
.avis-clients-score{font-family:'{{ theme.font_title }}',serif;font-size:32px;color:var(--accent);font-weight:600;line-height:1}
.avis-clients-meta{font-size:13px;color:var(--ink3)}
.avis-clients h2{font-family:'{{ theme.font_title }}',serif;font-size:24px;font-weight:400;margin-bottom:12px;color:var(--ink)}

/* ─── FAQ ─── */
.faq-section{margin:48px 0 32px}
.faq-section h2{font-family:'{{ theme.font_title }}',serif;font-size:28px;font-weight:400;margin-bottom:20px;color:var(--ink)}
.faq-item{border-bottom:1px solid var(--border);padding:16px 0}
.faq-item:first-child{padding-top:0}
.faq-q{font-weight:600;font-size:17px;color:var(--ink);margin-bottom:8px;cursor:pointer;display:flex;justify-content:space-between;align-items:center}
.faq-q::after{content:'+';font-size:24px;color:var(--ink3);font-weight:400;line-height:1;transition:transform .2s}
.faq-item.open .faq-q::after{transform:rotate(45deg)}
.faq-r{color:var(--ink2);font-size:15px;display:none;padding-top:8px}
.faq-item.open .faq-r{display:block}

/* ─── Verdict final ─── */
.verdict{background:linear-gradient(135deg,var(--surface) 0%,var(--surface2) 100%);border:2px solid var(--accent);border-radius:var(--r2);padding:32px;margin:48px 0 32px;text-align:center}
.verdict h2{font-family:'{{ theme.font_title }}',serif;font-size:28px;font-weight:400;margin-bottom:12px;color:var(--ink)}
.verdict p{color:var(--ink2);font-size:16px;margin-bottom:20px;max-width:600px;margin-left:auto;margin-right:auto}
.verdict-note{display:inline-flex;align-items:center;gap:12px;margin-bottom:20px}
.verdict-note .score-num{font-size:42px}
/* `.score-num` est utilisé dans le bloc verdict final + (potentiellement) dans
   d'autres modèles. Conservé en classe générique. */
.score-num{font-family:'{{ theme.font_title }}',serif;font-weight:600;color:var(--accent);line-height:1}
.score-num small{font-size:.5em;color:var(--ink3);font-weight:400}

/* ─── Responsive global (les rules spécifiques avis-bref-* et pros-cons sont déjà plus haut) ─── */
@media (max-width:680px){
  .tarifs-table th,.tarifs-table td{padding:10px}
  .verdict{padding:20px}
}
</style>
</head>
<body>

{% include "base/_nav.html.j2" %}

<main class="container">

  {# ─── HERO : juste H1 + meta-infos ──────────────────────────── #}
  <section class="avis-hero">
    <h1>{{ post.h1 }}</h1>
    {# Meta façon blog : catégorie (lien) · date · temps de lecture · auteur. #}
    <div class="article-meta">
      {% if post.categorie and post.categorie_slug %}
        <a href="/avis/{{ post.categorie_slug }}/" class="article-cat">{{ post.categorie }}</a>
        <span class="article-meta-dot"></span>
      {% endif %}
      {% if post.date_display %}
        <span class="article-meta-item">📅 {{ post.date_display }}</span>
        <span class="article-meta-dot"></span>
      {% endif %}
      {% if post.reading_time %}
        <span class="article-meta-item">⏱ {{ post.reading_time }} min de lecture</span>
        <span class="article-meta-dot"></span>
      {% endif %}
      {% if site.author_name %}
        <span class="article-meta-item">✍️ {{ site.author_name }}</span>
      {% endif %}
    </div>
  </section>

  {# ─── INTRO : paragraphe d'introduction du sujet ─────────────── #}
  {# Champ généré par Claude (cf. avis_publish_scheduled.py). Distinct de
     `en_bref` qui apparaît plus bas dans l'encart "Mon avis en Bref". #}
  {% if post.intro %}
  <section class="avis-intro">
    <p>{{ post.intro }}</p>
  </section>
  {% endif %}

  {# ─── MON AVIS EN BREF : titre + note à droite / logo + texte ─ #}
  <section class="avis-bref-card">
    <div class="avis-bref-header">
      <h2 class="avis-bref-title">Mon avis en Bref</h2>
      <div class="avis-bref-note">
        <span class="avis-bref-note-num">{{ post.note }}<small>/5</small></span>
        <div class="stars" aria-label="{{ post.note }} étoiles sur 5">
          {%- set full = post.note | int -%}
          {%- set half = 1 if (post.note - full) >= 0.5 else 0 -%}
          {%- for i in range(full) -%}<span class="full">★</span>{%- endfor -%}
          {%- if half -%}<span class="half">★</span>{%- endif -%}
          {%- for i in range(5 - full - half) -%}<span>★</span>{%- endfor -%}
        </div>
      </div>
    </div>
    <div class="avis-bref-body">
      <div class="avis-bref-logo">
        {# logo_path est uploadé via le dashboard d'édition d'avis et stocké
           comme chemin relatif type `/avis/<slug>/logo-<ts>.<ext>`. Si vide
           on affiche l'initiale de la marque comme placeholder. #}
        {% if post.logo_path %}
          <img src="{{ post.logo_path }}" alt="Logo {{ post.marque }}">
        {% else %}
          <span class="avis-bref-logo-placeholder">{{ post.marque[0] | upper if post.marque else '?' }}</span>
        {% endif %}
      </div>
      <div class="avis-bref-text">
        {% if post.en_bref %}<p>{{ post.en_bref }}</p>{% endif %}
        <div class="score-sentiment {{ post.sentiment }}">
          {% if post.sentiment == 'positif' %}Recommandé{% elif post.sentiment == 'mitige' %}Mitigé{% else %}À éviter{% endif %}
        </div>
      </div>
    </div>
  </section>

  {# ─── POINTS FORTS / POINTS FAIBLES sur 2 colonnes ──────────── #}
  {% if post.points_forts or post.points_faibles %}
  <section class="pros-cons">
    {% if post.points_forts %}
    <div class="pros">
      <h3>Points forts</h3>
      <ul>{% for p in post.points_forts %}<li>{{ p }}</li>{% endfor %}</ul>
    </div>
    {% endif %}
    {% if post.points_faibles %}
    <div class="cons">
      <h3>Points faibles</h3>
      <ul>{% for p in post.points_faibles %}<li>{{ p }}</li>{% endfor %}</ul>
    </div>
    {% endif %}
  </section>
  {% endif %}

  {# ─── CTA centré (sous les pros/cons) ───────────────────────── #}
  {% if post.cta_url %}
  <div class="cta-wrap-main">
    <a class="cta-btn" href="{{ post.cta_url }}" rel="sponsored noopener" target="_blank">
      {{ post.cta_label | default('Visiter ' ~ post.marque) }} →
    </a>
  </div>
  {% endif %}

  {# ─── EN BREF : pour qui et pourquoi ──────────────────────── #}
  {% if post.cible %}
  <div class="en-bref">
    <strong>En bref :</strong> {{ post.marque }} s'adresse principalement à <strong>{{ post.cible }}</strong>.
    {% if post.en_bref %} {{ post.en_bref }}{% endif %}
  </div>
  {% endif %}

  {# ─── SOMMAIRE ─────────────────────────────────────────────
     Sommaire dynamique placé directement après le bloc « En bref ».
     Les ancres pointent vers les `id` posés sur chaque H2 ci-dessous.
     On n'inclut une entrée que si la section correspondante est rendue,
     pour rester cohérent quand l'IA n'a pas généré tel ou tel bloc. #}
  <nav class="avis-toc" aria-label="Sommaire de l'avis">
    <p class="toc-title">Sommaire</p>
    <ol>
      {% if post.tarifs and post.tarifs | length > 0 %}
      <li><a href="#tarifs">Tarifs et offres</a></li>
      {% endif %}
      {# ── Nouveau bloc sections_html (prompt custom dashboard) ─────────
         Si sections_html est rempli, on génère DYNAMIQUEMENT une entrée TOC
         par H2 listé dans post.sections_toc (préparé côté Python en parsant
         le HTML pour extraire titres et IDs). Si sections_toc est vide pour
         une raison quelconque, on retombe sur une entrée unique "Analyse
         détaillée". Si pas de sections_html du tout, on liste les 3 H2
         standards historiques. #}
      {% if post.sections_html %}
        {% if post.sections_toc and post.sections_toc | length > 0 %}
          {% for entry in post.sections_toc %}
          <li><a href="#{{ entry.id }}">{{ entry.titre }}</a></li>
          {% endfor %}
        {% else %}
          <li><a href="#analyse">Analyse détaillée</a></li>
        {% endif %}
      {% else %}
      {% if post.h2_fonctionnalites and post.h2_fonctionnalites.contenu_html %}
      <li><a href="#fonctionnalites">{{ post.h2_fonctionnalites.titre }}</a></li>
      {% endif %}
      {% if post.h2_support and post.h2_support.contenu_html %}
      <li><a href="#support">{{ post.h2_support.titre }}</a></li>
      {% endif %}
      {% if post.h2_qualite_prix and post.h2_qualite_prix.contenu_html %}
      <li><a href="#qualite-prix">{{ post.h2_qualite_prix.titre }}</a></li>
      {% endif %}
      {% endif %}
      {% if (post.note_trustpilot and post.nb_avis_trustpilot) or (post.h2_avis_clients and post.h2_avis_clients.contenu_html) %}
      <li><a href="#avis-clients">{{ (post.h2_avis_clients.titre if post.h2_avis_clients else None) | default('Que disent les utilisateurs ?') }}</a></li>
      {% endif %}
      {% if post.faq and post.faq | length >= 2 %}
      <li><a href="#faq">Foire aux questions</a></li>
      {% endif %}
      {% if post.verdict %}
      <li><a href="#verdict">Verdict final</a></li>
      {% endif %}
    </ol>
  </nav>

  {# ─── TABLEAU TARIFS ─────────────────────────────────────── #}
  {% if post.tarifs and post.tarifs | length > 0 %}
  <section class="tarifs-section" id="tarifs">
    <h2>Tarifs et offres de {{ post.marque }}</h2>
    <table class="tarifs-table">
      <thead>
        <tr>
          <th>Offre</th>
          <th>Prix</th>
          <th>Inclus</th>
        </tr>
      </thead>
      <tbody>
        {% for t in post.tarifs %}
        <tr>
          <td><strong>{{ t.nom }}</strong></td>
          <td class="price">{{ t.prix }}</td>
          <td>{{ t.features }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {# ─── SECTIONS PRINCIPALES ──────────────────────────────────
     Deux cas mutuellement exclusifs :
     1. Avis "nouveau workflow" : sections_html est rempli (généré par
        Claude à partir du prompt custom rédigé dans le dashboard).
        On l'injecte tel quel — la structure Hn est libre.
     2. Avis "ancien workflow" (rétro-compat) : on rend les 3 H2 nommés
        h2_fonctionnalites / h2_support / h2_qualite_prix comme avant.
     Ancrer le bloc sur #analyse (cohérent avec l'entrée TOC) pour le
     premier cas, et garder les ancres historiques pour le second. #}
  {% if post.sections_html %}
  <section class="analyse-section" id="analyse">
    {{ post.sections_html | safe }}
  </section>
  {% else %}

  {# ─── H2 FONCTIONNALITÉS ─────────────────────────────────── #}
  {% if post.h2_fonctionnalites and post.h2_fonctionnalites.contenu_html %}
  <section class="analyse-section" id="fonctionnalites">
    <h2>{{ post.h2_fonctionnalites.titre }}</h2>
    {{ post.h2_fonctionnalites.contenu_html | safe }}
  </section>
  {% endif %}

  {# ─── H2 SUPPORT CLIENT ─────────────────────────────────── #}
  {% if post.h2_support and post.h2_support.contenu_html %}
  <section class="analyse-section" id="support">
    <h2>{{ post.h2_support.titre }}</h2>
    {{ post.h2_support.contenu_html | safe }}
  </section>
  {% endif %}

  {# ─── H2 QUALITÉ / PRIX ─────────────────────────────────── #}
  {% if post.h2_qualite_prix and post.h2_qualite_prix.contenu_html %}
  <section class="analyse-section" id="qualite-prix">
    <h2>{{ post.h2_qualite_prix.titre }}</h2>
    {{ post.h2_qualite_prix.contenu_html | safe }}
  </section>
  {% endif %}

  {% endif %}{# fin de la branche sections_html / 3 H2 standards #}

  {# ─── BLOC AVIS CLIENTS (preuve sociale) ────────────────── #}
  {% if post.note_trustpilot and post.nb_avis_trustpilot %}
  <section class="avis-clients" id="avis-clients">
    <h2>{{ post.h2_avis_clients.titre | default('Que disent les utilisateurs ?') }}</h2>
    <div class="avis-clients-header">
      <div class="avis-clients-score">{{ post.note_trustpilot }}<small>/5</small></div>
      <div class="avis-clients-meta">
        Sur <strong>{{ post.nb_avis_trustpilot }}</strong> avis<br>
        {{ post.plateforme_avis | default('Trustpilot') }}
      </div>
    </div>
    {% if post.h2_avis_clients and post.h2_avis_clients.contenu_html %}
      {{ post.h2_avis_clients.contenu_html | safe }}
    {% endif %}
  </section>
  {% elif post.h2_avis_clients and post.h2_avis_clients.contenu_html %}
  <section class="analyse-section" id="avis-clients">
    <h2>{{ post.h2_avis_clients.titre }}</h2>
    {{ post.h2_avis_clients.contenu_html | safe }}
  </section>
  {% endif %}

  {# ─── FAQ ────────────────────────────────────────────────── #}
  {% if post.faq and post.faq | length > 0 %}
  <section class="faq-section" id="faq">
    <h2>Foire aux questions</h2>
    {% for item in post.faq %}
    <div class="faq-item">
      <div class="faq-q">{{ item.q }}</div>
      <div class="faq-r">{{ item.r }}</div>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {# ─── VERDICT FINAL ─────────────────────────────────────── #}
  {% if post.verdict %}
  <section class="verdict" id="verdict">
    <h2>Verdict final sur {{ post.marque }}</h2>
    <div class="verdict-note">
      <span class="score-num">{{ post.note }}<small>/5</small></span>
      <div class="stars" style="font-size:24px">
        {%- set full = post.note | int -%}
        {%- set half = 1 if (post.note - full) >= 0.5 else 0 -%}
        {%- for i in range(full) -%}<span class="full">★</span>{%- endfor -%}
        {%- if half -%}<span class="half">★</span>{%- endif -%}
        {%- for i in range(5 - full - half) -%}<span>★</span>{%- endfor -%}
      </div>
    </div>
    <p>{{ post.verdict }}</p>
    {% if post.cta_url %}
    <a class="cta-btn" href="{{ post.cta_url }}" rel="sponsored noopener" target="_blank">
      {{ post.cta_label | default('Visiter ' ~ post.marque) }} →
    </a>
    {% endif %}
  </section>
  {% endif %}

  {# ─── BOX AUTEUR ─────────────────────────────────────────────
     Mêmes données que le blog (site.author_name / job / bio / photo).
     S'affiche si au moins le nom est renseigné dans config.yaml > author. #}
  {% if site.author_name %}
  <div class="author-box">
    {% if site.author_photo %}
    <img src="{{ site.author_photo }}" alt="{{ site.author_name }}" class="author-avatar">
    {% else %}
    <div class="author-avatar-placeholder">👤</div>
    {% endif %}
    <div class="author-info">
      <div class="author-label">Auteur</div>
      <div class="author-name">{{ site.author_name }}</div>
      {% if site.author_job %}<div class="author-job">{{ site.author_job }}</div>{% endif %}
      {% if site.author_bio %}<div class="author-bio">{{ site.author_bio }}</div>{% endif %}
    </div>
  </div>
  {% endif %}

</main>

{% include "base/_footer.html.j2" ignore missing %}

<script>
// Accordion FAQ — UX simple : click toggle "open" class
document.querySelectorAll('.faq-q').forEach(q => {
  q.addEventListener('click', () => q.parentElement.classList.toggle('open'));
});
</script>

</body>
</html>
