<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
{% if site.favicon_file is defined and site.favicon_file %}
<link rel="icon" href="{{ site.favicon_file }}">
{% else %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
{% endif %}
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nos outils gratuits {{ site.year }} - {{ site.name }}</title>
<meta name="description" content="Tous les outils interactifs de {{ site.name }} : convertisseurs, calculateurs, simulateurs. Utilisation gratuite et instantanée.">
<link rel="canonical" href="{{ site.domain }}/outils">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="{{ theme.google_fonts }}&v={{ site.slug }}" rel="stylesheet">
<style>
:root{
  --bg:{{ theme.bg }};--surface:#fff;--ink:{{ theme.ink }};
  --ink2:#6B6560;--ink3:#A09890;--accent:{{ theme.accent }};--accent2:{{ theme.accent2 }};
  --cta:{{ theme.cta_color if theme.cta_color is defined and theme.cta_color else "#F59E0B" }};
  --cta-text:{{ theme.cta_text_color if theme.cta_text_color is defined and theme.cta_text_color else "#ffffff" }};
  --border:#E2DDD6;--r:12px;--r2:20px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'{{ theme.font_body }}',sans-serif;background:var(--bg);color:var(--ink);font-size:16px;line-height:1.75}
a{color:inherit;text-decoration:none}

.hero{background:var(--ink);padding:48px 5vw 40px;text-align:center}
.hero h1{font-family:'{{ theme.font_title }}',serif;font-size:clamp(28px,4vw,48px);font-weight:400;color:#fff;line-height:1.15;letter-spacing:-.02em;margin-bottom:12px}
.hero-sub{font-size:16px;color:rgba(255,255,255,.6);max-width:560px;margin:0 auto}

main{max-width:1100px;margin:0 auto;padding:56px 5vw 80px}

.outils-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:18px}

.outil-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:24px 26px;display:flex;flex-direction:column;gap:12px;transition:.15s;cursor:pointer;position:relative;overflow:hidden}
.outil-card::before{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--accent),var(--accent2));opacity:0;transition:.15s}
.outil-card:hover{border-color:var(--accent);box-shadow:0 8px 24px rgba(0,0,0,.08);transform:translateY(-3px)}
.outil-card:hover::before{opacity:1}

.outil-icon{font-size:36px;line-height:1}
.outil-name{font-family:'{{ theme.font_title }}',serif;font-size:20px;font-weight:400;color:var(--ink);letter-spacing:-.01em}
.outil-desc{font-size:14px;color:var(--ink2);line-height:1.6;flex:1}
.outil-cta{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--accent);margin-top:4px}
.outil-cta::after{content:"→";transition:transform .15s}
.outil-card:hover .outil-cta::after{transform:translateX(4px)}

.empty{text-align:center;color:var(--ink3);padding:80px 0}
.empty-icon{font-size:48px;margin-bottom:16px;opacity:.5}
.empty-text{font-size:18px}

@media(max-width:600px){
  .outils-grid{grid-template-columns:1fr}
}
</style>
{% if site.google_site_verification is defined and site.google_site_verification %}
<meta name="google-site-verification" content="{{ site.google_site_verification }}">
{% endif %}
{% if site.analytics_clicky is defined and site.analytics_clicky %}
{% if '<script' in site.analytics_clicky %}
{{ site.analytics_clicky | safe }}
{% else %}
<script async data-id="{{ site.analytics_clicky }}" src="//static.getclicky.com/js"></script>
{% endif %}
{% endif %}
</head>
<body>

{% include "base/_nav.html.j2" %}

<div class="hero">
  <h1>Nos outils gratuits {{ site.year }}</h1>
  <p class="hero-sub">Convertisseurs, calculateurs et simulateurs : à utiliser en ligne, sans inscription.</p>
</div>

<main>
  {% if outils_list and outils_list | length > 0 %}
  <div class="outils-grid">
    {% for outil in outils_list %}
    <a href="/{{ outil.slug }}" class="outil-card">
      <div class="outil-icon">{{ outil.icon }}</div>
      <h2 class="outil-name">{{ outil.name }}</h2>
      <p class="outil-desc">{{ outil.description }}</p>
      <span class="outil-cta">Utiliser l'outil</span>
    </a>
    {% endfor %}
  </div>
  {% else %}
  <div class="empty">
    <div class="empty-icon">🧰</div>
    <div class="empty-text">Aucun outil disponible pour le moment.</div>
  </div>
  {% endif %}
</main>

{% include "base/_footer.html.j2" %}

<script>
function toggleMenu(){
  document.getElementById('nav-mobile').classList.toggle('open');
}
document.addEventListener('click',function(e){
  var m=document.getElementById('nav-mobile'),b=document.getElementById('burger');
  if(m&&b&&!m.contains(e.target)&&!b.contains(e.target)){m.classList.remove('open');}
});
</script>

{# Schema.org ItemList pour le SEO #}
{% if outils_list and outils_list | length > 0 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Outils {{ site.name }}",
  "url": "{{ site.domain }}/outils",
  "itemListElement": [
    {% for outil in outils_list %}{
      "@type": "ListItem",
      "position": {{ loop.index }},
      "url": "{{ site.domain }}/{{ outil.slug }}",
      "name": {{ outil.name | tojson }}
    }{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
</script>
{% endif %}

</body>
</html>
