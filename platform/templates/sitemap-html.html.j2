<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
{% if site.favicon_file is defined and site.favicon_file %}
<link rel="icon" href="{{ site.favicon_file }}">
{% else %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
{% endif %}
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Plan du site | {{ site.name }}</title>
<meta name="description" content="Plan du site {{ site.name }} - toutes les pages disponibles.">
<link rel="canonical" href="{{ site.domain }}/plan-du-site">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="{{ theme.google_fonts }}&v={{ site.slug }}" rel="stylesheet">
<style>
:root{
  --bg:{{ theme.bg }};
  --surface:#fff;
  --ink:{{ theme.ink }};
  --ink2:#6B6560;
  --ink3:#A09890;
  --accent:{{ theme.accent }};
  --accent2:{{ theme.accent2 }};
  --cta:{{ theme.cta_color if theme.cta_color is defined and theme.cta_color else "#F59E0B" }};
  --cta-text:{{ theme.cta_text_color if theme.cta_text_color is defined and theme.cta_text_color else "#ffffff" }};
  --border:#E2DDD6;
  --r:12px;
  --r2:20px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'{{ theme.font_body }}',sans-serif;background:var(--bg);color:var(--ink);font-size:16px;line-height:1.75}
a{text-decoration:none;color:inherit}
nav{background:var(--ink);padding:0 5vw;display:flex;align-items:center;height:64px;position:sticky;top:0;z-index:100}
.nav-inner{max-width:1200px;width:100%;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px;position:relative}
.nav-logo{font-family:'{{ theme.font_title }}',serif;font-weight:400;font-size:17px;color:#fff;flex-shrink:0}.nav-logo span{color:var(--accent2)}
.nav-links{display:flex;align-items:center;gap:4px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:30px;padding:4px 8px;position:absolute;left:50%;transform:translateX(-50%)}
.nav-links a{color:rgba(255,255,255,.65);font-size:13px;font-weight:500;padding:6px 14px;border-radius:24px;transition:.15s}
.nav-links a:hover{color:#fff;background:rgba(255,255,255,.1)}
.nav-cta{display:inline-flex;align-items:center;gap:6px;padding:8px 18px;border-radius:24px;background:var(--cta);color:var(--cta-text);font-size:13px;font-weight:700;transition:.15s;flex-shrink:0}
.nav-cta:hover{opacity:.88}
.nav-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;background:none;border:none}
.nav-burger span{display:block;width:22px;height:2px;background:#fff;border-radius:2px}
.nav-mobile{display:none;position:absolute;top:64px;left:0;right:0;background:var(--ink);border-top:1px solid rgba(255,255,255,.08);padding:16px 5vw;flex-direction:column;gap:4px;z-index:99}
.nav-mobile.open{display:flex}
.nav-mobile a{color:rgba(255,255,255,.75);font-size:15px;padding:12px 16px;border-radius:10px;transition:.15s}
main{max-width:1200px;margin:0 auto;padding:56px 5vw 80px}
h1{font-family:'{{ theme.font_title }}',serif;font-size:clamp(32px,4vw,48px);font-weight:400;letter-spacing:-.02em;margin-bottom:8px}
.subtitle{font-size:16px;color:var(--ink3);margin-bottom:48px}
.sitemap-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}
.sitemap-section{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:28px}
.sitemap-section h2{font-family:'{{ theme.font_title }}',serif;font-size:20px;font-weight:400;margin-bottom:20px;padding-bottom:12px;border-bottom:1px solid var(--border);color:var(--ink)}
.sitemap-section ul{list-style:none}
.sitemap-section li{padding:7px 0;border-bottom:0.5px solid var(--border);font-size:15px}
.sitemap-section li:last-child{border-bottom:none}
.sitemap-section a{color:var(--ink2);display:flex;align-items:center;gap:8px;transition:.15s}
.sitemap-section a:hover{color:var(--accent)}
.sitemap-section a::before{content:"→";color:var(--accent);font-size:12px;flex-shrink:0}
.sitemap-full{grid-column:1/-1}
.cat-group-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--ink3);padding-bottom:8px;border-bottom:1px solid var(--border);margin-bottom:12px;margin-top:20px}
.cat-group-title:first-child{margin-top:0}
.sitemap-count{font-size:13px;color:var(--ink3);font-weight:400;margin-left:6px}
@media(max-width:768px){.sitemap-grid{grid-template-columns:1fr}.nav-links,.nav-cta{display:none}.nav-burger{display:flex}}
</style>
{% if site.analytics_clicky is defined and site.analytics_clicky %}
{% if '<script' in site.analytics_clicky %}
{{ site.analytics_clicky | safe }}
{% else %}
<script async data-id="{{ site.analytics_clicky }}" src="//static.getclicky.com/js"></script>
{% endif %}
{% endif %}
</head>
<body>

{% include 'base/_nav.html.j2' %}

<main>
  <h1>Plan du site</h1>
  <p class="subtitle">{{ site.name }} — toutes les pages disponibles</p>

  <div class="sitemap-grid">

    {# ── Pages principales — liens conditionnels selon la config du site ── #}
    <div class="sitemap-section">
      <h2>Pages principales</h2>
      <ul>
        <li><a href="/">Accueil</a></li>
        {% if site.has_a_propos is defined and site.has_a_propos %}
        <li><a href="/a-propos/">À propos</a></li>
        {% endif %}
        {% if site.has_blog is defined and site.has_blog %}
        <li><a href="/blog/">Blog</a></li>
        {% endif %}
        {# "Nos comparateurs" : pattern identique au footer/nav — affiché si
           has_comparateurs n'est pas défini (rétro-compat sites legacy) OU
           explicitement à true. Caché si défini à false (blog-only). #}
        {% if site.has_comparateurs is not defined or site.has_comparateurs %}
        <li><a href="/nos-comparateurs">Nos comparateurs</a></li>
        {% endif %}
        <li><a href="/contact">Contact</a></li>
        <li><a href="/mentions-legales">Mentions légales</a></li>
        <li><a href="/politique-confidentialite">Politique de confidentialité</a></li>
      </ul>
    </div>

    {# ── Nos classements — section ENTIÈRE conditionnée sur présence ───────
       Si pas de classement (cas cadeauclic blog-only), la section disparaît
       au lieu d'afficher un cadre vide avec juste le titre. #}
    {% if classements_by_category or products %}
    <div class="sitemap-section sitemap-full">
      <h2>Nos classements</h2>
      {% if classements_by_category %}
        {% for category, classements in classements_by_category.items() %}
        <div class="cat-group-title">{{ category }}</div>
        <ul>
          {% for cls in classements %}
          <li><a href="/meilleur-{{ cls.slug }}">Meilleur {{ cls.label }}</a></li>
          {% endfor %}
        </ul>
        {% endfor %}
      {% else %}
        {% set ns = namespace(cats=[]) %}
        <ul>
        {% for prod in products %}
          {% set cat = prod.categorie | default('') %}
          {% if cat and cat not in ns.cats %}
          {% set ns.cats = ns.cats + [cat] %}
          <li><a href="/meilleur-{{ cat | lower | replace(' ', '-') }}">Meilleur {{ cat }}</a></li>
          {% endif %}
        {% endfor %}
        </ul>
      {% endif %}
    </div>
    {% endif %}

    {# ── Articles du blog — section pleine largeur, conditionnée sur posts ─
       Nécessite que generate.py expose `posts` au render (depuis juin 2026).
       Chaque post est un dict avec .title, .slug, .categorie, .date. #}
    {% if posts %}
    <div class="sitemap-section sitemap-full">
      <h2>Articles du blog <span class="sitemap-count">({{ posts | length }})</span></h2>
      {# Tri par catégorie si la propriété existe sur les posts, sinon liste plate #}
      {% set ns = namespace(by_cat={}, no_cat=[]) %}
      {% for p in posts %}
        {% set c = (p.categorie or p.category or '') | string | trim %}
        {% if c %}
          {% if c not in ns.by_cat %}
            {% set _ = ns.by_cat.update({c: []}) %}
          {% endif %}
          {% set _ = ns.by_cat[c].append(p) %}
        {% else %}
          {% set _ = ns.no_cat.append(p) %}
        {% endif %}
      {% endfor %}

      {% if ns.by_cat %}
        {% for cat, cat_posts in ns.by_cat.items() %}
        <div class="cat-group-title">{{ cat }} <span class="sitemap-count">({{ cat_posts | length }})</span></div>
        <ul>
          {% for p in cat_posts %}
          <li><a href="/blog/{{ p.slug }}/">{{ p.title }}</a></li>
          {% endfor %}
        </ul>
        {% endfor %}
        {% if ns.no_cat %}
        <div class="cat-group-title">Autres</div>
        <ul>
          {% for p in ns.no_cat %}
          <li><a href="/blog/{{ p.slug }}/">{{ p.title }}</a></li>
          {% endfor %}
        </ul>
        {% endif %}
      {% else %}
        {# Aucun post n'a de catégorie → liste plate #}
        <ul>
          {% for p in posts %}
          <li><a href="/blog/{{ p.slug }}/">{{ p.title }}</a></li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
    {% endif %}

  </div>
</main>

{% include "base/_footer.html.j2" %}


</body>
</html>
