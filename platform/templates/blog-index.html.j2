<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
{% if site.favicon_file is defined and site.favicon_file %}
<link rel="icon" href="{{ site.favicon_file }}">
{% else %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
{% endif %}
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ blog_title }}</title>
<meta name="description" content="{{ blog_meta }}">
{# Canonical : utilise base_url (= /blog pour l'index, /<slug-categorie> pour les pages catégorie). #}
{# Pour la page 1 le canonical pointe vers base_url, pour les pages 2+ vers base_url/N (auto-référent). #}
{# Évite la duplication SEO : avant ce fix, /categorie-salarie pointait son canonical vers /blog. #}
{% set page_url = base_url if (current_page is not defined or current_page == 1) else (base_url ~ '/' ~ current_page) %}
<link rel="canonical" href="{{ site.domain }}{{ page_url }}">
{% if prev_url %}<link rel="prev" href="{{ site.domain }}{{ prev_url }}">{% endif %}
{% if next_url %}<link rel="next" href="{{ site.domain }}{{ next_url }}">{% endif %}
<meta property="og:title" content="{{ blog_title }}">
<meta property="og:description" content="{{ blog_meta }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.domain }}{{ page_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="{{ theme.google_fonts }}&v={{ site.slug }}" rel="stylesheet">

<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:{{ theme.bg | default('#FAF9F6') }};--surface:{{ theme.surface | default('#fff') }};--surface2:{{ theme.surface2 | default('#F5F3EE') }};
  --ink:{{ theme.ink | default('#0F1419') }};--ink2:{{ theme.ink2 | default('#3D434B') }};--ink3:{{ theme.ink3 | default('#8B9CB0') }};
  --accent:{{ theme.accent | default('#C9A961') }};--accent2:{{ theme.accent2 | default('#1E5F8B') }};--green:{{ theme.green | default('#3D7A4F') }};
  --border:{{ theme.border | default('#E6E1D8') }};--r:8px;--r2:14px;
  {% if theme.cta_color %}--cta:{{ theme.cta_color }};{% endif %}{% if theme.cta_text_color %}--cta-text:{{ theme.cta_text_color }};{% endif %}
}
body{font-family:'{{ theme.font_body }}',system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.65;font-size:16px}
a{color:var(--accent2);text-decoration:none}
.container{max-width:1100px;margin:0 auto;padding:0 5vw}
/* Padding réduit (avant : 64px top / 32px bot) pour rapprocher le titre du header
   et le titre des filtres. Sur mobile (≤600px) on resserre encore. */
.blog-header{padding:32px 0 12px;text-align:center}
.blog-title{font-family:'{{ theme.font_title }}',serif;font-size:clamp(36px,6vw,56px);font-weight:400;letter-spacing:-.02em;color:var(--ink);margin-bottom:12px}
.blog-sub{font-size:18px;color:var(--ink3);max-width:600px;margin:0 auto}
/* Margin réduit (avant : 32px top / 40px bot) pour coller les filtres au titre. */
.blog-filters{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:16px 0 32px}
.blog-filter{font-size:13px;font-weight:600;color:var(--ink2);padding:8px 16px;border-radius:24px;border:1px solid var(--border);background:var(--surface);transition:.15s;cursor:pointer}
.blog-filter:hover,.blog-filter.active{color:var(--accent);border-color:var(--accent)}
.blog-filter-count{font-size:11px;color:var(--ink3);margin-left:4px}
.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-bottom:64px}
.blog-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);overflow:hidden;text-decoration:none;transition:.2s;display:flex;flex-direction:column}
.blog-card:hover{border-color:var(--accent);box-shadow:0 8px 24px rgba(0,0,0,.06);transform:translateY(-2px);text-decoration:none}
.blog-card-img{aspect-ratio:16/9;background:var(--surface2);overflow:hidden}
.blog-card-img img{width:100%;height:100%;object-fit:cover}
.blog-card-img-placeholder{width:100%;height:100%;background:linear-gradient(135deg,var(--surface2) 0%,var(--bg) 100%);display:flex;align-items:center;justify-content:center;color:var(--ink3);font-size:48px}
.blog-card-body{padding:20px 22px 24px;flex:1;display:flex;flex-direction:column}
.blog-card-cat{display:inline-block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--accent);margin-bottom:10px;align-self:flex-start}
.blog-card-title{font-family:'{{ theme.font_title }}',serif;font-size:20px;font-weight:400;line-height:1.3;color:var(--ink);margin-bottom:10px;letter-spacing:-.01em}
.blog-card-excerpt{font-size:14px;color:var(--ink3);line-height:1.55;margin-bottom:16px;flex:1}
.blog-card-meta{font-size:12px;color:var(--ink3);margin-top:auto}
.blog-empty{text-align:center;padding:80px 0;color:var(--ink3);font-size:16px}
/* Pagination style "rond bleu pour la page courante + ... + séparateur + Suivant".
   Match visuel de la maquette fournie : numéros centrés sur 32px, page courante
   en rond bleu plein, ellipsis pour gros volumes, séparateur vertical avant
   Précédent/Suivant, et flèche dans cercle foncé.
   ⚠️ ATTENTION : le sélecteur global `nav` défini dans _nav.html.j2 applique
   `flex-direction:column; background:var(--ink); position:sticky; padding:0 5vw`
   à TOUS les <nav>, y compris notre <nav class="blog-pagination">. On override
   donc explicitement ces propriétés pour éviter que la pagination s'affiche en
   colonne dans un fond sombre. */
.blog-pagination{display:flex;flex-direction:row;align-items:center;justify-content:center;gap:4px;margin:48px 0 24px;flex-wrap:nowrap;font-size:15px;background:transparent;padding:0;position:static}
.blog-page-numbers{display:flex;align-items:center;gap:4px}
.blog-page-num{display:inline-flex;align-items:center;justify-content:center;min-width:32px;height:32px;padding:0 8px;border-radius:50%;background:transparent;border:none;color:var(--ink2);text-decoration:none;font-weight:500;transition:color .15s}
.blog-page-num:hover{color:var(--accent)}
.blog-page-current{background:var(--accent);color:#fff;font-weight:600;cursor:default}
.blog-page-current:hover{color:#fff}
.blog-page-ellipsis{display:inline-flex;align-items:center;justify-content:center;min-width:24px;color:var(--ink3);user-select:none}
/* Séparateur vertical entre les numéros et le bouton Précédent/Suivant */
.blog-page-sep{display:inline-block;width:1px;height:20px;background:var(--border);margin:0 12px}
/* Lien Précédent/Suivant : texte + flèche dans rond foncé */
.blog-page-link{display:inline-flex;align-items:center;gap:8px;color:var(--ink);text-decoration:none;font-weight:500;padding:6px 4px;background:transparent;border:none;transition:opacity .15s}
.blog-page-link:hover{opacity:.6;background:transparent}
.blog-page-disabled{display:inline-flex;align-items:center;gap:8px;color:var(--ink3);font-weight:500;padding:6px 4px;opacity:.4;cursor:default;background:transparent;border:none}
.blog-page-arrow{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:var(--ink);color:#fff;font-size:11px;line-height:1;flex-shrink:0}
.blog-page-disabled .blog-page-arrow{background:var(--ink3)}
@media(max-width:600px){.blog-pagination{gap:2px;font-size:14px}.blog-page-num{min-width:28px;height:28px;padding:0 6px}.blog-page-sep{margin:0 6px}.blog-page-link,.blog-page-disabled{padding:4px 2px}.blog-page-link span:not(.blog-page-arrow){display:none}.blog-page-disabled span:not(.blog-page-arrow){display:none}}
/* Footer : on n'override PLUS — c'est _footer.html.j2 qui gère son propre CSS */
@media(max-width:900px){.blog-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){
  .blog-grid{grid-template-columns:1fr}
  /* Resserrage supplémentaire sur mobile : header + filtres ultra compacts */
  .blog-header{padding:20px 0 8px}
  .blog-title{margin-bottom:8px}
  .blog-filters{margin:10px 0 24px}
}
@media(max-width:768px){.nav-links,.nav-cta{display:none}.nav-burger{display:flex}}
</style>
{% if site.google_site_verification is defined and site.google_site_verification %}
<meta name="google-site-verification" content="{{ site.google_site_verification }}">
{% endif %}
{% if site.analytics_clicky is defined and site.analytics_clicky %}
{% if '<script' in site.analytics_clicky %}
{{ site.analytics_clicky | safe }}
{% else %}
<script async data-id="{{ site.analytics_clicky }}" src="//static.getclicky.com/js"></script>
{% endif %}
{% endif %}
</head>
<body>

{% include 'base/_nav.html.j2' %}

<header class="container">
  <div class="blog-header">
    <h1 class="blog-title">{{ blog_h1 }}</h1>
    {% if blog_intro %}<p class="blog-sub">{{ blog_intro }}</p>{% endif %}
  </div>
  {% if categories and categories | length > 1 %}
  <div class="blog-filters">
    <a class="blog-filter active" href="/blog">Tous <span class="blog-filter-count">({{ posts | length }})</span></a>
    {% for cat in categories %}
    <a class="blog-filter" href="/{{ cat.slug }}">{{ cat.name }} <span class="blog-filter-count">({{ cat.count }})</span></a>
    {% endfor %}
  </div>
  {% endif %}
</header>

<main class="container">
  {% if posts %}
  <div class="blog-grid">
    {% for post in posts %}
    <a href="/{{ post.slug }}" class="blog-card">
      <div class="blog-card-img">
        {% if post.featured_image %}
        <img src="{{ post.featured_image }}" alt="{{ post.title }}" loading="lazy">
        {% else %}
        <div class="blog-card-img-placeholder">📰</div>
        {% endif %}
      </div>
      <div class="blog-card-body">
        {% if post.categorie %}<span class="blog-card-cat">{{ post.categorie }}</span>{% endif %}
        <h2 class="blog-card-title">{{ post.title }}</h2>
        {% if post.excerpt %}<p class="blog-card-excerpt">{{ post.excerpt }}</p>{% endif %}
        {% if post.date_display %}<div class="blog-card-meta">{{ post.date_display }}</div>{% endif %}
      </div>
    </a>
    {% endfor %}
  </div>

  {# Pagination — affichée seulement s'il y a + d'une page #}
  {% if total_pages is defined and total_pages > 1 %}
  <nav class="blog-pagination" aria-label="Pagination du blog">
    {# Précédent (à gauche) — visible uniquement s'il y a une page précédente.
       Style : flèche dans rond foncé + texte « Précédent ». Sur mobile, texte masqué. #}
    {% if prev_url %}
    <a href="{{ prev_url }}" class="blog-page-link blog-page-prev" rel="prev">
      <span class="blog-page-arrow" aria-hidden="true">‹</span>
      <span>Précédent</span>
    </a>
    {% else %}
    <span class="blog-page-disabled">
      <span class="blog-page-arrow" aria-hidden="true">‹</span>
      <span>Précédent</span>
    </span>
    {% endif %}

    {# Séparateur vertical entre Précédent et les numéros #}
    {% if total_pages > 1 %}<span class="blog-page-sep" aria-hidden="true"></span>{% endif %}

    {# Liste des numéros avec ellipsis :
       on affiche systématiquement la page 1, la dernière page, et la fenêtre
       [current-1, current, current+1]. Si un gap > 1 sépare deux pages affichées,
       on insère « … » (rendu via .blog-page-ellipsis).
       `namespace(prev=0)` permet de muter la variable depuis l'intérieur du for. #}
    <div class="blog-page-numbers">
      {% set ns = namespace(prev=0) %}
      {% for p in range(1, total_pages + 1) %}
        {% if p == 1 or p == total_pages or (p >= current_page - 1 and p <= current_page + 1) %}
          {% if ns.prev > 0 and p - ns.prev > 1 %}
            <span class="blog-page-ellipsis" aria-hidden="true">…</span>
          {% endif %}
          {% set page_url = base_url if p == 1 else (base_url + '/' + (p|string)) %}
          {% if p == current_page %}
          <span class="blog-page-num blog-page-current" aria-current="page">{{ p }}</span>
          {% else %}
          <a href="{{ page_url }}" class="blog-page-num">{{ p }}</a>
          {% endif %}
          {% set ns.prev = p %}
        {% endif %}
      {% endfor %}
    </div>

    {# Séparateur vertical entre les numéros et Suivant #}
    {% if total_pages > 1 %}<span class="blog-page-sep" aria-hidden="true"></span>{% endif %}

    {% if next_url %}
    <a href="{{ next_url }}" class="blog-page-link blog-page-next" rel="next">
      <span>Suivant</span>
      <span class="blog-page-arrow" aria-hidden="true">›</span>
    </a>
    {% else %}
    <span class="blog-page-disabled">
      <span>Suivant</span>
      <span class="blog-page-arrow" aria-hidden="true">›</span>
    </span>
    {% endif %}
  </nav>
  {% endif %}

  {% else %}
  <div class="blog-empty">Aucun article pour le moment.</div>
  {% endif %}
</main>

{% include 'base/_footer.html.j2' ignore missing %}

</body>
</html>
