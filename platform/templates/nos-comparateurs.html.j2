<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
{% if site.favicon_file is defined and site.favicon_file %}
<link rel="icon" href="{{ site.favicon_file }}">
{% else %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
{% endif %}
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nos comparateurs {{ site.year }} - {{ site.name }}</title>
<meta name="description" content="Retrouvez tous nos comparatifs et classements de logiciels professionnels {{ site.year }} : {{ site.tagline }}">
<link rel="canonical" href="{{ site.domain }}/nos-comparateurs">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="{{ theme.google_fonts }}&v={{ site.slug }}" rel="stylesheet">
<style>
:root{
  --bg:{{ theme.bg }};--surface:#fff;--ink:{{ theme.ink }};
  --ink2:#6B6560;--ink3:#A09890;--accent:{{ theme.accent }};--accent2:{{ theme.accent2 }};
  --cta:{{ theme.cta_color if theme.cta_color is defined and theme.cta_color else "#F59E0B" }};
  --cta-text:{{ theme.cta_text_color if theme.cta_text_color is defined and theme.cta_text_color else "#ffffff" }};
  --border:#E2DDD6;--r:12px;--r2:20px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'{{ theme.font_body }}',sans-serif;background:var(--bg);color:var(--ink);font-size:16px;line-height:1.75}
a{color:inherit;text-decoration:none}

.hero{background:var(--ink);padding:48px 5vw 40px;text-align:center}
.hero h1{font-family:'{{ theme.font_title }}',serif;font-size:clamp(28px,4vw,48px);font-weight:400;color:#fff;line-height:1.15;letter-spacing:-.02em;margin-bottom:12px}
.hero-sub{font-size:16px;color:rgba(255,255,255,.6);max-width:560px;margin:0 auto}

main{max-width:1100px;margin:0 auto;padding:56px 5vw 80px}
.cat-section{margin-bottom:48px}
.cat-title{font-family:'{{ theme.font_title }}',serif;font-size:clamp(22px,3vw,30px);font-weight:400;letter-spacing:-.02em;margin-bottom:20px;padding-bottom:12px;border-bottom:2px solid var(--accent)}
.cat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}

.comp-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r2);padding:20px 22px;display:flex;align-items:center;justify-content:space-between;transition:.15s;cursor:pointer}
.comp-card:hover{border-color:var(--accent);box-shadow:0 4px 20px rgba(0,0,0,.06);transform:translateY(-2px)}
.comp-card-left{display:flex;flex-direction:column;gap:4px}
.comp-card-name{font-size:15px;font-weight:600;color:var(--ink)}
.comp-card-count{font-size:12px;color:var(--ink3)}
.comp-card-arrow{color:var(--accent);font-size:20px;opacity:0;transition:.15s}
.comp-card:hover .comp-card-arrow{opacity:1}

.footer-logo span{color:var(--accent2)}
.footer-links a:hover{color:#fff}

@media(max-width:768px){
  .cat-grid{grid-template-columns:1fr}
}
</style>
{% if site.google_site_verification is defined and site.google_site_verification %}
<meta name="google-site-verification" content="{{ site.google_site_verification }}">
{% endif %}
{% if site.analytics_clicky is defined and site.analytics_clicky %}
{% if '<script' in site.analytics_clicky %}
{{ site.analytics_clicky | safe }}
{% else %}
<script async data-id="{{ site.analytics_clicky }}" src="//static.getclicky.com/js"></script>
{% endif %}
{% endif %}
</head>
<body>

{% include "base/_nav.html.j2" %}


<div class="hero">
  <h1>Nos comparateurs {{ site.year }}</h1>
  <p class="hero-sub">{{ site.tagline }}</p>
</div>

<main>
  {% set schema_keywords = classements_by_category %}
  {% if classements_by_category %}
    {% for category, classements in classements_by_category.items() %}
    <section class="cat-section">
      <h2 class="cat-title">{{ category }}</h2>
      <div class="cat-grid">
        {% for cls in classements %}
        <a href="/meilleur-{{ cls.slug }}" class="comp-card">
          <div class="comp-card-left">
            <div class="comp-card-name">{{ cls.label }}</div>
            <div class="comp-card-count">{{ cls.count }} logiciel{{ 's' if cls.count > 1 else '' }} comparé{{ 's' if cls.count > 1 else '' }}</div>
          </div>
          <span class="comp-card-arrow">→</span>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endfor %}
  {% else %}
  <div style="text-align:center;color:var(--ink3);padding:60px 0">
    <div style="font-size:40px;margin-bottom:16px">📊</div>
    <div style="font-size:18px">Aucun comparateur disponible pour le moment.</div>
  </div>
  {% endif %}
</main>

{% include "base/_footer.html.j2" %}

<script>
function toggleMenu(){
  document.getElementById('nav-mobile').classList.toggle('open');
}
document.addEventListener('click',function(e){
  var m=document.getElementById('nav-mobile'),b=document.getElementById('burger');
  if(m&&b&&!m.contains(e.target)&&!b.contains(e.target)){m.classList.remove('open');}
});
</script>
</body>
</html>
