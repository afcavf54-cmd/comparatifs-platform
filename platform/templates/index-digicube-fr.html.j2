{#
  platform/templates/index-digicube-fr.html.j2
  Home dédiée Digicube.fr — design custom (navy + orange, Archivo / Hanken Grotesk)
  Porté depuis le mock Claude Design — juin 2026.
  Variables Jinja minimales : site.name, site.domain, site.tagline, site.description, year.
  Le reste du contenu est volontairement en dur (textes du design, à itérer ensuite).
#}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>{{ site.home_title | default("Digicube : l'information dédiée à la digitalisation des entreprises") }}</title>
<meta name="description" content="{{ site.home_description | default('Digicube décrypte les logiciels, services numériques, innovations technologiques et tendances digitales qui accompagnent les entreprises.') }}">

<link rel="canonical" href="https://www.{{ site.domain | default('digicube.fr') }}/">

{# Open Graph #}
<meta property="og:type" content="website">
<meta property="og:url" content="https://www.{{ site.domain | default('digicube.fr') }}/">
<meta property="og:title" content="{{ site.home_title | default("Digicube : l'information dédiée à la digitalisation des entreprises") }}">
<meta property="og:description" content="{{ site.home_description | default('Digicube décrypte les logiciels, services numériques, innovations technologiques et tendances digitales qui accompagnent les entreprises.') }}">
<meta property="og:site_name" content="{{ site.name | default('Digicube') }}">
<meta name="twitter:card" content="summary_large_image">

{# Favicon #}
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><path d='M50 6 92 28 50 50 8 28Z' fill='%23fb923c'/><path d='M8 28 50 50 50 94 8 72Z' fill='%23ea650b'/><path d='M92 28 50 50 50 94 92 72Z' fill='%23f97316'/></svg>">

{# Fonts (Google Fonts au lieu des @font-face embarqués) #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Hanken+Grotesk:wght@400;500;600;700&display=swap">

<style>
/* ============================================================
   DIGICUBE — Design system
   Navy + orange, big bold sans (Archivo / Hanken Grotesk)
   ============================================================ */

:root{
  /* Brand */
  --navy-950:#0d141f;
  --navy-900:#111a26;
  --navy-800:#16202e;
  --navy:#1f2937;
  --navy-700:#273548;
  --slate:#374151;

  --ink:#111827;
  --muted:#5b6573;
  --muted-2:#8b94a3;
  --bg:#f9fafb;
  --bg-2:#f1f3f6;
  --surface:#ffffff;
  --line:rgba(17,24,39,.09);
  --line-strong:rgba(17,24,39,.16);

  /* Accent */
  --accent:#f97316;
  --accent-600:#e9650b;
  --accent-700:#c9540a;
  --accent-tint:#fff1e7;
  --accent-soft:rgba(249,115,22,.12);
  --cool:#3b6ea5;

  /* Type */
  --font-display:'Archivo', system-ui, sans-serif;
  --font-body:'Hanken Grotesk', system-ui, sans-serif;

  /* Shape */
  --radius:18px;
  --radius-sm:12px;
  --radius-pill:999px;

  --maxw:1200px;
  --gut:clamp(20px,4vw,48px);

  --shadow-sm:0 1px 2px rgba(16,24,40,.05);
  --shadow:0 6px 24px -8px rgba(16,24,40,.14);
  --shadow-lg:0 28px 60px -24px rgba(13,20,31,.45);
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  font-family:var(--font-body);
  color:var(--ink);
  background:var(--bg);
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
  line-height:1.55;
}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font-family:inherit}

h1,h2,h3,h4{
  font-family:var(--font-display);
  font-weight:800;
  line-height:1.04;
  letter-spacing:-.022em;
  margin:0;
  color:var(--ink);
  text-wrap:balance;
}

.wrap{max-width:var(--maxw);margin:0 auto;padding-inline:var(--gut)}
.section{padding-block:clamp(56px,8vw,104px)}
.eyebrow{
  font-family:var(--font-body);
  font-weight:700;
  font-size:12.5px;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--accent-700);
  margin:0 0 14px;
  display:inline-flex;align-items:center;gap:9px;
}
.eyebrow::before{content:"";width:22px;height:2px;background:var(--accent);border-radius:2px}
.eyebrow--center{justify-content:center}
.lead{font-size:clamp(16px,1.4vw,18px);color:var(--muted);max-width:60ch;line-height:1.6}

/* ---------- Buttons ---------- */
.btn{
  display:inline-flex;align-items:center;gap:10px;
  font-family:var(--font-display);font-weight:700;font-size:15px;
  padding:14px 22px;border-radius:var(--radius-pill);
  border:1px solid transparent;cursor:pointer;transition:.18s ease;
  letter-spacing:-.01em;
}
.btn .arr{transition:transform .2s ease}
.btn:hover .arr{transform:translateX(3px)}
.btn--accent{background:var(--accent);color:#fff;box-shadow:0 8px 20px -8px var(--accent)}
.btn--accent:hover{background:var(--accent-600)}
.btn--ghost{background:transparent;color:#fff;border-color:rgba(255,255,255,.28)}
.btn--ghost:hover{border-color:rgba(255,255,255,.6);background:rgba(255,255,255,.06)}
.btn--dark{background:var(--navy);color:#fff}
.btn--dark:hover{background:var(--navy-700)}
.btn--light{background:#fff;color:var(--ink);border-color:var(--line-strong)}
.btn--light:hover{border-color:var(--ink)}
.btn--sm{padding:10px 16px;font-size:13.5px}

/* ============================================================
   HERO
   ============================================================ */
.hero{
  position:relative;
  background:
    radial-gradient(120% 90% at 85% -10%, rgba(249,115,22,.18), transparent 55%),
    radial-gradient(80% 70% at 0% 0%, rgba(59,110,165,.16), transparent 50%),
    linear-gradient(180deg,var(--navy-950),var(--navy-900) 60%,var(--navy-800));
  color:#fff;overflow:hidden;
}
.hero::before{
  content:"";position:absolute;inset:0;
  background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);
  background-size:46px 46px;mask-image:radial-gradient(120% 80% at 50% 0%,#000,transparent 80%);
  pointer-events:none;
}
.hero-inner{position:relative;padding-block:clamp(48px,7vw,86px) 0}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(32px,5vw,72px);align-items:center}
.hero-badge{
  display:inline-flex;align-items:center;gap:10px;
  background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);
  border-radius:var(--radius-pill);padding:7px 15px 7px 11px;
  font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  color:rgba(255,255,255,.82);margin-bottom:26px;
}
.hero-badge .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);
  box-shadow:0 0 0 4px var(--accent-soft)}
.hero h1{
  color:#fff;font-size:clamp(40px,5.6vw,72px);line-height:1.0;
  letter-spacing:-.03em;font-weight:800;
}
.hero h1 .hl{color:var(--accent)}
.hero p.lead{color:rgba(255,255,255,.72);margin-top:22px;max-width:46ch;font-size:clamp(16px,1.45vw,18.5px)}

/* hero CTA (remplace l'ancien searchbar) */
.hero-cta-block{margin-top:32px}

.search-tags{display:flex;gap:9px;flex-wrap:wrap;margin-top:16px}
.search-tags span{font-size:12.5px;color:rgba(255,255,255,.55);font-weight:600}
.search-tags a{
  font-size:12.5px;font-weight:600;color:rgba(255,255,255,.78);
  border:1px solid rgba(255,255,255,.16);border-radius:var(--radius-pill);
  padding:5px 12px;transition:.15s;white-space:nowrap;
}
.search-tags a:hover{border-color:var(--accent);color:#fff}

/* hero visual */
.hero-visual{position:relative}
.hero-figure{position:relative;border-radius:var(--radius);overflow:hidden;
  box-shadow:var(--shadow-lg);aspect-ratio:4/3.4}
.float-card{
  position:absolute;background:rgba(255,255,255,.96);color:var(--ink);
  border-radius:14px;padding:13px 16px;box-shadow:var(--shadow-lg);
  display:flex;align-items:center;gap:12px;backdrop-filter:blur(8px);
}
.float-card .fc-num{font-family:var(--font-display);font-weight:800;font-size:24px;line-height:1;letter-spacing:-.02em}
.float-card .fc-lbl{font-size:11.5px;color:var(--muted);font-weight:600;line-height:1.2}
.float-card .fc-ic{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;
  background:var(--accent-tint);color:var(--accent-700);flex:none}
.float-a{top:18px;left:-26px}
.float-b{bottom:22px;right:-22px}
.float-stars{color:var(--accent);letter-spacing:2px;font-size:13px}

/* hero chips strip */
.hero-chips{
  position:relative;margin-top:clamp(40px,5vw,64px);
  border-top:1px solid rgba(255,255,255,.1);
  padding-block:22px 30px;
  display:flex;flex-wrap:wrap;gap:10px 26px;align-items:center;justify-content:center;
}
.hero-chips .chip{display:inline-flex;align-items:center;gap:11px;
  color:rgba(255,255,255,.82);font-weight:700;font-size:15px;letter-spacing:-.01em}
.hero-chips .chip .pl{color:var(--accent);font-weight:800}

/* ============================================================
   TRUST BAND
   ============================================================ */
.trust{background:var(--navy-800);color:#fff;border-top:1px solid rgba(255,255,255,.06);
  padding-block:clamp(42px,6vw,68px) clamp(34px,4vw,52px)}
.trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;
  background:rgba(255,255,255,.08);border-radius:var(--radius);overflow:hidden;
  box-shadow:var(--shadow-lg)}
.trust-cell{background:var(--navy-900);padding:30px 26px;text-align:center}
.trust-cell .t-num{font-family:var(--font-display);font-weight:800;font-size:clamp(30px,3.4vw,42px);
  letter-spacing:-.03em;color:#fff}
.trust-cell .t-num .u{color:var(--accent)}
.trust-cell .t-lbl{font-size:13px;color:rgba(255,255,255,.6);font-weight:600;margin-top:6px;letter-spacing:.01em}
.trust-logos{display:flex;gap:34px;align-items:center;justify-content:center;flex-wrap:wrap;
  margin-top:30px;opacity:.55}
.trust-logos .lg{height:22px;color:rgba(255,255,255,.7);font-weight:800;font-family:var(--font-display);
  letter-spacing:.02em;font-size:15px;display:flex;align-items:center;gap:6px}

/* ============================================================
   SECTION HEADER
   ============================================================ */
.sec-head{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:42px}
.sec-head h2{font-size:clamp(28px,3.4vw,44px)}
.sec-head .lead{margin-top:14px}
.sec-head--center{flex-direction:column;align-items:center;text-align:center}
.link-more{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-display);
  font-weight:700;color:var(--ink);font-size:15px;white-space:nowrap;border-bottom:2px solid var(--accent);padding-bottom:3px}
.link-more .arr{transition:transform .2s}
.link-more:hover .arr{transform:translateX(3px)}

/* ============================================================
   COMPARATEURS
   ============================================================ */
.cmp-group{margin-bottom:40px}
.cmp-group-h{display:flex;align-items:center;gap:14px;margin-bottom:18px}
.cmp-group-h .gtag{font-family:var(--font-body);font-weight:700;font-size:12.5px;letter-spacing:.13em;
  text-transform:uppercase;color:var(--slate)}
.cmp-group-h .gline{flex:1;height:1px;background:var(--line)}
.cmp-group-h .gcount{font-size:12.5px;color:var(--muted-2);font-weight:600}

.cmp-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.cmp-card{
  background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-sm);
  padding:20px;display:flex;flex-direction:column;gap:12px;transition:.18s ease;position:relative;
  min-height:148px;
}
.cmp-card:hover{border-color:var(--accent);transform:translateY(-3px);box-shadow:var(--shadow)}
.cmp-ic{width:44px;height:44px;border-radius:11px;display:grid;place-items:center;flex:none;
  background:var(--accent-tint);color:var(--accent-700)}
.cmp-card h4{font-size:16px;font-weight:700;letter-spacing:-.015em;line-height:1.18}
.cmp-card .cdesc{font-size:13px;color:var(--muted);line-height:1.45;margin:0}
.cmp-card .cfoot{margin-top:auto;display:flex;align-items:center;justify-content:space-between;padding-top:6px}
.cmp-card .ccount{font-size:12.5px;color:var(--muted-2);font-weight:600;white-space:nowrap}
.cmp-card .cgo{color:var(--accent);opacity:0;transform:translateX(-4px);transition:.18s}
.cmp-card:hover .cgo{opacity:1;transform:translateX(0)}
.cmp-card.is-featured{grid-column:span 2;background:var(--navy-900);color:#fff;border-color:transparent}
.cmp-card.is-featured h4{color:#fff;font-size:22px}
.cmp-card.is-featured .cdesc{color:rgba(255,255,255,.66)}
.cmp-card.is-featured .cmp-ic{background:var(--accent);color:#fff}
.cmp-card.is-featured .ccount{color:rgba(255,255,255,.6)}

/* ============================================================
   GENERIC SPLIT (methodology / audience)
   ============================================================ */
.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(34px,5vw,72px);align-items:center}
.split.rev .split-media{order:-1}
.steps{display:flex;flex-direction:column;gap:8px;margin-top:30px}
.step{display:flex;gap:18px;padding:18px;border-radius:var(--radius-sm);transition:.15s;border:1px solid transparent}
.step:hover{background:var(--surface);border-color:var(--line);box-shadow:var(--shadow-sm)}
.step .sn{font-family:var(--font-display);font-weight:800;font-size:15px;color:#fff;background:var(--navy);
  width:34px;height:34px;border-radius:9px;display:grid;place-items:center;flex:none}
.step h4{font-size:17px;margin-bottom:5px;letter-spacing:-.015em}
.step p{margin:0;font-size:14.5px;color:var(--muted);line-height:1.5}
.step:nth-child(1) .sn{background:var(--accent)}

/* audience cards */
.aud-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:8px}
.aud-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-sm);
  padding:26px 24px;transition:.18s}
.aud-card:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:transparent}
.aud-ic{width:46px;height:46px;border-radius:12px;background:var(--accent-tint);color:var(--accent-700);
  display:grid;place-items:center;margin-bottom:16px}
.aud-card h4{font-size:18px;margin-bottom:8px}
.aud-card p{margin:0;font-size:14px;color:var(--muted);line-height:1.5}

/* ============================================================
   AVIS (software reviews, stars)
   ============================================================ */
.avis-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.avis-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-sm);
  padding:22px;display:flex;flex-direction:column;gap:13px;transition:.18s;position:relative}
.avis-card:hover{box-shadow:var(--shadow);border-color:transparent;transform:translateY(-3px)}
.avis-top{display:flex;align-items:center;gap:13px}
.avis-logo{width:46px;height:46px;border-radius:11px;background:var(--bg-2);border:1px solid var(--line);
  display:grid;place-items:center;font-family:var(--font-display);font-weight:800;color:var(--navy);font-size:17px;flex:none}
.avis-name{font-family:var(--font-display);font-weight:700;font-size:16px;letter-spacing:-.01em}
.avis-cat{font-size:12px;color:var(--muted-2);font-weight:600}
.avis-score{margin-left:auto;text-align:right}
.avis-score .sc{font-family:var(--font-display);font-weight:800;font-size:20px;letter-spacing:-.02em}
.stars{color:var(--accent);letter-spacing:2px;font-size:14px}
.stars .off{color:var(--line-strong)}
.avis-card p{margin:0;font-size:14px;color:var(--muted);line-height:1.5}
.avis-foot{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:6px;
  border-top:1px solid var(--line);font-size:12.5px;color:var(--muted-2);font-weight:600}
.avis-foot .verdict{color:var(--accent-700);font-weight:700;font-family:var(--font-display)}

/* ============================================================
   BLOG
   ============================================================ */
.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.post{display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--line);
  border-radius:var(--radius-sm);overflow:hidden;transition:.18s;position:relative}
.post:hover{box-shadow:var(--shadow);transform:translateY(-4px);border-color:transparent}
.post .ph{aspect-ratio:16/10}
.post-image{aspect-ratio:16/10;width:100%;object-fit:cover;display:block}
.card-link{position:absolute;inset:0;z-index:2;text-indent:-9999px;overflow:hidden}
.post-body{padding:20px;display:flex;flex-direction:column;gap:10px;flex:1}
.post-cat{font-size:11px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;color:var(--accent-700)}
.post h4{font-size:18px;line-height:1.22;letter-spacing:-.015em}
.post p{margin:0;font-size:13.5px;color:var(--muted);line-height:1.5}
.post-meta{margin-top:auto;display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--muted-2);
  font-weight:600;padding-top:8px}

/* ============================================================
   EDITO / AUTHOR
   ============================================================ */
.edito{background:var(--navy-900);color:#fff;position:relative;overflow:hidden}
.edito::before{content:"";position:absolute;inset:0;
  background:radial-gradient(70% 90% at 90% 10%,rgba(249,115,22,.16),transparent 55%);pointer-events:none}
.edito-grid{position:relative;display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(34px,5vw,68px);align-items:center}
.edito blockquote{margin:0;font-family:var(--font-display);font-weight:700;letter-spacing:-.02em;
  font-size:clamp(24px,2.7vw,36px);line-height:1.18;color:#fff}
.edito blockquote .hl{color:var(--accent)}
.edito .eyebrow{color:var(--accent)}
.author-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);
  border-radius:var(--radius);padding:30px;backdrop-filter:blur(6px)}
.author-top{display:flex;align-items:center;gap:16px;margin-bottom:18px}
.author-photo{width:72px;height:72px;border-radius:50%;flex:none;overflow:hidden;
  background:var(--accent);position:relative}
.author-photo .ph{width:100%;height:100%}
.author-role{font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.55)}
.author-name{font-family:var(--font-display);font-weight:800;font-size:24px;letter-spacing:-.02em;color:#fff;margin-top:2px}
.author-meta{font-size:13.5px;color:rgba(255,255,255,.6);margin-top:3px}
.author-card p{font-size:14.5px;color:rgba(255,255,255,.74);line-height:1.62;margin:0}
.author-sign{margin-top:18px;font-family:var(--font-display);font-weight:700;font-size:15px;color:var(--accent)}

/* ============================================================
   CTA / NEWSLETTER
   ============================================================ */
.cta{background:var(--accent);color:#fff;border-radius:var(--radius);padding:clamp(34px,5vw,60px);
  display:grid;grid-template-columns:1.2fr .8fr;gap:36px;align-items:center;position:relative;overflow:hidden}
.cta::before{content:"";position:absolute;right:-60px;top:-60px;width:300px;height:300px;border-radius:50%;
  background:rgba(255,255,255,.1)}
.cta h2{color:#fff;font-size:clamp(26px,3vw,40px);position:relative}
.cta p{color:rgba(255,255,255,.9);margin:14px 0 0;position:relative;font-size:16px}
.cta-form{position:relative;display:flex;gap:8px;background:#fff;border-radius:var(--radius-pill);padding:7px 7px 7px 8px}
.cta-form input{flex:1;border:0;outline:none;background:transparent;padding:12px 14px;font-family:var(--font-body);
  font-size:15px;min-width:0;color:var(--ink)}
.cta-note{position:relative;font-size:12.5px;color:rgba(255,255,255,.85);margin-top:12px}

/* ============================================================
   PLACEHOLDER (flat-orange illustration slots)
   ============================================================ */
.ph{
  position:relative;width:100%;height:100%;
  background:
    repeating-linear-gradient(135deg,rgba(249,115,22,.10) 0 2px,transparent 2px 13px),
    linear-gradient(150deg,var(--navy-800),var(--navy-900));
  display:grid;place-items:center;overflow:hidden;
}
.ph::before{content:"";position:absolute;width:46%;aspect-ratio:1;border-radius:50%;right:-6%;top:-12%;
  background:radial-gradient(circle,var(--accent) 0%,transparent 70%);opacity:.5}
.ph .ph-tag{
  position:relative;z-index:1;
  font-family:ui-monospace,'SFMono-Regular',Menlo,monospace;font-size:10.5px;font-weight:600;letter-spacing:.06em;
  text-transform:uppercase;color:rgba(255,255,255,.66);
  border:1px dashed rgba(255,255,255,.3);border-radius:8px;padding:7px 12px;background:rgba(13,20,31,.4);
  text-align:center;max-width:84%;line-height:1.35;
}
.ph--light{background:
    repeating-linear-gradient(135deg,rgba(249,115,22,.10) 0 2px,transparent 2px 13px),
    linear-gradient(150deg,var(--bg-2),#e9edf2)}
.ph--light .ph-tag{color:var(--slate);border-color:rgba(17,24,39,.22);background:rgba(255,255,255,.55)}

.sec-alt{background:var(--bg-2)}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width:1024px){
  .hero-grid{grid-template-columns:1fr;gap:40px}
  .hero-visual{max-width:520px}
  .cmp-grid{grid-template-columns:repeat(3,1fr)}
  .cmp-card.is-featured{grid-column:span 3}
  .split,.edito-grid,.cta{grid-template-columns:1fr}
  .split.rev .split-media{order:0}
}
@media (max-width:760px){
