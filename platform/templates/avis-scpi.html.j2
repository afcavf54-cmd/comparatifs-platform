<!-- Chart.js pour les donuts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script>
// Donuts géo et sectoriel
function parseData(str){
  if(!str||str==='None'||str==='')return{labels:[],data:[]};
  str=str.replace(/^["']|["']$/g,'').trim();
  var labels=[],data=[];
  str.split(',').forEach(function(s){
    var p=s.trim().split(':');
    if(p.length===2&&p[0].trim()&&!isNaN(parseFloat(p[1]))){
      labels.push(p[0].trim());data.push(parseFloat(p[1]));
    }
  });
  return{labels:labels,data:data};
}
function makeDonut(id,d,colors){
  var el=document.getElementById(id);
  if(!el||d.labels.length===0)return;
  new Chart(el,{type:'doughnut',data:{labels:d.labels,datasets:[{data:d.data,backgroundColor:colors.slice(0,d.data.length),borderWidth:2,borderColor:'transparent',hoverOffset:6}]},options:{responsive:true,maintainAspectRatio:true,cutout:'62%',plugins:{legend:{display:false},tooltip:{callbacks:{label:function(c){return' '+c.label+' : '+c.parsed+'%';}}}}}})}
function makeLegend(id,labels,colors){
  var el=document.getElementById(id);if(!el)return;
  labels.forEach(function(l,i){var s=document.createElement('span');s.style.cssText='display:flex;align-items:center;gap:4px;font-size:11px;';s.innerHTML='<span style="width:10px;height:10px;border-radius:2px;background:'+colors[i]+'"></span>'+l;el.appendChild(s);});
}
var GEO=['#1B4FD8','#4A7FE8','#85B0F4','#B5D4F8','#D8E8FC','#E6F1FB'];
var SEC=['#1D9E75','#5DCAA5','#9FE1CB','#3B6D11','#639922','#97C459'];

{% if prod.geo and prod.geo != 'None' %}
var geoData=parseData('{{ prod.geo | replace("'", "\\'") }}');
if(geoData.labels.length>0){makeDonut('donut-geo',geoData,GEO);makeLegend('legend-geo',geoData.labels,GEO);}
{% endif %}
{% if prod.secteurs and prod.secteurs != 'None' %}
var secData=parseData('{{ prod.secteurs | replace("'", "\\'") }}');
if(secData.labels.length>0){makeDonut('donut-sec',secData,SEC);makeLegend('legend-sec',secData.labels,SEC);}
{% endif %}

// FAQ accordion
document.querySelectorAll('.faq-q').forEach(function(q){
  q.addEventListener('click',function(){
    var a=this.nextElementSibling;
    var icon=this.querySelector('.faq-icon');
    if(a){var open=a.style.display==='block';a.style.display=open?'none':'block';if(icon)icon.textContent=open?'+':'−';}
  });
});
</script>
</body>
</html>
